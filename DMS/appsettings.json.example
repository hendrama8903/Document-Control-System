  },
  "AWSConfiguration": {
    "accessKey": "REPLACE_WITH_AWS_ACCESS_KEY",
    "secretKey": "REPLACE_WITH_AWS_SECRET_KEY",
    "bucketName": "REPLACE_WITH_BUCKET_NAME",
    "region": "ap-southeast-1"
  },
  "EmailConfiguration": {
    "username": "REPLACE_WITH_SMTP_USERNAME",
    "password": "REPLACE_WITH_SMTP_PASSWORD",
