  },
  "ActiveDirectory": {
    "Domain": "REPLACE_WITH_AD_DOMAIN"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "DMS": "Debug"
    }
  },
  "AllowedHosts": "*"
}
