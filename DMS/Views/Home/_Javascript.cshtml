<script type="text/javascript">
    var statusColorMap = {
        "WAITING APPROVAL": "#B8860B",
        "APPROVED": "#2E7D3B",
        "REJECTED": "#B5402C",
        "PUBLISHED (EFFECTIVE)": "#2B5FA8",
        "OBSOLETE": "#8A98A6",
        "DELETED": "#8A98A6",
        "DRAFT": "#B8860B",
        "RECEIVED": "#2E7D3B",
        "SENT": "#2B5FA8",
        "PARTIALLY SENT": "#5B7FBD"
    };

    var categoryPalette = ["#2B88D8", "#0E8A8A", "#B8860B", "#8C6FC9", "#D97B29", "#8A98A6", "#5B7FBD"];

    function getStatusColor(statusText) {
        var key = (statusText || "").toUpperCase();
        return statusColorMap[key] || "#2B88D8";
    }

    function formatNumber(value) {
        return (value || 0).toLocaleString();
    }

    $(document).ready(function () {
        loadDashboardSummary();
    });

    function loadDashboardSummary() {
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetDashboardSummary", "Home")",
            success: function (result) {
                if (result.status == true) {
                    renderDashboard(result.data);
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function (result) {
                showErrorMesgGrowl(result);
            }
        });
    }

    function renderDashboard(data) {
        var isQms = data.scope === "QMS";

        applyDashboardLabels(isQms);

        $("#kpiTotalDocuments").text(formatNumber(data.kpi.totalDocuments.value));
        $("#kpiPendingApprovals").text(formatNumber(data.kpi.pendingApprovals.value));
        $("#kpiRejected").text(formatNumber(data.kpi.rejectedDocuments.value));
        $("#kpiUploadedToday").text(formatNumber(data.kpi.uploadedToday.value));
        $("#kpiPublished").text(formatNumber(data.kpi.publishedDocuments.value));
        $("#kpiDueForReview").text(formatNumber(data.kpi.dueForReview.value));

        renderCategoryChart(data.categorySummary);
        renderStatusChart(data.statusSummary, isQms);

        // Chart Distribution/Received (P4D, org-wide) cuma relevan untuk QMS -
        // untuk user biasa dashboard-nya murni dokumen dia sendiri di DocumentMaintenance.
        $("#rowP4DCharts").toggle(isQms);
        if (isQms) {
            renderToggleDonut("distributionToggle", "chartDistribution", data.distribution);
            renderToggleDonut("receivedToggle", "chartReceived", data.received);
        }
    }

    // Label KPI/panel beda makna tergantung scope dashboard: "USER" = dokumen milik
    // sendiri (DocumentMaintenance), "QMS" = seluruh dokumen di Document Control (P4D).
    function applyDashboardLabels(isQms) {
        if (isQms) {
            $("#lblTotalDocuments").text("Total P4D Documents");
            $("#lblPendingApprovals").text("Pending Review");
            $("#lblRejected").text("Rejected in P4D");
            $("#lblUploadedToday").text("Registered Today");
            $("#lblPublished").text("Sent Documents");
            $("#lblDueForReview").text("Received Documents");
            $("#lnkPendingApprovals, #lnkRejected, #lnkUploadedToday, #lnkPublished, #lnkDueForReview")
                .attr("href", "@Url.Action("Index", "P4DMaintenance")");
            $("#titleCategoryChart").text("P4D Documents by Department");
            $("#lnkCategoryChart").attr("href", "@Url.Action("Index", "P4DMaintenance")");
            $("#titleStatusChart").text("Documents by Status");
        } else {
            $("#lblTotalDocuments").text("Total Documents");
            $("#lblPendingApprovals").text("Pending Approvals");
            $("#lblRejected").text("Rejected Documents");
            $("#lblUploadedToday").text("Uploaded Today");
            $("#lblPublished").text("Published Documents");
            $("#lblDueForReview").text("Due for Review");
            $("#lnkPendingApprovals, #lnkRejected, #lnkUploadedToday")
                .attr("href", "@Url.Action("Index", "DocumentMaintenance")");
            $("#lnkPublished").attr("href", "@Url.Action("Index", "P4DMaintenance")");
            $("#lnkDueForReview").attr("href", "@Url.Action("Index", "DocumentReport")");
            $("#titleCategoryChart").text("Documents by Category");
            $("#lnkCategoryChart").attr("href", "@Url.Action("Index", "DocumentReport")");
            $("#titleStatusChart").text("Documents by Level");
        }
    }

    // Donut chart pakai CSS conic-gradient murni - tanpa dependensi DevExtreme sama sekali,
    // jadi tidak ada lagi risiko bentrok bundle/versi seperti sebelumnya (dx.web.js vs
    // dx.viz.js, field legend yang tidak konsisten, legend hilang untuk chart 1 slice, dsb).
    function renderCssDonut(elementId, items, caption) {
        var container = $("#" + elementId);
        container.empty();

        if (!items || items.length == 0) {
            container.html('<div class="dash-empty-text">No data yet.</div>');
            return;
        }

        var total = items.reduce(function (sum, it) { return sum + it.count; }, 0) || 1;
        var cursor = 0;
        var gradientParts = items.map(function (it) {
            var start = (cursor / total) * 100;
            cursor += it.count;
            var end = (cursor / total) * 100;
            return it.color + " " + start + "% " + end + "%";
        });

        var wrap = $("<div>").addClass("dash-donut-wrap");

        var donut = $("<div>").addClass("dash-donut")
            .css("background", "conic-gradient(" + gradientParts.join(", ") + ")");
        var hole = $("<div>").addClass("dash-donut-hole");
        hole.append($("<div>").addClass("dash-donut-value").text(formatNumber(total)));
        hole.append($("<div>").addClass("dash-donut-caption").text(caption));
        donut.append(hole);

        var legend = $("<ul>").addClass("dash-donut-legend");
        items.forEach(function (it) {
            var li = $("<li>").attr("title", it.label + ": " + formatNumber(it.count) + " (" + it.percent + "%)");
            li.append($("<span>").addClass("dash-donut-swatch").css("background", it.color));
            li.append($("<span>").addClass("dash-donut-label").text(it.label));
            li.append($("<span>").addClass("dash-donut-count").text(formatNumber(it.count) + " (" + it.percent + "%)"));
            legend.append(li);
        });

        wrap.append(donut, legend);
        container.append(wrap);
    }

    function renderCategoryChart(categorySummary) {
        var items = (categorySummary || []).map(function (c, i) {
            return { label: c.category, count: c.count, percent: c.percent, color: categoryPalette[i % categoryPalette.length] };
        });
        renderCssDonut("chartCategory", items, "Total");
    }

    // Untuk QMS ini menampilkan status P4D (pakai warna status yang konsisten dgn status
    // di modul lain), untuk user biasa menampilkan Level dokumen (P4D tidak punya konsep
    // Level, jadi dipakai warna kategori biasa yang cuma untuk membedakan tiap slice).
    function renderStatusChart(statusSummary, isQms) {
        var items = (statusSummary || []).map(function (s, i) {
            return {
                label: s.status,
                count: s.count,
                percent: s.percent,
                color: isQms ? getStatusColor(s.status) : categoryPalette[i % categoryPalette.length]
            };
        });
        renderCssDonut("chartStatus", items, "Total");
    }

    function renderGenericDonut(elementId, dataset, caption) {
        var total = (dataset || []).reduce(function (sum, d) { return sum + d.count; }, 0) || 1;
        var items = (dataset || []).map(function (d, i) {
            return { label: d.name, count: d.count, percent: Math.round((d.count * 100) / total), color: categoryPalette[i % categoryPalette.length] };
        });
        renderCssDonut(elementId, items, caption);
    }

    // Toggle group (Division / Department) driving a donut chart from data already fetched — no re-fetch on click.
    function renderToggleDonut(toggleGroupId, chartId, dataset) {
        var group = $("#" + toggleGroupId);

        function draw() {
            var view = group.find(".dash-toggle-btn.active").data("view");
            var source = view === "division" ? dataset.byDivision : dataset.byDepartment;
            renderGenericDonut(chartId, source, view === "division" ? "Division" : "Department");
        }

        group.find(".dash-toggle-btn").off("click.dashToggle").on("click.dashToggle", function () {
            group.find(".dash-toggle-btn").removeClass("active");
            $(this).addClass("active");
            draw();
        });

        draw();
    }


</script>
