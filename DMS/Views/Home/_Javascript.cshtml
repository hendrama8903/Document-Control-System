<script type="text/javascript">
    var urlDocumentMaintenance = "@Url.Action("Index", "DocumentMaintenance")";
    var urlExternalDocument = "@Url.Action("Index", "ExternalDocument")";

    var statusColorMap = {
        "0": "#EA580C", // Waiting Approval
        "1": "#2E7D3B", // Approved
        "2": "#C62828", // Rejected
        "5": "#2450D8", // Published
        "6": "#B36B00"  // Waiting Acknowledgment
    };

    var categoryPalette = ["#2450D8", "#0E8A8A", "#B8860B", "#8C6FC9", "#D97B29", "#8A98A6", "#5B7FBD"];

    function formatNumber(value) {
        return (value || 0).toLocaleString();
    }

    function escapeHtml(value) {
        return $("<div>").text(value == null ? "" : value).html();
    }

    function documentUrl(code) {
        return urlDocumentMaintenance + "?DOCUMENT_CODE=" + encodeURIComponent(code || "");
    }

    $(document).ready(function () {
        $("#btn_refreshDashboard").on("click", loadDashboardSummary);
        loadDashboardSummary();
    });

    function loadDashboardSummary() {
        $("#hdRoot").addClass("hd-loading");
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetDashboardSummary", "Home")",
            success: function (result) {
                $("#hdRoot").removeClass("hd-loading");
                if (result.status == true) {
                    renderDashboard(result.data);
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function (result) {
                $("#hdRoot").removeClass("hd-loading");
                showErrorMesgGrowl(result);
            }
        });
    }

    function renderDashboard(data) {
        renderScope(data.user);
        renderActions(data.actions, data.user.isQms);
        renderMyApprovalList(data.myApprovalList, data.actions.myApproval);
        renderMyInProgress(data.myInProgress);
        renderOverview(data.overview, data.user);
        renderReviewList(data.upcomingReview, data.actions.reviewDue);
        renderQms(data.qms);
    }

    // chip scope Overview: "My Documents" atau unit yang dinaungi (sesuai jabatan)
    function renderScope(user) {
        var personal = user.scopeType === "PERSONAL";
        $("#hdOverviewScope")
            .text(personal ? "My Documents" : user.scopeLabel)
            .attr("title", personal ? "Documents you created" : (user.positionName ? user.positionName + " - " : "") + user.scopeLabel);
    }

    // ---------- Needs Your Action ----------
    function setActionCard(id, value) {
        $("#" + id + "Value").text(formatNumber(value));
        $("#" + id).toggleClass("has-items", value > 0).toggleClass("is-empty", !value);
    }

    function renderActions(actions, isQms) {
        setActionCard("actMyApproval", actions.myApproval);
        setActionCard("actRejected", actions.rejected);
        setActionCard("actReview", actions.reviewDue);
        $("#actReview").attr("title", actions.reviewOverdue > 0
            ? actions.reviewOverdue + " overdue, the rest due within the next 30 days"
            : "Review due within the next 30 days");

        $("#actP4D").toggle(isQms);
        if (isQms) setActionCard("actP4D", actions.p4dAction);
    }

    function emptyState(icon, text) {
        return '<li class="hd-empty" style="display:block;border:none;"><i class="fa ' + icon + '"></i>' + escapeHtml(text) + '</li>';
    }

    function renderMyApprovalList(items, total) {
        $("#myApprovalBadge").text(total || 0);
        var $list = $("#myApprovalList").empty();

        if (!items || items.length === 0) {
            $list.html(emptyState("fa-check-circle-o", "Nothing is waiting for your approval."));
            return;
        }

        // satu baris per dokumen supaya daftar panjang tetap ringkas (card di-scroll)
        items.forEach(function (it) {
            var step = it.step && it.total ? it.step + "/" + it.total + " · " : "";
            $list.append(
                '<li title="' + escapeHtml(it.code + " - " + it.name) + '">' +
                    '<div class="hd-list-main">' +
                        '<span class="hd-list-code">' + escapeHtml(it.code) + '</span>' +
                        '<span class="hd-list-name">' + escapeHtml(it.name) + '</span>' +
                    '</div>' +
                    '<span class="hd-list-meta">' + escapeHtml(step + moment(it.updated).fromNow()) + '</span>' +
                    '<a class="hd-open" href="' + documentUrl(it.code) + '">Review</a>' +
                '</li>');
        });
    }

    function renderMyInProgress(items) {
        var $list = $("#myInProgressList").empty();

        if (!items || items.length === 0) {
            $list.html(emptyState("fa-inbox", "None of your documents are in approval right now."));
            return;
        }

        items.forEach(function (it) {
            var pill;
            if (it.status == "6") {
                pill = '<span class="dms-pill dms-pill-warning"><i class="fa fa-users"></i> Waiting Ack.</span>';
            } else {
                pill = '<span class="dms-pill dms-pill-info"><i class="fa fa-clock-o"></i> Waiting'
                    + (it.step && it.total ? " " + it.step + "/" + it.total : "") + '</span>';
            }
            var waitingFor = it.status == "6" ? "Related division acknowledgment" : "Waiting for " + (it.approverName || "-");

            $list.append(
                '<li title="' + escapeHtml(it.name + " - " + waitingFor + " (" + moment(it.updated).fromNow() + ")") + '">' +
                    '<div class="hd-list-main">' +
                        '<a class="hd-list-code" href="' + documentUrl(it.code) + '">' + escapeHtml(it.code) + '</a>' +
                        '<span class="hd-list-name">' + escapeHtml(it.name) + '</span>' +
                    '</div>' +
                    '<span class="hd-list-meta">' + escapeHtml(it.status == "6" ? "Related div." : (it.approverName || "-")) + '</span>' +
                    '<div class="hd-list-right">' + pill + '</div>' +
                '</li>');
        });
    }

    // ---------- Overview ----------
    function setKpiPct(id, value, total) {
        $("#" + id).text(total > 0 ? "· " + Math.round(value * 100 / total) + "%" : "");
    }

    function renderOverview(overview, user) {
        var k = overview.kpi;
        $("#kpiTotal").text(formatNumber(k.total));
        $("#kpiInProgress").text(formatNumber(k.inProgress));
        $("#kpiEffective").text(formatNumber(k.effective));
        $("#kpiRejected").text(formatNumber(k.rejected));
        setKpiPct("kpiInProgressPct", k.inProgress, k.total);
        setKpiPct("kpiEffectivePct", k.effective, k.total);
        setKpiPct("kpiRejectedPct", k.rejected, k.total);

        renderTrend(overview.trend);

        renderCssDonut("chartStatus", (overview.byStatus || []).map(function (s) {
            return { label: s.label, count: s.count, percent: s.percent, color: statusColorMap[s.code] || "#8A98A6" };
        }), "Total");

        renderCssDonut("chartCategory", (overview.byCategory || []).map(function (c, i) {
            return { label: c.label, count: c.count, percent: c.percent, color: categoryPalette[i % categoryPalette.length] };
        }), "Total");

        renderBreakdown(overview.breakdown, user.scopeType);
    }

    function renderTrend(trend) {
        var $chart = $("#chartTrend").empty();
        var max = Math.max.apply(null, (trend || []).map(function (t) { return t.count; }).concat([1]));

        (trend || []).forEach(function (t, i) {
            var $col = $("<div>").addClass("hd-trend-col").toggleClass("current", i === trend.length - 1)
                .attr("title", t.label + ": " + t.count + " document(s)");
            $("<div>").addClass("hd-trend-value").text(t.count).appendTo($col);
            $("<div>").addClass("hd-trend-bar").css("height", "calc((100% - 38px) * " + (t.count / max).toFixed(3) + ")").appendTo($col);
            $("<div>").addClass("hd-trend-label").text(t.label).appendTo($col);
            $chart.append($col);
        });
    }

    function renderBreakdown(rows, scopeType) {
        var visible = rows && rows.length > 0;
        $("#breakdownCard").toggle(visible);
        if (!visible) return;

        var unit = scopeType === "COMPANY" ? "Division" : "Department";
        $("#breakdownTitle").text("By " + unit);
        $("#breakdownUnit").text(unit);

        function num(value, cls) {
            return '<td class="' + (value > 0 ? cls : "num-zero") + '">' + formatNumber(value) + '</td>';
        }

        var html = rows.map(function (r) {
            return '<tr><td>' + escapeHtml(r.name) + '</td>' +
                '<td>' + formatNumber(r.total) + '</td>' +
                num(r.inProgress, "num-progress") +
                num(r.effective, "") +
                num(r.rejected, "num-rejected") + '</tr>';
        }).join("");
        $("#breakdownBody").html(html);
    }

    // ---------- Upcoming Review ----------
    function renderReviewList(items, total) {
        var $list = $("#reviewList").empty();

        if (!items || items.length === 0) {
            $list.html(emptyState("fa-calendar-check-o", "No reviews due in the next 30 days."));
            return;
        }

        items.forEach(function (it) {
            var cls = it.daysLeft < 0 ? "overdue" : it.daysLeft <= 7 ? "soon" : "later";
            var label = it.daysLeft < 0 ? "Overdue " + Math.abs(it.daysLeft) + "d"
                : it.daysLeft === 0 ? "Today" : "in " + it.daysLeft + "d";
            var codeHtml = it.code
                ? '<a class="hd-list-code" href="' + documentUrl(it.code) + '">' + escapeHtml(it.code) + '</a>'
                : '<a class="hd-list-code" href="' + urlExternalDocument + '">External</a>';

            $list.append(
                '<li title="' + escapeHtml(it.name) + '">' +
                    '<div class="hd-list-main">' +
                        codeHtml +
                        '<span class="hd-list-name">' + escapeHtml(it.name) + '</span>' +
                    '</div>' +
                    '<span class="hd-list-meta">' + moment(it.date).format("DD MMM YYYY") + '</span>' +
                    '<div class="hd-list-right"><span class="hd-due ' + cls + '">' + label + '</span></div>' +
                '</li>');
        });

        if (total > items.length) {
            $list.append('<li class="hd-list-meta" style="justify-content:center;">+ ' + (total - items.length) + ' more in Document Report</li>');
        }
    }

    // ---------- Document Control (QMS) ----------
    function renderQms(qms) {
        $("#qmsSection").toggle(qms != null);
        // Grafik Document Control satu baris dengan grafik lain, supaya muat satu layar.
        $("#qmsSection .hd-row > .hd-card").appendTo(".hd-row-charts");
        if (qms == null) return;

        $("#qmsTotal").text(formatNumber(qms.kpi.total));
        $("#qmsToReceive").text(formatNumber(qms.kpi.toReceive));
        $("#qmsChecking").text(formatNumber(qms.kpi.checking));
        $("#qmsSent").text(formatNumber(qms.kpi.sent));
        $("#qmsRejected").text(formatNumber(qms.kpi.rejected));

        renderToggleDonut("distributionToggle", "chartDistribution", qms.distribution);
        renderToggleDonut("receivedToggle", "chartReceived", qms.received);
    }

    // Donut chart pakai CSS conic-gradient murni - tanpa dependensi DevExtreme sama sekali,
    // jadi tidak ada lagi risiko bentrok bundle/versi seperti sebelumnya (dx.web.js vs
    // dx.viz.js, field legend yang tidak konsisten, legend hilang untuk chart 1 slice, dsb).
    function renderCssDonut(elementId, items, caption) {
        var container = $("#" + elementId);
        container.empty();

        if (!items || items.length == 0) {
            container.html('<div class="hd-empty"><i class="fa fa-pie-chart"></i>No data yet.</div>');
            return;
        }

        var total = items.reduce(function (sum, it) { return sum + it.count; }, 0) || 1;
        var cursor = 0;
        var gradientParts = items.map(function (it) {
            var start = (cursor / total) * 100;
            cursor += it.count;
            var end = (cursor / total) * 100;
            return it.color + " " + start + "% " + end + "%";
        });

        var wrap = $("<div>").addClass("dash-donut-wrap");

        var donut = $("<div>").addClass("dash-donut")
            .css("background", "conic-gradient(" + gradientParts.join(", ") + ")");
        var hole = $("<div>").addClass("dash-donut-hole");
        hole.append($("<div>").addClass("dash-donut-value").text(formatNumber(total)));
        hole.append($("<div>").addClass("dash-donut-caption").text(caption));
        donut.append(hole);

        var legend = $("<ul>").addClass("dash-donut-legend");
        items.forEach(function (it) {
            var li = $("<li>").attr("title", it.label + ": " + formatNumber(it.count) + " (" + it.percent + "%)");
            li.append($("<span>").addClass("dash-donut-swatch").css("background", it.color));
            li.append($("<span>").addClass("dash-donut-label").text(it.label));
            li.append($("<span>").addClass("dash-donut-count").text(formatNumber(it.count) + " (" + it.percent + "%)"));
            legend.append(li);
        });

        wrap.append(donut, legend);
        container.append(wrap);
    }

    function renderGenericDonut(elementId, dataset, caption) {
        var total = (dataset || []).reduce(function (sum, d) { return sum + d.count; }, 0) || 1;
        var items = (dataset || []).map(function (d, i) {
            return { label: d.name, count: d.count, percent: Math.round((d.count * 100) / total), color: categoryPalette[i % categoryPalette.length] };
        });
        renderCssDonut(elementId, items, caption);
    }

    // Toggle group (Division / Department) driving a donut chart from data already fetched — no re-fetch on click.
    function renderToggleDonut(toggleGroupId, chartId, dataset) {
        var group = $("#" + toggleGroupId);

        function draw() {
            var view = group.find(".dash-toggle-btn.active").data("view");
            var source = view === "division" ? dataset.byDivision : dataset.byDepartment;
            renderGenericDonut(chartId, source, view === "division" ? "Division" : "Department");
        }

        group.find(".dash-toggle-btn").off("click.dashToggle").on("click.dashToggle", function () {
            group.find(".dash-toggle-btn").removeClass("active");
            $(this).addClass("active");
            draw();
        });

        draw();
    }
</script>
