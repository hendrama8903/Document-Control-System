<style>
    .dash-stat-row {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin: 20px 0;
    }

    .dash-stat-card {
        flex: 1 1 180px;
        min-width: 160px;
        border-radius: var(--radius, 14px);
        box-shadow: var(--shadow, 0 1px 2px rgba(20,35,50,.08));
        background: #fff;
        padding: 16px 18px;
        border-left: 5px solid var(--primary, #14456E);
    }

        .dash-stat-card .dash-stat-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--ink, #16212B);
            line-height: 1.2;
        }

        .dash-stat-card .dash-stat-label {
            color: var(--muted, #66788A);
            font-size: 12.5px;
            margin-top: 4px;
        }

        .dash-stat-card.dash-new { border-left-color: var(--emas, #B8860B); }
        .dash-stat-card.dash-approved { border-left-color: #2E7D3B; }
        .dash-stat-card.dash-rejected { border-left-color: var(--merah, #B5402C); }
        .dash-stat-card.dash-users { border-left-color: var(--accent, #2E6DA0); }

    .dash-ctrl-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .dash-ctrl-list li {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid var(--line, #DFE5EB);
        }

            .dash-ctrl-list li:last-child { border-bottom: none; }

        .dash-ctrl-list .dash-ctrl-count {
            font-weight: 700;
            color: var(--primary, #14456E);
        }

    #tblRecentDocuments td, #tblRecentDocuments th {
        vertical-align: middle;
    }

    .dash-empty-text {
        color: var(--muted, #66788A);
        text-align: center;
        padding: 20px 0;
    }
</style>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="adm-page-head">
                <div class="adm-eyebrow">Document Control System</div>
                <h1>@ViewData["Title"]</h1>
            </div>
        </div>
    </div>

    <div class="dash-stat-row">
        <div class="dash-stat-card dash-total">
            <div class="dash-stat-value" id="statTotalDocuments">0</div>
            <div class="dash-stat-label">Total Documents</div>
        </div>
        <div class="dash-stat-card dash-new">
            <div class="dash-stat-value" id="statNew">0</div>
            <div class="dash-stat-label">New / Draft</div>
        </div>
        <div class="dash-stat-card dash-approved">
            <div class="dash-stat-value" id="statApproved">0</div>
            <div class="dash-stat-label">Approved</div>
        </div>
        <div class="dash-stat-card dash-rejected">
            <div class="dash-stat-value" id="statRejected">0</div>
            <div class="dash-stat-label">Rejected</div>
        </div>
        <div class="dash-stat-card dash-users">
            <div class="dash-stat-value" id="statTotalUsers">0</div>
            <div class="dash-stat-label">Total Users</div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Documents by Status</h3>
                </div>
                <div class="box-body">
                    <div id="chartStatus" style="height:300px;"></div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Documents by Division</h3>
                </div>
                <div class="box-body">
                    <div id="chartDivision" style="height:300px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-7">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Recent Documents</h3>
                </div>
                <div class="box-body" style="padding:0;">
                    <table class="table" id="tblRecentDocuments">
                        <thead>
                            <tr>
                                <th>Document No</th>
                                <th>Document Name</th>
                                <th>Status</th>
                                <th>Last Updated</th>
                            </tr>
                        </thead>
                        <tbody id="tblRecentDocumentsBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Document Control Activity</h3>
                </div>
                <div class="box-body">
                    <ul class="dash-ctrl-list" id="listCtrlStatus"></ul>
                </div>
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
<script src="~/js/devextreme/dx.web.js"></script>
<script src="~/js/devextreme/dx.viz.js"></script>

@Html.Partial("_Javascript")
