<style>
    /* ---- KPI row ---- */
    .kpi-row {
        display: flex;
        flex-wrap: nowrap;
        align-items: stretch;
        gap: 10px;
        margin: 20px 0;
        overflow-x: auto;
        padding-bottom: 2px;
    }

    .kpi-card {
        position: relative;
        flex: 1 1 0;
        min-width: 170px;
        min-height: 130px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 14px;
        box-shadow: 0 2px 4px rgba(20,35,50,.06), 0 12px 28px -14px rgba(20,35,50,.28);
        padding: 22px 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(20,35,50,.08), 0 16px 32px -14px rgba(20,35,50,.32);
        }

        .kpi-card.blue { border-left-color: var(--accent); }
        .kpi-card.amber { border-left-color: var(--emas); }
        .kpi-card.red { border-left-color: var(--merah); }
        .kpi-card.teal { border-left-color: #0E8A8A; }
        .kpi-card.green { border-left-color: #2E7D3B; }
        .kpi-card.purple { border-left-color: #6C3FB5; }

    .kpi-more-detail {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--paper-2);
        color: var(--muted);
        font-size: 10px;
    }

        .kpi-more-detail:hover {
            background: var(--accent-soft);
            color: var(--accent);
            text-decoration: none;
        }

    .kpi-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: none;
        font-size: 19px;
    }

        .kpi-icon.blue { background: var(--accent-soft); color: var(--accent); }
        .kpi-icon.amber { background: var(--emas-soft); color: var(--emas); }
        .kpi-icon.red { background: var(--merah-soft); color: var(--merah); }
        .kpi-icon.teal { background: #E0F5F5; color: #0E8A8A; }
        .kpi-icon.green { background: #E3F3E7; color: #2E7D3B; }
        .kpi-icon.purple { background: #EEE7F8; color: #6C3FB5; }

    .kpi-value {
        font-size: 30px;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.15;
        font-variant-numeric: tabular-nums;
    }

    .kpi-label {
        font-size: 13px;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ---- Panel header action link (on box-primary blue header) ---- */
    .box-header-action {
        color: rgba(255,255,255,.85);
        font-size: 12px;
        white-space: nowrap;
    }

        .box-header-action:hover { color: #fff; text-decoration: none; }

    /* ---- Donut chart (CSS conic-gradient murni, tanpa library) ---- */
    .dash-donut-wrap {
        display: flex;
        align-items: center;
        gap: 20px;
        height: 100%;
        flex-wrap: wrap;
    }

    .dash-donut {
        position: relative;
        width: 230px;
        height: 230px;
        border-radius: 50%;
        flex: none;
    }

    .dash-donut-hole {
        position: absolute;
        inset: 22%;
        background: var(--surface);
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .dash-donut-value { font-size: 26px; font-weight: 700; color: var(--ink); }
    .dash-donut-caption { font-size: 12px; color: var(--muted); }

    .dash-donut-legend {
        list-style: none;
        margin: 0;
        padding: 0;
        flex: 1;
        min-width: 140px;
    }

        .dash-donut-legend li {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            font-size: 14px;
            color: var(--ink);
        }

    .dash-donut-swatch {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        flex: none;
    }

    .dash-donut-label {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dash-donut-count {
        flex: none;
        color: var(--muted);
        font-size: 13px;
        white-space: nowrap;
    }

    /* ---- Division / Department view toggle ---- */
    .dash-panel-toolbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 6px;
    }

    .dash-toggle {
        display: inline-flex;
        border-radius: 999px;
        overflow: hidden;
        border: 1px solid var(--line);
    }

    .dash-toggle-btn {
        border: none;
        background: var(--paper-2);
        color: var(--muted);
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 14px;
        cursor: pointer;
    }

        .dash-toggle-btn.active {
            background: var(--primary);
            color: #fff;
        }

        .dash-toggle-btn:focus { outline: none; }

    .dash-empty-text {
        color: var(--muted);
        text-align: center;
        padding: 24px 0;
        font-size: 12.5px;
    }

    /* ---- Tinggi panel menyesuaikan konten (proporsional), halaman boleh scroll ---- */
    .dash-viewport .box {
        display: flex;
        flex-direction: column;
    }

    .dash-viewport .box-body {
        display: flex;
        flex-direction: column;
    }

    #chartCategory, #chartStatus {
        min-height: 300px;
    }

    #chartDistribution, #chartReceived {
        min-height: 260px;
    }
</style>

<section class="content">
    <div class="kpi-row">
        <div class="kpi-card blue">
            <a class="kpi-more-detail" href="@Url.Action("Index", "DocumentReport")" title="More Detail"><i class="fa fa-external-link"></i></a>
            <div class="kpi-top">
                <div class="kpi-icon blue"><i class="fa fa-file-text-o"></i></div>
                <div class="kpi-value" id="kpiTotalDocuments">0</div>
            </div>
            <div class="kpi-label" id="lblTotalDocuments">Total Documents</div>
        </div>
        <div class="kpi-card amber">
            <a class="kpi-more-detail" id="lnkPendingApprovals" href="@Url.Action("Index", "DocumentMaintenance")" title="More Detail"><i class="fa fa-external-link"></i></a>
            <div class="kpi-top">
                <div class="kpi-icon amber"><i class="fa fa-clock-o"></i></div>
                <div class="kpi-value" id="kpiPendingApprovals">0</div>
            </div>
            <div class="kpi-label" id="lblPendingApprovals">Pending Approvals</div>
        </div>
        <div class="kpi-card red">
            <a class="kpi-more-detail" id="lnkRejected" href="@Url.Action("Index", "DocumentMaintenance")" title="More Detail"><i class="fa fa-external-link"></i></a>
            <div class="kpi-top">
                <div class="kpi-icon red"><i class="fa fa-times-circle"></i></div>
                <div class="kpi-value" id="kpiRejected">0</div>
            </div>
            <div class="kpi-label" id="lblRejected">Rejected Documents</div>
        </div>
        <div class="kpi-card teal">
            <a class="kpi-more-detail" id="lnkUploadedToday" href="@Url.Action("Index", "DocumentMaintenance")" title="More Detail"><i class="fa fa-external-link"></i></a>
            <div class="kpi-top">
                <div class="kpi-icon teal"><i class="fa fa-cloud-upload"></i></div>
                <div class="kpi-value" id="kpiUploadedToday">0</div>
            </div>
            <div class="kpi-label" id="lblUploadedToday">Uploaded Today</div>
        </div>
        <div class="kpi-card purple">
            <a class="kpi-more-detail" id="lnkPublished" href="@Url.Action("Index", "P4DMaintenance")" title="More Detail"><i class="fa fa-external-link"></i></a>
            <div class="kpi-top">
                <div class="kpi-icon purple"><i class="fa fa-share-alt"></i></div>
                <div class="kpi-value" id="kpiPublished">0</div>
            </div>
            <div class="kpi-label" id="lblPublished">Published Documents</div>
        </div>
        <div class="kpi-card green">
            <a class="kpi-more-detail" id="lnkDueForReview" href="@Url.Action("Index", "DocumentReport")" title="More Detail"><i class="fa fa-external-link"></i></a>
            <div class="kpi-top">
                <div class="kpi-icon green"><i class="fa fa-calendar-check-o"></i></div>
                <div class="kpi-value" id="kpiDueForReview">0</div>
            </div>
            <div class="kpi-label" id="lblDueForReview">Due for Review</div>
        </div>
    </div>

    <div class="dash-viewport">
        <div class="row">
            <div class="col-md-6">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title" id="titleCategoryChart">Documents by Category</h3>
                        <a class="box-header-action" id="lnkCategoryChart" href="@Url.Action("Index", "DocumentReport")">View Full Report <i class="fa fa-angle-right"></i></a>
                    </div>
                    <div class="box-body">
                        <div id="chartCategory"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title" id="titleStatusChart">Documents by Status</h3>
                        <a class="box-header-action" href="@Url.Action("Index", "DocumentReport")">View Full Report <i class="fa fa-angle-right"></i></a>
                    </div>
                    <div class="box-body">
                        <div id="chartStatus"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" id="rowP4DCharts">
            <div class="col-md-6">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Distributed Document By Department</h3>
                        <a class="box-header-action" href="@Url.Action("Index", "P4DMaintenance")"><i class="fa fa-external-link"></i> More Detail</a>
                    </div>
                    <div class="box-body">
                        <div class="dash-panel-toolbar">
                            <div class="dash-toggle" id="distributionToggle">
                                <button type="button" class="dash-toggle-btn" data-view="division">Division</button>
                                <button type="button" class="dash-toggle-btn active" data-view="department">Department</button>
                            </div>
                        </div>
                        <div id="chartDistribution"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Received Document</h3>
                        <a class="box-header-action" href="@Url.Action("Index", "P4DMaintenance")"><i class="fa fa-external-link"></i> More Detail</a>
                    </div>
                    <div class="box-body">
                        <div class="dash-panel-toolbar">
                            <div class="dash-toggle" id="receivedToggle">
                                <button type="button" class="dash-toggle-btn active" data-view="division">Division</button>
                                <button type="button" class="dash-toggle-btn" data-view="department">Department</button>
                            </div>
                        </div>
                        <div id="chartReceived"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_Javascript")
