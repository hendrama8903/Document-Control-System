<link rel="stylesheet" href="~/css/views/Home/Index.css" asp-append-version="true" />

<section class="content hd" id="hdRoot">
    <!-- Satu baris ringkas: Needs Your Action | Overview (scope jabatan) -->
    <div class="hd-strip">
        <div class="hd-strip-group">
            <div class="hd-strip-head">
                <span><i class="fa fa-bell" style="color:#EA580C;"></i> Needs Your Action</span>
            </div>
            <div class="hd-strip-tiles">
                <a class="hd-tile orange" id="actMyApproval" href="@Url.Action("Index", "DocumentMaintenance")?myApproval=1" title="Documents waiting for your approval">
                    <span class="hd-tile-icon"><i class="fa fa-bell"></i></span>
                    <span><span class="hd-tile-value" id="actMyApprovalValue">0</span><span class="hd-tile-label">My Approval</span></span>
                </a>
                <a class="hd-tile blue" id="actP4D" href="@Url.Action("Index", "P4DMaintenance")?myAction=1" title="P4D to receive, accept or send" style="display:none;">
                    <span class="hd-tile-icon"><i class="fa fa-inbox"></i></span>
                    <span><span class="hd-tile-value" id="actP4DValue">0</span><span class="hd-tile-label">Registration</span></span>
                </a>
                <a class="hd-tile red" id="actRejected" href="@Url.Action("Index", "DocumentMaintenance")" title="My Documents that were rejected and need revision">
                    <span class="hd-tile-icon"><i class="fa fa-undo"></i></span>
                    <span><span class="hd-tile-value" id="actRejectedValue">0</span><span class="hd-tile-label">Rejected</span></span>
                </a>
                <a class="hd-tile green" id="actReview" href="@Url.Action("Index", "DocumentReport")" title="Review due within the next 30 days">
                    <span class="hd-tile-icon"><i class="fa fa-calendar-check-o"></i></span>
                    <span><span class="hd-tile-value" id="actReviewValue">0</span><span class="hd-tile-label">Review Due</span></span>
                </a>
            </div>
        </div>
        <div class="hd-strip-group">
            <div class="hd-strip-head">
                <span><i class="fa fa-pie-chart" style="color:#2450D8;"></i> Overview</span>
                <span class="hd-scope-chip" id="hdOverviewScope"></span>
                <button type="button" class="hd-refresh" id="btn_refreshDashboard" title="Refresh"><i class="fa fa-refresh"></i></button>
            </div>
            <div class="hd-strip-tiles">
                <div class="hd-tile neutral">
                    <span><span class="hd-tile-value" id="kpiTotal">0</span><span class="hd-tile-label">Total</span></span>
                </div>
                <div class="hd-tile neutral">
                    <span><span class="hd-tile-value" id="kpiInProgress" style="color:#C2410C;">0</span><span class="hd-tile-label">In Approval <b id="kpiInProgressPct"></b></span></span>
                </div>
                <div class="hd-tile neutral">
                    <span><span class="hd-tile-value" id="kpiEffective" style="color:#2E7D3B;">0</span><span class="hd-tile-label" title="Approved or Published">Approved <b id="kpiEffectivePct"></b></span></span>
                </div>
                <div class="hd-tile neutral">
                    <span><span class="hd-tile-value" id="kpiRejected" style="color:#C62828;">0</span><span class="hd-tile-label">Rejected <b id="kpiRejectedPct"></b></span></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Lists -->
    <div class="hd-grid hd-grid-3 hd-row hd-row-lists" style="margin-top:16px;">
        <div class="hd-card">
            <div class="hd-card-head">
                <span class="hd-card-title"><i class="fa fa-bell"></i>Waiting for My Approval</span>
                <span class="hd-card-badge" id="myApprovalBadge">0</span>
                <a class="hd-card-link" href="@Url.Action("Index", "DocumentMaintenance")?myApproval=1">View All <i class="fa fa-angle-right"></i></a>
            </div>
            <ul class="hd-list" id="myApprovalList"></ul>
        </div>
        <div class="hd-card">
            <div class="hd-card-head">
                <span class="hd-card-title"><i class="fa fa-paper-plane-o"></i>My Documents in Progress</span>
                <a class="hd-card-link" href="@Url.Action("Index", "DocumentMaintenance")">Document Preparation <i class="fa fa-angle-right"></i></a>
            </div>
            <ul class="hd-list" id="myInProgressList"></ul>
        </div>
        <div class="hd-card" id="breakdownCard" style="display:none;">
            <div class="hd-card-head"><span class="hd-card-title"><i class="fa fa-sitemap"></i><span id="breakdownTitle">By Department</span></span></div>
            <div style="overflow-x:auto;">
                <table class="hd-table">
                    <thead>
                        <tr><th id="breakdownUnit">Department</th><th>Total</th><th>In Approval</th><th>Approved / Published</th><th>Rejected</th></tr>
                    </thead>
                    <tbody id="breakdownBody"></tbody>
                </table>
            </div>
        </div>
        <div class="hd-card" id="reviewCard">
            <div class="hd-card-head">
                <span class="hd-card-title"><i class="fa fa-calendar"></i>Upcoming Review</span>
                <a class="hd-card-link" href="@Url.Action("Index", "DocumentReport")">View All <i class="fa fa-angle-right"></i></a>
            </div>
            <ul class="hd-list" id="reviewList"></ul>
        </div>
    </div>

    <div class="hd-grid hd-grid-3 hd-row hd-row-charts" style="margin-top:16px;">
        <div class="hd-card hd-span-full">
            <div class="hd-card-head"><span class="hd-card-title"><i class="fa fa-bar-chart"></i>New Documents per Month</span></div>
            <div class="hd-trend" id="chartTrend"></div>
        </div>
        <div class="hd-card">
            <div class="hd-card-head"><span class="hd-card-title"><i class="fa fa-pie-chart"></i>By Status</span></div>
            <div id="chartStatus"></div>
        </div>
        <div class="hd-card">
            <div class="hd-card-head">
                <span class="hd-card-title"><i class="fa fa-tags"></i>By Category</span>
                <a class="hd-card-link" href="@Url.Action("Index", "DocumentReport")">Full Report <i class="fa fa-angle-right"></i></a>
            </div>
            <div id="chartCategory"></div>
        </div>
    </div>


    <!-- Document Control (QMS saja) -->
    <div id="qmsSection" style="display:none; margin-top:16px;">
        <div class="hd-strip">
            <div class="hd-strip-group">
                <div class="hd-strip-head">
                    <span><i class="fa fa-folder-open-o" style="color:#2450D8;"></i> Document Control</span>
                    <span class="hd-scope-chip">All registrations (P4D)</span>
                </div>
                <div class="hd-strip-tiles">
                    <div class="hd-tile"><span><span class="hd-tile-value" id="qmsTotal">0</span><span class="hd-tile-label">Total Registrations</span></span></div>
                    <div class="hd-tile"><span><span class="hd-tile-value" id="qmsToReceive" style="color:#2E75B6;">0</span><span class="hd-tile-label">To Receive</span></span></div>
                    <div class="hd-tile"><span><span class="hd-tile-value" id="qmsChecking" style="color:#B36B00;">0</span><span class="hd-tile-label">Checking</span></span></div>
                    <div class="hd-tile"><span><span class="hd-tile-value" id="qmsSent" style="color:#3949AB;">0</span><span class="hd-tile-label">Sent</span></span></div>
                    <div class="hd-tile"><span><span class="hd-tile-value" id="qmsRejected" style="color:#C62828;">0</span><span class="hd-tile-label">Rejected</span></span></div>
                </div>
            </div>
        </div>
        <div class="hd-grid hd-grid-2 hd-row" style="margin-top:16px;">
            <div class="hd-card">
                <div class="hd-card-head">
                    <span class="hd-card-title"><i class="fa fa-share-alt"></i>Distributed Documents</span>
                    <div class="dash-toggle" id="distributionToggle">
                        <button type="button" class="dash-toggle-btn" data-view="division">Division</button>
                        <button type="button" class="dash-toggle-btn active" data-view="department">Department</button>
                    </div>
                </div>
                <div id="chartDistribution"></div>
            </div>
            <div class="hd-card">
                <div class="hd-card-head">
                    <span class="hd-card-title"><i class="fa fa-check-square-o"></i>Accepted Registrations</span>
                    <div class="dash-toggle" id="receivedToggle">
                        <button type="button" class="dash-toggle-btn active" data-view="division">Division</button>
                        <button type="button" class="dash-toggle-btn" data-view="department">Department</button>
                    </div>
                </div>
                <div id="chartReceived"></div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_Javascript")
