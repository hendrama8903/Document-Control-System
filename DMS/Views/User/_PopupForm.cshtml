<link rel="stylesheet" href="~/css/views/User/_PopupForm.css" asp-append-version="true" />

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content adf-modal-content">
            <!-- Modal Header -->
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-user-plus"></i></div>
                <div>
                    <h4 class="adf-header-title" id="modal-title">New User</h4>
                    <p class="adf-header-sub">Create a new user account and assign access role.</p>
                </div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="uf-layout">
                    <!-- Sidebar: Profile Photo -->
                    <div class="uf-sidebar">
                        <h5>Profile Photo</h5>
                        <p>Upload a profile photo for this user.</p>
                        <div class="uf-avatar-wrap">
                            <div class="uf-avatar">
                                <img id="ufAvatarImg" src="" alt="Profile photo preview" onerror="this.onerror=null; $(this).attr('src','').hide(); $('#ufAvatarPlaceholder').show();" />
                                <i class="fa fa-user" id="ufAvatarPlaceholder"></i>
                            </div>
                            <div class="uf-avatar-cam" id="ufAvatarCam" title="Upload photo"><i class="fa fa-camera"></i></div>
                        </div>
                        <button type="button" class="dp-btn dp-btn-outline" id="ufUploadPhotoBtn"><i class="fa fa-upload"></i> Upload Photo</button>
                        <div class="uf-hint">JPG, PNG (Max. 2MB)</div>
                        <button type="button" class="uf-remove-photo" id="btn_delete_attachment">Remove photo</button>

                        <!-- FILE_PATH (profile photo) upload - kept functionally identical to the
                             pre-redesign markup (filestyle-wrapped input inside #inputContainer /
                             #fileNameContainer) so _Javascript.cshtml's existing class/value toggling
                             for the photo keeps working untouched; just visually hidden here since the
                             sidebar's camera icon / "Upload Photo" button trigger it instead. -->
                        <div class="form-group has-feedback" id="inputContainer" style="display:none;">
                            <div id="fileNameContainer">
                                <input type="file" class="filestyle" data-btnClass="btn-primary" id="filePath" accept=".jpg,.jpeg,.png">
                            </div>
                        </div>
                    </div>

                    <!-- Main: form sections -->
                    <div class="uf-main">
                        <div class="uf-section">
                            <div class="uf-section-title"><span class="uf-section-icon"><i class="fa fa-id-badge"></i></span> User Information</div>

                            <div class="uf-row" style="margin-top:14px;">
                                <div class="uf-field">
                                    <label>Username <span class="text-red">*</span></label>
                                    <div class="uf-input-group">
                                        <i class="fa fa-user uf-leading"></i>
                                        <input id="addEditUsername" type="text" placeholder="Enter username" oninput="removeWhiteSpace(this)" maxlength="50" />
                                    </div>
                                </div>
                                <div class="uf-field">
                                    <label>Reg No <span class="text-red">*</span></label>
                                    <div class="uf-input-group">
                                        <i class="fa fa-id-badge uf-leading"></i>
                                        <input id="addEditRegNo" type="text" placeholder="Enter registration number" oninput="removeWhiteSpace(this)" maxlength="50" />
                                    </div>
                                </div>
                            </div>

                            <div class="uf-row">
                                <div class="uf-field">
                                    <label>Full Name <span class="text-red">*</span></label>
                                    <div class="uf-input-group">
                                        <i class="fa fa-user uf-leading"></i>
                                        <input id="addEditFullname" type="text" placeholder="Enter full name" oninput="removeWhiteSpace(this)" maxlength="255" />
                                    </div>
                                </div>
                            </div>

                            <div class="uf-row">
                                <div class="uf-field">
                                    <label>Email <span class="text-red">*</span></label>
                                    <div class="uf-input-group">
                                        <i class="fa fa-envelope-o uf-leading"></i>
                                        <input id="addEditEmail" type="text" placeholder="Enter email address" oninput="removeWhiteSpace(this)" maxlength="255" />
                                    </div>
                                </div>
                                <div class="uf-field">
                                    <label>Phone</label>
                                    <div class="uf-input-group">
                                        <i class="fa fa-phone uf-leading"></i>
                                        <input id="addEditPhone" type="text" placeholder="Enter phone number (optional)" />
                                    </div>
                                </div>
                            </div>

                            <div class="uf-row">
                                <div class="uf-field">
                                    <label>Role <span class="text-red">*</span></label>
                                    <div class="uf-input-group">
                                        <i class="fa fa-shield uf-leading" style="z-index:1;"></i>
                                        <select class="form-control select2" id="addEditRoleId"></select>
                                    </div>
                                </div>
                            </div>

                            <label class="uf-check" for="addEditAdUser">
                                <input type="checkbox" id="addEditAdUser" />
                                Login menggunakan akun Active Directory (domain)
                            </label>
                        </div>

                        <div class="uf-divider"></div>

                        <div class="uf-section">
                            <div class="uf-section-title"><span class="uf-section-icon"><i class="fa fa-lock"></i></span> Password</div>
                            <div class="uf-section-sub">Password is required if not using Active Directory.</div>

                            <div class="uf-row" id="rowOldPassword">
                                <div class="uf-field">
                                    <label>Old Password <span class="text-red">*</span></label>
                                    <div class="uf-input-group">
                                        <i class="fa fa-lock uf-leading"></i>
                                        <input id="addEditOldPassword" type="password" placeholder="Enter old password" />
                                    </div>
                                    <span id="spanOldPassword" class="text-red" style="font-size:11px;">*Keep it blank if you don't change the password</span>
                                </div>
                            </div>

                            <div class="uf-row">
                                <div class="uf-field" id="rowNewPassword">
                                    <label id="labelNewPassword">Password <span class="text-red">*</span></label>
                                    <div class="uf-input-group uf-has-trailing">
                                        <i class="fa fa-lock uf-leading"></i>
                                        <input id="addEditPassword" type="password" placeholder="Enter password" />
                                        <i class="fa fa-eye uf-trailing uf-toggle-pw" data-target="#addEditPassword"></i>
                                    </div>
                                    <span id="spanEditPassword" class="text-red" style="font-size:11px;">*Keep it blank if you don't change the password</span>
                                </div>
                                <div class="uf-field" id="rowConfirmPassword">
                                    <label>Confirm Password <span class="text-red">*</span></label>
                                    <div class="uf-input-group uf-has-trailing">
                                        <i class="fa fa-lock uf-leading"></i>
                                        <input id="addEditConfirmPassword" type="password" placeholder="Confirm password" />
                                        <i class="fa fa-eye uf-trailing uf-toggle-pw" data-target="#addEditConfirmPassword"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="uf-divider"></div>

                        <div class="uf-section">
                            <div class="uf-section-title"><span class="uf-section-icon"><i class="fa fa-pencil"></i></span> Signature</div>
                            <div class="uf-section-sub">Upload user signature (optional). Stored separately from the profile photo, saved once you click Save User.</div>

                            <div class="uf-dropzone" id="ufSignatureDropzone">
                                <div class="uf-dropzone-left">
                                    <img id="ufSignaturePreview" alt="Signature preview" style="display:none; max-height:40px; max-width:90px; object-fit:contain;" />
                                    <i class="fa fa-cloud-upload" id="ufSignatureIcon"></i>
                                    <div>
                                        <div class="uf-dropzone-text"><span class="uf-browse" id="ufBrowseSignature">Click to browse</span> or drag &amp; drop file here</div>
                                        <div class="uf-dropzone-hint">JPG, PNG (Max. 2MB)</div>
                                        <div class="uf-dropzone-filename" id="ufSignatureFileName"></div>
                                    </div>
                                </div>
                                <div style="display:flex; gap:8px;">
                                    <button type="button" class="dp-btn dp-btn-outline" id="ufChooseFileBtn"><i class="fa fa-folder-open-o"></i> Choose File</button>
                                    <button type="button" class="dp-btn dp-btn-outline-danger" id="btn_delete_signature" style="display:none;"><i class="fa fa-trash-o"></i></button>
                                </div>
                                <input type="file" id="ufSignatureFile" accept=".jpg,.jpeg,.png" style="display:none;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn dp-btn dp-btn-outline" id="btn_cancel" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                    <button type="button" class="btn dp-btn dp-btn-primary" id="btn_save"><i class="fa fa-save"></i> Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
