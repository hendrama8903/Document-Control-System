<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="divTitle">
                <div class="content-header">
                    <h1>@ViewData["Title"]</h1>
                </div>
            </div>
        </div>
        <div class="col-xs-12 mt-10">
            <div class="col-md-4">
                <!-- Profile Image -->
                <div class="box" style="padding-top:10px; padding-bottom:10px">
                    <div class="box-body box-profile">
                        <img class="profile-user-img img-responsive img-circle" src="~/dist/img/user.png" alt="User profile picture">
                        <h3 class="profile-username text-center text-bold" style="margin-top:15px;margin-bottom:5px;" id="txtFullName"></h3>
                        <p class="text-muted text-center" style="margin-bottom:20px;" id="txtUserName"></p>
                        <a href="~/Auth/Logout" class="btn btn-danger btn-block"><b>Logout</b></a>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <div class="col-md-8">
                <div class="box">
                    <div class="box-body">
                        <div class="row">
                            <div class="col-lg-12" style="margin-top:10px;">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Username</label>
                                        <input class="form-control" id="addEditUsername" type="text" readonly />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <input class="form-control" id="txtUrl" type="hidden" value="@ViewData["Url"]" />
                                    <input class="form-control" id="addEditRoleIdProfile" type="hidden" value="@ViewData["Username"]" />
                                    <div class="form-group">
                                        <label>Role</label>
                                        <input class="form-control" id="addEditRoleName" type="text" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Reg No</label>
                                        <input class="form-control" id="addEditRegNo" type="text" maxlength="50" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Full Name</label>
                                        <input class="form-control" id="addEditFullname" type="text" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Phone</label>
                                        <input class="form-control" id="addEditPhone" type="number" pattern="/^-?\d+\.?\d*$/" onKeyPress="if(this.value.length==13) return false;" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Email</label>
                                        <input class="form-control" id="addEditEmail" type="email" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Old Password</label>
                                        <input class="form-control" id="addEditOldPassword" type="password" maxlength="255" />
                                        <span class="text-red">*Keep it blank if you don't change the password</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>New Password</label>
                                        <input class="form-control" id="addEditPassword" type="password" maxlength="255" />
                                        <span class="text-red">*Keep it blank if you don't change the password</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Signature</label>
                                        <div>
                                            <img id="imgSignature" src="" alt="Signature" style="max-height:60px; max-width:100%; border:1px solid #ddd; padding:4px; background:#fff; display:none;" />
                                            <p class="text-muted" id="noSignatureText" style="margin:0; display:none;">No signature uploaded</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Confirm Password</label>
                                        <input class="form-control" id="addEditConfirmPassword" type="password" maxlength="255" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 text-right" style="margin-top: 15px; margin-bottom:10px">
                                <button type="button" class="btn btn-primary" id="btn_save" style="width: 80px;">Save</button>
                                <button type="button" class="btn btn-danger" id="btn_cancel_profile" data-dismiss="modal" style="width: 80px; margin-right: 15px">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_Javascript")