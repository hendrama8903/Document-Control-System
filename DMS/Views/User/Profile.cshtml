<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="up-header">
                <div class="up-header-icon"><i class="fa fa-user"></i></div>
                <div>
                    <h1>@ViewData["Title"]</h1>
                    <p>Manage your personal information, account settings, and preferences.</p>
                </div>
            </div>

            <div class="up-layout">
                <!-- Sidebar -->
                <div class="up-sidebar-card">
                    <div class="up-avatar-wrap">
                        <img class="up-avatar" id="imgAvatar" src="~/dist/img/user.png" alt="Profile photo" onerror="this.onerror=null;this.src='@Url.Content("~/dist/img/user.png")';">
                        <button type="button" class="up-avatar-upload" id="btn_changeAvatar" title="Change photo"><i class="fa fa-camera"></i></button>
                        <input type="file" id="avatarFileInput" accept=".jpg,.jpeg,.png" style="display:none;">
                    </div>
                    <h3 id="txtFullName">-</h3>
                    <p class="up-role" id="txtRoleName">-</p>

                    <ul class="up-info-list">
                        <li>
                            <i class="fa fa-user-o"></i>
                            <div><span>Username</span><b id="txtUsername">-</b></div>
                        </li>
                        <li>
                            <i class="fa fa-id-card-o"></i>
                            <div><span>Reg No.</span><b id="txtRegNo">-</b></div>
                        </li>
                        <li>
                            <i class="fa fa-envelope-o"></i>
                            <div><span>Email</span><b id="txtEmailSidebar">-</b></div>
                        </li>
                        <li>
                            <i class="fa fa-phone"></i>
                            <div><span>Phone</span><b id="txtPhoneSidebar">-</b></div>
                        </li>
                        <li>
                            <i class="fa fa-calendar-o"></i>
                            <div><span>Member Since</span><b id="txtMemberSince">-</b></div>
                        </li>
                    </ul>

                    <div class="up-sidebar-actions">
                        <button type="button" class="up-btn-cancel" id="btn_cancel_profile_sidebar"><i class="fa fa-times"></i> Cancel</button>
                        <button type="button" class="up-btn-primary" id="btn_save_sidebar"><i class="fa fa-save"></i> Save</button>
                    </div>
                </div>

                <!-- Content -->
                <div class="up-content-card">
                    <div class="up-section">
                        <div class="up-section-header">
                            <div class="up-section-title"><i class="fa fa-id-badge"></i> Personal Information</div>
                            <span class="up-section-sub">Update your personal details below.</span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label>Username</label>
                                <input class="form-control" id="addEditUsername" type="text" readonly>
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Role</label>
                                <input class="form-control" id="addEditRoleName" type="text" readonly>
                                <input type="hidden" id="addEditRoleId">
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Reg No.</label>
                                <input class="form-control" id="addEditRegNo" type="text" maxlength="50">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label>Full Name</label>
                                <input class="form-control" id="addEditFullname" type="text" maxlength="255">
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Phone</label>
                                <input class="form-control" id="addEditPhone" type="text" maxlength="15" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Email</label>
                                <input class="form-control" id="addEditEmail" type="email" maxlength="255">
                            </div>
                        </div>
                    </div>

                    <div class="up-section">
                        <div class="up-section-header">
                            <div class="up-section-title"><i class="fa fa-lock"></i> Change Password</div>
                            <span class="up-section-sub">Leave these blank if you don't want to change your password.</span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label>Current Password</label>
                                <input class="form-control" id="addEditOldPassword" type="password" maxlength="255" autocomplete="new-password">
                            </div>
                            <div class="col-md-4 form-group">
                                <label>New Password</label>
                                <input class="form-control" id="addEditPassword" type="password" maxlength="255" autocomplete="new-password">
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Confirm New Password</label>
                                <input class="form-control" id="addEditConfirmPassword" type="password" maxlength="255" autocomplete="new-password">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 form-group">
                                <label>Signature</label>
                                <div class="up-signature-compact">
                                    <div class="up-signature-preview-sm">
                                        <img id="imgSignature" src="" alt="Signature" style="display:none;">
                                        <span id="noSignatureText">No signature</span>
                                    </div>
                                    <div>
                                        <button type="button" class="up-btn-outline up-btn-sm" id="btn_changeSignature"><i class="fa fa-upload"></i> Change</button>
                                        <input type="file" id="signatureFileInput" accept=".jpg,.jpeg,.png" style="display:none;">
                                        <div class="up-hint">JPG, PNG (Max. 2MB)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_ProfileJavascript")
