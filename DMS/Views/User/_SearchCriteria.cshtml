<div class="box-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; padding:0 0 14px 0;">
    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
        @if ((bool)ViewData["Add"])
        {
            <button type="button" class="btn btn-success btn-sm" id="btn_add" style="min-width: 84px;"><i class="fa fa-plus"></i> Add</button>
        }
        @if ((bool)ViewData["Edit"])
        {
            <button type="button" class="btn btn-warning btn-sm" id="btn_edit" style="min-width: 84px;"><i class="fa fa-pencil-square-o"></i> Edit</button>
        }
        @if ((bool)ViewData["Delete"])
        {
            <button type="button" class="btn btn-danger btn-sm" id="btn_delete" style="min-width: 84px;"><i class="fa fa-trash-o"></i> Delete</button>
        }
        @if ((bool)ViewData["Position"])
        {
            <button type="button" class="btn btn-primary btn-sm" id="btn_position" style="min-width: 84px;"><i class="fa fa-plus"></i> Position</button>
        }
        @if ((bool)ViewData["Restore"])
        {
            <button type="button" class="btn btn-restore btn-sm" id="btn_restore" style="min-width: 84px; display:none;"><i class="fa fa-undo"></i> Restore</button>
        }
        <label class="adm-toggle">
            <input type="checkbox" id="chk_showDeleted" />
            <span class="adm-toggle-track"><span class="adm-toggle-thumb"></span></span>
            <span class="adm-toggle-label">Show Deleted Users</span>
        </label>
    </div>
    <div>
        <button type="button" class="btn btn-primary btn-sm" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
    </div>
</div>
