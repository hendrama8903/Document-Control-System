<style>
    /* site.css forces .fa-chevron-up/-down to white globally (for a dark-background
       use elsewhere) - override back to the normal dp-icon-btn color for this button. */
    #btn_toggleStats i {
        color: #344054;
    }
</style>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="divTitle">
                <div class="dp-header">
                    <div class="dp-header-left">
                        <div class="dp-header-icon"><i class="fa fa-users"></i></div>
                        <div>
                            <h1>@ViewData["Title"]</h1>
                            <p>Manage user accounts and application access.</p>
                        </div>
                    </div>
                    <div class="dp-header-actions">
                        @if ((bool)ViewData["Add"])
                        {
                            <button type="button" class="dp-btn dp-btn-primary" id="btn_add"><i class="fa fa-plus"></i> Add User</button>
                        }
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_export"><i class="fa fa-download"></i> Export</button>
                        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-cog"></i></button>
                        <button type="button" class="dp-icon-btn" id="btn_toggleStats" title="Hide Summary Cards"><i class="fa fa-chevron-up"></i></button>
                    </div>
                    <div class="dp-header-stats dp-header-stats-grid" id="userStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-users"></i></div>
                            <div>
                                <span>Total Users</span>
                                <b id="userStatTotal">-</b>
                                <small>All users in system</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Active Users</span>
                                <b id="userStatActive">-</b>
                                <small id="userStatActivePct">-</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-user-times"></i></div>
                            <div>
                                <span>Inactive Users</span>
                                <b id="userStatInactive">-</b>
                                <small>Not active</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dp-card">
                <div id="divSearch">
                    @Html.Partial("_SearchCriteria")
                </div>
                <div id="divGrid">
                    @Html.Partial("_GridView")
                </div>
                <div class="dp-info-bar">
                    <i class="fa fa-info-circle"></i>
                    Inactive users cannot log in. You can restore them from the action menu.
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_PopupForm")
@Html.Partial("_PopupFormPosition")
@Html.Partial("_Javascript")
