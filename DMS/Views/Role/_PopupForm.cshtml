<link rel="stylesheet" href="~/css/views/Role/_PopupForm.css" asp-append-version="true" />

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content adf-modal-content">
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-shield"></i></div>
                <div class="adf-header-title" id="modal-title">New Role</div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label">Role ID <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditRoleId" type="text" maxlength="50" />
                </div>
                <div class="form-group">
                    <label class="control-label">Role Name <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditRoleName" type="text" maxlength="255" />
                </div>
                <div class="form-group">
                    <label class="control-label">Description</label>
                    <textarea class="form-control" rows="4" id="addEditRoleDesc" maxlength="255"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn dp-btn dp-btn-outline" id="btn_cancel" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn dp-btn dp-btn-primary" id="btn_save"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalViewRole" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content adf-modal-content">
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-shield"></i></div>
                <div class="adf-header-title">View Role</div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <div class="ra-view-row"><span>Role ID</span><b id="viewRoleId">-</b></div>
                <div class="ra-view-row"><span>Role Name</span><b id="viewRoleName">-</b></div>
                <div class="ra-view-row"><span>Description</span><b id="viewRoleDesc">-</b></div>
                <div class="ra-view-row"><span>Users</span><b id="viewRoleUsers">-</b></div>
                <div class="ra-view-row"><span>Permissions</span><b id="viewRolePermissions">-</b></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn dp-btn dp-btn-outline" data-dismiss="modal"><i class="fa fa-times"></i> Close</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/views/Role/_PopupForm-2.css" asp-append-version="true" />

<div class="modal fade" id="modalAuth" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content adf-modal-content">
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-shield"></i></div>
                <div>
                    <div class="adf-header-title" id="modal-title-auth">Authorization</div>
                    <div class="adf-header-sub">Manage menus and permissions for this role.</div>
                </div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <div class="ra-auth-toolbar">
                    <div class="ra-auth-stats">
                        <div class="ra-auth-stat blue"><i class="fa fa-th-large"></i><div><b id="authStatMenus">0</b><span>Total Menus</span></div></div>
                        <div class="ra-auth-stat green"><i class="fa fa-shield"></i><div><b id="authStatPermissions">0</b><span>Total Permissions</span></div></div>
                        <div class="ra-auth-stat purple"><i class="fa fa-check-square-o"></i><div><b id="authStatEnabled">0</b><span>Permissions Enabled</span></div></div>
                        <div class="ra-auth-stat orange"><i class="fa fa-ban"></i><div><b id="authStatDisabled">0</b><span>Permissions Disabled</span></div></div>
                    </div>
                    <div class="dp-search ra-auth-permsearch">
                        <i class="fa fa-search"></i>
                        <input type="text" id="authSearchPermission" placeholder="Search permission...">
                    </div>
                </div>

                <div class="ra-auth-columns">
                    <div class="ra-auth-col">
                        <div class="ra-auth-col-title">1. Menu</div>
                        <div class="dp-search ra-auth-colsearch"><i class="fa fa-search"></i><input type="text" id="authSearchMenu" placeholder="Search menu..."></div>
                        <div class="ra-auth-list" id="authMenuList"></div>
                    </div>
                    <div class="ra-auth-col">
                        <div class="ra-auth-col-title">2. Sub Menu</div>
                        <div class="dp-search ra-auth-colsearch"><i class="fa fa-search"></i><input type="text" id="authSearchSubMenu" placeholder="Search sub menu..."></div>
                        <div class="ra-auth-list" id="authSubMenuList"></div>
                    </div>
                    <div class="ra-auth-col">
                        <div class="ra-auth-col-title-row">
                            <div>
                                <div class="ra-auth-col-title" style="padding:0;">3. Permission</div>
                                <span class="ra-auth-col-sub" id="authPermTargetLabel">Set permission for: -</span>
                            </div>
                            <label class="ra-auth-checkall"><input type="checkbox" id="authCheckAllPermission"> Check All</label>
                        </div>
                        <div class="ra-auth-permgrid" id="authPermissionGrid"></div>
                    </div>
                </div>

                <div class="ra-auth-legend">
                    <span><i class="ra-auth-dot" style="background:#1E9E63"></i> Read/View</span>
                    <span><i class="ra-auth-dot" style="background:#2450D8"></i> Create/Add</span>
                    <span><i class="ra-auth-dot" style="background:#B36B00"></i> Edit/Update</span>
                    <span><i class="ra-auth-dot" style="background:#C62828"></i> Delete</span>
                    <span><i class="ra-auth-dot" style="background:#6C3FB5"></i> Approval</span>
                    <span><i class="ra-auth-dot" style="background:#0E8074"></i> Process</span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn dp-btn dp-btn-outline" id="btn_auth_clearall"><i class="fa fa-undo"></i> Clear All</button>
                <div class="ra-auth-footer-right">
                    <button type="button" class="btn dp-btn dp-btn-outline" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                    <button type="button" class="btn dp-btn dp-btn-primary" id="btn_save_auth"><i class="fa fa-save"></i> Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
