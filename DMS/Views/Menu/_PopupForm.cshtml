<style>
    .adf-modal-content {
        border: none;
        border-radius: 14px;
        overflow: hidden;
    }

    .adf-header {
        background: linear-gradient(135deg, #2450D8, #1C3FA6);
        color: #fff;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .adf-header-icon {
        flex: none;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .adf-header-title { font-size: 15.5px; font-weight: 700; }

    .adf-close {
        margin-left: auto;
        background: transparent;
        border: none;
        color: rgba(255,255,255,.9);
        font-size: 18px;
        line-height: 1;
        padding: 6px;
        cursor: pointer;
    }

    .adf-close:hover { color: #fff; }

    .adf-modal-content .modal-body { background: #fff; padding: 20px 24px; }

    .adf-modal-content .form-group { margin-bottom: 14px; }

    .adf-modal-content .form-group > .control-label {
        display: block;
        margin-bottom: 4px;
        font-size: 12.5px;
    }

    .adf-modal-content .modal-footer {
        background: #fff;
        border-top: 1px solid #E3E8EE;
        padding: 14px 22px;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
    }

    .adf-modal-content .modal-footer::before,
    .adf-modal-content .modal-footer::after {
        content: none;
    }

    .btn-adf-cancel {
        background: #fff;
        border: 1px solid #D0D5DD;
        color: #344054;
    }

    .btn-adf-cancel:hover { background: #F9FAFB; color: #344054; }

    #modalAddEdit .modal-dialog { width: 520px; max-width: 94vw; }
    #modalFunction .modal-dialog { width: 520px; max-width: 94vw; }

    #modalAddEdit .radio-inline-group { display: flex; gap: 18px; align-items: center; padding-top: 6px; }
    #modalAddEdit .radio-inline-group label { font-weight: 400; margin: 0; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
</style>

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content adf-modal-content">
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-sitemap"></i></div>
                <div class="adf-header-title" id="modal-title">Add / Edit Menu</div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label">Menu ID <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditMenuID" type="text" />
                </div>
                <div class="form-group">
                    <label class="control-label">Sequence <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditMenuSeq" type="text" style="width:120px;" />
                </div>
                <div class="form-group" id="radioMenuType">
                    <label class="control-label">Menu Type <span class="text-red">*</span></label>
                    <div class="radio-inline-group">
                        <label><input type="radio" name="addEditMenuName" id="chkMenuParent" value="Parent" checked> Parent Menu</label>
                        <label><input type="radio" name="addEditMenuName" id="chkMenuChild" value="Child"> Sub Menu</label>
                    </div>
                </div>
                <div class="form-group">
                    <select name="parent_id" id="addEditParentID" class="form-control" disabled></select>
                </div>
                <div class="form-group">
                    <label class="control-label">Menu Name <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditMenuName" type="text" />
                </div>
                <div class="form-group">
                    <label class="control-label">Menu Icon <span class="text-red">*</span></label>
                    <input class="form-control icon-picker" id="addEditMenuIcon" type="text" autocomplete="off" />
                </div>
                <div class="form-group">
                    <label class="control-label">Menu URL <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditMenuURL" type="text" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-adf-cancel" id="btn_cancel" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn btn-primary" id="btn_save"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFunction" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content adf-modal-content">
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-cube"></i></div>
                <div class="adf-header-title" id="modal-title-function">Add / Edit Function</div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="functionMenuId" />
                <div class="form-group">
                    <label class="control-label">Function ID <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditFunctionId" type="text" />
                </div>
                <div class="form-group">
                    <label class="control-label">Function Name <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditFunctionName" type="text" />
                </div>
                <div class="form-group">
                    <label class="control-label">Description</label>
                    <textarea class="form-control" rows="4" id="addEditFunctionDesc"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-adf-cancel" id="btn_cancel_function" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn btn-primary" id="btn_save_function"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>
