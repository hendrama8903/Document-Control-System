<link rel="stylesheet" href="~/css/views/Menu/_PopupForm.css" asp-append-version="true" />

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content adf-modal-content">
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-sitemap"></i></div>
                <div>
                    <div class="adf-header-title" id="modal-title">New Menu</div>
                    <div class="adf-header-sub">Create a new menu for the application navigation</div>
                </div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <div class="adf-row-2col">
                    <div class="form-group">
                        <label class="control-label">Menu ID <i class="fa fa-info-circle adf-label-hint" title="Menu ID is generated automatically"></i></label>
                        <input class="form-control" id="addEditMenuID" type="text" readonly />
                        <div class="adf-help">Menu ID is generated automatically</div>
                    </div>
                </div>

                <div class="adf-row-2col">
                    <div class="form-group">
                        <label class="control-label">Sequence <span class="text-red">*</span></label>
                        <div class="adf-input-icon"><i class="fa fa-hashtag adf-input-icon-glyph"></i><input class="form-control" id="addEditMenuSeq" type="number" min="1" /></div>
                    </div>
                    <div class="form-group" id="radioMenuType">
                        <label class="control-label">Menu Type <span class="text-red">*</span></label>
                        <div class="radio-inline-group">
                            <label class="adf-radio-card"><input type="radio" name="addEditMenuType" id="chkMenuParent" value="Parent" checked><i class="fa fa-clone"></i> Parent Menu</label>
                            <label class="adf-radio-card"><input type="radio" name="addEditMenuType" id="chkMenuChild" value="Child"><i class="fa fa-level-up fa-rotate-90"></i> Sub Menu</label>
                        </div>
                    </div>
                </div>

                <div class="form-group" id="parentMenuRow" style="display:none;">
                    <label class="control-label">Parent Menu <span class="text-red">*</span></label>
                    <select name="parent_id" id="addEditParentID" class="form-control" disabled></select>
                </div>

                <div class="form-group">
                    <label class="control-label">Menu Name <span class="text-red">*</span></label>
                    <div class="adf-input-icon"><i class="fa fa-file-text-o adf-input-icon-glyph"></i><input class="form-control" id="addEditMenuName" type="text" /></div>
                    <div class="adf-help">This name will be displayed in the menu</div>
                </div>

                <div class="form-group">
                    <label class="control-label">Menu Icon <span class="text-red">*</span></label>
                    <div class="adf-icon-picker-wrap">
                        <input class="form-control icon-picker" id="addEditMenuIcon" type="text" autocomplete="off" />
                    </div>
                    <div class="adf-icon-preview">
                        Preview: <span class="adf-icon-preview-swatch"><i id="menuIconPreviewGlyph" class="fa fa-folder"></i></span> <b id="menuNamePreviewText">Menu Name</b>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label">Menu URL <span class="text-red">*</span></label>
                    <div class="adf-input-icon"><i class="fa fa-link adf-input-icon-glyph"></i><input class="form-control" id="addEditMenuURL" type="text" placeholder="/Document/Index" /></div>
                    <div class="adf-help">Example: /Document/Index</div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn dp-btn dp-btn-outline" id="btn_cancel" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn dp-btn dp-btn-primary" id="btn_save"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFunction" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content adf-modal-content">
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-cube"></i></div>
                <div class="adf-header-title" id="modal-title-function">New Function</div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="functionMenuId" />
                <div class="form-group">
                    <label class="control-label">Function ID <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditFunctionId" type="text" />
                </div>
                <div class="form-group">
                    <label class="control-label">Function Name <span class="text-red">*</span></label>
                    <input class="form-control" id="addEditFunctionName" type="text" />
                </div>
                <div class="form-group">
                    <label class="control-label">Description</label>
                    <textarea class="form-control" rows="4" id="addEditFunctionDesc"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn dp-btn dp-btn-outline" id="btn_cancel_function" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn dp-btn dp-btn-primary" id="btn_save_function"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>
