<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modal-title">Add / Edit @ViewData["Title"]</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 form-horizontal" style="margin-top:15px; margin-left:15px">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Position Name <span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <input class="form-control" id="addEditPositionNm" type="text" maxlength="255" />
                                        <input class="form-control" id="addEditId" type="hidden" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Position Level <span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <input class="form-control" id="addEditPositionLvl" type="number" min="1" step="1" />
                                        <span class="help-block" style="margin-bottom:0;">Used for approval order. Multiple position names can share the same level.</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-primary" id="btn_save" style="width: 80px;">Save</button>
                    <button type="button" class="btn btn-danger" id="btn_cancel" data-dismiss="modal" style="width: 80px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
