<link rel="stylesheet" href="~/css/views/shared/master-stats-panel.css" asp-append-version="true" />
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-layout-row stats-collapsed" id="dpLayoutRow">
                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                <aside class="dp-stats-panel" id="dpStatsPanel">
                    <div class="dp-stats-panel-head">
                        <span>Position Summary</span>
                        <button type="button" class="dp-stats-panel-close" id="btn_closeStatsPanel"><i class="fa fa-times"></i></button>
                    </div>
                    <div class="dp-stats-panel-body" id="pmStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-address-card-o"></i></div>
                            <div>
                                <span>Total Position</span>
                                <b id="pmStatTotal">-</b>
                                <small>All positions</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Active Position</span>
                                <b id="pmStatActive">-</b>
                                <small>Currently active</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-ban"></i></div>
                            <div>
                                <span>Inactive Position</span>
                                <b id="pmStatInactive">-</b>
                                <small>Not active</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-calendar"></i></div>
                            <div>
                                <span>Last Updated</span>
                                <b id="pmStatLastUpdated">-</b>
                                <small>&nbsp;</small>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>
@Html.Partial("_PopupForm")
@Html.Partial("_Javascript")
