<link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
<script src="~/js/devextreme/dx.web.js"></script>

<style>
    /* pastikan editor filter row terlihat jelas (hindari bentrok styling tema) */
    #datagrid .dx-datagrid-filter-row .dx-texteditor {
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fff;
    }

    #datagrid .dx-datagrid-filter-row .dx-texteditor-input {
        padding: 5px 8px;
        min-height: 28px;
    }

    /* tampilkan judul kolom penuh (wrap), jangan terpotong "..." */
    #datagrid .dx-datagrid-headers .dx-header-row td .dx-datagrid-text-content {
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.3;
    }

    .pm-status-cell { display: flex; align-items: center; gap: 6px; }
    .pm-status-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: #1E9E63; }
    .pm-status-dot.inactive { background: #C62828; }
</style>

<div class="box-body">
    <div id="datagrid"></div>
</div>

<script type="text/javascript">
    var gCanEdit = @(((bool)ViewData["Edit"]) ? "true" : "false");
    var gCanDelete = @(((bool)ViewData["Delete"]) ? "true" : "false");

    function getSelectedRowData() {
        var rows = $("#datagrid").dxDataGrid("instance").getSelectedRowsData();
        return rows.length > 0 ? rows[0] : null;
    }

    function getSelectedRowsData() {
        return $("#datagrid").dxDataGrid("instance").getSelectedRowsData();
    }

    function updateActionButtons() {
        var count = getSelectedRowsData().length;

        $("#btn_edit").prop("disabled", count != 1);
        $("#btn_delete").prop("disabled", count < 1);
    }

    function computeGridHeight() {
        var gridTop = $("#datagrid").offset().top;
        var footerHeight = $("#divFooter").outerHeight(true) || 0;

        return Math.max(300, $(window).height() - gridTop - footerHeight - 40);
    }

    function pmRenderStats(data) {
        var total = data.length;
        var inactive = data.filter(function (r) { return r.DELETE_FLAG == 1; }).length;
        var active = total - inactive;

        var lastUpdated = null;
        data.forEach(function (r) {
            var dt = r.CHANGED_DT || r.CREATED_DT;
            if (dt != null && (lastUpdated == null || moment(dt).isAfter(lastUpdated))) {
                lastUpdated = dt;
            }
        });

        $("#pmStatTotal").text(total);
        $("#pmStatActive").text(active);
        $("#pmStatInactive").text(inactive);
        $("#pmStatLastUpdated").html(lastUpdated != null
            ? moment(lastUpdated).format("DD MMM YYYY") + "<br><span style='font-size:11px;font-weight:600;color:#66788A;'>" + moment(lastUpdated).format("HH:mm") + "</span>"
            : "-");
    }

    $(document).ready(function () {
        $("#btn_add").prop("disabled", false);
        $("#btn_edit").prop("disabled", true);
        $("#btn_delete").prop("disabled", true);

        var gridStore = new DevExpress.data.CustomStore({
            key: "POSITION_ID",
            loadMode: "raw",
            load: function () {
                var d = $.Deferred();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Search", "PositionMaster")",
                    data: {
                        draw: 1,
                        start: 0,
                        length: 100000,
                        initialMode: false,
                        showAll: true
                    }
                }).done(function (result) {
                    var data = result.data == "" ? [] : result.data;
                    pmRenderStats(data);
                    d.resolve(data);
                }).fail(function () {
                    d.reject("Data loading error");
                });

                return d.promise();
            }
        });

        $("#datagrid").dxDataGrid({
            dataSource: gridStore,
            showBorders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            wordWrapEnabled: false,
            sorting: { mode: "none" },
            noDataText: "Data not found.",
            height: computeGridHeight(),
            filterRow: { visible: false, applyFilter: "auto" },
            headerFilter: { visible: true },
            searchPanel: { visible: false, highlightCaseSensitive: false },
            toolbar: { visible: false },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always",
                allowSelectAll: false
            },
            paging: { pageSize: 10 },
            pager: {
                visible: true,
                displayMode: "compact",
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true,
                showNavigationButtons: true
            },
            columnChooser: {
                enabled: true,
                mode: "select"
            },
            columnFixing: { enabled: true },
            onSelectionChanged: function () {
                updateActionButtons();
            },
            columns: [
                { type: "selection", width: 40, fixed: true, fixedPosition: "left" },
                {
                    caption: "No",
                    width: 50,
                    alignment: "center",
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex();
                        var pageSize = options.component.pageSize();
                        container.text(pageIndex * pageSize + options.row.rowIndex + 1);
                    }
                },
                { dataField: "POSITION_NAME", caption: "Position Name", fixed: true, fixedPosition: "left" },
                { dataField: "POSITION_LEVEL", caption: "Position Level", alignment: "center", width: 120 },
                {
                    dataField: "DELETE_FLAG",
                    caption: "Status",
                    alignment: "center",
                    width: 130,
                    calculateCellValue: function (row) {
                        return row.DELETE_FLAG == 1 ? "Inactive" : "Active";
                    },
                    lookup: {
                        dataSource: [{ v: "Active" }, { v: "Inactive" }],
                        valueExpr: "v",
                        displayExpr: "v"
                    },
                    cellTemplate: function (container, options) {
                        var inactive = options.data.DELETE_FLAG == 1;
                        var $cell = $("<div>").addClass("pm-status-cell");
                        $("<span>").addClass("pm-status-dot").toggleClass("inactive", inactive).appendTo($cell);
                        $("<span>").text(inactive ? "Inactive" : "Active").appendTo($cell);
                        $cell.appendTo(container);
                    }
                },
                { dataField: "CREATED_BY", caption: "Created By", visible: false },
                {
                    dataField: "CREATED_DT",
                    caption: "Created Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CREATED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY") : "");
                    }
                },
                { dataField: "CHANGED_BY", caption: "Changed By", visible: false },
                {
                    dataField: "CHANGED_DT",
                    caption: "Changed Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CHANGED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY") : "");
                    }
                },
                {
                    caption: "Action",
                    alignment: "center",
                    width: 70,
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<button>")
                            .attr({ type: "button", title: "More actions" })
                            .addClass("dp-act-kebab")
                            .html('<i class="fa fa-ellipsis-v"></i>')
                            .on("click", function (e) {
                                e.stopPropagation();
                                openRowActionMenu($(this), row);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });

        $("#btn_columns").on("click", function () {
            $("#datagrid").dxDataGrid("instance").showColumnChooser();
        });

        // ---------- toolbar: show/hide column filter row ("More Filters") ----------
        $("#btn_toggleFilters").on("click", function () {
            var grid = $("#datagrid").dxDataGrid("instance");
            var visible = !grid.option("filterRow.visible");
            grid.option("filterRow.visible", visible);
            $(this).toggleClass("active", visible);
        });

        // ---------- toolbar: reset ----------
        $("#btn_resetFilters").on("click", function () {
            var grid = $("#datagrid").dxDataGrid("instance");
            grid.clearFilter();
            grid.clearSelection();
        });

        // ---------- toolbar: refresh ----------
        $("#btn_refresh").on("click", function () {
            $("#datagrid").dxDataGrid("instance").clearSelection();
            $("#datagrid").dxDataGrid("instance").refresh();
        });

        $(window).on("resize", function () {
            $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
        });

        $('body').tooltip({ selector: '[data-toggle="tooltip"]' });
    });

    // ---------- per-row "more actions" kebab menu ----------
    var $pmRowMenu = null;

    function buildRowActionMenu() {
        if ($pmRowMenu) return $pmRowMenu;

        $pmRowMenu = $('<ul class="dropdown-menu dp-dropdown-menu" role="menu"></ul>')
            .css({ position: "absolute", display: "none", "z-index": 2000, "min-width": "170px" })
            .appendTo("body");

        $(document).on("click", function () {
            $pmRowMenu.hide();
        });

        return $pmRowMenu;
    }

    function menuItem(cssClass, icon, label, onClick) {
        var $li = $('<li><a href="#" class="' + cssClass + '"><i class="fa ' + icon + '"></i> ' + label + '</a></li>');
        $li.find("a").on("click", function (e) {
            e.preventDefault();
            $pmRowMenu.hide();
            onClick();
        });
        return $li;
    }

    function openRowActionMenu($btn, row) {
        var $menu = buildRowActionMenu();
        $menu.empty();
        var grid = $("#datagrid").dxDataGrid("instance");

        if (gCanEdit) {
            $menu.append(menuItem("dp-menu-edit", "fa-pencil-square-o", "Edit", function () {
                grid.selectRows([row.POSITION_ID], false);
                onEditPrepare();
            }));
        }

        if (gCanDelete) {
            $menu.append('<li class="divider"></li>');
            $menu.append(menuItem("dp-menu-delete", "fa-trash-o", "Delete", function () {
                grid.selectRows([row.POSITION_ID], false);
                onDeletePrepare();
            }));
        }

        var offset = $btn.offset();
        $menu.css({ top: offset.top + $btn.outerHeight() + 4, left: offset.left - $menu.outerWidth() + $btn.outerWidth() })
            .show();
    }
</script>
