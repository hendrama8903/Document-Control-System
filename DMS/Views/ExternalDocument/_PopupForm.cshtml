<div class="modal fade" id="modalAddEdit" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modal-title">Add / Edit @ViewData["Title"]</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 form-horizontal" style="margin-top:15px; margin-left:15px">

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Document Name<span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <input class="form-control" id="addEditDocumentName" type="text" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Revision/Edition</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditRevisionEdition" type="text" maxlength="50" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">External Type</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditExternalType" type="text" maxlength="255" placeholder="mis. Hino Drawing, Standard, Regulasi" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Received Date</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditReceivedDate" type="date" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Status</label>
                                    <div class="col-sm-6">
                                        <select class="form-control" id="addEditStatus"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Storage Location</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditStorageLocation" type="text" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Storage PIC</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditStoragePic" type="text" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Review Frequency</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditReviewFrequency" type="text" maxlength="100" placeholder="mis. 1 Tahun" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Review Source</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditReviewSource" type="text" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Last Check Date</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditLastCheckDate" type="date" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Review Cycle (months)</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="addEditReviewCycleMonths" type="number" min="0" value="12" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Pengaruh Terhadap Dokumen Internal</label>
                                    <div class="col-sm-8">
                                        <select class="form-control" id="addEditInternalImpact"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row" id="impactedDocumentContainer" style="display:none;">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Dokumen Internal Terkait</label>
                                    <div class="col-sm-8">
                                        <select class="form-control" id="addEditImpactedDocument"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group has-feedback" id="inputContainer">
                                    <label class="col-sm-3 control-label">Attachment</label>
                                    <div class="col-sm-6" id="fileNameContainer">
                                        <input type="file" class="filestyle" data-btnClass="btn-primary" id="attachmentPath" style="height: 31px;">
                                    </div>
                                    <div class="col-sm-2" style="padding-left: 0px">
                                        <div class="btn-group">
                                            @if ((bool)ViewData["Delete-FilePath"])
                                            {
                                                <button type="button" id="btn_delete_filepath" class="btn btn-danger" data-toggle="tooltip" data-placement="bottom" title="Remove Attachment"><i class="fa fa-trash"></i></button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-primary" id="btn_save" style="width: 80px;">Save</button>
                    <button type="button" class="btn btn-danger" id="btn_cancel" data-dismiss="modal" style="width: 80px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
