<style>
    .approval-stepper {
        display: flex;
        align-items: flex-start;
        overflow-x: auto;
        padding: 10px 4px 4px 4px;
    }

    .stepper-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 110px;
        max-width: 130px;
        text-align: center;
        flex-shrink: 0;
    }

    .stepper-icon {
        width: 34px;
        height: 34px;
        line-height: 34px;
        border-radius: 50%;
        color: #fff;
        font-size: 14px;
    }

    .stepper-done .stepper-icon { background-color: #00a65a; }
    .stepper-current .stepper-icon { background-color: #00c0ef; box-shadow: 0 0 0 4px rgba(0,192,239,0.25); }
    .stepper-rejected .stepper-icon { background-color: #dd4b39; }
    .stepper-upcoming .stepper-icon { background-color: #d2d6de; color: #777; }

    .stepper-label {
        margin-top: 6px;
        font-weight: 600;
        font-size: 12px;
        word-break: break-word;
    }

    .stepper-sub {
        font-size: 11px;
        color: #777;
        word-break: break-word;
    }

    .stepper-date {
        font-size: 11px;
        color: #999;
    }

    .stepper-connector {
        flex: 1 0 24px;
        height: 3px;
        background-color: #d2d6de;
        margin-top: 17px;
        min-width: 24px;
    }

    .stepper-connector-done { background-color: #00a65a; }
    .stepper-connector-rejected { background-color: #dd4b39; }
</style>

<div class="modal fade" id="modalApproval" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modal-title-function">Approval List</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row" style="margin-top: 15px;">
                    <div class="col-lg-12">
                        <div class="col-lg-3">
                            <p><b>Document No :</b></p>
                        </div>
                        <div class="col-lg-3">
                            <p id="approvalDocumentNo"></p>
                        </div>
                        <div class="col-lg-3">
                            <p><b>Document Name :</b></p>
                        </div>
                        <div class="col-lg-3">
                            <p id="approvalDocumentName"></p>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="col-lg-3">
                            <p><b>Department :</b></p>
                        </div>
                        <div class="col-lg-3">
                            <p id="approvalDocumentDepartment"></p>
                        </div>
                        <div class="col-lg-3">
                            <p><b>Classified :</b></p>
                        </div>
                        <div class="col-lg-3">
                            <p id="approvalDocumentClassified"></p>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <hr>
                    </div>
                    <div class="col-lg-12">
                        <div class="col-lg-3">
                            <p><b>Document Creator :</b></p>
                        </div>
                        <div class="col-lg-3">
                            <p id="approvalCreator">HSCODE-001</p>
                        </div>
                        <div class="col-lg-3">
                            <p><b>Approval Status :</b></p>
                        </div>
                        <div class="col-lg-3">
                            <p id="approvalStatus"></p>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top: 15px;">
                    <div class="col-lg-12">
                        <div id="approvalStepper" class="approval-stepper"></div>
                    </div>
                </div>
                <div class="row" style="margin-top: 15px;">
                    <div class="col-lg-12">
                        <table id="approvalgrid" class="table table-bordered table-condensed" width="100%">
                            <thead>
                                <tr>
                                    <th>Approver</th>
                                    <th>Status</th>
                                    <th>Approval Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
                <div class="row" style="margin-top: 15px;">
                    <div class="col-lg-12">
                        <table id="historyGrid" class="table table-bordered table-condensed" width="100%">
                            <thead>
                                <tr>
                                    <th>Approver</th>
                                    <th>Approval Date</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
                <div class="row" style="margin-top: 10px; display: none" id="pengesahanLayout">
                    <div class="col-lg-12">
                        <button id="btn_download_pengesahan" class="btn btn-primary">Download Bukti Pengesahan</button>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-grey" id="btn_close_approvalList" style="width: 80px;" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalApprovalForm" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modal-title-function">Approval</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row" style="margin-top: 15px;">
                    <div class="col-lg-12">
                        <p><b>Remark :</b></p>
                    </div>
                    <div class="col-lg-12">
                        <textarea id="approvalRemark" rows="5" class="form-control"></textarea>
                    </div>
                </div>
                <div class="text-right" style="margin-top: 20px">
                    <button type="button" class="btn btn-primary" id="btn_approve"><i class="fa fa-check"></i> Approve</button>
                    <button type="button" class="btn btn-reject" id="btn_reject"><i class="fa fa-ban"></i> Reject</button>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-grey" id="btn_close_approval" style="width: 80px;" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>