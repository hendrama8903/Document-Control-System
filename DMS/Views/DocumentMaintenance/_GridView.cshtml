            <!-- RECOMMIT DINA -->
<link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
<script src="~/js/devextreme/dx.web.js"></script>

<style>
    /* pastikan editor filter row terlihat jelas (hindari bentrok styling tema) */
    #datagrid .dx-datagrid-filter-row .dx-texteditor {
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fff;
    }

    #datagrid .dx-datagrid-filter-row .dx-texteditor-input {
        padding: 5px 8px;
        min-height: 28px;
    }

    /* tampilkan judul kolom penuh (wrap), jangan terpotong "..." */
    #datagrid .dx-datagrid-headers .dx-header-row td .dx-datagrid-text-content {
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.3;
    }

    /* panel detail dokumen (row expand) */
    .doc-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 14px 24px;
        padding: 16px 24px;
        background: #f9fafb;
        max-height: 210px;
        overflow-y: auto;
    }

    .doc-detail-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #8a8a8a;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .doc-detail-value {
        font-size: 13px;
        color: #333;
        word-break: break-word;
    }
</style>

<div class="box-body">
    <div id="datagrid"></div>
</div>

<!-- TAMBAHKAN MODAL BY HENDRA -->
<div class="modal fade" id="modalPrint" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" style="background:#2E75B6;">
                <h5 class="modal-title text-white" style="color:white !important;">Print Confirmation</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Total Pages</label>
                    <input type="text" id="txtTotalPages" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label>Number of Copies <span class="text-danger">*</span></label>
                    <input type="number" id="txtPrintCopy" class="form-control"
                           min="1" max="99" value="1" />
                </div>
                <div class="form-group">
                    <label>Total Sheets</label>
                    <input type="text" id="txtTotalSheets" class="form-control"
                           readonly style="font-weight:bold; color:#2E75B6;" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" id="btnConfirmPrint">🖨️ Print
                </button>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL BY HENDRA -->

<script type="text/javascript">
    function getSelectedRowData() {
        var rows = $("#datagrid").dxDataGrid("instance").getSelectedRowsData();
        return rows.length > 0 ? rows[0] : null;
    }

    function updateActionButtons() {
        var row = getSelectedRowData();
        var editable = row != null && row.STATUS != 1 && row.STATUS != 5;

        $("#btn_edit").prop("disabled", !editable);
        $("#btn_delete").prop("disabled", !editable);
        $("#btn_approval").prop("disabled", row == null);
        $("#btn_history").prop("disabled", row == null);
    }

    function computeGridHeight() {
        var gridTop = $("#datagrid").offset().top;
        var footerHeight = $("#divFooter").outerHeight(true) || 0;

        return Math.max(300, $(window).height() - gridTop - footerHeight - 40);
    }

    $(document).ready(function () {
        $("#btn_add").prop("disabled", false);
        $("#btn_edit").prop("disabled", true);
        $("#btn_delete").prop("disabled", true);
        $("#btn_approval").prop("disabled", true);
        $("#btn_history").prop("disabled", true);
        $("#btn_download").prop("disabled", false);

        var gridStore = new DevExpress.data.CustomStore({
            key: "DOCUMENT_TRANSACTION_ID",
            loadMode: "raw",
            load: function () {
                var d = $.Deferred();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Search", "DocumentMaintenance")",
                    data: {
                        draw: 1,
                        start: 0,
                        length: 100000,
                        initialMode: false
                    }
                }).done(function (result) {
                    d.resolve(result.data == "" ? [] : result.data);
                }).fail(function () {
                    d.reject("Data loading error");
                });

                return d.promise();
            }
        });

        $("#datagrid").dxDataGrid({
            dataSource: gridStore,
            showBorders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            wordWrapEnabled: false,
            sorting: { mode: "none" },
            noDataText: "Data not found.",
            height: computeGridHeight(),
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            toolbar: { visible: false },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always",
                allowSelectAll: false
            },
            paging: { pageSize: 10 },
            pager: {
                visible: true,
                displayMode: "compact",
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true,
                showNavigationButtons: true
            },
            columnChooser: {
                enabled: true,
                mode: "select"
            },
            columnFixing: { enabled: true },
            masterDetail: {
                enabled: true,
                template: function (container, options) {
                    var row = options.data;

                    function val(v) { return (v === null || v === undefined || v === "") ? "-" : v; }
                    function dateVal(v) { return v ? moment(v).format("DD-MM-YYYY") : "-"; }
                    function dateTimeVal(v) { return v ? moment(v).format("DD-MM-YYYY hh:mm:ss") : "-"; }
                    function documentTypeVal(v) {
                        if (v == "01") return "New";
                        if (v == "02") return "Revision";
                        return val(v);
                    }

                    var fields = [
                        { label: "Document Category", value: val(row.DOCUMENT_NAME) },
                        { label: "Document Type", value: documentTypeVal(row.DOCUMENT_TYPE) },
                        { label: "Document Level", value: val(row.LEVEL_CODE) },
                        { label: "Classified", value: val(row.CLASSIFIED_VAL) },
                        { label: "Process Code", value: val(row.PROCESS_CODE) },
                        { label: "Company Code", value: val(row.COMPANY_CODE) },
                        { label: "Section", value: val(row.SECTION_NAME) },
                        { label: "Item Changed", value: val(row.ITEM_CHANGED) },
                        { label: "Reason", value: val(row.REASON) },
                        { label: "Reference No", value: val(row.REFERENCE_NO) },
                        { label: "Source", value: val(row.SOURCE) },
                        { label: "Document Date", value: dateVal(row.DOCUMENT_DATE) },
                        { label: "First Revision Date", value: dateVal(row.DOCUMENT_REVISION_0_DATE) },
                        { label: "Next Review Date", value: dateVal(row.NEXT_REVIEW_DATE) },
                        { label: "Document Creator", value: val(row.DOCUMENT_CREATOR) },
                        { label: "Created", value: val(row.CREATED_BY) + " - " + dateTimeVal(row.CREATED_DT) },
                        { label: "Last Changed", value: val(row.CHANGED_BY) + " - " + dateTimeVal(row.CHANGED_DT) }
                    ];

                    var wrapper = $("<div>").addClass("doc-detail-grid");

                    fields.forEach(function (f) {
                        var item = $("<div>");
                        $("<div>").addClass("doc-detail-label").text(f.label).appendTo(item);
                        $("<div>").addClass("doc-detail-value").text(f.value).appendTo(item);
                        item.appendTo(wrapper);
                    });

                    wrapper.appendTo(container);
                }
            },
            onSelectionChanged: function (e) {
                if (e.selectedRowKeys.length > 1) {
                    e.component.selectRows(e.currentSelectedRowKeys, false);
                    return;
                }
                updateActionButtons();
            },
            columns: [
                { type: "selection", width: 40, fixed: true, fixedPosition: "left" },
                {
                    caption: "No",
                    width: 50,
                    alignment: "center",
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex();
                        var pageSize = options.component.pageSize();
                        container.text(pageIndex * pageSize + options.row.rowIndex + 1);
                    }
                },
                { dataField: "DOCUMENT_CODE", caption: "Document No", fixed: true, fixedPosition: "left" },
                { dataField: "DOCUMENT_TRANSACTION_NAME", caption: "Document Name" },
                {
                    dataField: "STATUS_DISPLAY",
                    caption: "Status",
                    alignment: "center",
                    cellTemplate: function (container, options) {
                        var row = options.data;
                        var labelClass = "label label-danger";
                        var icon = "fa-times-circle";

                        if (row.STATUS == 0) {
                            labelClass = "label label-info";
                            icon = "fa-clock-o";
                        } else if (row.STATUS == 1) {
                            labelClass = "label label-success";
                            icon = "fa-check-circle";
                        } else if (row.STATUS == 4) {
                            labelClass = "label label-default";
                            icon = "fa-archive";
                        } else if (row.STATUS == 5) {
                            labelClass = "label label-primary";
                            icon = "fa-flag-checkered";
                        }

                        $("<span>").addClass(labelClass).html('<i class="fa ' + icon + '"></i> ' + row.STATUS_DISPLAY).appendTo(container);
                    }
                },
                {
                    dataField: "P4D_STATUS_VAL",
                    caption: "Registration Status",
                    alignment: "center",
                    cellTemplate: function (container, options) {
                        var value = options.data.P4D_STATUS_VAL;

                        if (value == null || value == "") {
                            container.text("-");
                            return;
                        }

                        var labelClass = "label label-danger";
                        var icon = "fa-times-circle";

                        if (value == "DRAFT") {
                            labelClass = "label label-info";
                            icon = "fa-clock-o";
                        } else if (value == "ON PROGRESS" || value == "PARTIALLY SENT") {
                            labelClass = "label label-warning";
                            icon = "fa-hourglass-half";
                        } else if (value == "SENT") {
                            labelClass = "label label-primary";
                            icon = "fa-paper-plane";
                        } else if (value == "RECEIVED") {
                            labelClass = "label label-success";
                            icon = "fa-check-circle";
                        } else if (value == "DELETED") {
                            labelClass = "label label-default";
                            icon = "fa-archive";
                        }

                        $("<span>").addClass(labelClass).html('<i class="fa ' + icon + '"></i> ' + value).appendTo(container);
                    }
                },
                { dataField: "REVISION", caption: "Revision", alignment: "center" },
                {
                    caption: "Division",
                    calculateCellValue: function (row) {
                        return row.DIVISION + " - " + row.DIVISION_NAME;
                    }
                },
                {
                    caption: "Department",
                    calculateCellValue: function (row) {
                        return row.DEPARTMENT_CODE + " - " + row.DEPARTMENT_NAME;
                    }
                },
                {
                    dataField: "DOCUMENT_TYPE",
                    caption: "Document Type",
                    alignment: "center",
                    visible: false,
                    calculateCellValue: function (row) {
                        if (row.DOCUMENT_TYPE == "01") return "New";
                        if (row.DOCUMENT_TYPE == "02") return "Revision";
                        return row.DOCUMENT_TYPE;
                    }
                },
                { dataField: "LEVEL_CODE", caption: "Document Level", alignment: "center", visible: false },
                { dataField: "CLASSIFIED_VAL", caption: "Classified", visible: false },
                { dataField: "ITEM_CHANGED", caption: "Item Changed", visible: false },
                { dataField: "REASON", caption: "Reason", visible: false },
                { dataField: "REFERENCE_NO", caption: "Reference No", visible: false },
                { dataField: "SOURCE", caption: "Source", visible: false },
                { dataField: "CREATED_BY", caption: "Created By", visible: false },
                {
                    dataField: "CREATED_DT",
                    caption: "Created Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CREATED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY hh:mm:ss") : "");
                    }
                },
                { dataField: "CHANGED_BY", caption: "Changed By", visible: false },
                {
                    dataField: "CHANGED_DT",
                    caption: "Changed Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CHANGED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY hh:mm:ss") : "");
                    }
                },
                {
                    caption: "Action",
                    alignment: "center",
                    width: 110,
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        container.css("white-space", "nowrap");

                        $("<button>")
                            .attr({ type: "button", title: "View" })
                            .addClass("btn btn-primary btn-sm adm-act-btn")
                            .html('<i class="fa fa-file-pdf-o"></i>')
                            .on("click", function () {
                                onViewAttachment(row.FILE_PATH, row.DOCUMENT_TRANSACTION_ID);
                            })
                            .appendTo(container);

                        $("<button>")
                            .attr({ type: "button", title: "Print" })
                            .addClass("btn btn-default btn-sm adm-act-btn adm-act-secondary")
                            .css("margin-left", "6px")
                            .html('<i class="fa fa-print"></i>')
                            .on("click", function () {
                                onPrintAttachment(row.FILE_PATH, row.DOCUMENT_TRANSACTION_ID, row.APPROVAL_ID);
                            })
                            .appendTo(container);
                    }
                },
                {
                    caption: "Distribution",
                    alignment: "center",
                    width: 90,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<button>")
                            .attr({ type: "button", name: "btnDistribution" })
                            .addClass("btn btn-primary btn-sm")
                            .html('<i class="fa fa-file-o"></i>')
                            .on("click", function () {
                                onclickDistribution(row.DOCUMENT_TRANSACTION_ID);
                            })
                            .appendTo(container);
                    }
                },
                {
                    caption: "Log",
                    alignment: "center",
                    width: 60,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<button>")
                            .attr({ type: "button" })
                            .addClass("btn btn-primary btn-sm")
                            .html('<i class="fa fa-history"></i>')
                            .on("click", function () {
                                onclickLog(row.DOCUMENT_TRANSACTION_ID);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });

        $("#btn_columns").on("click", function () {
            $("#datagrid").dxDataGrid("instance").showColumnChooser();
        });

        $(window).on("resize", function () {
            $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
        });

        $('body').tooltip({ selector: '[data-toggle="tooltip"]' });
    });
</script>
