            <!-- RECOMMIT DINA -->
<link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
<script src="~/js/devextreme/dx.web.js"></script>

<style>
    /* pastikan editor filter row terlihat jelas (hindari bentrok styling tema) */
    #datagrid .dx-datagrid-filter-row .dx-texteditor {
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fff;
    }

    #datagrid .dx-datagrid-filter-row .dx-texteditor-input {
        padding: 5px 8px;
        min-height: 28px;
    }
</style>

<div class="box-body">
    <div id="datagrid"></div>
</div>

<!-- TAMBAHKAN MODAL BY HENDRA -->
<div class="modal fade" id="modalPrint" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" style="background:#2E75B6;">
                <h5 class="modal-title text-white" style="color:white !important;">Print Confirmation</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Total Pages</label>
                    <input type="text" id="txtTotalPages" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label>Number of Copies <span class="text-danger">*</span></label>
                    <input type="number" id="txtPrintCopy" class="form-control"
                           min="1" max="99" value="1" />
                </div>
                <div class="form-group">
                    <label>Total Sheets</label>
                    <input type="text" id="txtTotalSheets" class="form-control"
                           readonly style="font-weight:bold; color:#2E75B6;" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" id="btnConfirmPrint">🖨️ Print
                </button>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL BY HENDRA -->

<script type="text/javascript">
    function getSelectedRowData() {
        var rows = $("#datagrid").dxDataGrid("instance").getSelectedRowsData();
        return rows.length > 0 ? rows[0] : null;
    }

    function updateActionButtons() {
        var row = getSelectedRowData();
        var editable = row != null && row.STATUS != 1;

        $("#btn_edit").prop("disabled", !editable);
        $("#btn_delete").prop("disabled", !editable);
        $("#btn_approval").prop("disabled", row == null);
        $("#btn_history").prop("disabled", row == null);
    }

    function computeGridHeight() {
        var gridTop = $("#datagrid").offset().top;
        var footerHeight = $("#divFooter").outerHeight(true) || 0;

        return Math.max(300, $(window).height() - gridTop - footerHeight - 40);
    }

    $(document).ready(function () {
        $("#btn_add").prop("disabled", false);
        $("#btn_edit").prop("disabled", true);
        $("#btn_delete").prop("disabled", true);
        $("#btn_approval").prop("disabled", true);
        $("#btn_history").prop("disabled", true);
        $("#btn_download").prop("disabled", false);

        var gridStore = new DevExpress.data.CustomStore({
            key: "DOCUMENT_TRANSACTION_ID",
            loadMode: "raw",
            load: function () {
                var d = $.Deferred();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Search", "DocumentMaintenance")",
                    data: {
                        draw: 1,
                        start: 0,
                        length: 100000,
                        initialMode: false
                    }
                }).done(function (result) {
                    d.resolve(result.data == "" ? [] : result.data);
                }).fail(function () {
                    d.reject("Data loading error");
                });

                return d.promise();
            }
        });

        $("#datagrid").dxDataGrid({
            dataSource: gridStore,
            showBorders: true,
            columnAutoWidth: true,
            wordWrapEnabled: false,
            sorting: { mode: "none" },
            noDataText: "Data not found.",
            height: computeGridHeight(),
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            toolbar: { visible: false },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always",
                allowSelectAll: false
            },
            paging: { pageSize: 10 },
            pager: {
                visible: true,
                displayMode: "compact",
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true,
                showNavigationButtons: true
            },
            columnChooser: {
                enabled: true,
                mode: "select"
            },
            columnFixing: { enabled: true },
            onSelectionChanged: function (e) {
                if (e.selectedRowKeys.length > 1) {
                    e.component.selectRows(e.currentSelectedRowKeys, false);
                    return;
                }
                updateActionButtons();
            },
            columns: [
                { type: "selection", width: 40, fixed: true, fixedPosition: "left" },
                {
                    caption: "No",
                    width: 50,
                    alignment: "center",
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex();
                        var pageSize = options.component.pageSize();
                        container.text(pageIndex * pageSize + options.row.rowIndex + 1);
                    }
                },
                { dataField: "DOCUMENT_CODE", caption: "Document No", fixed: true, fixedPosition: "left" },
                { dataField: "DOCUMENT_TRANSACTION_NAME", caption: "Document Name" },
                {
                    dataField: "STATUS_DISPLAY",
                    caption: "Status",
                    alignment: "center",
                    cellTemplate: function (container, options) {
                        var row = options.data;
                        var labelClass = "label label-danger";

                        if (row.STATUS == 0) {
                            labelClass = "label label-info";
                        } else if (row.STATUS == 1) {
                            labelClass = "label label-success";
                        }

                        $("<span>").addClass(labelClass).text(row.STATUS_DISPLAY).appendTo(container);
                    }
                },
                { dataField: "REVISION", caption: "Revision", alignment: "center" },
                {
                    caption: "Divisi",
                    calculateCellValue: function (row) {
                        return row.DIVISION + " - " + row.DIVISION_NAME;
                    }
                },
                {
                    caption: "Department",
                    calculateCellValue: function (row) {
                        return row.DEPARTMENT_CODE + " - " + row.DEPARTMENT_NAME;
                    }
                },
                { dataField: "CLASSIFIED_VAL", caption: "Classified" },
                { dataField: "ITEM_CHANGED", caption: "Item Changed" },
                { dataField: "REASON", caption: "Reason" },
                { dataField: "REFERENCE_NO", caption: "Reference No" },
                { dataField: "SOURCE", caption: "Source" },
                { dataField: "CREATED_BY", caption: "Created By", visible: false },
                {
                    dataField: "CREATED_DT",
                    caption: "Created Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CREATED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY hh:mm:ss") : "");
                    }
                },
                { dataField: "CHANGED_BY", caption: "Changed By", visible: false },
                {
                    dataField: "CHANGED_DT",
                    caption: "Changed Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CHANGED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY hh:mm:ss") : "");
                    }
                },
                {
                    caption: "Action",
                    alignment: "center",
                    width: 110,
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        container.css("white-space", "nowrap");

                        $("<button>")
                            .attr({ type: "button", title: "View" })
                            .addClass("btn btn-primary btn-sm")
                            .html('<i class="fa fa-eye"></i>')
                            .on("click", function () {
                                onViewAttachment(row.FILE_PATH, row.DOCUMENT_TRANSACTION_ID);
                            })
                            .appendTo(container);

                        $("<button>")
                            .attr({ type: "button", title: "Print" })
                            .addClass("btn btn-primary btn-sm")
                            .css("margin-left", "3px")
                            .html('<i class="fa fa-print"></i>')
                            .on("click", function () {
                                onPrintAttachment(row.FILE_PATH, row.DOCUMENT_TRANSACTION_ID, row.APPROVAL_ID);
                            })
                            .appendTo(container);
                    }
                },
                {
                    caption: "Distribution",
                    alignment: "center",
                    width: 90,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<button>")
                            .attr({ type: "button", name: "btnDistribution" })
                            .addClass("btn btn-primary btn-sm")
                            .html('<i class="fa fa-file-o"></i>')
                            .on("click", function () {
                                onclickDistribution(row.DOCUMENT_TRANSACTION_ID);
                            })
                            .appendTo(container);
                    }
                },
                {
                    caption: "Log",
                    alignment: "center",
                    width: 60,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<button>")
                            .attr({ type: "button" })
                            .addClass("btn btn-primary btn-sm")
                            .html('<i class="fa fa-history"></i>')
                            .on("click", function () {
                                onclickLog(row.DOCUMENT_TRANSACTION_ID);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });

        $("#btn_columns").on("click", function () {
            $("#datagrid").dxDataGrid("instance").showColumnChooser();
        });

        $(window).on("resize", function () {
            $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
        });

        $('body').tooltip({ selector: '[data-toggle="tooltip"]' });
    });
</script>
