<link rel="stylesheet" href="~/css/views/DocumentMaintenance/_ViewDetailPopup.css" asp-append-version="true" />

<div class="modal fade" id="modalViewDetail" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="dd-header">
                <div class="dd-header-left">
                    <div class="dd-header-icon"><i class="fa fa-file-text-o"></i></div>
                    <div>
                        <div class="dd-header-title">Document Detail</div>
                        <div class="dd-header-sub" id="modalViewDetail-subtitle">-</div>
                    </div>
                </div>
                <div class="dd-header-actions">
                    <button type="button" class="dd-act-btn" id="btnDdPreview"><i class="fa fa-eye"></i> Preview</button>
                    <button type="button" class="dd-act-btn" id="btnDdDownload"><i class="fa fa-download"></i> Download</button>
                    <button type="button" class="dd-act-btn" id="btnDdHistory"><i class="fa fa-history"></i> Revision History</button>
                    <button type="button" class="dd-act-btn" id="btnDdPrint"><i class="fa fa-print"></i> Print</button>
                    <span class="dd-header-divider"></span>
                    <button type="button" class="dd-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="dd-hero">
                    <div class="dd-hero-icon"><i class="fa fa-file-text-o"></i></div>
                    <div class="dd-hero-main">
                        <div class="dd-hero-code" id="vdCode">-</div>
                        <div class="dd-hero-name" id="vdCategoryHero">-</div>
                        <div class="dd-hero-badges">
                            <span class="dd-badge" id="vdStatusBadge" style="display:none;"></span>
                            <span class="dd-badge dd-badge-type" id="vdTypeBadge" style="display:none;"></span>
                            <span class="dd-badge dd-badge-level" id="vdLevelBadge" style="display:none;"></span>
                            <span class="dd-badge dd-badge-classified" id="vdClassifiedBadge" style="display:none;"></span>
                        </div>
                    </div>
                    <div class="dd-hero-dates">
                        <div class="dd-date-row"><i class="fa fa-calendar"></i> Document Date <b id="vdDocumentDate">-</b></div>
                        <div class="dd-date-row"><i class="fa fa-pencil"></i> First Revision Date <b id="vdFirstRevisionDate">-</b></div>
                        <div class="dd-date-row"><i class="fa fa-calendar-check-o"></i> Next Review Date <b id="vdNextReviewDate">-</b></div>
                    </div>
                </div>

                <div class="dd-grid-2">
                    <div class="dd-card">
                        <div class="dd-card-title"><span class="dd-card-icon"><i class="fa fa-info-circle"></i></span> Document Information</div>
                        <div class="dd-rows">
                            <div class="dd-row"><span>Document Category</span><b id="vdCategory">-</b></div>
                            <div class="dd-row"><span>Document Type</span><b id="vdType">-</b></div>
                            <div class="dd-row"><span>Document Level</span><b id="vdLevel">-</b></div>
                            <div class="dd-row"><span>Classified</span><b id="vdClassified">-</b></div>
                        </div>
                    </div>

                    <div class="dd-card">
                        <div class="dd-card-title"><span class="dd-card-icon"><i class="fa fa-building"></i></span> Process &amp; Organization</div>
                        <div class="dd-rows">
                            <div class="dd-row"><span>Process Code</span><b id="vdProcessCode">-</b></div>
                            <div class="dd-row"><span>Company Code</span><b id="vdCompanyCode">-</b></div>
                            <div class="dd-row"><span>Section</span><b id="vdSection">-</b></div>
                            <div class="dd-row"><span>Item Changed</span><b id="vdItemChanged">-</b></div>
                        </div>
                    </div>
                </div>

                <div class="dd-card">
                    <div class="dd-card-title"><span class="dd-card-icon"><i class="fa fa-link"></i></span> Reference</div>
                    <div class="dd-ref-grid">
                        <div><span>Reason</span><b id="vdReason">-</b></div>
                        <div><span>Reference No</span><b id="vdReferenceNo">-</b></div>
                        <div><span>Source</span><b id="vdSource">-</b></div>
                    </div>

                    <div class="dd-audit-strip">
                        <div class="dd-audit-item">
                            <span><i class="fa fa-user"></i> Document Creator</span>
                            <b id="vdCreator">-</b>
                        </div>
                        <div class="dd-audit-item">
                            <span><i class="fa fa-plus-circle"></i> Created</span>
                            <b id="vdCreated">-</b>
                        </div>
                        <div class="dd-audit-item">
                            <span><i class="fa fa-pencil"></i> Last Changed</span>
                            <b id="vdChanged">-</b>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn dp-btn dp-btn-outline" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var gDetailRow = null;

    function onViewDetail(row) {
        gDetailRow = row;

        function setVal(id, v) {
            var el = $("#" + id);
            var isEmpty = (v === null || v === undefined || v === "");
            el.text(isEmpty ? "-" : v);
            el.toggleClass("dd-empty", isEmpty);
        }

        function dateVal(v) { return v ? moment(v).format("DD-MM-YYYY") : null; }

        function auditVal(by, dt) {
            var user = (by === null || by === undefined || by === "") ? "-" : by;
            var when = dt ? moment(dt).format("DD-MM-YYYY HH:mm:ss") : "-";
            return "<em>" + user + "</em> &middot; " + when;
        }

        function typeLabel(v) {
            if (v == "01") return "New";
            if (v == "02") return "Revision";
            return (v === null || v === undefined || v === "") ? null : v;
        }

        $("#modalViewDetail-subtitle").text(row.DOCUMENT_CODE ? row.DOCUMENT_CODE : "-");
        $("#vdCode").text(row.DOCUMENT_CODE ? row.DOCUMENT_CODE : "-");
        $("#vdCategoryHero").text(row.DOCUMENT_NAME ? row.DOCUMENT_NAME : "-");

        setVal("vdCategory", row.DOCUMENT_NAME);
        setVal("vdLevel", row.LEVEL_CODE);
        setVal("vdClassified", row.CLASSIFIED_VAL);
        setVal("vdProcessCode", row.PROCESS_CODE);
        setVal("vdCompanyCode", row.COMPANY_CODE);
        setVal("vdSection", row.SECTION_NAME);
        setVal("vdItemChanged", row.ITEM_CHANGED);
        setVal("vdReason", row.REASON);
        setVal("vdReferenceNo", row.REFERENCE_NO);
        setVal("vdSource", row.SOURCE);
        setVal("vdDocumentDate", dateVal(row.DOCUMENT_DATE));
        setVal("vdFirstRevisionDate", dateVal(row.DOCUMENT_REVISION_0_DATE));
        setVal("vdNextReviewDate", dateVal(row.NEXT_REVIEW_DATE));
        setVal("vdCreator", row.DOCUMENT_CREATOR);

        var type = typeLabel(row.DOCUMENT_TYPE);
        $("#vdType").html(type === null ? '<span class="dd-empty">-</span>' : type);

        $("#vdCreated").html(auditVal(row.CREATED_BY, row.CREATED_DT));
        $("#vdChanged").html(auditVal(row.CHANGED_BY, row.CHANGED_DT));

        // hero badges
        var $status = $("#vdStatusBadge");
        if (row.STATUS_DISPLAY) {
            var statusClass = "dd-badge-status-def";
            var statusIcon = "fa-times-circle";
            if (row.STATUS == 0) { statusClass = "dd-badge-status-0"; statusIcon = "fa-clock-o"; }
            else if (row.STATUS == 1) { statusClass = "dd-badge-status-1"; statusIcon = "fa-check-circle"; }
            else if (row.STATUS == 4) { statusClass = "dd-badge-status-4"; statusIcon = "fa-archive"; }
            else if (row.STATUS == 5) { statusClass = "dd-badge-status-5"; statusIcon = "fa-flag-checkered"; }
            $status.attr("class", "dd-badge " + statusClass)
                .html('<i class="fa ' + statusIcon + '"></i> ' + row.STATUS_DISPLAY)
                .show();
        } else {
            $status.hide();
        }

        var $type = $("#vdTypeBadge");
        if (type !== null) {
            $type.text(type).show();
        } else {
            $type.hide();
        }

        var $level = $("#vdLevelBadge");
        if (row.LEVEL_CODE) {
            $level.html('<i class="fa fa-star"></i> Level ' + row.LEVEL_CODE).show();
        } else {
            $level.hide();
        }

        var $classified = $("#vdClassifiedBadge");
        if (row.CLASSIFIED_VAL) {
            $classified.html('<i class="fa fa-shield"></i> ' + row.CLASSIFIED_VAL).show();
        } else {
            $classified.hide();
        }

        $("#modalViewDetail").modal();
    }

    $(document).ready(function () {
        $("#btnDdPreview").on("click", function () {
            if (!gDetailRow) return;
            onViewAttachment(gDetailRow.FILE_PATH, gDetailRow.DOCUMENT_TRANSACTION_ID);
        });

        $("#btnDdDownload").on("click", function () {
            if (!gDetailRow) return;
            onDownloadAttachment(gDetailRow.FILE_PATH, gDetailRow.DOCUMENT_TRANSACTION_ID);
        });

        $("#btnDdHistory").on("click", function () {
            if (!gDetailRow) return;
            gHistoryDocumentCode = gDetailRow.DOCUMENT_CODE;
            $("#modal-title-history").text("Document History - " + gDetailRow.DOCUMENT_CODE);
            $("#datagridHistory").dxDataGrid("instance").refresh();
            $("#modalViewDetail").modal("hide");
            $("#modalDocumentHistory").modal();
        });

        $("#btnDdPrint").on("click", function () {
            if (!gDetailRow || !gDetailRow.FILE_PATH) {
                showErrorMesgGrowl("This data does not have an attachment");
                return;
            }
            var link = '@Html.Raw(Url.Action("ViewAttachment", "DocumentMaintenance", new { FILE_PATH = "-1", DOCUMENT_TRANSACTION_ID = "-2", type = "-3" }))';
            link = link.replace("-1", gDetailRow.FILE_PATH);
            link = link.replace("-2", gDetailRow.DOCUMENT_TRANSACTION_ID);
            link = link.replace("-3", "1");
            var printWin = window.open(link, '_blank');
            if (printWin) {
                printWin.addEventListener('load', function () {
                    printWin.print();
                });
            }
        });
    });
</script>
