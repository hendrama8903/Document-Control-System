<style>
    #modalViewDetail .modal-dialog {
        width: 880px;
        max-width: 96vw;
    }

    #modalViewDetail .modal-title {
        font-size: 17px;
    }

    #modalViewDetail .modal-title small {
        display: block;
        font-size: 12px;
        font-weight: 400;
        color: rgba(255, 255, 255, 0.85);
        margin-top: 2px;
    }

    #modalViewDetail .modal-body {
        max-height: calc(100vh - 210px);
        overflow-y: auto;
        padding: 20px 24px;
        background: #F4F6F8;
    }

    .vd-section {
        border: 1px solid #E3E8EE;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 14px;
        background: #fff;
    }

    .vd-section:last-of-type {
        margin-bottom: 0;
    }

    .vd-section-title {
        font-size: 12px;
        font-weight: 700;
        color: #2E75B6;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .vd-section-title i {
        font-size: 13px;
        width: 14px;
        text-align: center;
    }

    .vd-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 16px 24px;
    }

    .vd-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #98A2B3;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .vd-value {
        font-size: 13.5px;
        color: #1D2939;
        font-weight: 500;
        word-break: break-word;
    }

    .vd-value.vd-empty {
        color: #C2C7CF;
        font-weight: 400;
    }

    .vd-badge {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 20px;
    }

    .vd-badge-new {
        background: #E7F1FB;
        color: #2E75B6;
    }

    .vd-badge-revision {
        background: #FFF3E0;
        color: #B36B00;
    }

    .vd-audit-strip {
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px dashed #D8DEE6;
        display: flex;
        flex-wrap: wrap;
        gap: 18px 28px;
    }

    .vd-audit-item {
        flex: 1;
        min-width: 200px;
    }

    .vd-audit-item .vd-label i {
        margin-right: 4px;
    }

    .vd-audit-item .vd-value {
        font-size: 12.5px;
        color: #667085;
        font-weight: 400;
    }

    .vd-audit-item .vd-value b {
        color: #344054;
        font-weight: 600;
    }
</style>

<div class="modal fade" id="modalViewDetail" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title">
                    <i class="fa fa-file-text-o"></i> Document Detail
                    <small id="modalViewDetail-subtitle"></small>
                </h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="vd-section">
                    <div class="vd-section-title"><i class="fa fa-info-circle"></i> Document Information</div>
                    <div class="vd-grid">
                        <div><div class="vd-label">Document Category</div><div class="vd-value" id="vdCategory">-</div></div>
                        <div><div class="vd-label">Document Type</div><div class="vd-value" id="vdType">-</div></div>
                        <div><div class="vd-label">Document Level</div><div class="vd-value" id="vdLevel">-</div></div>
                        <div><div class="vd-label">Classified</div><div class="vd-value" id="vdClassified">-</div></div>
                    </div>
                </div>

                <div class="vd-section">
                    <div class="vd-section-title"><i class="fa fa-sitemap"></i> Process &amp; Organization</div>
                    <div class="vd-grid">
                        <div><div class="vd-label">Process Code</div><div class="vd-value" id="vdProcessCode">-</div></div>
                        <div><div class="vd-label">Company Code</div><div class="vd-value" id="vdCompanyCode">-</div></div>
                        <div><div class="vd-label">Section</div><div class="vd-value" id="vdSection">-</div></div>
                        <div><div class="vd-label">Item Changed</div><div class="vd-value" id="vdItemChanged">-</div></div>
                    </div>
                </div>

                <div class="vd-section">
                    <div class="vd-section-title"><i class="fa fa-link"></i> Reference</div>
                    <div class="vd-grid">
                        <div><div class="vd-label">Reason</div><div class="vd-value" id="vdReason">-</div></div>
                        <div><div class="vd-label">Reference No</div><div class="vd-value" id="vdReferenceNo">-</div></div>
                        <div><div class="vd-label">Source</div><div class="vd-value" id="vdSource">-</div></div>
                    </div>
                </div>

                <div class="vd-section">
                    <div class="vd-section-title"><i class="fa fa-calendar"></i> Dates</div>
                    <div class="vd-grid">
                        <div><div class="vd-label">Document Date</div><div class="vd-value" id="vdDocumentDate">-</div></div>
                        <div><div class="vd-label">First Revision Date</div><div class="vd-value" id="vdFirstRevisionDate">-</div></div>
                        <div><div class="vd-label">Next Review Date</div><div class="vd-value" id="vdNextReviewDate">-</div></div>
                    </div>

                    <div class="vd-audit-strip">
                        <div class="vd-audit-item">
                            <div class="vd-label"><i class="fa fa-user"></i> Document Creator</div>
                            <div class="vd-value" id="vdCreator">-</div>
                        </div>
                        <div class="vd-audit-item">
                            <div class="vd-label"><i class="fa fa-plus-circle"></i> Created</div>
                            <div class="vd-value" id="vdCreated">-</div>
                        </div>
                        <div class="vd-audit-item">
                            <div class="vd-label"><i class="fa fa-pencil"></i> Last Changed</div>
                            <div class="vd-value" id="vdChanged">-</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-danger" data-dismiss="modal" style="width: 80px;">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function onViewDetail(row) {
        function setVal(id, v) {
            var el = $("#" + id);
            var isEmpty = (v === null || v === undefined || v === "");
            el.text(isEmpty ? "-" : v);
            el.toggleClass("vd-empty", isEmpty);
        }

        function dateVal(v) { return v ? moment(v).format("DD-MM-YYYY") : null; }

        function auditVal(by, dt) {
            var user = (by === null || by === undefined || by === "") ? "-" : by;
            var when = dt ? moment(dt).format("DD-MM-YYYY HH:mm:ss") : "-";
            return "<b>" + user + "</b> &middot; " + when;
        }

        function typeBadge(v) {
            if (v == "01") return '<span class="vd-badge vd-badge-new">New</span>';
            if (v == "02") return '<span class="vd-badge vd-badge-revision">Revision</span>';
            return (v === null || v === undefined || v === "") ? null : v;
        }

        $("#modalViewDetail-subtitle").text(row.DOCUMENT_CODE ? row.DOCUMENT_CODE : "");

        setVal("vdCategory", row.DOCUMENT_NAME);
        setVal("vdLevel", row.LEVEL_CODE);
        setVal("vdClassified", row.CLASSIFIED_VAL);
        setVal("vdProcessCode", row.PROCESS_CODE);
        setVal("vdCompanyCode", row.COMPANY_CODE);
        setVal("vdSection", row.SECTION_NAME);
        setVal("vdItemChanged", row.ITEM_CHANGED);
        setVal("vdReason", row.REASON);
        setVal("vdReferenceNo", row.REFERENCE_NO);
        setVal("vdSource", row.SOURCE);
        setVal("vdDocumentDate", dateVal(row.DOCUMENT_DATE));
        setVal("vdFirstRevisionDate", dateVal(row.DOCUMENT_REVISION_0_DATE));
        setVal("vdNextReviewDate", dateVal(row.NEXT_REVIEW_DATE));
        setVal("vdCreator", row.DOCUMENT_CREATOR);

        var type = typeBadge(row.DOCUMENT_TYPE);
        $("#vdType").html(type === null ? '<span class="vd-empty">-</span>' : type);

        $("#vdCreated").html(auditVal(row.CREATED_BY, row.CREATED_DT));
        $("#vdChanged").html(auditVal(row.CHANGED_BY, row.CHANGED_DT));

        $("#modalViewDetail").modal();
    }
</script>
