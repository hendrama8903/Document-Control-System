<link rel="stylesheet" href="~/css/views/DocumentMaintenance/_TemplateCenterPopup.css" asp-append-version="true" />

<div class="modal fade" id="modalTemplateCenter" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="tpl-header">
                <div>
                    <div class="tpl-title">Template Center</div>
                    <div class="tpl-sub">Download the template that matches your document type.</div>
                </div>
                <div class="tpl-header-right">
                    <div class="tpl-search">
                        <i class="fa fa-search"></i>
                        <input type="text" id="tplSearchInput" placeholder="Search template..." autocomplete="off" />
                    </div>
                    <button type="button" class="tpl-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
                </div>
            </div>

            <div class="tpl-body">
                <table class="tpl-table">
                    <thead>
                        <tr>
                            <th width="20%">Document Type</th>
                            <th width="34%">Description</th>
                            <th width="14%">Format</th>
                            <th width="14%">Size</th>
                            <th width="18%">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tplTableBody"></tbody>
                </table>
                <div class="tpl-empty" id="tplEmptyState" style="display:none;">No template found.</div>
            </div>

            <div class="tpl-footer">
                <i class="fa fa-info-circle"></i> Make sure you use the latest template to avoid upload data errors.
            </div>
        </div>
    </div>
</div>
