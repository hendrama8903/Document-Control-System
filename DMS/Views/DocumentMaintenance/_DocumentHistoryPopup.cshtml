<link rel="stylesheet" href="~/css/views/DocumentMaintenance/_DocumentHistoryPopup.css" asp-append-version="true" />

<div class="modal fade" id="modalDocumentHistory" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modal-title-history">Document History</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div id="datagridHistory"></div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn dp-btn dp-btn-outline" id="btn_cancel_history" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var documentHistoryPopupConfig = {
        urls: {
            searchHistory: "@Url.Action("SearchHistory", "DocumentMaintenance")"
        }
    };
</script>
<script src="~/js/views/document-history-popup.js" asp-append-version="true"></script>
