<!-- RECOMMIT DINA -->
<link rel="stylesheet" href="~/css/views/DocumentMaintenance/_PopupForm.css" asp-append-version="true" />

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Header -->
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-file-text-o"></i></div>
                <div>
                    <div class="adf-header-title" id="modal-title">New Document</div>
                    <div class="adf-header-sub">Fill in the document information below</div>
                </div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <!-- Horizontal stepper DIHAPUS (request Hendra 2026-08-20, supaya
                 konten dapat ruang lebih) - klik-scroll-ke-section &
                 highlight-aktif-saat-scroll di script bawah juga sudah
                 dilepas karena elemen targetnya (.adf-step) tidak ada lagi.
                 Penomoran section (.adf-section-num, counter CSS) tetap ada
                 di judul tiap card sebagai penanda urutan. -->

            <div class="adf-body">
                <div class="adf-content">
                    <!-- Step: Basic Information - Document Type, Date & Document No jadi
                         satu baris (request Hendra 2026-08-20). Document No tetap
                         auto-generate berdasarkan Level/Division/Department/Section/
                         ProcessCode/CompanyCode yang baru diisi di step berikutnya -
                         wajar kalau kotaknya masih kosong sampai step 2 & 3 dilengkapi,
                         karena listener perubahan field-field itu tidak bergantung pada
                         urutan tampil di DOM. -->
                    <div class="adf-section" id="adfSectionDocType">
                        <div class="adf-section-title"><span class="adf-section-num"></span> Basic Information</div>

                        <div class="row">
                            <div class="col-md-3 form-group">
                                <label class="control-label">Document Type <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDocumentType" onchange="onChangeDocumentType()" required></select>
                                <input class="form-control" id="addEditDocumentId" type="hidden" />
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="control-label">Date <span class="text-red">*</span></label>
                                <input class="form-control" id="addEditDate" type="date" required />
                            </div>
                            <div class="col-md-6 form-group">
                                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; row-gap:2px;">
                                    <label class="control-label" style="margin-bottom:0;">Document No <span class="text-red">*</span></label>
                                    <div id="addEditNumberingModeGroup">
                                        <label style="font-weight:normal; display:inline-flex; align-items:center; margin-right:14px; margin-bottom:0; cursor:pointer;">
                                            <input type="radio" name="addEditNumberingMode" id="addEditNumberingModeAuto" value="AUTO" checked="checked" onchange="onChangeNumberingMode()" style="margin:0 4px 0 0;" />Automatic
                                        </label>
                                        <label style="font-weight:normal; display:inline-flex; align-items:center; margin-bottom:0; cursor:pointer;">
                                            <input type="radio" name="addEditNumberingMode" id="addEditNumberingModeManual" value="MANUAL" onchange="onChangeNumberingMode()" style="margin:0 4px 0 0;" />Manual
                                        </label>
                                    </div>
                                </div>
                                <input class="form-control" id="addEditDocumentNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" required />
                                <div id="addEditManualNoGroup" class="input-group hide">
                                    <span class="input-group-addon" id="addEditManualNoPrefix">-</span>
                                    <input class="form-control" id="addEditManualSeqNo" type="text" maxlength="3" placeholder="XXX" oninput="this.value=this.value.replace(/[^0-9]/g,'')" required />
                                </div>
                                @*Updated By Arie - 2023-08-24*@
                                <select class="form-control" id="addEditDocumentNo2" onchange="onChangeDocumentNo()" required></select>
                            </div>
                        </div>
                    </div>

                    <!-- Step: Classification - Document Level dulu (menentukan pilihan
                         Document Code yang tersedia lewat GetDocumentCodeByLevel), baru
                         Document Code/Category, Process Code, Classified, Document Name,
                         External (request Hendra 2026-08-20: Document Name dipindah ke
                         sini dari step Document Details lama). -->
                    <div class="adf-section" id="adfSectionClassification">
                        <div class="adf-section-title"><span class="adf-section-num"></span> Classification</div>

                        <div class="row">
                            <div class="col-md-2 form-group">
                                <label class="control-label">Document Level <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDocumentLevel" onchange="onChangeDocumentLevel()" required></select>
                            </div>
                            <div class="col-md-2 form-group">
                                <label class="control-label">Document Code <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDocumentCode" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Process Code <span id="mandatoryMarkProcessCode" class="text-red">*</span></label>
                                <select class="form-control" id="addEditProcessCode" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Classified <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditClassified" required></select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 form-group">
                                <label class="control-label">Document Name <span class="text-red">*</span></label>
                                <input class="form-control" id="addEditDocumentName" type="text" oninput="removeWhiteSpace(this)" maxlength="255" required />
                            </div>
                        </div>

                        <!-- Related Division (SPR/SIPOCOR Level 2 only, conditional -
                             hidden by default, shown by updateRelatedDivisionVisibility()
                             in _Javascript.cshtml). Ditaruh LANGSUNG setelah Document
                             Name, sebelum panel External (request Hendra 2026-08-20) -
                             supaya begitu user memilih Document Level=2 & Document
                             Code=SPR, dia langsung lihat blok ini tanpa perlu scroll
                             lewat panel External dulu. Tile divisi dokumen sendiri
                             dikunci Main PIC & ikut ter-refresh setelah Division di step
                             Organization diisi, lewat lockCreatorDivisionRole() -
                             urutan render tidak masalah. -->
                        <div id="adfSectionRelatedDivision" style="display:none;">
                            <div class="rd-header">
                                <div>
                                    <div class="rd-title">Related Division</div>
                                    <div class="rd-desc">Click a division to set its role - Related needs to acknowledge ("Mengetahui"); Not Related is the default.</div>
                                </div>
                                <div class="rd-search-wrap">
                                    <i class="fa fa-search"></i>
                                    <input type="text" id="relatedDivisionSearch" placeholder="Search division..." oninput="filterRelatedDivisionCheckboxes()" />
                                </div>
                            </div>
                            <div class="row" id="relatedDivisionCheckboxes"></div>
                            <div class="rd-showmore" id="relatedDivisionShowMore" style="display:none;">
                                <a href="javascript:void(0);" onclick="toggleRelatedDivisionShowMore()">
                                    <span id="relatedDivisionShowMoreText">Show more</span> <i class="fa fa-chevron-down"></i>
                                </a>
                            </div>
                        </div>

                        <div class="external-panel">
                            <div class="panel-title">
                                <input type="checkbox" id="addEditExternal" name="addEditExternal">
                                <label for="addEditExternal" style="font-weight: 700; margin-left: 4px;">External</label>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="control-label">Reference No <span id="mandatoryMarkReferenceNo" class="text-red" style="display: none">*</span></label>
                                    <input class="form-control" id="addEditReferenceNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" required />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="control-label">Source <span id="mandatoryMarkSource" class="text-red" style="display: none">*</span></label>
                                    <input class="form-control" id="addEditSource" type="text" oninput="removeWhiteSpace(this)" maxlength="255" required />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group checkbox-inline-group" style="padding-top:0;">
                                    <input type="checkbox" id="addEditImpactToOtherDocument" name="addEditImpactToOtherDocument" value="IMP">
                                    <label for="addEditImpactToOtherDocument" style="margin-left: 4px;">Impact To Other Document</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step: Organization - divisi pemilik dokumen ini, dipakai step
                         berikutnya (Document Details) utk bikin prefix nomor otomatis,
                         dan (kalau Document Code = SPR & Level = 2) utk tandai Main PIC
                         di step "Related Division" di atas. -->
                    <div class="adf-section" id="adfSectionOrg">
                        <div class="adf-section-title"><span class="adf-section-num"></span> Organization</div>

                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="control-label">Division <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDivision" onchange="setDepartment(this.value)" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Department <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDepartment" onchange="setSection(this.value);" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Section <span id="mandatoryMarkSection" class="text-red">*</span></label>
                                <select class="form-control" id="addEditSection" required></select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="control-label">Company Code <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditCompanyCode" required></select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="control-label">Creator <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDocumentCreator" required></select>
                            </div>
                        </div>

                        <!-- Pratinjau approval chain (2026-11-06): alur yang berlaku untuk
                             Level + Document Code + Creator terpilih, dihitung server dengan
                             fungsi yang sama dengan pembuatan approval sebenarnya. -->
                        <div class="adf-approval-preview" id="addEditApprovalPreview" style="display:none;"></div>
                    </div>

                    <!-- Step: Attachment & Others - file diupload TERAKHIR karena baru
                         di titik ini semua metadata (kode/nomor dokumen dst) sudah
                         ditentukan, jadi validasi template (ValidateTemplateConfiguration)
                         punya konteks DOCUMENT_ID yang benar. -->
                    <div class="adf-section" id="adfSectionAttachment">
                        <div class="adf-section-title"><span class="adf-section-num"></span> Attachment &amp; Others</div>

                        <!-- Analisis dampak revisi (OCR tahap 2, 2026-11-06): dokumen lain yang
                             menyebut nomor dokumen yang sedang direvisi. -->
                        <div class="adf-insight" id="addEditImpactPanel" style="display:none;"></div>

                        <div class="row">
                            <div class="col-md-6 form-group" id="fileNameContainer">
                                <label class="control-label">Document Upload <span class="text-red">*</span></label>
                                <div class="adf-dropzone" id="addEditDropzone">
                                    <i class="fa fa-cloud-upload dz-icon"></i>
                                    <div class="dz-text" id="addEditDropzoneText">Drag &amp; drop file here<br>or <span class="dz-browse">Browse File</span></div>
                                    <div class="dz-hint">Allowed: XLSX, XLS (Max. 20 MB)</div>
                                </div>
                                <input type="file" id="addEditDocumentUpload" accept=".xlsx,.xls" style="position:absolute; width:1px; height:1px; opacity:0; overflow:hidden;" required>
                                <!-- Cek isi file (OCR tahap 2, 2026-11-06) -->
                                <div class="adf-filecheck" id="addEditFileCheck" style="display:none;"></div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-12 form-group">
                                        <label class="control-label">Item Changed</label>
                                        <input class="form-control" id="addEditItemChanged" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12 form-group">
                                        <label class="control-label">Reason</label>
                                        <input class="form-control" id="addEditReason" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Sticky Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn dp-btn dp-btn-outline" id="btn_cancel" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn dp-btn dp-btn-primary" id="btn_save">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // drag & drop upload
        var $dropzone = $('#addEditDropzone');
        var $fileInput = $('#addEditDocumentUpload');

        $dropzone.on('click', function () {
            if (!$fileInput.prop('disabled')) {
                $fileInput.trigger('click');
            }
        });

        $dropzone.on('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (!$fileInput.prop('disabled')) {
                $dropzone.addClass('dragover');
            }
        });

        $dropzone.on('dragleave drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropzone.removeClass('dragover');
        });

        $dropzone.on('drop', function (e) {
            if ($fileInput.prop('disabled')) return;
            var files = e.originalEvent.dataTransfer.files;
            if (files && files.length) {
                $fileInput[0].files = files;
                $fileInput.trigger('change');
            }
        });

        $fileInput.on('change', function () {
            var fileName = this.files && this.files.length ? this.files[0].name : '';
            if (fileName) {
                $('#addEditDropzoneText').html('<span class="dz-filename"><i class="fa fa-file-excel-o"></i> ' + fileName + '</span>');
            } else {
                $('#addEditDropzoneText').html('Drag &amp; drop file here<br>or <span class="dz-browse">Browse File</span>');
            }
        });

        // keep dropzone visually in sync with the (hidden) input's disabled state
        var fileInputEl = document.getElementById('addEditDocumentUpload');
        new MutationObserver(function () {
            $dropzone.toggleClass('disabled', fileInputEl.disabled);
        }).observe(fileInputEl, { attributes: true, attributeFilter: ['disabled'] });
    });

    function clearDocumentUpload() {
        $('#addEditDocumentUpload').val('');
        $('#addEditDropzoneText').html('Drag &amp; drop file here<br>or <span class="dz-browse">Browse File</span>');
    }
</script>
