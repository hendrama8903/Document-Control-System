<style>
    #modalAddEdit .modal-dialog {
        width: 980px;
        max-width: 96vw;
    }

    #modalAddEdit .modal-content {
        display: flex;
        flex-direction: column;
        max-height: 90vh;
        border: none;
        border-radius: 14px;
        overflow: hidden;
    }

    /* header */
    #modalAddEdit .adf-header {
        flex: none;
        background: linear-gradient(135deg, #2450D8, #1C3FA6);
        color: #fff;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    #modalAddEdit .adf-header-icon {
        flex: none;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    #modalAddEdit .adf-header-title {
        font-size: 15.5px;
        font-weight: 700;
    }

    #modalAddEdit .adf-header-sub {
        font-size: 12px;
        color: rgba(255,255,255,.85);
        margin-top: 1px;
    }

    #modalAddEdit .adf-close {
        margin-left: auto;
        background: transparent;
        border: none;
        color: rgba(255,255,255,.9);
        font-size: 18px;
        line-height: 1;
        padding: 6px;
        cursor: pointer;
    }

    #modalAddEdit .adf-close:hover { color: #fff; }

    /* body: sidebar + content */
    #modalAddEdit .adf-body {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        background: #F4F6F8;
    }

    #modalAddEdit .adf-sidebar {
        flex: none;
        width: 220px;
        background: #fff;
        border-right: 1px solid #E3E8EE;
        padding: 16px 12px;
        overflow-y: auto;
    }

    #modalAddEdit .adf-nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border-radius: 8px;
        cursor: pointer;
        margin-bottom: 2px;
    }

    #modalAddEdit .adf-nav-item:hover { background: #F4F6F8; }

    #modalAddEdit .adf-nav-item.active { background: #E7F1FB; }

    #modalAddEdit .adf-nav-icon {
        flex: none;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: #EEF0F2;
        color: #667085;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
    }

    #modalAddEdit .adf-nav-item.active .adf-nav-icon {
        background: #2450D8;
        color: #fff;
    }

    #modalAddEdit .adf-nav-item b {
        display: block;
        font-size: 12.5px;
        color: #1D2939;
        font-weight: 600;
    }

    #modalAddEdit .adf-nav-item span {
        display: block;
        font-size: 10.5px;
        color: #98A2B3;
    }

    #modalAddEdit .adf-tips {
        margin-top: 14px;
        border-top: 1px solid #E3E8EE;
        padding-top: 14px;
        font-size: 11px;
        color: #66788A;
        line-height: 1.5;
    }

    #modalAddEdit .adf-tips b {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #1D2939;
        margin-bottom: 6px;
        font-size: 11.5px;
    }

    #modalAddEdit .adf-content {
        flex: 1 1 auto;
        min-width: 0;
        overflow-y: auto;
        padding: 18px 22px;
    }

    #modalAddEdit .adf-section {
        background: #fff;
        border: 1px solid #E3E8EE;
        border-radius: 10px;
        padding: 16px 18px 4px;
        margin-bottom: 16px;
        scroll-margin-top: 8px;
    }

    #modalAddEdit .adf-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 13.5px;
        font-weight: 700;
        color: #1D2939;
        margin-bottom: 14px;
    }

    #modalAddEdit .adf-section-num {
        flex: none;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #2450D8;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11.5px;
        font-weight: 700;
    }

    #modalAddEdit .form-group {
        margin-bottom: 14px;
    }

    #modalAddEdit .form-group > .control-label {
        display: block;
        margin-bottom: 4px;
        font-size: 12.5px;
    }

    #modalAddEdit .external-panel {
        border: 1px solid #DFE5EB;
        border-radius: 10px;
        padding: 14px 16px 2px;
        margin: 4px 0 8px;
        background: #F7F9FB;
    }

    #modalAddEdit .external-panel .panel-title {
        font-weight: 700;
        font-size: 12.5px;
        margin-bottom: 12px;
    }

    #modalAddEdit .checkbox-inline-group {
        padding-top: 26px;
    }

    #modalAddEdit .form-control:required:focus,
    #modalAddEdit .select2-selection.required-focus {
        border-color: #2E75B6 !important;
        box-shadow: 0 0 0 3px rgba(46, 117, 182, 0.25) !important;
    }

    /* drag & drop upload */
    #modalAddEdit .adf-dropzone {
        position: relative;
        border: 1.5px dashed #C6D0DB;
        border-radius: 10px;
        background: #F9FAFB;
        padding: 22px 16px;
        text-align: center;
        cursor: pointer;
        transition: border-color .15s ease, background .15s ease;
    }

    #modalAddEdit .adf-dropzone:hover,
    #modalAddEdit .adf-dropzone.dragover {
        border-color: #2450D8;
        background: #E7F1FB;
    }

    #modalAddEdit .adf-dropzone.disabled {
        opacity: .55;
        cursor: not-allowed;
        pointer-events: none;
    }

    #modalAddEdit .adf-dropzone i.dz-icon {
        font-size: 22px;
        color: #98A2B3;
        margin-bottom: 6px;
        display: block;
    }

    #modalAddEdit .adf-dropzone .dz-text {
        font-size: 12.5px;
        color: #344054;
    }

    #modalAddEdit .adf-dropzone .dz-browse {
        color: #2450D8;
        font-weight: 700;
        text-decoration: underline;
    }

    #modalAddEdit .adf-dropzone .dz-hint {
        font-size: 10.5px;
        color: #98A2B3;
        margin-top: 4px;
    }

    #modalAddEdit .adf-dropzone .dz-filename {
        font-size: 12.5px;
        color: #2450D8;
        font-weight: 700;
        word-break: break-all;
    }

    /* sticky footer */
    #modalAddEdit .modal-footer {
        flex: none;
        background: #fff;
        border-top: 1px solid #E3E8EE;
        padding: 14px 22px;
        margin: 0;
    }
</style>

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Header -->
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-file-text-o"></i></div>
                <div>
                    <div class="adf-header-title" id="modal-title">Add / Edit @ViewData["Title"]</div>
                    <div class="adf-header-sub">Fill in the document information below</div>
                </div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <!-- Body: sidebar + sections -->
            <div class="adf-body">
                <div class="adf-sidebar">
                    <div class="adf-nav-item active" data-target="#adfSectionBasic">
                        <div class="adf-nav-icon">1</div>
                        <div>
                            <b>Basic Information</b>
                            <span>Document details</span>
                        </div>
                    </div>
                    <div class="adf-nav-item" data-target="#adfSectionOrg">
                        <div class="adf-nav-icon">2</div>
                        <div>
                            <b>Organization</b>
                            <span>Division &amp; Department</span>
                        </div>
                    </div>
                    <div class="adf-nav-item" data-target="#adfSectionClassification">
                        <div class="adf-nav-icon">3</div>
                        <div>
                            <b>Classification</b>
                            <span>Document category</span>
                        </div>
                    </div>
                    <div class="adf-nav-item" data-target="#adfSectionAttachment">
                        <div class="adf-nav-icon">4</div>
                        <div>
                            <b>Attachment</b>
                            <span>Upload &amp; others</span>
                        </div>
                    </div>

                    <div class="adf-tips">
                        <b><i class="fa fa-lightbulb-o"></i> Tips</b>
                        Fields marked with <b style="display:inline;font-size:inherit;">*</b> are required.
                    </div>
                </div>

                <div class="adf-content">
                    <!-- 1. Basic Information -->
                    <div class="adf-section" id="adfSectionBasic">
                        <div class="adf-section-title"><span class="adf-section-num">1</span> Basic Information</div>

                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="control-label">Document Type <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDocumentType" onchange="onChangeDocumentType()" required></select>
                                <input class="form-control" id="addEditDocumentId" type="hidden" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Document Level <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDocumentLevel" onchange="onChangeDocumentLevel()" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Date <span class="text-red">*</span></label>
                                <input class="form-control" id="addEditDate" type="date" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; row-gap:2px;">
                                    <label class="control-label" style="margin-bottom:0;">Document No <span class="text-red">*</span></label>
                                    <div id="addEditNumberingModeGroup">
                                        <label style="font-weight:normal; display:inline-flex; align-items:center; margin-right:14px; margin-bottom:0; cursor:pointer;">
                                            <input type="radio" name="addEditNumberingMode" id="addEditNumberingModeAuto" value="AUTO" checked="checked" onchange="onChangeNumberingMode()" style="margin:0 4px 0 0;" />Automatic
                                        </label>
                                        <label style="font-weight:normal; display:inline-flex; align-items:center; margin-bottom:0; cursor:pointer;">
                                            <input type="radio" name="addEditNumberingMode" id="addEditNumberingModeManual" value="MANUAL" onchange="onChangeNumberingMode()" style="margin:0 4px 0 0;" />Manual
                                        </label>
                                    </div>
                                </div>
                                <input class="form-control" id="addEditDocumentNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" required />
                                <div id="addEditManualNoGroup" class="input-group hide">
                                    <span class="input-group-addon" id="addEditManualNoPrefix">-</span>
                                    <input class="form-control" id="addEditManualSeqNo" type="text" maxlength="3" placeholder="XXX" oninput="this.value=this.value.replace(/[^0-9]/g,'')" required />
                                </div>
                                @*Updated By Arie - 2023-08-24*@
                                <select class="form-control" id="addEditDocumentNo2" onchange="onChangeDocumentNo()" required></select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="control-label">Document Name <span class="text-red">*</span></label>
                                <input class="form-control" id="addEditDocumentName" type="text" oninput="removeWhiteSpace(this)" maxlength="255" required />
                            </div>
                        </div>
                    </div>

                    <!-- 2. Organization -->
                    <div class="adf-section" id="adfSectionOrg">
                        <div class="adf-section-title"><span class="adf-section-num">2</span> Organization</div>

                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="control-label">Division <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDivision" onchange="setDepartment(this.value)" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Department <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDepartment" onchange="setSection(this.value);" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Section <span id="mandatoryMarkSection" class="text-red">*</span></label>
                                <select class="form-control" id="addEditSection" required></select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="control-label">Company Code <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditCompanyCode" required></select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="control-label">Creator <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDocumentCreator" required></select>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Classification -->
                    <div class="adf-section" id="adfSectionClassification">
                        <div class="adf-section-title"><span class="adf-section-num">3</span> Classification</div>

                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="control-label">Document Code <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditDocumentCode" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Process Code <span id="mandatoryMarkProcessCode" class="text-red">*</span></label>
                                <select class="form-control" id="addEditProcessCode" required></select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Classified <span class="text-red">*</span></label>
                                <select class="form-control" id="addEditClassified" required></select>
                            </div>
                        </div>

                        <div class="external-panel">
                            <div class="panel-title">
                                <input type="checkbox" id="addEditExternal" name="addEditExternal">
                                <label for="addEditExternal" style="font-weight: 700; margin-left: 4px;">External</label>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="control-label">Reference No <span id="mandatoryMarkReferenceNo" class="text-red" style="display: none">*</span></label>
                                    <input class="form-control" id="addEditReferenceNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" required />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="control-label">Source <span id="mandatoryMarkSource" class="text-red" style="display: none">*</span></label>
                                    <input class="form-control" id="addEditSource" type="text" oninput="removeWhiteSpace(this)" maxlength="255" required />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group checkbox-inline-group" style="padding-top:0;">
                                    <input type="checkbox" id="addEditImpactToOtherDocument" name="addEditImpactToOtherDocument" value="IMP">
                                    <label for="addEditImpactToOtherDocument" style="margin-left: 4px;">Impact To Other Document</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Attachment -->
                    <div class="adf-section" id="adfSectionAttachment">
                        <div class="adf-section-title"><span class="adf-section-num">4</span> Attachment &amp; Others</div>

                        <div class="row">
                            <div class="col-md-6 form-group" id="fileNameContainer">
                                <label class="control-label">Document Upload <span class="text-red">*</span></label>
                                <div class="adf-dropzone" id="addEditDropzone">
                                    <i class="fa fa-cloud-upload dz-icon"></i>
                                    <div class="dz-text" id="addEditDropzoneText">Drag &amp; drop file here<br>or <span class="dz-browse">Browse File</span></div>
                                    <div class="dz-hint">Allowed: XLSX, XLS (Max. 20 MB)</div>
                                </div>
                                <input type="file" id="addEditDocumentUpload" accept=".xlsx,.xls" style="position:absolute; width:1px; height:1px; opacity:0; overflow:hidden;" required>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-12 form-group">
                                        <label class="control-label">Item Changed</label>
                                        <input class="form-control" id="addEditItemChanged" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12 form-group">
                                        <label class="control-label">Reason</label>
                                        <input class="form-control" id="addEditReason" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sticky Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-danger" id="btn_cancel" data-dismiss="modal" style="width: 80px;">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btn_save" style="width: 80px;">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // sidebar click -> scroll to section
        $('#modalAddEdit .adf-nav-item').on('click', function () {
            var target = $($(this).data('target'));
            if (target.length) {
                $('#modalAddEdit .adf-content').animate({ scrollTop: target.position().top + $('#modalAddEdit .adf-content').scrollTop() - 8 }, 250);
            }
        });

        // highlight sidebar item on scroll
        $('#modalAddEdit .adf-content').on('scroll', function () {
            var scrollPos = $(this).scrollTop();
            var current = null;
            $('#modalAddEdit .adf-section').each(function () {
                if ($(this).position().top - 20 <= 0) {
                    current = '#' + $(this).attr('id');
                }
            });
            if (current) {
                $('#modalAddEdit .adf-nav-item').removeClass('active');
                $('#modalAddEdit .adf-nav-item[data-target="' + current + '"]').addClass('active');
            }
        });

        // drag & drop upload
        var $dropzone = $('#addEditDropzone');
        var $fileInput = $('#addEditDocumentUpload');

        $dropzone.on('click', function () {
            if (!$fileInput.prop('disabled')) {
                $fileInput.trigger('click');
            }
        });

        $dropzone.on('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (!$fileInput.prop('disabled')) {
                $dropzone.addClass('dragover');
            }
        });

        $dropzone.on('dragleave drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropzone.removeClass('dragover');
        });

        $dropzone.on('drop', function (e) {
            if ($fileInput.prop('disabled')) return;
            var files = e.originalEvent.dataTransfer.files;
            if (files && files.length) {
                $fileInput[0].files = files;
                $fileInput.trigger('change');
            }
        });

        $fileInput.on('change', function () {
            var fileName = this.files && this.files.length ? this.files[0].name : '';
            if (fileName) {
                $('#addEditDropzoneText').html('<span class="dz-filename"><i class="fa fa-file-excel-o"></i> ' + fileName + '</span>');
            } else {
                $('#addEditDropzoneText').html('Drag &amp; drop file here<br>or <span class="dz-browse">Browse File</span>');
            }
        });

        // keep dropzone visually in sync with the (hidden) input's disabled state
        var fileInputEl = document.getElementById('addEditDocumentUpload');
        new MutationObserver(function () {
            $dropzone.toggleClass('disabled', fileInputEl.disabled);
        }).observe(fileInputEl, { attributes: true, attributeFilter: ['disabled'] });
    });

    function clearDocumentUpload() {
        $('#addEditDocumentUpload').val('');
        $('#addEditDropzoneText').html('Drag &amp; drop file here<br>or <span class="dz-browse">Browse File</span>');
    }
</script>
