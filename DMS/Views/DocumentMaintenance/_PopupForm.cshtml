<style>
    #modalAddEdit .modal-dialog {
        width: 960px;
        max-width: 96vw;
    }

    #modalAddEdit .modal-body {
        max-height: calc(100vh - 210px);
        overflow-y: auto;
        padding: 18px 24px 6px;
    }

    #modalAddEdit .form-group {
        margin-bottom: 14px;
    }

    #modalAddEdit .form-group > .control-label {
        display: block;
        margin-bottom: 4px;
        font-size: 12.5px;
    }

    #modalAddEdit .external-panel {
        border: 1px solid #DFE5EB;
        border-radius: 10px;
        padding: 14px 16px 2px;
        margin: 4px 0 8px;
        background: #F7F9FB;
    }

    #modalAddEdit .external-panel .panel-title {
        font-weight: 700;
        font-size: 12.5px;
        margin-bottom: 12px;
    }

    #modalAddEdit .checkbox-inline-group {
        padding-top: 26px;
    }
</style>

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modal-title">Add / Edit @ViewData["Title"]</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="control-label">Document Type <span class="text-red">*</span></label>
                        <select class="form-control" id="addEditDocumentType" onchange="onChangeDocumentType()"></select>
                        <input class="form-control" id="addEditDocumentId" type="hidden" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Document No <span class="text-red">*</span></label>
                        <input class="form-control" id="addEditDocumentNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                        @*Updated By Arie - 2023-08-24*@
                        <select class="form-control" id="addEditDocumentNo2" onchange="onChangeDocumentNo()"></select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Document Level <span class="text-red">*</span></label>
                        <select class="form-control" id="addEditDocumentLevel" onchange="onChangeDocumentLevel()"></select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="control-label">Document Code <span class="text-red">*</span></label>
                        <select class="form-control" id="addEditDocumentCode"></select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Division <span class="text-red">*</span></label>
                        <select class="form-control" id="addEditDivision" onchange="setDepartment(this.value)"></select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Department <span class="text-red">*</span></label>
                        <select class="form-control" id="addEditDepartment" onchange="setSection(this.value);"></select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="control-label">Section <span id="mandatoryMarkSection" class="text-red">*</span></label>
                        <select class="form-control" id="addEditSection"></select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Creator <span class="text-red">*</span></label>
                        <select class="form-control" id="addEditDocumentCreator"></select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Company Code <span class="text-red">*</span></label>
                        <select class="form-control" id="addEditCompanyCode"></select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="control-label">Process Code <span id="mandatoryMarkProcessCode" class="text-red">*</span></label>
                        <select class="form-control" id="addEditProcessCode"></select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Classified <span class="text-red">*</span></label>
                        <select class="form-control" id="addEditClassified"></select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Document Name <span class="text-red">*</span></label>
                        <input class="form-control" id="addEditDocumentName" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="control-label">Date <span class="text-red">*</span></label>
                        <input class="form-control" id="addEditDate" type="date" />
                    </div>
                    <div class="col-md-4 form-group" id="fileNameContainer">
                        <label class="control-label">Document Upload <span class="text-red">*</span></label>
                        <input type="file" class="filestyle" data-btnClass="btn-primary" id="addEditDocumentUpload" style="height: 31px;" accept=".xlsx,.xls">
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="control-label">Item Changed</label>
                        <input class="form-control" id="addEditItemChanged" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="control-label">Reason</label>
                        <input class="form-control" id="addEditReason" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                    </div>
                </div>

                <div class="external-panel">
                    <div class="panel-title">
                        <input type="checkbox" id="addEditExternal" name="addEditExternal">
                        <label for="addEditExternal" style="font-weight: 700; margin-left: 4px;">External</label>
                    </div>
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label class="control-label">Reference No <span id="mandatoryMarkReferenceNo" class="text-red" style="display: none">*</span></label>
                            <input class="form-control" id="addEditReferenceNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                        </div>
                        <div class="col-md-4 form-group">
                            <label class="control-label">Source <span id="mandatoryMarkSource" class="text-red" style="display: none">*</span></label>
                            <input class="form-control" id="addEditSource" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                        </div>
                        <div class="col-md-4 form-group checkbox-inline-group">
                            <input type="checkbox" id="addEditImpactToOtherDocument" name="addEditImpactToOtherDocument" value="IMP">
                            <label for="addEditImpactToOtherDocument" style="margin-left: 4px;">Impact To Other Document</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-primary" id="btn_save" style="width: 80px;">Save</button>
                    <button type="button" class="btn btn-danger" id="btn_cancel" data-dismiss="modal" style="width: 80px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
