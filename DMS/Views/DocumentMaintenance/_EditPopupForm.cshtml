<!-- RECOMMIT DINA -->
<link rel="stylesheet" href="~/css/views/DocumentMaintenance/_EditPopupForm.css" asp-append-version="true" />

<div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- Header -->
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-pencil-square-o"></i></div>
                <div>
                    <div class="adf-header-title" id="modalEdit-title">Edit @ViewData["Title"]</div>
                    <div class="adf-header-sub" id="modalEdit-subtitle">Update document information and file</div>
                </div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <!-- Document Information -->
                <div class="adf-section">
                    <div class="adf-section-title"><i class="fa fa-file-text-o"></i> Document Information</div>

                    <div class="adf-info-layout">
                        <div class="adf-info-main">
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="control-label"><i class="fa fa-hashtag adf-label-icon"></i>Document No <span class="text-red">*</span></label>
                                    <div class="adf-locked-wrap">
                                        <input class="form-control adf-locked" id="editDocumentNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" readonly />
                                        <i class="fa fa-lock"></i>
                                    </div>
                                    <input class="form-control" id="editDocumentId" type="hidden" />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="control-label"><i class="fa fa-code-fork adf-label-icon"></i>Revision <span class="text-red">*</span></label>
                                    <div class="adf-locked-wrap">
                                        <input class="form-control adf-locked" id="editRevision" type="text" oninput="removeWhiteSpace(this)" maxlength="255" readonly />
                                        <i class="fa fa-lock"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="control-label"><i class="fa fa-file-o adf-label-icon"></i>Document Name <span class="text-red">*</span></label>
                                    <input class="form-control" id="editDocumentName" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="control-label"><i class="fa fa-calendar adf-label-icon"></i>Date <span class="text-red">*</span></label>
                                    <input class="form-control" id="editDate" type="date" />
                                </div>
                            </div>
                        </div>

                        <div class="adf-status-panel adf-status-info" id="editStatusPanel">
                            <div class="adf-status-label">Document Status</div>
                            <div class="adf-status-row">
                                <div class="adf-status-icon"><i class="fa fa-clock-o" id="editStatusIcon"></i></div>
                                <div class="adf-status-text" id="editStatusText">-</div>
                            </div>
                            <div class="adf-status-hint" id="editStatusHint"></div>
                        </div>
                    </div>
                </div>

                <!-- Document File -->
                <div class="adf-section">
                    <div class="adf-section-title"><i class="fa fa-paperclip"></i> Document File</div>

                    <div class="form-group">
                        <label class="control-label">Current File</label>
                        <div class="adf-current-file" id="editCurrentFileRow">
                            <i class="fa fa-file-excel-o dz-file-icon" id="editCurrentFileIcon"></i>
                            <span class="dz-filename" id="editCurrentFileName">-</span>
                            <span class="dz-empty hide" id="editCurrentFileEmpty">No file attached</span>
                            <a href="#" id="btn_preview_filepath"><i class="fa fa-eye"></i> Preview</a>
                            <a href="#" id="btn_download_filepath"><i class="fa fa-download"></i> Download</a>
                            <button type="button" id="btn_delete_filepath" class="dz-remove" data-toggle="tooltip" data-placement="bottom" title="Remove Document"><i class="fa fa-trash"></i></button>
                        </div>
                    </div>

                    <div class="form-group has-feedback" id="inputContainer">
                        <label class="control-label">Replace File</label>
                        <div class="adf-dropzone" id="editDropzone">
                            <span><i class="fa fa-cloud-upload dz-icon"></i><span class="dz-text" id="editDropzoneText">Drag &amp; drop file here or <span class="dz-browse">click to browse</span></span></span>
                            <div class="dz-hint">Allowed: XLSX, XLS (Max. 20 MB)</div>
                        </div>
                        <div id="editFileNameContainer" style="position:absolute; width:1px; height:1px; overflow:hidden;">
                            <input type="file" id="editDocumentUpload" accept=".xlsx,.xls" style="width:1px;height:1px;opacity:0;">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label class="control-label">Remark</label>
                            <textarea class="form-control" rows="3" id="editRemark"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Additional Information -->
                <div class="adf-section">
                    <div class="adf-section-title"><i class="fa fa-list-alt"></i> Additional Information</div>

                    <div class="external-panel">
                        <div class="panel-title">
                            <input type="checkbox" id="editExternal" name="editExternal">
                            <label for="editExternal" style="font-weight: 700; margin-left: 4px;">External</label>
                        </div>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="control-label">Reference No <span id="mandatoryMarkEditReferenceNo" class="text-red" style="display: none">*</span></label>
                                <input class="form-control" id="editReferenceNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="control-label">Source <span id="mandatoryMarkEditSource" class="text-red" style="display: none">*</span></label>
                                <input class="form-control" id="editSource" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                            </div>
                            <div class="col-md-4 form-group checkbox-inline-group">
                                <input type="checkbox" id="editImpactToOtherDocument" name="editImpactToOtherDocument" value="IMP">
                                <label for="editImpactToOtherDocument" style="margin-left: 4px;">Impact To Other Document</label>
                                <i class="fa fa-info-circle" data-toggle="tooltip" data-placement="top" title="Check this if changes to this document also affect other related documents." style="margin-left:5px; color:#98A2B3;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sticky Footer -->
            <div class="modal-footer">
                <button type="button" class="btn dp-btn dp-btn-outline" id="btn_view_history_edit"><i class="fa fa-history"></i> View History</button>
                <div>
                    <button type="button" class="btn dp-btn dp-btn-outline" id="btn_cancel" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn dp-btn dp-btn-primary" id="btn_saveEdit"><i class="fa fa-save"></i> Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var $editDropzone = $('#editDropzone');
        var $editFileInput = $('#editDocumentUpload');

        $editDropzone.on('click', function () {
            $editFileInput.trigger('click');
        });

        $editDropzone.on('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $editDropzone.addClass('dragover');
        });

        $editDropzone.on('dragleave drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $editDropzone.removeClass('dragover');
        });

        $editDropzone.on('drop', function (e) {
            var files = e.originalEvent.dataTransfer.files;
            if (files && files.length) {
                $editFileInput[0].files = files;
                $editFileInput.trigger('change');
            }
        });

        $editFileInput.on('change', function () {
            var fileName = this.files && this.files.length ? this.files[0].name : '';
            if (fileName) {
                $('#editDropzoneText').html('<i class="fa fa-file-excel-o"></i> ' + fileName);
            } else {
                $('#editDropzoneText').html('Drag &amp; drop file here or <span class="dz-browse">click to browse</span>');
            }
        });

        $('#btn_preview_filepath').on('click', function (e) {
            e.preventDefault();
            if (gFilePath) {
                onViewAttachment(gFilePath, gDocumentId);
            }
        });

        $('#btn_download_filepath').on('click', function (e) {
            e.preventDefault();
            if (gFilePath) {
                onDownloadAttachment(gFilePath, gDocumentId);
            }
        });

        $('#btn_view_history_edit').on('click', function () {
            onHistoryPrepare();
        });
    });

    function updateEditCurrentFileDisplay(filePath) {
        var hasFile = filePath !== null && filePath !== undefined && filePath !== "";

        $('#editCurrentFileIcon, #editCurrentFileName, #btn_preview_filepath, #btn_download_filepath').toggle(hasFile);
        $('#editCurrentFileEmpty').toggle(!hasFile);

        if (hasFile) {
            var parts = filePath.split("/");
            $('#editCurrentFileName').text(parts[parts.length - 1]);
        }
    }

    // Same color coding as the grid's STATUS pill (_GridView.cshtml), applied
    // to the "Document Status" panel next to Document Information.
    function updateEditStatusPanel(data) {
        var status = data.STATUS;
        var cls = "adf-status-danger";
        var icon = "fa-times-circle";
        var hint = "This document was rejected. Update and resubmit for approval.";

        if (status == 0) {
            cls = "adf-status-info";
            icon = "fa-clock-o";
            hint = "Draft, not yet submitted for approval.";
        } else if (status == 4) {
            cls = "adf-status-default";
            icon = "fa-archive";
            hint = "";
        }

        $('#editStatusPanel')
            .removeClass("adf-status-info adf-status-success adf-status-warning adf-status-primary adf-status-default adf-status-danger")
            .addClass(cls);
        $('#editStatusIcon').attr("class", "fa " + icon);
        $('#editStatusText').text(data.STATUS_DISPLAY || "-");
        $('#editStatusHint').text(hint);
    }
</script>
