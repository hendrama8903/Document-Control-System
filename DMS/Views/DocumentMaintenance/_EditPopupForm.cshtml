            <!-- RECOMMIT DINA -->
<style>
    #modalEdit .modal-dialog {
        width: 760px;
        max-width: 96vw;
    }

    #modalEdit .modal-body {
        max-height: calc(100vh - 210px);
        overflow-y: auto;
        padding: 18px 24px 6px;
    }

    #modalEdit .form-group {
        margin-bottom: 14px;
    }

    #modalEdit .form-group > .control-label {
        display: block;
        margin-bottom: 4px;
        font-size: 12.5px;
    }

    #modalEdit .external-panel {
        border: 1px solid #DFE5EB;
        border-radius: 10px;
        padding: 14px 16px 2px;
        margin: 4px 0 8px;
        background: #F7F9FB;
    }

    #modalEdit .external-panel .panel-title {
        font-weight: 700;
        font-size: 12.5px;
        margin-bottom: 12px;
    }

    #modalEdit .checkbox-inline-group {
        padding-top: 26px;
    }
</style>

<div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modalEdit-title">Edit @ViewData["Title"]</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="control-label">Document No <span class="text-red">*</span></label>
                        <input class="form-control" id="editDocumentNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                        <input class="form-control" id="editDocumentId" type="hidden" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="control-label">Revision <span class="text-red">*</span></label>
                        <input class="form-control" id="editRevision" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="control-label">Document Name <span class="text-red">*</span></label>
                        <input class="form-control" id="editDocumentName" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="control-label">Date <span class="text-red">*</span></label>
                        <input class="form-control" id="editDate" type="date" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group has-feedback" id="inputContainer">
                            <label class="control-label">Document Upload <span class="text-red">*</span></label>
                            <div style="display: flex; align-items: flex-start; gap: 6px;">
                                <div id="editFileNameContainer" style="flex: 1; padding: 0;">
                                    <input type="file" class="filestyle" data-btnClass="btn-primary" id="editDocumentUpload" style="height: 31px;" accept=".xlsx,.xls">
                                </div>
                                <div>
                                    <button type="button" id="btn_delete_filepath" class="btn btn-danger" data-toggle="tooltip" data-placement="bottom" title="Remove Document"><i class="fa fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 form-group">
                        <label class="control-label">Remark</label>
                        <textarea class="form-control" rows="3" id="editRemark"></textarea>
                    </div>
                </div>

                <div class="external-panel">
                    <div class="panel-title">
                        <input type="checkbox" id="editExternal" name="editExternal">
                        <label for="editExternal" style="font-weight: 700; margin-left: 4px;">External</label>
                    </div>
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label class="control-label">Reference No <span id="mandatoryMarkEditReferenceNo" class="text-red" style="display: none">*</span></label>
                            <input class="form-control" id="editReferenceNo" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                        </div>
                        <div class="col-md-4 form-group">
                            <label class="control-label">Source <span id="mandatoryMarkEditSource" class="text-red" style="display: none">*</span></label>
                            <input class="form-control" id="editSource" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                        </div>
                        <div class="col-md-4 form-group checkbox-inline-group">
                            <input type="checkbox" id="editImpactToOtherDocument" name="editImpactToOtherDocument" value="IMP">
                            <label for="editImpactToOtherDocument" style="margin-left: 4px;">Impact To Other Document</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-primary" id="btn_saveEdit" style="width: 80px;">Save</button>
                    <button type="button" class="btn btn-danger" id="btn_cancel" data-dismiss="modal" style="width: 80px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
