<!-- RECOMMIT DINA -->
<div class="box-header dp-toolbar">
    <div class="dp-toolbar-left">
        @if ((bool)ViewData["Add"])
        {
            <button type="button" class="btn dp-btn dp-btn-primary" id="btn_add"><i class="fa fa-plus"></i> Add Document</button>
        }
        @if ((bool)ViewData["Edit"])
        {
            <button type="button" class="btn dp-btn dp-btn-outline" id="btn_edit"><i class="fa fa-pencil-square-o"></i> Edit</button>
        }
        @if ((bool)ViewData["Delete"])
        {
            <button type="button" class="btn dp-btn dp-btn-outline-danger" id="btn_delete"><i class="fa fa-trash-o"></i> Delete</button>
        }
        @if ((bool)ViewData["Approve"])
        {
            <button type="button" class="btn dp-btn dp-btn-outline-success" id="btn_approval"><i class="fa fa-check"></i> Approval</button>
        }
        <button type="button" class="btn dp-btn dp-btn-outline" id="btn_history" disabled><i class="fa fa-history"></i> History</button>
        <button type="button" class="btn dp-btn dp-btn-outline" id="btn_refresh"><i class="fa fa-refresh"></i> Refresh</button>
    </div>
    <div class="dp-toolbar-right">
        <button type="button" class="dp-icon-btn" id="btn_toggleFilters" title="Show/hide column filters"><i class="fa fa-filter"></i></button>
        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
        <button type="button" class="btn dp-btn dp-btn-outline" id="btn_download"><i class="fa fa-download"></i> Export</button>
    </div>
</div>
