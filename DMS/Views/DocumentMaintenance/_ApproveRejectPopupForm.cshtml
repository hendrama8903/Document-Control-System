<div class="modal fade" id="modalApproveReject" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" onclick="onclickClose()"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modalApproveReject-title"></h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <button type="button" class="btn btn-success" id="btn_approveApproval" style="width: 80px;">Approve</button>
                <button type="button" class="btn btn-reject" id="btn_rejectApproval" style="width: 80px;">Reject</button>
                <br />
                <br />
                <input class="form-control" id="approveRejectDocumentId" type="hidden" />
                <input class="form-control" id="approveRejectDocumentNo" type="hidden" />

                <table id="datagridApproval" class="table table-bordered table-condensed" width="100%">
                    <thead>
                        <tr>
                            <th class="text-center">Sequence</th>
                            <th class="text-center">Approver Name</th>
                            <th class="text-center">Department</th>
                            <th class="text-center">Section</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                </table>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
