<style>
    /* site.css forces .fa-chevron-up/-down to white globally (for a dark-background
       use elsewhere) - override back to the normal dp-icon-btn color for this button. */
    #btn_toggleStats i {
        color: #344054;
    }
</style>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="divTitle">
                <div class="dp-header">
                    <div class="dp-header-left">
                        <div class="dp-header-icon"><i class="fa fa-exchange"></i></div>
                        <div>
                            <h1>@ViewData["Title"]</h1>
                        </div>
                    </div>
                    <div class="dp-header-actions">
                        @if ((bool)ViewData["Reassign"])
                        {
                            <button type="button" class="dp-btn dp-btn-primary" id="btn_reassign" disabled><i class="fa fa-exchange"></i> Reassign Approver</button>
                        }
                        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
                        <button type="button" class="dp-icon-btn" id="btn_toggleStats" title="Hide Summary Cards"><i class="fa fa-chevron-up"></i></button>
                    </div>
                    <div class="dp-header-stats dp-header-stats-grid" id="rsStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-users"></i></div>
                            <div>
                                <span>Total Users</span>
                                <b id="rsStatTotal">-</b>
                                <small>All users</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-sitemap"></i></div>
                            <div>
                                <span>Divisions</span>
                                <b id="rsStatDivisions">-</b>
                                <small>Distinct divisions</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-building-o"></i></div>
                            <div>
                                <span>Departments</span>
                                <b id="rsStatDepartments">-</b>
                                <small>Distinct departments</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-id-badge"></i></div>
                            <div>
                                <span>Roles</span>
                                <b id="rsStatRoles">-</b>
                                <small>Distinct roles</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dp-card">
                <div id="divSearch">
                    @Html.Partial("_SearchCriteria")
                </div>
                <div id="divGrid">
                    @Html.Partial("_GridView")
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_PopupFormReassign")
@Html.Partial("_Javascript")
