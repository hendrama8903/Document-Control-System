<style>
    /* site.css forces .fa-chevron-up/-down to white globally (for a dark-background
       use elsewhere) - override back to the normal dp-icon-btn color for this button. */
    #btn_toggleStats i {
        color: #344054;
    }
</style>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="divTitle">
                <div class="dp-header">
                    <div class="dp-header-left">
                        <div class="dp-header-icon"><i class="fa fa-sort-numeric-asc"></i></div>
                        <div>
                            <h1>@ViewData["Title"]</h1>
                            <p>Manage the document sequence numbers currently used by the system.</p>
                        </div>
                    </div>
                    <div class="dp-header-actions">
                        @if ((bool)ViewData["Edit"])
                        {
                            <button type="button" class="dp-btn dp-btn-outline" id="btn_edit"><i class="fa fa-pencil-square-o"></i> Edit</button>
                        }
                        @if ((bool)ViewData["Reset"])
                        {
                            <button type="button" class="dp-btn dp-btn-outline-danger" id="btn_reset" title="Force set the counter to any number, bypassing the normal lower-value guard"><i class="fa fa-undo"></i> Reset</button>
                        }
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_export"><i class="fa fa-download"></i> Export Excel</button>
                        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
                        <button type="button" class="dp-icon-btn" id="btn_toggleStats" title="Hide Summary Cards"><i class="fa fa-chevron-up"></i></button>
                    </div>
                    <div class="dp-header-stats dp-header-stats-grid" id="msqStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-sort-numeric-asc"></i></div>
                            <div>
                                <span>Total Sequences</span>
                                <b id="msqStatTotal">-</b>
                                <small>All sequences</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-list"></i></div>
                            <div>
                                <span>Sequence Types</span>
                                <b id="msqStatTypes">-</b>
                                <small>Distinct types</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-hashtag"></i></div>
                            <div>
                                <span>Highest Counter</span>
                                <b id="msqStatHighest">-</b>
                                <small>Highest number used</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-calendar"></i></div>
                            <div>
                                <span>Last Updated</span>
                                <b id="msqStatLastUpdated" style="font-size:13px;">-</b>
                                <small>&nbsp;</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dp-card">
                <div id="divSearch">
                    @Html.Partial("_SearchCriteria")
                </div>
                <div id="divGrid">
                    @Html.Partial("_GridView")
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_PopupForm")
@Html.Partial("_Javascript")
