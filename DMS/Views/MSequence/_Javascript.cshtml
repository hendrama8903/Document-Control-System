<script type="text/javascript">
    var gSeqType = null;
    var gSeqCode = null;

    var gResetSeqType = null;
    var gResetSeqCode = null;
    var gResetCurrentSeqNo = null;

    $(document).ready(function() {
        $("#btn_edit").on("click", function() {
            onEditPrepare();
        });

        $("#btn_save").on("click", function() {
            confirmEditData();
        });

        $("#btn_reset").on("click", function() {
            onResetPrepare();
        });

        $("#btn_reset_save").on("click", function() {
            confirmResetData();
        });

        $("#resetConfirmText").on("input", function() {
            $("#btn_reset_save").prop("disabled", $(this).val() !== "RESET");
        });

        $("#modalReset").on("hidden.bs.modal", function() {
            $("#resetConfirmText").val("");
            $("#btn_reset_save").prop("disabled", true);
        });

        $("#btn_export").on("click", function () {
            window.location.href = "@Url.Action("DownloadExcel", "MSequence")";
        });

        function setStatsPanelCollapsed(collapsed) {
            var $row = $("#dpLayoutRow");
            var $icon = $("#btn_toggleStats i");

            $row.toggleClass("stats-collapsed", collapsed);
            $icon.toggleClass("fa-angle-double-right", !collapsed).toggleClass("fa-angle-double-left", collapsed);
            $("#btn_toggleStats").attr("title", collapsed ? "Show Summary" : "Hide Summary");

            setTimeout(function () {
                $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
            }, 230);
        }

        $("#btn_toggleStats").on("click", function () {
            setStatsPanelCollapsed(!$("#dpLayoutRow").hasClass("stats-collapsed"));
        });

        $("#btn_closeStatsPanel").on("click", function () {
            setStatsPanelCollapsed(true);
        });
    });

    function onSearch() {
        var grid = $("#datagrid").dxDataGrid("instance");
        grid.clearSelection();
        grid.refresh();
    }

    function onEditPrepare() {
        var row = getSelectedRowData();
        if (row == null) {
            return;
        }

        gSeqType = row.SEQ_TYPE;
        gSeqCode = row.SEQ_CODE;

        $.ajax({
            type: "POST",
            url: "@Url.Action("GetByKey", "MSequence")",
            async: false,
            data: {
                SEQ_TYPE: gSeqType,
                SEQ_CODE: gSeqCode
            },
            success: function(result) {
                if (result.status == true) {
                    var data = result.data;

                    $('#modal-title').html("Edit Document Numbering");
                    $('#editSeqCode').val(data.SEQ_CODE);
                    $('#editSeqType').val(data.SEQ_TYPE);
                    $('#editSeqNo').val(data.SEQ_NO).attr("min", data.SEQ_NO);

                    $("#modalAddEdit").modal();
                    $('#modalAddEdit').on('shown.bs.modal', function() {
                        $('#editSeqNo').focus();
                    });
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function(result) {
                showErrorMesgGrowl(result);
            }
        });
    }

    function confirmEditData() {
        showConfirmMesg("Are you sure you want to continue process?", editData, "Confirmation");
    }

    function editData() {
        popUpProgressShow();

        $.ajax({
            type: "POST",
            url: "@Url.Action("Update", "MSequence")",
            dataType: 'json',
            data: {
                OLD_SEQ_TYPE: gSeqType,
                OLD_SEQ_CODE: gSeqCode,
                SEQ_TYPE: $('#editSeqType').val(),
                SEQ_CODE: $('#editSeqCode').val(),
                SEQ_NO: $('#editSeqNo').val()
            },
            success: function(result) {
                if (result.status == true) {
                    showSuccessMesgGrowl(result.message);
                    onSearch();
                    popUpProgressHide();
                    $("#modalAddEdit").modal('hide');
                } else {
                    showErrorMesgGrowl(result.message);
                    popUpProgressHide();
                }
            },
            error: function(result) {
                showErrorMesgGrowl(result);
                popUpProgressHide();
            }
        });
    }

    function onResetPrepare() {
        var row = getSelectedRowData();
        if (row == null) {
            return;
        }

        gResetSeqType = row.SEQ_TYPE;
        gResetSeqCode = row.SEQ_CODE;

        $.ajax({
            type: "POST",
            url: "@Url.Action("GetByKey", "MSequence")",
            async: false,
            data: {
                SEQ_TYPE: gResetSeqType,
                SEQ_CODE: gResetSeqCode
            },
            success: function(result) {
                if (result.status == true) {
                    var data = result.data;
                    gResetCurrentSeqNo = data.SEQ_NO;

                    $('#resetSeqCode').val(data.SEQ_CODE);
                    $('#resetSeqType').val(data.SEQ_TYPE);
                    $('#resetSeqNoCurrent').val(data.SEQ_NO);
                    $('#resetSeqNoNew').val(data.SEQ_NO);
                    $('#resetConfirmText').val("");
                    $('#btn_reset_save').prop("disabled", true);

                    $("#modalReset").modal();
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function(result) {
                showErrorMesgGrowl(result);
            }
        });
    }

    function confirmResetData() {
        var newSeqNo = $('#resetSeqNoNew').val();
        showConfirmMesg(
            "You are about to force the number \"" + gResetSeqCode + "\" from " + gResetCurrentSeqNo + " to " + newSeqNo +
            ". If this number is lower than the highest number already used, the system may generate a duplicate document code. Continue?",
            resetData,
            "Confirmation"
        );
    }

    function resetData() {
        popUpProgressShow();

        $.ajax({
            type: "POST",
            url: "@Url.Action("Reset", "MSequence")",
            dataType: 'json',
            data: {
                SEQ_TYPE: gResetSeqType,
                SEQ_CODE: gResetSeqCode,
                SEQ_NO: $('#resetSeqNoNew').val()
            },
            success: function(result) {
                if (result.status == true) {
                    showSuccessMesgGrowl(result.message);
                    onSearch();
                    popUpProgressHide();
                    $("#modalReset").modal('hide');
                } else {
                    showErrorMesgGrowl(result.message);
                    popUpProgressHide();
                }
            },
            error: function(result) {
                showErrorMesgGrowl(result);
                popUpProgressHide();
            }
        });
    }
</script>
