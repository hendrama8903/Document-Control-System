<div class="modal fade" id="modalAddEdit" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modal-title">Edit @ViewData["Title"]</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 form-horizontal" style="margin-top:15px; margin-left:15px">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Sequence Code<span class="text-red"> *</span></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="editSeqCode" type="text" />
                                        <p class="help-block" style="margin-top:6px;">Changing this moves the counter to the new prefix - the old prefix will start over from 1 the next time the system uses it.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Type<span class="text-red"> *</span></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="editSeqType" type="text" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Last Number Used<span class="text-red"> *</span></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="editSeqNo" type="number" min="0" />
                                        <p class="help-block" style="margin-top:6px;">The next number the system will generate is this value + 1. It cannot be changed to a number lower than what is currently stored.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-primary" id="btn_save" style="width: 80px;">Save</button>
                    <button type="button" class="btn btn-danger" id="btn_cancel" data-dismiss="modal" style="width: 80px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalReset" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title"><i class="fa fa-exclamation-triangle text-red"></i> Force Reset Number</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="alert alert-danger" style="margin: 0 15px 15px 15px;">
                    <strong>Warning:</strong> This action bypasses the normal safeguard and can cause the system to generate a
                    document code that has <u>already been used</u> if the number is lowered below a number that
                    was already used. Only use this if you are sure no document has used that number yet.
                </div>
                <div class="row">
                    <div class="col-lg-12 form-horizontal" style="margin-left:15px">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Sequence Code</label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="resetSeqCode" type="text" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Type</label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="resetSeqType" type="text" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Current Number</label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="resetSeqNoCurrent" type="text" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">New Number<span class="text-red"> *</span></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="resetSeqNoNew" type="number" min="0" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Confirmation<span class="text-red"> *</span></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="resetConfirmText" type="text" placeholder="Type RESET to enable Save" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-danger" id="btn_reset_save" style="width: 80px;" disabled>Save</button>
                    <button type="button" class="btn btn-default" id="btn_reset_cancel" data-dismiss="modal" style="width: 80px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
