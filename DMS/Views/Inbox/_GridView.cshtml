<link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
<script src="~/js/devextreme/dx.web.js"></script>

<style>
    /* pastikan editor filter row terlihat jelas (hindari bentrok styling tema) */
    #datagrid .dx-datagrid-filter-row .dx-texteditor {
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fff;
    }

    #datagrid .dx-datagrid-filter-row .dx-texteditor-input {
        padding: 5px 8px;
        min-height: 28px;
    }

    /* tampilkan judul kolom penuh (wrap), jangan terpotong "..." */
    #datagrid .dx-datagrid-headers .dx-header-row td .dx-datagrid-text-content {
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.3;
    }

    #datagrid .dx-data-row.ib-unread-row { background: #F5F9FF; }
    #datagrid .dx-data-row.ib-unread-row:hover > td { background: #E7F1FB; }

    .ib-title-cell { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    .ib-unread-dot { width: 7px; height: 7px; border-radius: 50%; background: #2450D8; flex: none; }
    .ib-title-cell.ib-read .ib-unread-dot { visibility: hidden; }
    .ib-title-cell b { color: #1D2939; }
    .ib-title-cell.ib-read b { color: #475467; font-weight: 600; }

    .ib-msg-cell { color: #66788A; white-space: normal; }

    .ib-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }
    .ib-status-pill.unread { background: #E7F1FB; color: #2450D8; }
    .ib-status-pill.read { background: #EEF0F2; color: #5A5F66; }
</style>

<div class="box-body">
    <div id="datagrid"></div>
</div>

<script type="text/javascript">
    function getSelectedRowData() {
        var rows = $("#datagrid").dxDataGrid("instance").getSelectedRowsData();
        return rows.length > 0 ? rows[0] : null;
    }

    function computeGridHeight() {
        var gridTop = $("#datagrid").offset().top;
        var footerHeight = $("#divFooter").outerHeight(true) || 0;

        return Math.max(300, $(window).height() - gridTop - footerHeight - 40);
    }

    function ibRenderStats(data) {
        var total = data.length;
        var unread = data.filter(function (r) { return r.STATUS == "0"; }).length;

        $("#ibStatTotal").text(total);
        $("#ibStatUnread").text(unread);
        $("#ibStatRead").text(total - unread);
    }

    $(document).ready(function () {
        var gridStore = new DevExpress.data.CustomStore({
            key: "NOTIFICATION_ID",
            loadMode: "raw",
            load: function () {
                var d = $.Deferred();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Search", "Inbox")"
                }).done(function (result) {
                    var data = result.status == true ? result.data : [];
                    ibRenderStats(data);
                    d.resolve(data);
                }).fail(function () {
                    d.reject("Data loading error");
                });

                return d.promise();
            }
        });

        $("#datagrid").dxDataGrid({
            dataSource: gridStore,
            showBorders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            wordWrapEnabled: false,
            sorting: { mode: "none" },
            noDataText: "No notifications yet.",
            height: computeGridHeight(),
            filterRow: { visible: false, applyFilter: "auto" },
            headerFilter: { visible: true },
            searchPanel: { visible: false, highlightCaseSensitive: false },
            toolbar: { visible: false },
            selection: { mode: "none" },
            paging: { pageSize: 10 },
            pager: {
                visible: true,
                displayMode: "compact",
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true,
                showNavigationButtons: true
            },
            columnChooser: {
                enabled: true,
                mode: "select"
            },
            columnFixing: { enabled: true },
            onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data.STATUS == "0") {
                    e.rowElement.addClass("ib-unread-row");
                }
            },
            columns: [
                {
                    caption: "No",
                    width: 50,
                    alignment: "center",
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex();
                        var pageSize = options.component.pageSize();
                        container.text(pageIndex * pageSize + options.row.rowIndex + 1);
                    }
                },
                {
                    caption: "Status",
                    dataField: "STATUS",
                    width: 100,
                    calculateCellValue: function (row) {
                        return row.STATUS == "0" ? "Unread" : "Read";
                    },
                    cellTemplate: function (container, options) {
                        var unread = options.data.STATUS == "0";
                        $("<span>").addClass("ib-status-pill " + (unread ? "unread" : "read")).text(unread ? "Unread" : "Read").appendTo(container);
                    }
                },
                {
                    dataField: "NOTIFICATION_TITLE",
                    caption: "Title",
                    minWidth: 180,
                    cellTemplate: function (container, options) {
                        var row = options.data;
                        var unread = row.STATUS == "0";
                        var $cell = $("<div>").addClass("ib-title-cell").toggleClass("ib-read", !unread);
                        $("<span>").addClass("ib-unread-dot").appendTo($cell);
                        $("<b>").text(row.NOTIFICATION_TITLE || "").appendTo($cell);
                        $cell.on("click", function () { ibOpenNotification(row); });
                        $cell.appendTo(container);
                    }
                },
                {
                    dataField: "NOTIFICATION_TEXT",
                    caption: "Message",
                    minWidth: 260,
                    cellTemplate: function (container, options) {
                        $("<div>").addClass("ib-msg-cell").html(options.data.NOTIFICATION_TEXT || "").appendTo(container);
                    }
                },
                {
                    dataField: "NOTIFICATION_DATE",
                    caption: "Date",
                    alignment: "right",
                    width: 150,
                    cellTemplate: function (container, options) {
                        var value = options.data.NOTIFICATION_DATE;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY HH:mm") : "");
                    }
                },
                {
                    caption: "Action",
                    alignment: "center",
                    width: 70,
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<button>")
                            .attr({ type: "button", title: "More actions" })
                            .addClass("dp-act-kebab")
                            .html('<i class="fa fa-ellipsis-v"></i>')
                            .on("click", function (e) {
                                e.stopPropagation();
                                openRowActionMenu($(this), row);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });

        $("#btn_columns").on("click", function () {
            $("#datagrid").dxDataGrid("instance").showColumnChooser();
        });

        // ---------- toolbar: show/hide column filter row ("More Filters") ----------
        $("#btn_toggleFilters").on("click", function () {
            var grid = $("#datagrid").dxDataGrid("instance");
            var visible = !grid.option("filterRow.visible");
            grid.option("filterRow.visible", visible);
            $(this).toggleClass("active", visible);
        });

        // ---------- toolbar: reset ----------
        $("#btn_resetFilters").on("click", function () {
            var grid = $("#datagrid").dxDataGrid("instance");
            grid.clearFilter();
        });

        // ---------- toolbar: refresh ----------
        $("#btn_refresh").on("click", function () {
            $("#datagrid").dxDataGrid("instance").refresh();
        });

        $("#btn_markAllRead").on("click", function () {
            $.ajax({
                type: "POST",
                url: "@Url.Action("MarkAllRead", "Inbox")"
            }).done(function (result) {
                if (result.status == true) {
                    $("#datagrid").dxDataGrid("instance").refresh();
                    if (typeof GetListNotif === "function") { GetListNotif(); }
                } else {
                    showErrorMesgGrowl(result.message);
                }
            });
        });

        // ---------- toolbar: clear all notifications (permanent, not soft delete) ----------
        $("#btn_clearAll").on("click", function () {
            showConfirmMesg("Are you sure you want to clear all notifications? This cannot be undone.", function () {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("ClearAll", "Inbox")"
                }).done(function (result) {
                    if (result.status == true) {
                        $("#datagrid").dxDataGrid("instance").refresh();
                        if (typeof GetListNotif === "function") { GetListNotif(); }
                    } else {
                        showErrorMesgGrowl(result.message);
                    }
                });
            }, "Confirmation");
        });

        $(window).on("resize", function () {
            $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
        });

        $('body').tooltip({ selector: '[data-toggle="tooltip"]' });
    });

    // ---------- open a notification: mark as read (if needed) then navigate ----------
    function ibOpenNotification(row) {
        if (row.STATUS == "0") {
            $.ajax({
                type: "POST",
                url: "@Url.Action("MarkRead", "Inbox")",
                data: { notificationId: row.NOTIFICATION_ID, status: "1" }
            }).always(function () {
                if (typeof GetListNotif === "function") { GetListNotif(); }
                if (row.NOTIFICATION_URL) { window.location.href = row.NOTIFICATION_URL; }
            });
        } else if (row.NOTIFICATION_URL) {
            window.location.href = row.NOTIFICATION_URL;
        }
    }

    // ---------- per-row "more actions" kebab menu ----------
    var $ibRowMenu = null;

    function buildRowActionMenu() {
        if ($ibRowMenu) return $ibRowMenu;

        $ibRowMenu = $('<ul class="dropdown-menu dp-dropdown-menu" role="menu"></ul>')
            .css({ position: "absolute", display: "none", "z-index": 2000, "min-width": "170px" })
            .appendTo("body");

        $(document).on("click", function () {
            $ibRowMenu.hide();
        });

        return $ibRowMenu;
    }

    function menuItem(cssClass, icon, label, onClick) {
        var $li = $('<li><a href="#" class="' + cssClass + '"><i class="fa ' + icon + '"></i> ' + label + '</a></li>');
        $li.find("a").on("click", function (e) {
            e.preventDefault();
            $ibRowMenu.hide();
            onClick();
        });
        return $li;
    }

    function ibSetStatus(row, status) {
        $.ajax({
            type: "POST",
            url: "@Url.Action("MarkRead", "Inbox")",
            data: { notificationId: row.NOTIFICATION_ID, status: status }
        }).done(function (result) {
            if (result.status == true) {
                $("#datagrid").dxDataGrid("instance").refresh();
                if (typeof GetListNotif === "function") { GetListNotif(); }
            } else {
                showErrorMesgGrowl(result.message);
            }
        });
    }

    function openRowActionMenu($btn, row) {
        var $menu = buildRowActionMenu();
        $menu.empty();

        $menu.append(menuItem("dp-menu-preview", "fa-external-link", "Open", function () {
            ibOpenNotification(row);
        }));

        if (row.STATUS == "0") {
            $menu.append(menuItem("dp-menu-edit", "fa-check-circle-o", "Mark as Read", function () {
                ibSetStatus(row, "1");
            }));
        } else {
            $menu.append(menuItem("dp-menu-edit", "fa-envelope-o", "Mark as Unread", function () {
                ibSetStatus(row, "0");
            }));
        }

        var offset = $btn.offset();
        $menu.css({ top: offset.top + $btn.outerHeight() + 4, left: offset.left - $menu.outerWidth() + $btn.outerWidth() })
            .show();
    }
</script>
