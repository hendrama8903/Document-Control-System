@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>DMS - @ViewData["Title"]</title>
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css">
    <!-- Google Font -->
    <link rel="stylesheet" href="~/lib/google-font/google-font.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Slick -->
    <link rel="stylesheet" href="~/lib/slick-1.8.1/slick/slick.css" />
    <link rel="stylesheet" href="~/lib/slick-1.8.1/slick/slick-theme.css" />
    <style>
        :root {
            --primary: #0078D4;
            --primary-2: #106EBE;
            --accent: #2B88D8;
            --navy: #004578;
            --gold: #B8860B;
            --paper: #F7F9FB;
            --ink: #16212B;
            --muted: #66788A;
            --line: #E3E8EE;
            --field: #F0F3F6;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
            color: var(--ink);
            font-size: 14px;
            -webkit-font-smoothing: antialiased;
            background: #fff;
        }

        .lg-wrap {
            position: relative;
            height: 100vh;
            min-height: 560px;
            display: flex;
            overflow: hidden;
        }

        /* ---------- panel kiri: form ---------- */
        .lg-form {
            position: relative;
            z-index: 2;
            flex: 1 1 42%;
            min-width: 360px;
            max-width: 760px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 64px 76px;
            background: #fff;
            overflow-y: auto;
        }

        .lg-form-inner {
            width: 100%;
            max-width: 460px;
        }

        .lg-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 40px;
        }

        .lg-brand img {
            height: 40px;
            width: auto;
        }

        .lg-brand .name {
            font-size: 15px;
            font-weight: 800;
            color: var(--primary);
            line-height: 1.25;
        }

        .lg-brand .tag {
            font-size: 11.5px;
            color: var(--muted);
            font-weight: 500;
        }

        .lg-welcome {
            font-size: 17px;
            color: var(--muted);
            font-weight: 500;
            margin-bottom: 4px;
        }

        .lg-wordmark-wrap {
            margin-bottom: 20px;
        }

        .lg-wordmark {
            display: block;
            font-size: 56px;
            font-weight: 800;
            letter-spacing: -.02em;
            line-height: 1.1;
            background: linear-gradient(90deg, var(--gold), var(--primary) 45%, var(--navy));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .lg-wordmark-wrap .pill {
            display: inline-block;
            margin-top: 8px;
            background: var(--gold);
            color: #fff;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .04em;
            padding: 5px 14px;
            border-radius: 20px;
            white-space: nowrap;
            box-shadow: 0 6px 14px -4px rgba(184,134,11,.45);
        }

        .lg-sub {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 28px;
        }

        .lg-divider {
            height: 1px;
            background: var(--line);
            margin-bottom: 24px;
        }

        .lg-field {
            margin-bottom: 14px;
        }

        .lg-field label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 6px;
        }

        .lg-input {
            position: relative;
        }

        .lg-input input.form-control {
            height: 44px;
            padding: 8px 44px 8px 16px;
            border-radius: 10px;
            border: 1px solid transparent;
            background: var(--field);
            box-shadow: none;
            font-size: 14px;
            color: var(--ink);
            transition: .15s;
        }

        .lg-input input.form-control::placeholder {
            color: #97A5B2;
        }

        .lg-input input.form-control:focus {
            outline: none;
            background: #fff;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(43,136,216,.15);
        }

        .lg-eye {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 32px;
            height: 32px;
            border: none;
            background: none;
            color: #97A5B2;
            border-radius: 7px;
            cursor: pointer;
        }

        .lg-eye:hover { color: var(--primary); }

        .btn-signin {
            width: 100%;
            height: 46px;
            margin-top: 10px;
            border: 2px solid var(--primary);
            border-radius: 10px;
            background: #fff;
            color: var(--primary);
            font-size: 14.5px;
            font-weight: 700;
            letter-spacing: .02em;
            transition: .15s;
        }

        .btn-signin:hover, .btn-signin:focus {
            background: var(--primary);
            color: #fff;
        }

        .btn-signin[disabled] { opacity: .7; }

        .lg-foot {
            margin-top: 24px;
            font-size: 11px;
            color: var(--muted);
        }

        /* ---------- panel kanan: foto ---------- */
        .lg-side-wrap {
            position: relative;
            z-index: 1;
            flex: 1 1 58%;
            overflow: hidden;
        }

        .lg-side {
            position: absolute;
            inset: 0;
            overflow: hidden;
            background: linear-gradient(180deg, var(--primary-2), var(--navy));
        }

        .lg-side-mask {
            position: absolute;
            inset: 0;
            z-index: 6;
            pointer-events: none;
        }

        .lg-side .slider,
        .lg-side .slick-list,
        .lg-side .slick-track,
        .lg-side .slick-slide,
        .lg-side .slick-slide > div {
            height: 100%;
        }

        .lg-side .slick-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .lg-side .slick-dots {
            bottom: 26px;
        }

        .lg-side .slick-dots li button:before {
            font-size: 9px;
            color: #fff;
            opacity: .5;
        }

        .lg-side .slick-dots li.slick-active button:before {
            opacity: 1;
            color: var(--gold);
        }

        /* ---------- responsive ---------- */
        @@media (max-width: 860px) {
            .lg-side-wrap { display: none; }

            .lg-wrap { height: auto; min-height: 100vh; }

            .lg-form {
                max-width: 100%;
                padding: 40px 28px;
            }

            .lg-wordmark { font-size: 44px; }
        }
    </style>
</head>
<body>
    <div class="lg-wrap">

        <!-- panel kiri: form login -->
        <div class="lg-form">
            <div class="lg-form-inner">
                <div class="lg-brand">
                    <img src="~/dist/img/Hino-logo.png" alt="Hino">
                    <div>
                        <div class="name">Hino Motors Manufacturing Indonesia</div>
                        <div class="tag">Kawasan Industri Kota Bukit Indah, Purwakarta</div>
                    </div>
                </div>

                <div class="lg-welcome">Selamat datang di</div>
                <div class="lg-wordmark-wrap">
                    <span class="lg-wordmark">DMS</span>
                    <span class="pill">Document Management System</span>
                </div>
                <div class="lg-sub">Sign in to your account to continue.</div>

                <div class="lg-divider"></div>

                <div class="lg-field">
                    <label for="username">Username</label>
                    <div class="lg-input">
                        <input type="text" class="form-control" id="username" placeholder="Enter your username" autocomplete="username" autofocus>
                    </div>
                </div>

                <div class="lg-field">
                    <label for="password">Password</label>
                    <div class="lg-input">
                        <input type="password" class="form-control" id="password" placeholder="Enter your password" autocomplete="current-password">
                        <button type="button" class="lg-eye" onclick="togglePassword()" tabindex="-1" title="Show / hide password">
                            <i class="fa fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <button id="btn_login" type="submit" class="btn-signin" data-loading-text="Signing in..." onclick="Validate()">
                    Sign In
                </button>

                <div class="lg-foot">2026 &copy; Hino Motors Manufacturing Indonesia</div>
            </div>
        </div>

        <!-- panel kanan: slider foto (tepi kiri melengkung) -->
        <div class="lg-side-wrap">
            <div class="lg-side">
                <div class="slider">
                    <div><img src="~/dist/img/slider-1.jpg" title="HINO300 Dutro"></div>
                    <div><img src="~/dist/img/slider-2.jpg" title="HINO500 Ranger"></div>
                    <div><img src="~/dist/img/slider-3.jpg" title="HINO700 Profia"></div>
                    <div><img src="~/dist/img/slider-4.jpg" title="HINO Bus"></div>
                </div>
            </div>

            <!-- tepi lengkung (mask putih) + ornamen garis gold, satu path yang sama persis -->
            <svg class="lg-side-mask" viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M10,0 C34,24 34,76 10,100 L0,100 L0,0 Z" fill="#fff" />
                <path d="M10,0 C34,24 34,76 10,100" fill="none" stroke="#D9A73B" stroke-width="1.4" vector-effect="non-scaling-stroke" />
            </svg>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/lib/bootstrap-growl/jquery.bootstrap-growl.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/lib/slick-1.8.1/slick/slick.min.js"></script>

    <script>

        $(document).ready(function(){

            $('.slider').slick({
                dots: true,
                arrows: false,
                infinite: true,
                autoplay: true,
                autoplaySpeed: 5000,
                fade: true,
                speed: 900
            });

            $('#password').keypress(function (e) {
                if (e.which == 13) {
                    Validate();
                    return false;
                }
            });
        });

        function togglePassword() {
            var input = document.getElementById('password');
            var icon = document.getElementById('eyeIcon');
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.className = show ? 'fa fa-eye-slash' : 'fa fa-eye';
        }

        function Validate() {
            $("#btn_login").button("loading");
            $.ajax(
            {
                type: "POST",
                url: '@Url.Action("Validate", "Auth")',
                data: {
                    USERNAME: $('#username').val(),
                    PASSWORD: $('#password').val(),
                        param: '@ViewData["ParamURL"]'
                },
                error: function (result) {
                    $("#btn_login").button("reset");

                    if (result.responseText) {
                        $.bootstrapGrowl(result.responseText, {
                            type: 'danger',
                            allow_dismiss: true,
                            align: 'right',
                            delay: 0
                        });
                    }
                },
                success: function (result) {
                    console.log(result);
                    $("#btn_login").button("reset");
                    if (result.status == true) {
                            if (result.data != null) {
                                window.location.href = result.data;
                            } else {
                                window.location.href = '@Url.Action("Index", "Home")';
                            }
                    }
                    else {
                        showErrorMesgGrowl(result.message);
                    }
                }
            });
        }

    </script>
</body>
</html>
