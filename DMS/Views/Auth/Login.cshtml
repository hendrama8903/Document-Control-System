@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Document Control System | Login</title>
<link href="~/css/fonts.css" rel="stylesheet">
<style>
  :root{
    --primary-blue:#1455D9;
    --dark-blue:#0E3FA5;
    --accent-cyan:#2EC5E6;
    --light-blue:#EAF2FF;
    --text-dark:#0B1B3A;
    --text-secondary:#64748B;
    --line:#E3E8EF;
    --field-bg:#F5F8FE;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html, body{height:100%; width:100%;}
  body{
    font-family:'Inter', sans-serif;
    color:var(--text-dark);
    min-height:100vh;
    background-color:#EAF2FE;
    background-image:url('@Url.Content("~/images/logo_bg.png")');
    background-repeat:no-repeat;
    background-position:center center;
    background-size:cover;
    background-attachment:fixed;
    overflow-x:hidden;
  }

  .page-wrap{
    position:relative;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:clamp(24px,4.4vh,48px) 20px 32px;
  }

  /* ---------- brand header ---------- */
  .brand-header{
    position:relative;
    z-index:2;
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
    margin-bottom:clamp(18px,3.4vh,30px);
    animation:fadeUp .5s cubic-bezier(.2,.7,.3,1) both;
  }
  .brand-header img{
    height:clamp(84px,12vh,120px);
    width:auto;
    object-fit:contain;
    margin-bottom:clamp(12px,2.2vh,18px);
  }
  .brand-header h1{
    font-family:'Poppins',sans-serif;
    font-weight:700;
    font-size:clamp(17px,2.4vh,23px);
    color:var(--text-dark);
    letter-spacing:.2px;
  }
  .brand-header h1 .accent{color:var(--primary-blue);}
  .brand-header p{
    margin-top:6px;
    font-size:clamp(12px,1.5vh,13.5px);
    color:var(--text-secondary);
  }

  @@keyframes fadeUp{
    from{opacity:0; transform:translateY(10px);}
    to{opacity:1; transform:translateY(0);}
  }
  @@keyframes cardIn{
    from{opacity:0; transform:translateY(14px);}
    to{opacity:1; transform:translateY(0);}
  }

  /* ---------- middle: login card, centered ---------- */
  .content-row{
    position:relative;
    z-index:2;
    width:100%;
    max-width:360px;
  }

  /* ---------- the sign-in card itself ---------- */
  .card{
    width:100%;
    background:#ffffff;
    border-radius:10px;
    padding:clamp(32px,4.4vh,42px) clamp(20px,2.6vw,26px) clamp(64px,8.6vh,80px);
    box-shadow:0 30px 70px -20px rgba(11,27,58,.22), 0 2px 8px rgba(11,27,58,.06);
    border:1px solid rgba(20,85,217,.06);
    position:relative;
    z-index:3;
    animation:cardIn .5s cubic-bezier(.2,.7,.3,1) both .1s;
  }
  .card .brand-icon{display:flex; justify-content:center; margin-bottom:10px;}
  .card .brand-icon span{
    width:46px; height:46px;
    border-radius:50%;
    background:linear-gradient(135deg, var(--light-blue), #DCE7FB);
    display:flex; align-items:center; justify-content:center;
  }
  .card .brand-icon img{width:27px; height:27px; object-fit:contain;}

  .card h2{
    font-family:'Poppins',sans-serif;
    font-size:clamp(18px,2.4vh,21px);
    font-weight:700;
    color:var(--text-dark);
    text-align:center;
    margin-bottom:4px;
  }
  .card > p.sub{
    font-size:clamp(11.5px,1.5vh,12.5px);
    color:var(--text-secondary);
    text-align:center;
    margin-bottom:clamp(14px,2.2vh,18px);
  }
  label{
    display:block;
    font-size:12.5px;
    font-weight:600;
    color:var(--text-dark);
    margin-bottom:6px;
  }
  .field{margin-bottom:clamp(10px,1.6vh,14px);}
  .input-group{position:relative; display:flex; align-items:center;}
  .input-group svg.leading{position:absolute; left:13px; width:16px; height:16px; color:#A7AEC0; transition:color .15s ease;}
  .input-group svg.trailing{position:absolute; right:13px; width:17px; height:17px; color:#A7AEC0; cursor:pointer;}
  .input-group:focus-within svg.leading{color:var(--primary-blue);}
  input[type=text], input[type=email], input[type=password]{
    width:100%;
    padding:clamp(10px,1.9vh,12px) 14px clamp(10px,1.9vh,12px) 42px;
    border:1.5px solid transparent;
    background:var(--field-bg);
    border-radius:12px;
    font-size:13.5px;
    font-family:'Inter',sans-serif;
    color:var(--text-dark);
    outline:none;
    transition:border-color .15s ease, box-shadow .15s ease, background .15s ease;
  }
  input::placeholder{color:#A7AEC0;}
  input:hover{background:#EFF4FE;}
  input:focus{
    background:#ffffff;
    border-color:var(--primary-blue);
    box-shadow:0 0 0 4px rgba(20,85,217,.12);
  }
  input#password{padding-right:40px;}

  .btn-login{
    margin-top:clamp(4px,1vh,8px);
    width:100%;
    padding:clamp(11px,1.9vh,13px);
    border:none;
    border-radius:12px;
    background:linear-gradient(135deg, var(--primary-blue), var(--dark-blue) 75%);
    background-size:160% 160%;
    background-position:0% 50%;
    color:#fff;
    font-size:14px;
    font-weight:600;
    font-family:'Inter',sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    cursor:pointer;
    box-shadow:0 12px 20px -8px rgba(14,63,165,.55);
    transition:transform .15s ease, box-shadow .15s ease, background-position .3s ease;
  }
  .btn-login:hover{transform:translateY(-2px); box-shadow:0 18px 30px -10px rgba(14,63,165,.6); background-position:100% 50%;}
  .btn-login:active{transform:translateY(0); box-shadow:0 10px 16px -8px rgba(14,63,165,.55);}
  .btn-login svg{width:15px; height:15px;}

  /* growl notification (login failed/success/info) */
  .bootstrap-growl{
    font-family:'Inter', sans-serif;
    font-size:13px;
    font-weight:500;
    line-height:1.4;
    padding:12px 34px 12px 16px;
    border-radius:10px;
    border:1px solid transparent;
    box-shadow:0 14px 30px -10px rgba(14,63,165,.35);
  }
  .bootstrap-growl.alert-danger{background:#fdecec; border-color:#f5c2c2; color:#a12b2b;}
  .bootstrap-growl.alert-success{background:#e8f8f0; border-color:#b7e6cc; color:#1a7a4c;}
  .bootstrap-growl.alert-info{background:var(--light-blue); border-color:#c7d9f7; color:var(--dark-blue);}
  .bootstrap-growl .close{
    position:absolute; top:8px; right:10px;
    font-size:16px; line-height:1; color:inherit; opacity:.55;
    cursor:pointer; background:none; border:none;
  }
  .bootstrap-growl .close:hover{opacity:1;}

  /* ===== responsive: tablet & phone ===== */
  @@media (max-width: 768px){
    /* background-attachment:fixed is buggy/janky on mobile browsers (esp. iOS Safari) */
    body{background-attachment:scroll;}
  }
  @@media (max-width: 600px){
    .page-wrap{padding:20px 16px 24px;}
    .brand-header{margin-bottom:16px;}
    .brand-header img{height:56px; margin-bottom:10px;}
    .brand-header h1{font-size:16px;}
    .brand-header p{font-size:11.5px;}
    .content-row{max-width:100%;}
    .card{padding:26px 18px 30px; border-radius:10px;}
    .card .brand-icon span{width:42px; height:42px;}
    .card .brand-icon img{width:24px; height:24px;}
    .card h2{font-size:18px;}
  }
  /* short viewport (landscape phones) - trim vertical spacing so form stays reachable */
  @@media (max-height: 500px){
    .page-wrap{padding-top:14px; padding-bottom:14px;}
    .brand-header{margin-bottom:10px;}
    .brand-header img{height:44px; margin-bottom:6px;}
    .brand-header p{display:none;}
    .card{padding:18px 18px 20px;}
    .card .brand-icon{margin-bottom:4px;}
    .card > p.sub{margin-bottom:10px;}
    .field{margin-bottom:8px;}
  }
</style>
</head>
<body>
<div class="page-wrap">
  <div class="brand-header">
    <img src="~/images/logo_dcs.png" alt="Document Control System">
  </div>

  <div class="content-row">
    <div class="login-col">
      <div class="card">
        <div class="brand-icon"><span><img src="~/images/logo.png" alt="DCS icon"></span></div>

        <h2>Welcome Back!</h2>
        <p class="sub">Sign in to access your account</p>

        <form id="loginForm">
          <div class="field">
            <label for="username">Username</label>
            <div class="input-group">
              <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
              <input type="text" id="username" name="username" placeholder="Enter your username" autocomplete="username" required>
            </div>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <div class="input-group">
              <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
              <svg class="trailing" id="togglePw" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
          </div>

          <button type="submit" class="btn-login" id="btn_login" data-loading-text="Signing in...">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            Sign In
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="~/lib/bootstrap-growl/jquery.bootstrap-growl.js"></script>
<script src="~/js/site.js"></script>

<script>
  document.getElementById('togglePw').addEventListener('click', function(){
    const pw = document.getElementById('password');
    pw.type = pw.type === 'password' ? 'text' : 'password';
  });

  document.getElementById('loginForm').addEventListener('submit', function (e) {
    e.preventDefault();
    Validate();
  });

  function Validate() {
    $("#btn_login").button("loading");
    $('.bootstrap-growl').remove();

    $.ajax({
      type: "POST",
      url: '@Url.Action("Validate", "Auth")',
      data: {
        USERNAME: $('#username').val(),
        PASSWORD: $('#password').val(),
        param: '@ViewData["ParamURL"]'
      },
      error: function (result) {
        $("#btn_login").button("reset");

        if (result.responseText) {
          $.bootstrapGrowl(result.responseText, {
            type: 'danger',
            allow_dismiss: true,
            align: 'right',
            delay: 10000
          });
        }
      },
      success: function (result) {
        if (result.status == true) {
          var redirectUrl = result.data != null ? result.data : '@Url.Action("Index", "Home")';
          $.bootstrapGrowl('Login successful, redirecting...', {
            type: 'success',
            allow_dismiss: false,
            align: 'right',
            delay: 1200
          });
          setTimeout(function () {
            window.location.href = redirectUrl;
          }, 600);
        } else {
          $("#btn_login").button("reset");
          showErrorMesgGrowl(result.message);
        }
      }
    });
  }
</script>
</body>
</html>
