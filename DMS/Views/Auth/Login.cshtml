@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DMS - Document Management System | Login</title>
<link href="~/css/fonts.css" rel="stylesheet">
<style>
  :root{
    --blue-900:#0b1f4d;
    --blue-800:#122a8f;
    --blue-700:#1C3FA6;
    --blue-600:#2450D8;
    --blue-500:#3f63ea;
    --blue-400:#6685f0;
    --blue-100:#e7edfb;
    --blue-50:#f2f6fd;
    --ink:#0e1b3d;
    --line:#e3e7ef;
    --green:#22b573;
    --page-bg:#eef2fb;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html, body{
    height:100%;
    width:100%;
    overflow:hidden;
  }
  body{
    font-family:'Inter', sans-serif;
    background:var(--page-bg);
    color:var(--ink);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:clamp(8px, 1.4vh, 20px);
  }
  .wrap{
    width:100%;
    height:100%;
    max-width:1600px;
    max-height:860px;
    background:#eef3fc;
    border-radius:clamp(14px, 2vh, 24px);
    display:flex;
    align-items:center;
    justify-content:space-between;
    position:relative;
    overflow:hidden;
    padding:clamp(18px, 3.2vh, 44px) clamp(28px, 4.6vw, 64px);
    gap:clamp(20px, 3vw, 40px);
    box-shadow:0 30px 60px -20px rgba(20,40,100,.15);
  }

  /* Curved divider shape matching reference artwork */
  .curve-bg{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    z-index:0;
  }
  .dots{
    position:absolute;
    top:16%;
    left:38.5%;
    width:150px;
    height:110px;
    background-image:radial-gradient(circle, #c7d5f4 1.6px, transparent 1.6px);
    background-size:13px 13px;
    opacity:.8;
    z-index:1;
  }

  /* LEFT SIDE */
  .left{
    position:relative;
    z-index:2;
    flex:1.15;
    min-width:0;
    height:100%;
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding-right:clamp(8px,1.5vw,20px);
  }
  .brand{
    display:flex;
    align-items:center;
    gap:18px;
    margin-bottom:clamp(14px, 2.8vh, 34px);
  }
  .brand-icon{
    width:clamp(66px,8.4vh,98px);
    height:clamp(66px,8.4vh,98px);
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
  }
  .brand-icon svg{width:56%;height:56%;}
  .brand-text h1{
    font-family:'Poppins',sans-serif;
    font-size:clamp(28px,6vh,44px);
    font-weight:800;
    color:var(--blue-900);
    letter-spacing:.5px;
    line-height:1;
  }
  .brand-text p{
    font-size:clamp(13px,1.8vh,16px);
    color:#5a6478;
    margin-top:6px;
    letter-spacing:.3px;
  }

  .headline{
    font-family:'Poppins',sans-serif;
    font-size:clamp(22px,3.6vh,38px);
    font-weight:700;
    color:var(--blue-900);
    line-height:1.22;
    max-width:520px;
  }
  .rule{
    width:52px;
    height:4px;
    background:var(--blue-600);
    border-radius:2px;
    margin:clamp(10px,1.8vh,20px) 0;
  }
  .desc{
    font-size:clamp(11.5px,1.6vh,14.5px);
    color:#5a6478;
    line-height:1.6;
    max-width:410px;
    margin-bottom:clamp(10px,2vh,26px);
  }

  .illustration{
    position:relative;
    width:100%;
    max-width:560px;
    margin:0 0 clamp(10px,2vh,24px);
    flex:1;
    min-height:0;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .illustration svg{width:100%; height:auto; max-height:100%; display:block;}

  .features{
    display:flex;
    gap:clamp(16px,2.6vw,40px);
    flex-wrap:nowrap;
  }
  .feature{
    display:flex;
    gap:10px;
    align-items:flex-start;
    max-width:180px;
  }
  .feature-icon{
    width:clamp(26px,3.4vh,32px);
    height:clamp(26px,3.4vh,32px);
    border-radius:9px;
    background:var(--blue-100);
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
  }
  .feature-icon svg{width:16px;height:16px;color:var(--blue-600);}
  .feature h4{
    font-size:clamp(12px,1.6vh,14px);
    font-weight:700;
    color:var(--blue-900);
    margin-bottom:2px;
  }
  .feature p{
    font-size:clamp(10px,1.35vh,12px);
    color:#8891a3;
    line-height:1.45;
  }

  /* RIGHT SIDE - login card */
  .right{
    position:relative;
    z-index:2;
    flex:0 0 clamp(280px, 22vw, 360px);
    height:100%;
    display:flex;
    align-items:center;
  }
  .card-outer{
    width:100%;
    display:flex;
    flex-direction:column;
    max-height:100%;
  }
  .card{
    background:#ffffff;
    border-radius:20px;
    padding:clamp(24px,3.6vh,40px) clamp(22px,2.6vw,36px) clamp(40px,6vh,64px);
    box-shadow:0 30px 60px -15px rgba(20,40,110,.22);
  }
  .card-logo{
    width:clamp(54px,8vh,80px);
    height:clamp(54px,8vh,80px);
    border-radius:50%;
    background:var(--blue-50);
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto clamp(8px,1.6vh,16px);
  }
  .card-logo-inner{
    width:66%;
    height:66%;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .card-logo-inner svg{width:56%;height:56%;}
  .card h2{
    font-family:'Poppins',sans-serif;
    text-align:center;
    font-size:clamp(17px,2.6vh,22px);
    font-weight:700;
    color:var(--blue-900);
    margin-bottom:4px;
  }
  .card > p.sub{
    text-align:center;
    font-size:clamp(11px,1.5vh,13px);
    color:#8891a3;
    margin-bottom:clamp(12px,2.2vh,24px);
  }
  label{
    display:block;
    font-size:clamp(11.5px,1.5vh,13px);
    font-weight:600;
    color:#26314f;
    margin-bottom:6px;
  }
  .field{margin-bottom:clamp(8px,1.6vh,15px);}
  .input-group{
    position:relative;
    display:flex;
    align-items:center;
  }
  .input-group svg.leading{
    position:absolute;
    left:13px;
    width:16px;
    height:16px;
    color:#a7aec0;
  }
  .input-group svg.trailing{
    position:absolute;
    right:13px;
    width:17px;
    height:17px;
    color:#a7aec0;
    cursor:pointer;
  }
  input[type=text], input[type=email], input[type=password]{
    width:100%;
    padding:clamp(9px,1.7vh,12px) 13px clamp(9px,1.7vh,12px) 40px;
    border:1.5px solid var(--line);
    border-radius:9px;
    font-size:clamp(12px,1.6vh,13.5px);
    font-family:'Inter',sans-serif;
    color:var(--ink);
    outline:none;
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  input::placeholder{color:#a7aec0;}
  input:focus{
    border-color:var(--blue-500);
    box-shadow:0 0 0 3px rgba(36,80,216,.12);
  }
  input#password{padding-right:40px;}

  .row-between{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:clamp(10px,2vh,22px);
  }
  .remember{
    display:flex;
    align-items:center;
    gap:7px;
    font-size:clamp(11.5px,1.5vh,13px);
    font-weight:400;
    color:#3a4459;
    margin-bottom:0;
    cursor:pointer;
  }
  .remember input{
    width:15px;height:15px;
    accent-color:var(--blue-600);
    cursor:pointer;
  }
  .forgot{
    font-size:clamp(11.5px,1.5vh,13px);
    color:var(--blue-600);
    text-decoration:none;
    font-weight:500;
  }
  .forgot:hover{text-decoration:underline;}

  .btn-login{
    width:100%;
    margin-top:clamp(30px,4.5vh,42px);
    padding:clamp(10px,1.9vh,13px);
    border:none;
    border-radius:9px;
    background:linear-gradient(180deg, var(--blue-600), var(--blue-700));
    color:#fff;
    font-size:clamp(12.5px,1.7vh,14.5px);
    font-weight:600;
    font-family:'Inter',sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    cursor:pointer;
    box-shadow:0 12px 20px -8px rgba(19,50,138,.55);
    transition:transform .12s ease, box-shadow .12s ease;
  }
  .btn-login:hover{transform:translateY(-1px); box-shadow:0 16px 26px -8px rgba(19,50,138,.6);}
  .btn-login svg{width:15px;height:15px;}

  .divider{
    display:flex;
    align-items:center;
    gap:12px;
    margin:clamp(10px,2vh,20px) 0;
    color:#a7aec0;
    font-size:11.5px;
  }
  .divider::before, .divider::after{
    content:"";
    flex:1;
    height:1px;
    background:var(--line);
  }

  .btn-sso{
    width:100%;
    padding:clamp(9px,1.7vh,12px);
    border:1.5px solid var(--blue-500);
    border-radius:9px;
    background:#fff;
    color:var(--blue-600);
    font-size:clamp(12px,1.6vh,13.5px);
    font-weight:600;
    font-family:'Inter',sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    cursor:pointer;
    transition:background .15s ease;
  }
  .btn-sso:hover{background:var(--blue-50);}
  .btn-sso svg{width:15px;height:15px;}

  .footer{
    text-align:center;
    margin-top:clamp(8px,1.6vh,18px);
    font-size:10.5px;
    color:#9aa2b4;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:5px;
    flex-wrap:wrap;
  }
  .footer svg{width:11px;height:11px;}

  /* growl notification (login failed/success/info) */
  .bootstrap-growl{
    font-family:'Inter', sans-serif;
    font-size:13px;
    font-weight:500;
    line-height:1.4;
    padding:12px 34px 12px 16px;
    border-radius:10px;
    border:1px solid transparent;
    box-shadow:0 14px 30px -10px rgba(20,40,100,.35);
  }
  .bootstrap-growl.alert-danger{
    background:#fdecec;
    border-color:#f5c2c2;
    color:#a12b2b;
  }
  .bootstrap-growl.alert-success{
    background:#e8f8f0;
    border-color:#b7e6cc;
    color:#1a7a4c;
  }
  .bootstrap-growl.alert-info{
    background:var(--blue-50);
    border-color:#c7d5f4;
    color:var(--blue-800);
  }
  .bootstrap-growl .close{
    position:absolute;
    top:8px;
    right:10px;
    font-size:16px;
    line-height:1;
    color:inherit;
    opacity:.55;
    cursor:pointer;
    background:none;
    border:none;
  }
  .bootstrap-growl .close:hover{opacity:1;}

  /* ===== TABLET / MOBILE — show login form only ===== */
  @@media (max-width: 900px){
    html, body{height:auto; min-height:100%; overflow-y:auto;}
    body{
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:100vh;
      padding:24px 16px;
    }
    .wrap{
      background:transparent;
      box-shadow:none;
      border-radius:0;
      width:100%;
      max-width:400px;
      height:auto;
      max-height:none;
      margin:0 auto;
      padding:0;
      gap:0;
      overflow:visible;
      justify-content:center;
    }
    .curve-bg, .dots, .left{display:none;}
    .right{flex:none; width:100%; height:auto;}
    .card-outer{max-width:400px; margin:0 auto; width:100%;}
  }

  @@media (max-width: 420px){
    .card{padding:28px 20px 34px;}
  }
</style>
</head>
<body>
<div class="wrap">
  <svg class="curve-bg" viewBox="0 0 1536 900" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="curveGrad" x1="10%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#5b7bef"/>
        <stop offset="45%" stop-color="#3a5aea"/>
        <stop offset="100%" stop-color="#1c34b8"/>
      </linearGradient>
    </defs>
    <!-- outer light halo, creates the thin layered edge -->
    <path d="M 980 -40
             C 650 220, 650 640, 980 900
             L 1600 900
             L 1600 -40
             Z" fill="#dfe8f8"/>
    <!-- inner saturated curve -->
    <path d="M 1040 -40
             C 730 220, 730 640, 1040 900
             L 1600 900
             L 1600 -40
             Z" fill="url(#curveGrad)"/>
  </svg>
  <div class="dots"></div>

  <!-- LEFT -->
  <div class="left">
    <div class="brand">
      <div class="brand-icon">
        <img src="~/images/img_login2.png" alt="Folder icon" style="height:100%;object-fit:contain;">
      </div>
      <div class="brand-text">
        <h1>DMS</h1>
        <p>Document Management System</p>
      </div>
    </div>

    <h2 class="headline">Manage Your Documents</h2>
    <div class="rule"></div>
   

    <div class="illustration">
                <img src="~/images/img_login1.png"  alt="Document Management System illustration" style="height:auto;max-height:100%;object-fit:contain;display:block;margin:0 auto;">
    </div>

    <div class="features">
      <div class="feature">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l7 3v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V5l7-3z"/></svg>
        </div>
        <div>
          <h4>Secure</h4>
          <p>Data security guaranteed</p>
        </div>
      </div>
      <div class="feature">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>
        </div>
        <div>
          <h4>Organized</h4>
          <p>Documents neatly and systematically arranged</p>
        </div>
      </div>
      <div class="feature">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <div>
          <h4>Easy Access</h4>
          <p>Find documents quickly</p>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT -->
  <div class="right">
    <div class="card-outer">
      <div class="card">
        <div class="card-logo">
          <div class="card-logo-inner">
            <img src="~/images/img_login2.png" alt="Folder icon" style="height:100%;object-fit:contain;">
          </div>
        </div>
        <h2>Welcome</h2>
        <p class="sub">Sign in to access your documents</p>

        <form id="loginForm">
          <div class="field">
            <label for="username">Username</label>
            <div class="input-group">
              <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
              <input type="text" id="username" name="username" placeholder="Enter username" autocomplete="username" required>
            </div>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <div class="input-group">
              <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              <input type="password" id="password" name="password" placeholder="Enter password" autocomplete="current-password" required>
              <svg class="trailing" id="togglePw" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
          </div>

          <button type="submit" class="btn-login" id="btn_login" data-loading-text="Signing in...">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            Login
          </button>
        </form>
      </div>

    </div>
  </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="~/lib/bootstrap-growl/jquery.bootstrap-growl.js"></script>
<script src="~/js/site.js"></script>

<script>
  document.getElementById('togglePw').addEventListener('click', function(){
    const pw = document.getElementById('password');
    pw.type = pw.type === 'password' ? 'text' : 'password';
  });

  $(document).ready(function () {
    var rememberedUsername = localStorage.getItem('dmsRememberedUsername');
    if (rememberedUsername) {
      $('#username').val(rememberedUsername);
      $('#rememberMe').prop('checked', true);
      $('#password').focus();
    }
  });

  function forgotPassword() {
    $.bootstrapGrowl('Please contact IT Admin to reset your account password.', {
      type: 'info',
      allow_dismiss: true,
      align: 'right',
      delay: 4000
    });
  }

  document.getElementById('loginForm').addEventListener('submit', function (e) {
    e.preventDefault();
    Validate();
  });

  function Validate() {
    $("#btn_login").button("loading");
    $('.bootstrap-growl').remove();

    if ($('#rememberMe').is(':checked')) {
      localStorage.setItem('dmsRememberedUsername', $('#username').val());
    } else {
      localStorage.removeItem('dmsRememberedUsername');
    }

    $.ajax({
      type: "POST",
      url: '@Url.Action("Validate", "Auth")',
      data: {
        USERNAME: $('#username').val(),
        PASSWORD: $('#password').val(),
        param: '@ViewData["ParamURL"]'
      },
      error: function (result) {
        $("#btn_login").button("reset");

        if (result.responseText) {
          $.bootstrapGrowl(result.responseText, {
            type: 'danger',
            allow_dismiss: true,
            align: 'right',
            delay: 10000
          });
        }
      },
      success: function (result) {
        if (result.status == true) {
          var redirectUrl = result.data != null ? result.data : '@Url.Action("Index", "Home")';
          $.bootstrapGrowl('Login successful, redirecting...', {
            type: 'success',
            allow_dismiss: false,
            align: 'right',
            delay: 1200
          });
          setTimeout(function () {
            window.location.href = redirectUrl;
          }, 600);
        } else {
          $("#btn_login").button("reset");
          showErrorMesgGrowl(result.message);
        }
      }
    });
  }
</script>
</body>
</html>
