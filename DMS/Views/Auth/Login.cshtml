@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Document Control System | Login</title>
<link href="~/css/fonts.css" rel="stylesheet" asp-append-version="true">
<link rel="stylesheet" href="~/css/views/Auth/Login.css" asp-append-version="true" />
</head>
<body>
<div class="page-wrap">
  <div class="brand-header">
    <img src="~/images/logo_dcs.png" alt="Document Control System">
  </div>

  <div class="content-row">
    <div class="login-col">
      <div class="card">
        <div class="brand-icon"><span><img src="~/images/logo.png" alt="DCS icon"></span></div>

        <h2>Welcome Back!</h2>
        <p class="sub">Sign in to access your account</p>

        <form id="loginForm">
          <div class="field">
            <label for="username">Username</label>
            <div class="input-group">
              <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
              <input type="text" id="username" name="username" placeholder="Enter your username" autocomplete="username" required>
            </div>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <div class="input-group">
              <svg class="leading" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
              <svg class="trailing" id="togglePw" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
          </div>

          <button type="submit" class="btn-login" id="btn_login" data-loading-text="Signing in...">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            Sign In
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap-growl/jquery.bootstrap-growl.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
  document.getElementById('togglePw').addEventListener('click', function(){
    const pw = document.getElementById('password');
    pw.type = pw.type === 'password' ? 'text' : 'password';
  });

  document.getElementById('loginForm').addEventListener('submit', function (e) {
    e.preventDefault();
    if ($("#btn_login").prop("disabled")) return; // cegah klik/Enter ganda selama proses
    Validate();
  });

  // Tombol login nonaktif + spinner selama proses. Dulu memakai $.fn.button("loading")
  // milik Bootstrap 3 yang tidak ada di Bootstrap versi ini, jadi tombol tidak pernah
  // berubah dan bisa diklik berkali-kali.
  var gLoginButtonHtml = $("#btn_login").html();
  function setLoginLoading(loading) {
    var $btn = $("#btn_login");
    $btn.prop("disabled", loading).toggleClass("is-loading", loading).attr("aria-busy", loading);
    $("#username, #password").prop("disabled", loading);
    $btn.html(loading ? '<span class="spinner" aria-hidden="true"></span> Signing in...' : gLoginButtonHtml);
  }

  function Validate() {
    // Nilai dibaca sebelum input dinonaktifkan
    var username = $('#username').val();
    var password = $('#password').val();
    setLoginLoading(true);
    $('.bootstrap-growl').remove();

    $.ajax({
      type: "POST",
      url: '@Url.Action("Validate", "Auth")',
      data: {
        USERNAME: username,
        PASSWORD: password,
        param: '@ViewData["ParamURL"]'
      },
      error: function (result) {
        setLoginLoading(false);

        if (result.responseText) {
          $.bootstrapGrowl(result.responseText, {
            type: 'danger',
            allow_dismiss: true,
            align: 'right',
            delay: 10000
          });
        }
      },
      success: function (result) {
        if (result.status == true) {
          var redirectUrl = result.data != null ? result.data : '@Url.Action("Index", "Home")';
          $.bootstrapGrowl('Login successful, redirecting...', {
            type: 'success',
            allow_dismiss: false,
            align: 'right',
            delay: 1200
          });
          setTimeout(function () {
            window.location.href = redirectUrl; // tombol tetap loading sampai halaman berpindah
          }, 600);
        } else {
          setLoginLoading(false);
          showErrorMesgGrowl(result.message);
        }
      }
    });
  }
</script>
</body>
</html>
