<div class="box-header dp-toolbar">
    <div class="dp-toolbar-left al-filters">
        <div class="al-filter">
            <label for="searchDate">Date Range</label>
            <input class="form-control al-filter-date" id="searchDate" type="text" placeholder="Select date range" />
        </div>
        <div class="al-filter">
            <label for="filterModule">Module</label>
            <select id="filterModule" class="al-filter-select">
                <option value="">All Module</option>
            </select>
        </div>
        <div class="al-filter">
            <label for="filterUser">User</label>
            <select id="filterUser" class="al-filter-select">
                <option value="">All User</option>
            </select>
        </div>
        <div class="al-filter">
            <label for="filterStatus">Status</label>
            <select id="filterStatus" class="al-filter-select">
                <option value="">All Status</option>
                <option value="SUCCESS">Success</option>
                <option value="FAILED">Failed</option>
                <option value="RUNNING">Running</option>
            </select>
        </div>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_refresh" title="Refresh"><i class="fa fa-refresh"></i> Refresh</button>
        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i> </button>
    </div>
    <div class="dp-toolbar-right">
        <button type="button" class="dp-btn dp-btn-outline" id="btn_export"><i class="fa fa-download"></i> Export</button>
        <button type="button" class="dp-icon-btn dp-stats-toggle" id="btn_toggleStats" title="Show Log Summary">
            <i class="fa fa-angle-double-left"></i>
        </button>
    </div>
</div>
