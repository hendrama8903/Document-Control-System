<link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
<script src="~/js/devextreme/dx.web.js"></script>

<style>
    /* pastikan editor filter row terlihat jelas (hindari bentrok styling tema) */
    #datagrid .dx-datagrid-filter-row .dx-texteditor {
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fff;
    }

    #datagrid .dx-datagrid-filter-row .dx-texteditor-input {
        padding: 5px 8px;
        min-height: 28px;
    }

    #datagrid .process-id-link {
        color: #0078D4;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
    }
</style>

<div class="box-body">
    <div id="datagrid"></div>
</div>

<script type="text/javascript">
    function computeGridHeight() {
        var gridTop = $("#datagrid").offset().top;
        var footerHeight = $("#divFooter").outerHeight(true) || 0;

        return Math.max(300, $(window).height() - gridTop - footerHeight - 40);
    }

    $(document).ready(function () {
        var gridStore = new DevExpress.data.CustomStore({
            loadMode: "raw",
            load: function () {
                var d = $.Deferred();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Search", "LogMonitoring")",
                    data: {
                        draw: 1,
                        start: 0,
                        length: 100000,
                        START_DT: gStartDate,
                        END_DT: gEndDate
                    }
                }).done(function (result) {
                    d.resolve(result.data == "" ? [] : result.data);
                }).fail(function () {
                    d.reject("Data loading error");
                });

                return d.promise();
            }
        });

        $("#datagrid").dxDataGrid({
            dataSource: gridStore,
            showBorders: true,
            columnAutoWidth: true,
            wordWrapEnabled: false,
            sorting: { mode: "none" },
            noDataText: "Data not found.",
            height: computeGridHeight(),
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            toolbar: { visible: false },
            paging: { pageSize: 10 },
            pager: {
                visible: true,
                displayMode: "compact",
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true,
                showNavigationButtons: true
            },
            columnChooser: {
                enabled: true,
                mode: "select"
            },
            columnFixing: { enabled: true },
            columns: [
                {
                    caption: "No",
                    width: 50,
                    alignment: "center",
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex();
                        var pageSize = options.component.pageSize();
                        container.text(pageIndex * pageSize + options.row.rowIndex + 1);
                    }
                },
                {
                    dataField: "PROCESS_ID",
                    caption: "Process ID",
                    alignment: "center",
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<a>")
                            .addClass("process-id-link")
                            .text(row.PROCESS_ID)
                            .on("click", function () {
                                onDetail(row.PROCESS_ID);
                            })
                            .appendTo(container);
                    }
                },
                { dataField: "MODULE", caption: "Module Name" },
                { dataField: "FUNCTION", caption: "Function Name" },
                {
                    dataField: "START_DT",
                    caption: "Start Date",
                    alignment: "center",
                    cellTemplate: function (container, options) {
                        var value = options.data.START_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY HH:mm:ss") : "");
                    }
                },
                {
                    dataField: "END_DT",
                    caption: "End Date",
                    alignment: "center",
                    cellTemplate: function (container, options) {
                        var value = options.data.END_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY HH:mm:ss") : "");
                    }
                },
                {
                    caption: "Process Status",
                    alignment: "center",
                    calculateCellValue: function (row) {
                        if (row.PROCESS_STATUS == 0) {
                            return "0:Start";
                        } else if (row.PROCESS_STATUS == 1) {
                            return "1:Process";
                        } else if (row.PROCESS_STATUS == 2) {
                            return "2:Finish";
                        } else if (row.PROCESS_STATUS == 3) {
                            return "3:Finish with error";
                        }
                        return row.PROCESS_STATUS + ":Abnormal";
                    }
                },
                { dataField: "CREATED_BY", caption: "User Name" }
            ]
        });

        $("#btn_columns").on("click", function () {
            $("#datagrid").dxDataGrid("instance").showColumnChooser();
        });

        $(window).on("resize", function () {
            $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
        });
    });
</script>
