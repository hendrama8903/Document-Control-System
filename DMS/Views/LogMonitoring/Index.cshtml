<link rel="stylesheet" href="~/css/views/shared/master-stats-panel.css" asp-append-version="true" />
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-layout-row stats-collapsed" id="dpLayoutRow">
                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                <aside class="dp-stats-panel" id="dpStatsPanel">
                    <div class="dp-stats-panel-head">
                        <span>Log Summary</span>
                        <button type="button" class="dp-stats-panel-close" id="btn_closeStatsPanel"><i class="fa fa-times"></i></button>
                    </div>
                    <div class="dp-stats-panel-body" id="alStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-database"></i></div>
                            <div>
                                <span>Total Log</span>
                                <b id="alStatTotal">-</b>
                                <small>All activity</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Success</span>
                                <b id="alStatSuccess">-</b>
                                <small id="alStatSuccessPct">-</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon red"><i class="fa fa-times-circle"></i></div>
                            <div>
                                <span>Failed</span>
                                <b id="alStatFailed">-</b>
                                <small id="alStatFailedPct">-</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-refresh"></i></div>
                            <div>
                                <span>Running</span>
                                <b id="alStatRunning">-</b>
                                <small id="alStatRunningPct">-</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-calendar"></i></div>
                            <div>
                                <span>Today</span>
                                <b id="alStatToday">-</b>
                                <small>Activity today</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-users"></i></div>
                            <div>
                                <span>Active User</span>
                                <b id="alStatActiveUser">-</b>
                                <small>Active users today</small>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>
@Html.Partial("_PopupForm")
@Html.Partial("_Javascript")
