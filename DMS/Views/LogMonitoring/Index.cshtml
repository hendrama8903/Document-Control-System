<style>
    /* site.css forces .fa-chevron-up/-down to white globally (for a dark-background
       use elsewhere) - override back to the normal dp-icon-btn color for this button. */
    #btn_toggleStats i {
        color: #344054;
    }
</style>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="divTitle">
                <div class="dp-header">
                    <div class="dp-header-left">
                        <div class="dp-header-icon"><i class="fa fa-history"></i></div>
                        <div>
                            <h1>@ViewData["Title"]</h1>
                            <p>Monitor all user activity in the system.</p>
                        </div>
                    </div>
                    <div class="dp-header-actions">
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_export"><i class="fa fa-download"></i> Export</button>
                        <button type="button" class="dp-icon-btn" id="btn_toggleStats" title="Hide Summary Cards"><i class="fa fa-chevron-up"></i></button>
                    </div>
                    <div class="dp-header-stats dp-header-stats-grid" id="alStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-database"></i></div>
                            <div>
                                <span>Total Log</span>
                                <b id="alStatTotal">-</b>
                                <small>All activity</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Success</span>
                                <b id="alStatSuccess">-</b>
                                <small id="alStatSuccessPct">-</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon red"><i class="fa fa-times-circle"></i></div>
                            <div>
                                <span>Failed</span>
                                <b id="alStatFailed">-</b>
                                <small id="alStatFailedPct">-</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-refresh"></i></div>
                            <div>
                                <span>Running</span>
                                <b id="alStatRunning">-</b>
                                <small id="alStatRunningPct">-</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-calendar"></i></div>
                            <div>
                                <span>Today</span>
                                <b id="alStatToday">-</b>
                                <small>Activity today</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-users"></i></div>
                            <div>
                                <span>Active User</span>
                                <b id="alStatActiveUser">-</b>
                                <small>Active users today</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dp-card">
                <div id="divSearch">
                    @Html.Partial("_SearchCriteria")
                </div>
                <div id="divGrid">
                    @Html.Partial("_GridView")
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_PopupForm")
@Html.Partial("_Javascript")
