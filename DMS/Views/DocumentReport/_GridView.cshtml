<link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
<script src="~/js/devextreme/dx.web.js"></script>

<style>
    /* pastikan editor filter row terlihat jelas (hindari bentrok styling tema) */
    #datagrid .dx-datagrid-filter-row .dx-texteditor {
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fff;
    }

    #datagrid .dx-datagrid-filter-row .dx-texteditor-input {
        padding: 5px 8px;
        min-height: 28px;
    }

    /* tampilkan judul kolom penuh (wrap), jangan terpotong "..." */
    #datagrid .dx-datagrid-headers .dx-header-row td .dx-datagrid-text-content {
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.3;
    }
</style>

<div class="box-body">
    <div id="datagrid"></div>
</div>

<script type="text/javascript">
    function computeGridHeight() {
        var gridTop = $("#datagrid").offset().top;
        var footerHeight = $("#divFooter").outerHeight(true) || 0;

        return Math.max(300, $(window).height() - gridTop - footerHeight - 40);
    }

    $(document).ready(function () {
        var gridStore = new DevExpress.data.CustomStore({
            key: "DOCUMENT_TRANSACTION_ID",
            loadMode: "raw",
            load: function () {
                var d = $.Deferred();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Search", "DocumentReport")",
                    data: {
                        draw: 1,
                        start: 0,
                        length: 100000,
                        initialMode: false
                    }
                }).done(function (result) {
                    d.resolve(result.data == "" ? [] : result.data);
                }).fail(function () {
                    d.reject("Data loading error");
                });

                return d.promise();
            }
        });

        $("#datagrid").dxDataGrid({
            dataSource: gridStore,
            showBorders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            wordWrapEnabled: false,
            sorting: { mode: "none" },
            noDataText: "Data not found.",
            height: computeGridHeight(),
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            toolbar: { visible: false },
            selection: { mode: "single" },
            paging: { pageSize: 10 },
            pager: {
                visible: true,
                displayMode: "compact",
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true,
                showNavigationButtons: true
            },
            columnChooser: {
                enabled: true,
                mode: "select"
            },
            columnFixing: { enabled: true },
            columns: [
                {
                    caption: "No",
                    width: 50,
                    alignment: "center",
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex();
                        var pageSize = options.component.pageSize();
                        container.text(pageIndex * pageSize + options.row.rowIndex + 1);
                    }
                },
                { dataField: "DOCUMENT_CODE", caption: "Document Code", fixed: true, fixedPosition: "left" },
                { dataField: "DOCUMENT_TRANSACTION_NAME", caption: "Document Name" },
                {
                    dataField: "DOCUMENT_DATE",
                    caption: "Document Date",
                    alignment: "right",
                    cellTemplate: function (container, options) {
                        var value = options.data.DOCUMENT_DATE;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY") : "");
                    }
                },
                {
                    dataField: "NEXT_REVIEW_DATE",
                    caption: "Next Review Date",
                    alignment: "right",
                    cellTemplate: function (container, options) {
                        var value = options.data.NEXT_REVIEW_DATE;

                        if (value == null) {
                            container.text("");
                            return;
                        }

                        var reviewDate = moment(value).startOf("day");
                        var today = moment().startOf("day");
                        var daysLeft = reviewDate.diff(today, "days");
                        var labelClass = "label label-default";

                        if (daysLeft < 0) {
                            labelClass = "label label-danger";
                        } else if (daysLeft <= 30) {
                            labelClass = "label label-warning";
                        }

                        $("<span>").addClass(labelClass).text(reviewDate.format("DD-MM-YYYY")).appendTo(container);
                    }
                },
                {
                    caption: "Division",
                    calculateCellValue: function (row) {
                        return row.DIVISION != null ? row.DIVISION + " - " + row.DIVISION_NAME : "";
                    }
                },
                {
                    caption: "Department",
                    calculateCellValue: function (row) {
                        return row.DEPARTMENT_CODE != null ? row.DEPARTMENT_CODE + " - " + row.DEPARTMENT_NAME : "";
                    }
                },
                { dataField: "REVISION", caption: "Revision", alignment: "center" },
                {
                    dataField: "PUBLISH_FLAG",
                    caption: "Published",
                    alignment: "center",
                    cellTemplate: function (container, options) {
                        var row = options.data;
                        var labelClass = row.PUBLISH_FLAG == 1 ? "label label-success" : "label label-warning";
                        var text = row.PUBLISH_FLAG == 1 ? "YES" : "NO";

                        $("<span>").addClass(labelClass).text(text).appendTo(container);
                    }
                },
                { dataField: "DOCUMENT_CREATOR", caption: "Creator" },
                {
                    dataField: "DISTRIBUTION_DATE",
                    caption: "Distribution Date",
                    alignment: "right",
                    cellTemplate: function (container, options) {
                        var value = options.data.DISTRIBUTION_DATE;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY") : "");
                    }
                }
            ]
        });

        $(window).on("resize", function () {
            $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
        });

        $('body').tooltip({ selector: '[data-toggle="tooltip"]' });
    });
</script>
