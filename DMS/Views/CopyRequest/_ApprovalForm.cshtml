<!-- Panel review approval - side panel geser dari kanan (BUKAN modal), pola
     sama persis DocumentControlDashboard/_AcceptanceDetailPopup.cshtml &
     CopyRequest/_PrintLogPanel.cshtml (request Hendra 2026-08-16, sebelumnya
     Bootstrap modal). -->
<style>
    #approvalPanel {
        position: fixed;
        top: 0;
        right: 0;
        width: 520px;
        max-width: 94vw;
        height: 100vh;
        background: #fff;
        box-shadow: -8px 0 24px rgba(20,35,50,.18);
        z-index: 1050;
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform .22s cubic-bezier(.4,0,.2,1);
    }

    #approvalPanel.open { transform: translateX(0); }

    #approvalPanel .adf-header {
        background: #fff;
        color: #101828;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #EEF1F5;
        position: relative;
        flex: none;
    }

    #approvalPanel .adf-header-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #E7F1FB;
        color: #2450D8;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: none;
        font-size: 15px;
    }

    #approvalPanel .adf-header-title { font-size: 14px; font-weight: 700; color: #101828; }
    #approvalPanel .adf-header-sub { font-size: 12px; color: #8A94A3; margin-top: 2px; }

    #approvalPanel .adf-close {
        background: none;
        border: none;
        color: #98A2B3;
        font-size: 13px;
        cursor: pointer;
        padding: 2px;
        margin-left: auto;
    }

    #approvalPanel .adf-close:hover { color: #475467; }

    #approvalPanel .panel-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        background: #F4F6F8;
        padding: 18px 20px;
    }

    #approvalPanel .adf-section {
        background: #fff;
        border: 1px solid #E3E8EE;
        border-radius: 10px;
        padding: 16px 18px;
        margin-bottom: 14px;
    }

    #approvalPanel .adf-section:last-child { margin-bottom: 0; }

    #approvalPanel .adf-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        font-weight: 700;
        color: #5A6472;
        letter-spacing: .03em;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    #approvalPanel .adf-section-title i { color: #2450D8; }

    #approvalPanel .adf-info-main {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px 20px;
    }

    #approvalPanel .adf-info-field {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    #approvalPanel .adf-info-field > i {
        color: #2450D8;
        font-size: 13px;
        margin-top: 3px;
        flex: none;
        width: 14px;
        text-align: center;
    }

    #approvalPanel .adf-info-label {
        font-size: 10.5px;
        font-weight: 700;
        color: #8A94A3;
        text-transform: uppercase;
        letter-spacing: .02em;
    }

    #approvalPanel .adf-info-value {
        font-size: 13.5px;
        color: #1D2939;
        font-weight: 600;
        margin-top: 2px;
        word-break: break-word;
    }

    /* Status banner - dulu kartu di samping info (side-by-side), sekarang
       full-width di atas karena lebar sidebar tidak cukup untuk dua kolom
       (request Hendra 2026-08-16). */
    #approvalPanel .adf-status-panel {
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 14px;
    }

    #approvalPanel .adf-status-panel .adf-status-label {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .04em;
        opacity: .8;
        margin-bottom: 10px;
    }

    #approvalPanel .adf-status-panel .adf-status-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    #approvalPanel .adf-status-panel .adf-status-icon {
        flex: none;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: currentColor;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #approvalPanel .adf-status-panel .adf-status-icon i {
        color: #fff;
        font-size: 15px;
    }

    #approvalPanel .adf-status-panel .adf-status-text-wrap { min-width: 0; }

    #approvalPanel .adf-status-panel .adf-status-pre {
        font-size: 10.5px;
        font-weight: 700;
        opacity: .85;
    }

    #approvalPanel .adf-status-panel .adf-status-text {
        font-weight: 800;
        font-size: 14.5px;
        line-height: 1.25;
        word-break: break-word;
    }

    #approvalPanel .adf-status-panel .adf-status-hint {
        font-size: 11px;
        opacity: .85;
        margin-top: 8px;
        line-height: 1.4;
    }

    #approvalPanel .adf-status-info { background: #E7F1FB; color: #2E75B6; }
    #approvalPanel .adf-status-success { background: #E6F4EA; color: #1E7E34; }
    #approvalPanel .adf-status-warning { background: #FFF3E0; color: #B36B00; }
    #approvalPanel .adf-status-danger { background: #FDECEA; color: #C62828; }

    #approvalPanel .adf-remark-readonly {
        font-size: 12.5px;
        color: #1D2939;
        background: #F4F6F8;
        border: 1px solid #E3E8EE;
        border-radius: 8px;
        padding: 10px 12px;
        white-space: pre-wrap;
    }
</style>

<div id="approvalPanel">
    <div class="adf-header">
        <div class="adf-header-icon"><i class="fa fa-check-circle-o"></i></div>
        <div>
            <div class="adf-header-title">Print Request Review</div>
            <div class="adf-header-sub" id="approvalRequestNo">-</div>
        </div>
        <button type="button" class="adf-close" id="btn_closeApprovalPanel"><i class="fa fa-times"></i></button>
    </div>

    <div class="panel-body">
        <!-- Status -->
        <div class="adf-status-panel adf-status-warning" id="approvalStatusPanel">
            <div class="adf-status-label">STATUS</div>
            <div class="adf-status-row">
                <div class="adf-status-icon"><i class="fa fa-clock-o" id="approvalStatusIcon"></i></div>
                <div class="adf-status-text-wrap">
                    <div class="adf-status-pre" id="approvalStatusPre"></div>
                    <div class="adf-status-text" id="approvalStatusText">-</div>
                </div>
            </div>
            <div class="adf-status-hint" id="approvalStatusHint"></div>
        </div>

        <!-- Request Information -->
        <div class="adf-section">
            <div class="adf-section-title"><i class="fa fa-file-text-o"></i> Request Information</div>

            <div class="adf-info-main">
                <div class="adf-info-field">
                    <i class="fa fa-building-o"></i>
                    <div>
                        <div class="adf-info-label">Division</div>
                        <div class="adf-info-value" id="approvalDivision"></div>
                    </div>
                </div>
                <div class="adf-info-field">
                    <i class="fa fa-sitemap"></i>
                    <div>
                        <div class="adf-info-label">Department</div>
                        <div class="adf-info-value" id="approvalDepartment"></div>
                    </div>
                </div>
                <div class="adf-info-field">
                    <i class="fa fa-sitemap"></i>
                    <div>
                        <div class="adf-info-label">Section</div>
                        <div class="adf-info-value" id="approvalSection"></div>
                    </div>
                </div>
                <div class="adf-info-field">
                    <i class="fa fa-user"></i>
                    <div>
                        <div class="adf-info-label">Requested By</div>
                        <div class="adf-info-value" id="approvalRequestedBy"></div>
                    </div>
                </div>
                <div class="adf-info-field">
                    <i class="fa fa-calendar"></i>
                    <div>
                        <div class="adf-info-label">Request Date</div>
                        <div class="adf-info-value" id="approvalRequestDate"></div>
                    </div>
                </div>
                <div class="adf-info-field">
                    <i class="fa fa-list-alt"></i>
                    <div>
                        <div class="adf-info-label">Total Documents</div>
                        <div class="adf-info-value" id="approvalTotalDocuments"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Document list, so QMS can eyeball it against the physical form -->
        <div class="adf-section">
            <div class="adf-section-title"><i class="fa fa-file-o"></i> Requested Documents</div>
            <div id="approvalDocumentList"></div>
        </div>

        <!-- Action / already-decided remark -->
        <div class="adf-section" id="approvalActionSection">
            <div class="adf-section-title" id="approvalActionTitle"><i class="fa fa-check-circle-o"></i> QMS Review</div>

            <div id="approvalActionInput">
                <p><b>Remark (optional):</b></p>
                <textarea id="approvalRemark" rows="4" class="form-control"></textarea>
                <div class="text-right" style="margin-top: 14px">
                    <button type="button" class="btn btn-primary" id="btn_approve"><i class="fa fa-check"></i> Approve</button>
                    <button type="button" class="btn btn-reject" id="btn_reject"><i class="fa fa-ban"></i> Reject</button>
                </div>
            </div>

            <div id="approvalActionReadonly" style="display:none;">
                <div class="adf-info-label" style="margin-bottom:6px;">Remark</div>
                <div class="adf-remark-readonly" id="approvalRemarkReadonly">-</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#btn_closeApprovalPanel").on("click", function () {
            $("#approvalPanel").removeClass("open");
        });

        // Klik di luar panel menutup panel - klik pada elemen yang MEMBUKA
        // panel ini (Request No/kebab "View Approval" di grid) sudah
        // stopPropagation() masing-masing jadi tidak langsung menutup ulang
        // panel yang baru dibuka.
        $(document).on("click", function (e) {
            if ($("#approvalPanel").hasClass("open") && !$(e.target).closest("#approvalPanel").length) {
                $("#approvalPanel").removeClass("open");
            }
        });
    });
</script>
