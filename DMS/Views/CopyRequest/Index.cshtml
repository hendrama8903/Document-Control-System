<link rel="stylesheet" href="~/css/views/CopyRequest/Index.css" asp-append-version="true" />
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-layout-row stats-collapsed" id="dpLayoutRow">
                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                <aside class="dp-stats-panel" id="dpStatsPanel">
                    <div class="dp-stats-panel-head">
                        <span>Document Status</span>
                        <button type="button" class="dp-stats-panel-close" id="btn_closeStatsPanel"><i class="fa fa-times"></i></button>
                    </div>
                    <div class="dp-stats-panel-body" id="crStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-hourglass-half"></i></div>
                            <div>
                                <span>Waiting Approval</span>
                                <b id="crWaitingApproval">-</b>
                                <small>Requests</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Approved</span>
                                <b id="crApproved">-</b>
                                <small>Requests</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon red"><i class="fa fa-times-circle"></i></div>
                            <div>
                                <span>Rejected</span>
                                <b id="crRejected">-</b>
                                <small>Requests</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-calendar"></i></div>
                            <div>
                                <span>Approved Today</span>
                                <b id="crApprovedToday">-</b>
                                <small>Requests</small>
                            </div>
                        </div>
                    </div>
                    <div class="dp-stats-panel-foot">
                        <a href="@Url.Action("Index", "Home")" class="dp-stats-viewall"><i class="fa fa-bar-chart"></i>View All Statistics</a>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_PopupForm")
@Html.Partial("_ApprovalForm")
@Html.Partial("_PrintLogPanel")
@Html.Partial("_Javascript")
