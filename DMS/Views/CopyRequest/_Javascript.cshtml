@using Microsoft.AspNetCore.Http

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<script type="text/javascript">
    var copyRequestConfig = {
        canEdit: @(((bool)ViewData["Edit"]) ? "true" : "false"),
        canDelete: @(((bool)ViewData["Delete"]) ? "true" : "false"),
        canSubmit: @(((bool)ViewData["Submit"]) ? "true" : "false"),
        canPrint: @(((bool)ViewData["Print"]) ? "true" : "false"),
        canApprove: @(((bool)ViewData["Approve"]) ? "true" : "false"),
        sessionDivision: "@Html.Raw(HttpContextAccessor.HttpContext.Session.GetString("DIVISION"))",
        sessionDepartmentId: "@Html.Raw(HttpContextAccessor.HttpContext.Session.GetInt32("DEPARTMENT_ID"))",
        sessionSectionCode: "@Html.Raw(HttpContextAccessor.HttpContext.Session.GetString("SECTION_CODE"))",
        sessionUsername: "@Html.Raw(HttpContextAccessor.HttpContext.Session.GetString("USERNAME"))",
        urls: {
            search: "@Url.Action("Search", "CopyRequest")",
            printForm: "@Url.Action("PrintForm", "CopyRequest")",
            exportExcel: "@Url.Action("ExportExcel", "CopyRequest")",
            mSystemSearchSystem: "@Url.Action("SearchSystem", "MSystem")",
            addEdit: "@Url.Action("AddEdit", "CopyRequest")",
            deleteDetail: "@Url.Action("DeleteDetail", "CopyRequest")",
            addEditDetail: "@Url.Action("AddEditDetail", "CopyRequest")",
            deleteData: "@Url.Action("Delete", "CopyRequest")",
            submit: "@Url.Action("Submit", "CopyRequest")",
            searchDetail: "@Url.Action("SearchDetail", "CopyRequest")",
            searchApprovedDocuments: "@Url.Action("SearchApprovedDocuments", "CopyRequest")",
            approveReject: "@Url.Action("ApproveReject", "CopyRequest")"
        }
    };
</script>
<script src="~/js/views/copy-request.js" asp-append-version="true"></script>
