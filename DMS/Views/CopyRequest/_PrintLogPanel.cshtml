            <!-- Panel monitoring cetak fisik (PrintTrack, read-only) - side panel
                 geser dari kanan (BUKAN modal), pola sama persis
                 DocumentControlDashboard/_AcceptanceDetailPopup.cshtml (request
                 Hendra 2026-08-15). Kartu bertumpuk (BUKAN dxDataGrid berkolom
                 banyak) - lebar panel cuma ~460px, tabel 6+ kolom (Document/
                 Qty/Status/Printer/Sheets/Operator/Waktu) memaksa scroll ke
                 samping terus-menerus; nama dokumen butuh wrap bebas, bukan
                 dipepet lebar kolom (request Hendra 2026-08-15). -->
<style>
    #printLogPanel {
        position: fixed;
        top: 0;
        right: 0;
        width: 460px;
        max-width: 92vw;
        height: 100vh;
        background: #fff;
        box-shadow: -8px 0 24px rgba(20,35,50,.18);
        z-index: 1050;
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform .22s cubic-bezier(.4,0,.2,1);
    }

    #printLogPanel.open { transform: translateX(0); }

    #printLogPanel .plf-header {
        background: #fff;
        color: #101828;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #EEF1F5;
        position: relative;
        flex: none;
    }

    #printLogPanel .plf-header-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #E7F1FB;
        color: #2450D8;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: none;
        font-size: 15px;
    }

    #printLogPanel .plf-header-title { font-size: 14px; font-weight: 700; color: #101828; }
    #printLogPanel .plf-header-sub { font-size: 12px; color: #8A94A3; margin-top: 2px; }

    #printLogPanel .plf-close {
        background: none;
        border: none;
        color: #98A2B3;
        font-size: 13px;
        cursor: pointer;
        padding: 2px;
        margin-left: auto;
    }

    #printLogPanel .plf-close:hover { color: #475467; }

    #printLogPanel .panel-body { padding: 16px 18px; flex: 1 1 auto; overflow-y: auto; overflow-x: hidden; }

    #printLogPanel .plp-search {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #E3E8EE;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 14px;
    }

    #printLogPanel .plp-card {
        border: 1px solid #E3E8EE;
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 10px;
    }

    #printLogPanel .plp-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
    }

    #printLogPanel .plp-doc-code { font-weight: 700; font-size: 13px; color: #1C3FA6; }
    #printLogPanel .plp-doc-name { font-size: 12px; color: #475467; margin-top: 2px; line-height: 1.4; }

    #printLogPanel .plp-qty { font-size: 11.5px; color: #66788A; white-space: nowrap; margin-top: 2px; }

    #printLogPanel .plp-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 999px;
        white-space: nowrap;
        flex: none;
    }
    #printLogPanel .plp-pill-success { background: #E4F7EC; color: #1E9E63; }
    #printLogPanel .plp-pill-danger { background: #FDECEA; color: #C62828; }
    #printLogPanel .plp-pill-default { background: #F1F3F6; color: #66788A; }

    #printLogPanel .plp-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 16px;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid #EEF1F4;
        font-size: 11.5px;
        color: #5A6472;
    }
    #printLogPanel .plp-card-meta span { display: inline-flex; align-items: center; gap: 5px; }
    #printLogPanel .plp-card-meta i { color: #8A94A6; width: 12px; text-align: center; }
    #printLogPanel .plp-card-error { margin-top: 8px; font-size: 11.5px; color: #C62828; }
    #printLogPanel .plp-empty { text-align: center; color: #98A2B3; font-size: 12.5px; padding: 30px 10px; }
</style>

<div id="printLogPanel">
    <div class="plf-header">
        <div class="plf-header-icon"><i class="fa fa-print"></i></div>
        <div>
            <div class="plf-header-title">Print Detail</div>
            <div class="plf-header-sub" id="plpRequestNo">-</div>
        </div>
        <button type="button" class="plf-close" id="btn_closePrintLogPanel"><i class="fa fa-times"></i></button>
    </div>
    <div class="panel-body">
        <input type="text" class="plp-search" id="plpSearch" placeholder="Search document...">
        <div id="plpCardList"></div>
    </div>
</div>

<script type="text/javascript">
    var plpRows = [];

    function crOpenPrintLog(row) {
        $("#plpRequestNo").text(row.REQUEST_NO || "Draft");
        $("#plpSearch").val("");
        $("#printLogPanel").addClass("open");

        $.ajax({
            type: "POST",
            url: "@Url.Action("SearchPrintLog", "CopyRequest")",
            data: { requestId: row.REQUEST_ID },
            success: function (result) {
                plpRows = (result.status && result.data) ? result.data : [];
                renderPrintLogCards(plpRows);
            },
            error: function () {
                showErrorMesgGrowl("Failed to load print detail");
            }
        });
    }

    function printLogStatusPill(d) {
        var pillClass = "plp-pill-default";
        var pillText = "Not Printed";

        if (d.PRINT_LOG_ID != null) {
            if (d.LOG_PRINT_STATUS == "Success") {
                pillClass = "plp-pill-success";
                pillText = "Success";
            } else if (d.LOG_PRINT_STATUS == "Failed") {
                pillClass = "plp-pill-danger";
                pillText = "Failed";
            } else {
                pillClass = "plp-pill-default";
                pillText = d.LOG_PRINT_STATUS || "Cancelled";
            }
        }

        return '<span class="plp-pill ' + pillClass + '">' + pillText + '</span>';
    }

    function renderPrintLogCards(rows) {
        var $list = $("#plpCardList").empty();

        if (!rows || rows.length === 0) {
            $list.html('<div class="plp-empty"><i class="fa fa-inbox" style="font-size:24px; display:block; margin-bottom:8px; color:#C0C6CE;"></i>No documents in this request.</div>');
            return;
        }

        rows.forEach(function (d) {
            var $card = $('<div class="plp-card"></div>');

            var $top = $('<div class="plp-card-top"></div>');
            $('<div>')
                .append($('<div class="plp-doc-code"></div>').text(d.DOCUMENT_CODE || "-"))
                .append($('<div class="plp-doc-name"></div>').text(d.DOCUMENT_NAME || ""))
                .append($('<div class="plp-qty"></div>').text("Qty " + (d.COPY_QTY != null ? d.COPY_QTY : "-")))
                .appendTo($top);
            $(printLogStatusPill(d)).appendTo($top);
            $top.appendTo($card);

            // Baris meta (printer/lembar/operator/waktu) cuma relevan kalau
            // sudah pernah dicetak (punya PRINT_LOG_ID) - dokumen yang belum
            // dicetak sama sekali cukup ditampilkan qty + pill saja.
            if (d.PRINT_LOG_ID != null) {
                var $meta = $('<div class="plp-card-meta"></div>');
                if (d.PRINTER_NAME) {
                    $meta.append($('<span>').html('<i class="fa fa-print"></i> ' + d.PRINTER_NAME));
                }
                if (d.TOTAL_SHEETS != null) {
                    $meta.append($('<span>').html('<i class="fa fa-file-text-o"></i> ' + d.TOTAL_SHEETS + ' sheets'));
                }
                if (d.PRINTED_BY) {
                    $meta.append($('<span>').html('<i class="fa fa-user"></i> ' + d.PRINTED_BY));
                }
                if (d.PRINTED_DT) {
                    $meta.append($('<span>').html('<i class="fa fa-clock-o"></i> ' + moment(d.PRINTED_DT).format("DD MMM YYYY HH:mm")));
                }
                $meta.appendTo($card);

                if (d.LOG_PRINT_STATUS == "Failed" && d.ERROR_DETAIL) {
                    $('<div class="plp-card-error"></div>').html('<i class="fa fa-exclamation-circle"></i> ' + d.ERROR_DETAIL).appendTo($card);
                }
            }

            $card.appendTo($list);
        });
    }

    $(document).ready(function () {
        $("#btn_closePrintLogPanel").on("click", function () {
            $("#printLogPanel").removeClass("open");
        });

        // Klik di luar panel menutup panel - klik pada sel Print sendiri sudah
        // stopPropagation() jadi tidak akan langsung menutup ulang panel yang
        // baru dibuka.
        $(document).on("click", function (e) {
            if ($("#printLogPanel").hasClass("open") && !$(e.target).closest("#printLogPanel").length) {
                $("#printLogPanel").removeClass("open");
            }
        });

        $("#plpSearch").on("input", function () {
            var term = $(this).val().toLowerCase();
            if (!term) {
                renderPrintLogCards(plpRows);
                return;
            }

            var filtered = plpRows.filter(function (d) {
                return ((d.DOCUMENT_CODE || "") + " " + (d.DOCUMENT_NAME || "")).toLowerCase().indexOf(term) !== -1;
            });
            renderPrintLogCards(filtered);
        });
    });
</script>
