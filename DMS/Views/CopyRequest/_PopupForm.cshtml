<link rel="stylesheet" href="~/css/views/shared/request-popup.css" asp-append-version="true" />

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Header -->
            <div class="adf-header">
                <div class="adf-header-icon"><i class="fa fa-plus"></i></div>
                <div class="adf-header-title" id="modal-title">New Print Request</div>
                <button type="button" class="adf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <input type="hidden" id="addEditRequestId" />
                <input type="hidden" id="addEditSection" />

                <div class="adf-section">
                    <div class="adf-section-title"><span class="adf-section-icon"><i class="fa fa-folder-o"></i></span> Jenis Dokumen</div>
                    <div class="category-checks" id="docCategoryContainer"></div>
                </div>

                <div class="row-sections">
                    <div>
                        <div class="adf-section">
                            <div class="adf-section-title"><span class="adf-section-icon"><i class="fa fa-calendar-o"></i></span> Tanggal Permohonan <span class="text-red">*</span></div>
                            <input class="form-control" id="addEditRequestDate" type="date" />
                        </div>
                    </div>
                    <div>
                        <div class="adf-section">
                            <div class="adf-section-title"><span class="adf-section-icon"><i class="fa fa-comment-o"></i></span> Remark <span class="text-muted" style="font-weight:normal;">(optional)</span></div>
                            <textarea class="form-control" rows="2" id="addEditRemark" placeholder="Enter remark (optional)"></textarea>
                        </div>
                    </div>
                </div>

                <div class="adf-section" id="detailGridWrap">
                    <div style="display:flex; align-items:center; justify-content:space-between;">
                        <div>
                            <div class="adf-section-title" style="margin-bottom:2px;"><span class="adf-section-icon"><i class="fa fa-file-text-o"></i></span> Dokumen yang Diminta</div>
                            <div class="adf-section-sub">Pilih dokumen yang sudah terdaftar &amp; approved untuk diminta salinannya.</div>
                        </div>
                        <button type="button" class="btn dp-btn dp-btn-outline-primary" id="btn_addDetailRow"><i class="fa fa-plus"></i> Add Document</button>
                    </div>
                    <table id="detailGrid" class="table table-bordered table-condensed" width="100%" style="margin-top: 8px;">
                        <thead>
                            <tr>
                                <th width="35px">No</th>
                                <th>No. Dokumen</th>
                                <th>Nama Dokumen</th>
                                <th width="60px">Qty</th>
                                <th width="90px">HP / Warna</th>
                                <th width="70px">Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn dp-btn dp-btn-outline" id="btn_cancel" data-dismiss="modal"><i class="fa fa-times"></i> Close</button>
                <button type="button" class="btn dp-btn dp-btn-primary" id="btn_save"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_DetailRowPopupForm")
@Html.Partial("_DocumentPickerPopupForm")
