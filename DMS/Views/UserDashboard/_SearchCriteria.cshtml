<div class="box-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; padding:0 0 14px 0;">
    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
        @if ((bool)ViewData["Acknowledge"])
        {
            <button type="button" class="btn btn-success btn-sm" id="btn_acknowledge" style="min-width: 84px;"><i class="fa fa-share-square-o"></i> Acknowledge</button>
        }
    </div>
    <div style="display:flex; align-items:center; gap:6px;">
        @if ((bool)ViewData["Request"])
        {
            <button type="button" class="btn btn-success btn-sm" id="btn_request" style="min-width: 84px;"><i class="fa fa-plus"></i> Request</button>
        }
        <button type="button" class="btn btn-primary btn-sm" id="btn_export" style="min-width: 100px;"><i class="fa fa-file-excel-o"></i> Export</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
    </div>
</div>
