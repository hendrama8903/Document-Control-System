            <!-- RECOMMIT DINA -->
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="divTitle">
                <div class="dp-header">
                    <div class="dp-header-left">
                        <div class="dp-header-icon"><i class="fa fa-folder-open"></i></div>
                        <div>
                            <h1>@ViewData["Title"]</h1>
                            <p>All documents that have been approved and are effective. You can view, download, and acknowledge the documents.</p>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        @if ((bool)ViewData["Request"])
                        {
                            <button type="button" class="dp-btn dp-btn-success" id="btn_request"><i class="fa fa-plus"></i> Request Document</button>
                        }
                        <button type="button" class="dp-btn dp-btn-primary" id="btn_export"><i class="fa fa-file-excel-o"></i> Export</button>
                        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
                    </div>
                    <div class="dp-header-stats dp-header-stats-grid">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-file-text-o"></i></div>
                            <div>
                                <span>Total Documents</span>
                                <b id="udTotal">-</b>
                                <small>All effective documents</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Acknowledged</span>
                                <b id="udAcknowledged">-</b>
                                <small id="udAcknowledgedPct">&nbsp;</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-hourglass-half"></i></div>
                            <div>
                                <span>Not Acknowledged</span>
                                <b id="udNotAcknowledged">-</b>
                                <small id="udNotAcknowledgedPct">&nbsp;</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-calendar"></i></div>
                            <div>
                                <span>Next Review (30 Days)</span>
                                <b id="udNextReview">-</b>
                                <small>Documents need review</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon red"><i class="fa fa-times-circle"></i></div>
                            <div>
                                <span>Obsolete</span>
                                <b id="udObsolete">-</b>
                                <small>No longer in use</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dp-card">
                <div id="divSearch">
                    @Html.Partial("_SearchCriteria")
                </div>
                <div id="divGrid">
                    @Html.Partial("_GridView")
                </div>
            </div>
        </div>
    </div>
</section>
@Html.Partial("_PopupForm")
@Html.Partial("_Javascript")
