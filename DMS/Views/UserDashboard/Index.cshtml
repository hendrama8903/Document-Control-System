            <!-- RECOMMIT DINA -->
<link rel="stylesheet" href="~/css/views/UserDashboard/Index.css" asp-append-version="true" />
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            @* My Documents / Reference Documents (2026-11-18): since 2026-11-19 a switch at the start of
               each card's toolbar (like List | Matrix of the Masterlist), partial _ViewSwitch. *@
            <div class="dp-card ud-ref-panel" id="udRefPanel" style="display:none;">
                <div class="box-header dp-toolbar">
                    <div class="dp-toolbar-left">
                        @await Html.PartialAsync("_ViewSwitch", "reference")
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_refRefresh"><i class="fa fa-refresh"></i> Refresh</button>
                    </div>
                </div>
                <div class="box-body dms-grid">
                    <div class="ud-ref-intro">
                        <i class="fa fa-info-circle"></i>
                        <span><b>Read only.</b> Shared by Document Control until the access ends. Opens as <b>UNCONTROLLED COPY</b>, no download or print.</span>
                    </div>
                    <div id="refGrid"></div>
                </div>
            </div>

            @* folders-hidden (2026-11-19): no folder sidebar, folder title or subfolder list and no Move to
               Folder; Waiting for Acceptance is a toolbar button. Remove the class to bring folders back. *@
            <div class="dp-layout-row stats-collapsed folders-hidden" id="dpLayoutRow">
                @{ ViewData["FolderController"] = "UserDashboard"; }
                @Html.Partial("~/Views/DocumentControlDashboard/_FolderTree.cshtml")

                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div class="dcd-folder-header-block">
                            @* plain path, shown only inside a folder (e.g. My Folders › Pedoman) *@
                            <div class="dcd-crumb" id="dcdCrumb"></div>
                            <div class="dcd-folder-title-row">
                                <span class="dcd-folder-title" id="dcdFolderTitle">All Documents</span>
                                <span class="dcd-folder-subtitle" id="dcdFolderSubtitle"></span>
                            </div>
                        </div>
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        @* Subfolders of the open location, listed above its documents like File Explorer *@
                        <div class="ud-folder-list" id="udFolderList"></div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                <aside class="dcd-stats-panel" id="dpStatsPanel">
                    <div class="dp-stats-panel-head">
                        <span>Document Status</span>
                        <button type="button" class="dp-stats-panel-close" id="btn_closeStatsPanel"><i class="fa fa-times"></i></button>
                    </div>
                    <div class="dp-stats-panel-body" id="udStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-file-text-o"></i></div>
                            <div>
                                <span>Total Documents</span>
                                <b id="udTotal">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Accepted</span>
                                <b id="udAcknowledged">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-hourglass-half"></i></div>
                            <div>
                                <span>Waiting Acceptance</span>
                                <b id="udNotAcknowledged">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon red"><i class="fa fa-times-circle"></i></div>
                            <div>
                                <span>Obsolete</span>
                                <b id="udObsolete">-</b>
                            </div>
                        </div>
                    </div>
                    <div class="dp-stats-panel-foot">
                        <a href="@Url.Action("Index", "Home")" class="dp-stats-viewall"><i class="fa fa-bar-chart"></i>View All Statistics</a>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>
@Html.Partial("_Javascript")
