<style>
    #modalDocumentPicker .modal-dialog { width: 760px; max-width: 96vw; }
    #modalDocumentPicker table.dataTable td { vertical-align: middle; }
    #modalDocumentPicker .picker-type-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    #modalDocumentPicker .picker-type-baru { background: #E6F4EA; color: #1E7E34; }
    #modalDocumentPicker .picker-type-revisi { background: #E7F1FB; color: #2E75B6; }
</style>

<div class="modal fade" id="modalDocumentPicker" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title">Add Document</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <p class="text-muted" style="margin-bottom:10px; font-size:12.5px;">Documents already registered in P4D, not yet approved there. Check the ones to include, then Add Selected.</p>

                <table id="pickerGrid" class="table table-bordered table-condensed" width="100%">
                    <thead>
                        <tr>
                            <th width="30px"></th>
                            <th>No. Dokumen</th>
                            <th>Nama Dokumen</th>
                            <th width="80px">Jenis</th>
                            <th width="80px">Status</th>
                        </tr>
                    </thead>
                </table>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal" style="width: 80px;">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn_addSelectedDocuments">Add Selected (<span id="pickerSelectedCount">0</span>)</button>
            </div>
        </div>
    </div>
</div>
