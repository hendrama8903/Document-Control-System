<link rel="stylesheet" href="~/css/views/DocumentSubmission/Index.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/shared/master-stats-panel.css" asp-append-version="true" />
@* Same layout as the other list pages (2026-11-16): toolbar inside the card and a collapsible
   summary panel beside the grid, instead of a page header with KPI cards above it. *@
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-layout-row stats-collapsed" id="dpLayoutRow">
                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                <aside class="dp-stats-panel" id="dpStatsPanel">
                    <div class="dp-stats-panel-head">
                        <span>Submission Summary</span>
                        <button type="button" class="dp-stats-panel-close" id="btn_closeStatsPanel"><i class="fa fa-times"></i></button>
                    </div>
                    <div class="dp-stats-panel-body" id="dsStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-file-text-o"></i></div>
                            <div>
                                <span>Total Submissions</span>
                                <b id="dsTotalSubmissions">-</b>
                                <small>Forms</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-calendar-check-o"></i></div>
                            <div>
                                <span>This Month</span>
                                <b id="dsThisMonth">-</b>
                                <small>Forms</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-clone"></i></div>
                            <div>
                                <span>Documents Bundled</span>
                                <b id="dsDocumentsBundled">-</b>
                                <small>Documents</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-clock-o"></i></div>
                            <div>
                                <span>Latest Submission</span>
                                <b id="dsLatestSubmission">-</b>
                                <small>&nbsp;</small>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_PopupForm")
@Html.Partial("_ApprovalForm")
@Html.Partial("_Javascript")
