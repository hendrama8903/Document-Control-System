<link rel="stylesheet" href="~/css/devextreme/dx.light.css" />
<script src="~/js/devextreme/dx.web.js"></script>

<style>
    .dp-count-chip {
        display: inline-block;
        min-width: 22px;
        padding: 2px 8px;
        border-radius: 20px;
        background: #E7F1FB;
        color: #2E75B6;
        font-size: 12px;
        font-weight: 700;
    }
</style>

<div class="box-body">
    <div id="datagrid"></div>
</div>

<script type="text/javascript">
    var gCanEdit = @(((bool)ViewData["Edit"]) ? "true" : "false");
    var gCanDelete = @(((bool)ViewData["Delete"]) ? "true" : "false");
    var gCanPrint = @(((bool)ViewData["Print"]) ? "true" : "false");

    function getSelectedRowData() {
        var rows = $("#datagrid").dxDataGrid("instance").getSelectedRowsData();
        return rows.length > 0 ? rows[0] : null;
    }

    function updateActionButtons() {
        var row = getSelectedRowData();
        var editable = row != null && row.STATUS == "0";

        $("#btn_edit").prop("disabled", !editable);
        $("#btn_delete").prop("disabled", !editable);
    }

    function computeGridHeight() {
        var gridTop = $("#datagrid").offset().top;
        var footerHeight = $("#divFooter").outerHeight(true) || 0;

        return Math.max(300, $(window).height() - gridTop - footerHeight - 40);
    }

    $(document).ready(function () {
        $("#btn_add").prop("disabled", false);
        $("#btn_edit").prop("disabled", true);
        $("#btn_delete").prop("disabled", true);

        var gridStore = new DevExpress.data.CustomStore({
            key: "SUBMISSION_ID",
            loadMode: "raw",
            load: function () {
                var d = $.Deferred();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Search", "DocumentSubmission")",
                    data: {
                        draw: 1,
                        start: 0,
                        length: 100000,
                        initialMode: false
                    }
                }).done(function (result) {
                    d.resolve(result.data == "" ? [] : result.data);
                }).fail(function () {
                    d.reject("Data loading error");
                });

                return d.promise();
            }
        });

        $("#datagrid").dxDataGrid({
            dataSource: gridStore,
            showBorders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            wordWrapEnabled: false,
            sorting: { mode: "none" },
            noDataText: "Data not found.",
            height: computeGridHeight(),
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            toolbar: { visible: false },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always",
                allowSelectAll: false
            },
            paging: { pageSize: 10 },
            pager: {
                visible: true,
                displayMode: "compact",
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true,
                showNavigationButtons: true
            },
            columnChooser: {
                enabled: true,
                mode: "select"
            },
            columnFixing: { enabled: true },
            onSelectionChanged: function (e) {
                if (e.selectedRowKeys.length > 1) {
                    e.component.selectRows(e.currentSelectedRowKeys, false);
                    return;
                }
                updateActionButtons();
            },
            columns: [
                { type: "selection", width: 40, fixed: true, fixedPosition: "left" },
                {
                    caption: "No",
                    width: 50,
                    alignment: "center",
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex();
                        var pageSize = options.component.pageSize();
                        container.text(pageIndex * pageSize + options.row.rowIndex + 1);
                    }
                },
                {
                    dataField: "SUBMISSION_NO",
                    caption: "Submission No",
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        if (!row.SUBMISSION_NO) {
                            container.text("-");
                            return;
                        }

                        $("<button>")
                            .attr("type", "button")
                            .addClass("dp-link")
                            .text(row.SUBMISSION_NO)
                            .on("click", function () {
                                $("#datagrid").dxDataGrid("instance").selectRows([row.SUBMISSION_ID], false);
                                onEditPrepare();
                            })
                            .appendTo(container);
                    }
                },
                {
                    dataField: "SUBMISSION_DATE",
                    caption: "Submission Date",
                    alignment: "right",
                    cellTemplate: function (container, options) {
                        var value = options.data.SUBMISSION_DATE;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY") : "");
                    }
                },
                { dataField: "DIVISION_NAME", caption: "Division" },
                { dataField: "DEPARTMENT_NAME", caption: "Department" },
                { dataField: "SECTION_NAME", caption: "Section" },
                {
                    dataField: "DETAIL_COUNT",
                    caption: "Documents",
                    alignment: "center",
                    cellTemplate: function (container, options) {
                        $("<span>").addClass("dp-count-chip").text(options.data.DETAIL_COUNT || 0).appendTo(container);
                    }
                },
                { dataField: "CREATED_BY", caption: "Created By" },
                {
                    dataField: "CREATED_DT",
                    caption: "Created Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CREATED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY hh:mm:ss") : "");
                    }
                },
                {
                    caption: "Action",
                    alignment: "center",
                    width: 70,
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<button>")
                            .attr({ type: "button", title: "More actions" })
                            .addClass("dp-act-kebab")
                            .html('<i class="fa fa-ellipsis-v"></i>')
                            .on("click", function (e) {
                                e.stopPropagation();
                                openRowActionMenu($(this), row);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });

        $("#btn_columns").on("click", function () {
            $("#datagrid").dxDataGrid("instance").showColumnChooser();
        });

        $("#btn_refresh").on("click", function () {
            $("#datagrid").dxDataGrid("instance").clearSelection();
            $("#datagrid").dxDataGrid("instance").refresh();
        });

        $(window).on("resize", function () {
            $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
        });

        $('body').tooltip({ selector: '[data-toggle="tooltip"]' });
    });

    // ---------- per-row "more actions" kebab menu ----------
    var $dsRowMenu = null;

    function buildRowActionMenu() {
        if ($dsRowMenu) return $dsRowMenu;

        $dsRowMenu = $('<ul class="dropdown-menu dp-dropdown-menu" role="menu"></ul>')
            .css({ position: "absolute", display: "none", "z-index": 2000, "min-width": "170px" })
            .appendTo("body");

        $(document).on("click", function () {
            $dsRowMenu.hide();
        });

        return $dsRowMenu;
    }

    function menuItem(cssClass, icon, label, onClick) {
        var $li = $('<li><a href="#" class="' + cssClass + '"><i class="fa ' + icon + '"></i> ' + label + '</a></li>');
        $li.find("a").on("click", function (e) {
            e.preventDefault();
            $dsRowMenu.hide();
            onClick();
        });
        return $li;
    }

    function openRowActionMenu($btn, row) {
        var $menu = buildRowActionMenu();
        $menu.empty();

        if (gCanEdit) {
            $menu.append(menuItem("ds-menu-edit", "fa-pencil-square-o", "Edit", function () {
                var grid = $("#datagrid").dxDataGrid("instance");
                grid.selectRows([row.SUBMISSION_ID], false);
                onEditPrepare();
            }));
        }

        if (gCanPrint) {
            $menu.append(menuItem("ds-menu-print", "fa-print", "Print Form", function () {
                window.open("@Url.Action("PrintForm", "DocumentSubmission")?submissionId=" + row.SUBMISSION_ID, "_blank");
            }));
            $menu.append(menuItem("ds-menu-export-excel", "fa-file-excel-o", "Export Excel", function () {
                window.open("@Url.Action("ExportExcel", "DocumentSubmission")?submissionId=" + row.SUBMISSION_ID, "_blank");
            }));
        }

        if (gCanDelete) {
            $menu.append('<li class="divider"></li>');
            $menu.append(menuItem("ds-menu-delete", "fa-trash-o", "Delete", function () {
                var grid = $("#datagrid").dxDataGrid("instance");
                grid.selectRows([row.SUBMISSION_ID], false);
                onDeletePrepare();
            }));
        }

        var offset = $btn.offset();
        $menu.css({ top: offset.top + $btn.outerHeight() + 4, left: offset.left - $menu.outerWidth() + $btn.outerWidth() })
            .show();
    }
</script>
