<style>
    /* ---------- KPI cards moved out of the top header into a docked
       right-side panel (request Hendra 2026-08-17: same treatment as
       Document Preparation/Registration). ---------- */
    /* flex-wrap (not a max-width breakpoint) keeps Folders + Register Overview
       side by side as long as they both fit (request Hendra 2026-08-29: "sejajar
       seperti pada mockup") - only the main grid card (last in source order, and
       the one that needs the most room) drops to its own line once the row runs
       out of width. On a genuinely narrow/phone viewport, Folders and Register
       Overview eventually wrap onto separate lines too, each still keeping its
       own fixed card width rather than stretching full-width. */
    .dp-layout-row {
        display: flex;
        align-items: stretch;
        flex-wrap: wrap;
        row-gap: 16px;
    }
    .dp-layout-main {
        flex: 1 1 420px;
        min-width: 420px;
        display: flex;
        flex-direction: column;
    }
    .dp-layout-main .dp-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }
    .dp-layout-main .dp-card #divGrid {
        flex: 1 1 auto;
        min-height: 0;
    }

    /* toggle lives in the grid toolbar - a plain toolbar button so it never
       overlaps grid content, matching the other icon buttons there. */
    .dp-stats-toggle {
        position: relative;
        color: #2450D8;
        border-color: #C7D9F7;
        background: #F4F8FF;
    }
    .dp-stats-toggle:hover {
        background: #E7F1FB;
        border-color: #2450D8;
    }
    .dp-stats-toggle-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 999px;
        background: #D64545;
        color: #fff;
        font-size: 9.5px;
        font-weight: 800;
        display: none;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
    }

    .dp-stats-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        border-bottom: 1px solid #EEF1F5;
        white-space: nowrap;
    }
    .dp-stats-panel-head span {
        font-size: 14px;
        font-weight: 700;
        color: #101828;
    }
    .dp-stats-panel-close {
        background: none;
        border: none;
        color: #98A2B3;
        font-size: 13px;
        cursor: pointer;
        padding: 2px;
    }
    .dp-stats-panel-close:hover { color: #475467; }

    .dp-stats-panel-body {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px 18px;
        white-space: nowrap;
    }
    .dp-stats-panel-body .dp-stat-card {
        width: 100%;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
    }
    .dp-stats-panel-body .dp-stat-card:hover {
        border-color: #D5DDE8;
    }

    .dp-stats-panel-foot {
        padding: 6px 18px 18px;
    }
    .dp-stats-viewall {
        display: block;
        width: 100%;
        text-align: center;
        padding: 9px 12px;
        border: 1px solid #D5DDE8;
        border-radius: 10px;
        font-size: 12.5px;
        font-weight: 600;
        color: #2450D8;
        text-decoration: none;
        white-space: nowrap;
    }
    .dp-stats-viewall:hover { background: #F4F8FF; color: #2450D8; text-decoration: none; }
    .dp-stats-viewall i { margin-right: 6px; }

    /* Register Overview (request Hendra 2026-08-29: same row as Folders, both
       fixed-width sidebar cards side by side ("sejajar seperti pada mockup"),
       stretched to match height via the row's align-items:stretch - not stacked,
       not fused into Folders' own card. Each keeps its OWN independent show/hide
       toggle ("keduanya bisa show hide" - restored 2026-08-29): Folders defaults
       shown (folders-collapsed), Register Overview defaults hidden
       (stats-collapsed) - same default as before this whole feature existed. */
    .dcd-stats-panel {
        flex: 0 0 260px;
        width: 260px;
        margin-right: 16px;
        background: #fff;
        border: 1px solid #E3E8EF;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(16,24,40,.04);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: flex-basis .22s cubic-bezier(.4,0,.2,1), width .22s cubic-bezier(.4,0,.2,1),
                    margin-right .22s cubic-bezier(.4,0,.2,1), opacity .18s ease, border-color .22s ease, box-shadow .22s ease;
    }
    .dp-layout-row.stats-collapsed .dcd-stats-panel {
        flex-basis: 0;
        width: 0;
        margin-right: 0;
        opacity: 0;
        border-color: transparent;
        box-shadow: none;
        pointer-events: none;
    }

    /* Only on a genuinely narrow (phone-width) viewport, where even Folders +
       Register Overview alone (260+16+260px) no longer fit side by side, let the
       collapse toggles recede - collapsing wouldn't free up meaningful room once
       everything's already wrapped onto its own line. */
    @@media (max-width: 560px) {
        #btn_toggleFolders, #btn_toggleStats { display: none; }
    }
</style>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-layout-row stats-collapsed" id="dpLayoutRow">
                @Html.Partial("_FolderTree")

                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div class="dcd-folder-header-block">
                            <div class="dcd-crumb" id="dcdCrumb"></div>
                            <div class="dcd-folder-title-row">
                                <span class="dcd-folder-title" id="dcdFolderTitle">All Documents</span>
                                <span class="dcd-folder-subtitle" id="dcdFolderSubtitle"></span>
                            </div>
                        </div>
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                @Html.Partial("_RegisterOverview")
            </div>
        </div>
    </div>
</section>
@Html.Partial("_AcceptanceDetailPopup")
@Html.Partial("~/Views/DocumentMaintenance/_DocumentHistoryPopup.cshtml")
@Html.Partial("_Javascript")
