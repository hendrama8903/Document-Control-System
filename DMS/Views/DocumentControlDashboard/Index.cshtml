            <!-- RECOMMIT DINA -->
<style>
    /* site.css forces .fa-chevron-up/-down to white globally (for a dark-background
       use elsewhere) - override back to the normal dp-icon-btn color for this button. */
    #btn_toggleStats i {
        color: #344054;
    }
</style>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="divTitle">
                <div class="dp-header">
                    <div class="dp-header-left">
                        <div class="dp-header-icon"><i class="fa fa-file-text-o"></i></div>
                        <div>
                            <h1>@ViewData["Title"]</h1>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <button type="button" class="dp-btn dp-btn-primary" id="btn_export"><i class="fa fa-file-excel-o"></i> Export</button>
                        <a href="@Url.Action("Index", "Home")" class="dp-btn dp-btn-outline"><i class="fa fa-th-large"></i> Dashboard</a>
                        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
                        <button type="button" class="dp-icon-btn" id="btn_toggleStats" title="Hide Summary Cards"><i class="fa fa-chevron-up"></i></button>
                    </div>
                    <div class="dp-header-stats dp-header-stats-grid" id="dcdStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-file-text-o"></i></div>
                            <div>
                                <span>Total Documents</span>
                                <b id="dcdTotal">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Effective Documents</span>
                                <b id="dcdEffective">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-clock-o"></i></div>
                            <div>
                                <span>Need Review</span>
                                <b id="dcdNeedReview">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-users"></i></div>
                            <div>
                                <span>Waiting Acceptance</span>
                                <b id="dcdPendingAck">-</b>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dp-card">
                <div id="divSearch">
                    @Html.Partial("_SearchCriteria")
                </div>
                <div id="divGrid">
                    @Html.Partial("_GridView")
                </div>
            </div>
        </div>
    </div>
</section>
@Html.Partial("_AcceptanceDetailPopup")
@Html.Partial("~/Views/DocumentMaintenance/_DocumentHistoryPopup.cshtml")
@Html.Partial("_Javascript")
