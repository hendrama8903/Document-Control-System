<style>
    /* ---------- KPI cards moved out of the top header into a docked
       right-side panel (request Hendra 2026-08-17: same treatment as
       Document Preparation/Registration). ---------- */
    .dp-layout-row {
        display: flex;
        align-items: stretch;
    }
    .dp-layout-main {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }
    .dp-layout-main .dp-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }
    .dp-layout-main .dp-card #divGrid {
        flex: 1 1 auto;
        min-height: 0;
    }

    /* toggle lives in the grid toolbar next to Export - a plain toolbar
       button so it never overlaps grid content, matching the other icon
       buttons there. */
    .dp-stats-toggle {
        position: relative;
        color: #2450D8;
        border-color: #C7D9F7;
        background: #F4F8FF;
    }
    .dp-stats-toggle:hover {
        background: #E7F1FB;
        border-color: #2450D8;
    }
    .dp-stats-toggle-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 999px;
        background: #D64545;
        color: #fff;
        font-size: 9.5px;
        font-weight: 800;
        display: none;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
    }

    .dp-stats-panel {
        flex: 0 0 272px;
        width: 272px;
        margin-left: 16px;
        background: #fff;
        border: 1px solid #E3E8EF;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(16,24,40,.04);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: flex-basis .22s cubic-bezier(.4,0,.2,1), width .22s cubic-bezier(.4,0,.2,1),
                    margin-left .22s cubic-bezier(.4,0,.2,1), opacity .18s ease, border-color .22s ease, box-shadow .22s ease;
    }
    .dp-layout-row.stats-collapsed .dp-stats-panel {
        flex-basis: 0;
        width: 0;
        margin-left: 0;
        opacity: 0;
        border-color: transparent;
        box-shadow: none;
        pointer-events: none;
    }

    .dp-stats-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        border-bottom: 1px solid #EEF1F5;
        white-space: nowrap;
    }
    .dp-stats-panel-head span {
        font-size: 14px;
        font-weight: 700;
        color: #101828;
    }
    .dp-stats-panel-close {
        background: none;
        border: none;
        color: #98A2B3;
        font-size: 13px;
        cursor: pointer;
        padding: 2px;
    }
    .dp-stats-panel-close:hover { color: #475467; }

    .dp-stats-panel-body {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px 18px;
        white-space: nowrap;
    }
    .dp-stats-panel-body .dp-stat-card {
        width: 100%;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
    }
    .dp-stats-panel-body .dp-stat-card:hover {
        border-color: #D5DDE8;
    }

    .dp-stats-panel-foot {
        margin-top: auto;
        padding: 6px 18px 18px;
    }
    .dp-stats-viewall {
        display: block;
        width: 100%;
        text-align: center;
        padding: 9px 12px;
        border: 1px solid #D5DDE8;
        border-radius: 10px;
        font-size: 12.5px;
        font-weight: 600;
        color: #2450D8;
        text-decoration: none;
        white-space: nowrap;
    }
    .dp-stats-viewall:hover { background: #F4F8FF; color: #2450D8; text-decoration: none; }
    .dp-stats-viewall i { margin-right: 6px; }

    @@media (max-width: 900px) {
        .dp-layout-row { flex-direction: column; }
        .dp-stats-toggle { display: none; }
        .dp-stats-panel, .dp-layout-row.stats-collapsed .dp-stats-panel {
            flex-basis: auto; width: 100%; margin-left: 0; opacity: 1; pointer-events: auto;
            border-color: #E3E8EF; box-shadow: 0 4px 14px rgba(16,24,40,.04); margin-top: 16px;
        }
    }
</style>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-layout-row stats-collapsed" id="dpLayoutRow">
                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                <aside class="dp-stats-panel" id="dpStatsPanel">
                    <div class="dp-stats-panel-head">
                        <span>Register Overview</span>
                        <button type="button" class="dp-stats-panel-close" id="btn_closeStatsPanel"><i class="fa fa-times"></i></button>
                    </div>
                    <div class="dp-stats-panel-body" id="dcdStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-file-text-o"></i></div>
                            <div>
                                <span>Total Documents</span>
                                <b id="dcdTotal">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-check-circle"></i></div>
                            <div>
                                <span>Effective Documents</span>
                                <b id="dcdEffective">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-clock-o"></i></div>
                            <div>
                                <span>Need Review</span>
                                <b id="dcdNeedReview">-</b>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-users"></i></div>
                            <div>
                                <span>Waiting Acceptance</span>
                                <b id="dcdPendingAck">-</b>
                            </div>
                        </div>
                    </div>
                    <div class="dp-stats-panel-foot">
                        <a href="@Url.Action("Index", "Home")" class="dp-stats-viewall"><i class="fa fa-bar-chart"></i>View All Statistics</a>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>
@Html.Partial("_AcceptanceDetailPopup")
@Html.Partial("~/Views/DocumentMaintenance/_DocumentHistoryPopup.cshtml")
@Html.Partial("_Javascript")
