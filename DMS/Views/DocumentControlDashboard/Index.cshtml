<link rel="stylesheet" href="~/css/views/DocumentControlDashboard/Index.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/DocumentControlDashboard/Binder.css" asp-append-version="true" />
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            @* folders-hidden: folders are hidden for now - sidebar, Move to Folder and the row checkboxes (Hendra 2026-11-18); remove the class to bring them back *@
            <div class="dp-layout-row stats-collapsed folders-hidden" id="dpLayoutRow">
                @Html.Partial("_FolderTree")

                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div class="dcd-folder-header-block">
                            <div class="dcd-crumb" id="dcdCrumb"></div>
                            @* Folder title + document count ("All Documents · 5 documents") removed
                               2026-11-19; the row now only appears while a Needs Action filter is on. *@
                            <div class="dcd-folder-title-row" id="dcdFolderTitleRow" style="display:none;">
                                @* shown only while a Needs Action filter is on (it is set in the
                                   Register Overview panel, which may be closed) *@
                                <span class="dcd-action-active" id="dcdActionActive" style="display:none;">
                                    <i class="fa fa-filter"></i> <span id="dcdActionActiveLabel"></span>
                                    <button type="button" id="btn_clearActionFilter" title="Clear this filter"><i class="fa fa-times"></i></button>
                                </span>
                            </div>
                            @* Binder details of the open folder (2026-11-15): type, label code, holder,
                               location, and what to do with it. Filled by dcdRenderBinderHeader(). *@
                            <div class="dcd-binder-bar" id="dcdBinderBar" style="display:none;">
                                <div class="dcd-binder-meta" id="dcdBinderMeta"></div>
                                <div class="dcd-binder-actions">
                                    <button type="button" class="dp-btn dp-btn-outline" id="btn_binderIndex"><i class="fa fa-list-alt"></i> Binder Index</button>
                                    <button type="button" class="dp-btn dp-btn-outline" id="btn_binderDetails"><i class="fa fa-pencil"></i> Binder Details</button>
                                </div>
                            </div>
                        </div>
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                @Html.Partial("_RegisterOverview")
            </div>
        </div>
    </div>
</section>
@Html.Partial("_AcceptanceDetailPopup")
@if ((bool)ViewData["ExportPdf"])
{
    @Html.Partial("_CopyRegisterPanel")
}
@Html.Partial("_BinderPanel")
@Html.Partial("_BinderDetailsPopup")
@Html.Partial("~/Views/DocumentMaintenance/_DocumentHistoryPopup.cshtml")
@Html.Partial("_Javascript")
