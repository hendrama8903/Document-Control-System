            <!-- Panel detail Acceptance (read-only, QMS-only) - side panel geser dari
                 kanan (BUKAN modal) supaya grid utama tetap terlihat & interaktif saat
                 panel terbuka; klik baris dokumen lain langsung update isi panel tanpa
                 perlu tutup dulu (request Hendra 2026-08-15). -->
<style>
    #acceptancePanel {
        position: fixed;
        top: 0;
        right: 0;
        width: 420px;
        max-width: 92vw;
        height: 100vh;
        background: #fff;
        box-shadow: -8px 0 24px rgba(20,35,50,.18);
        z-index: 1050;
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform .22s cubic-bezier(.4,0,.2,1);
    }

    #acceptancePanel.open { transform: translateX(0); }

    #acceptancePanel .adf-header {
        background: #fff;
        color: #101828;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #EEF1F5;
        position: relative;
        flex: none;
    }

    #acceptancePanel .adf-header-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #E7F1FB;
        color: #2450D8;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: none;
        font-size: 15px;
    }

    #acceptancePanel .adf-header-title { font-size: 14px; font-weight: 700; color: #101828; }
    #acceptancePanel .adf-header-sub { font-size: 12px; color: #8A94A3; margin-top: 2px; }

    #acceptancePanel .adf-close {
        background: none;
        border: none;
        color: #98A2B3;
        font-size: 13px;
        cursor: pointer;
        padding: 2px;
        margin-left: auto;
    }

    #acceptancePanel .adf-close:hover { color: #475467; }

    #acceptancePanel .panel-body { padding: 16px 18px; flex: 1 1 auto; overflow: hidden; }

    #acceptancePanel .adp-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11.5px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 999px;
    }
    #acceptancePanel .adp-pill-success { background: #E4F7EC; color: #1E9E63; }
    #acceptancePanel .adp-pill-warning { background: #FFF4DC; color: #B36B00; }
    #acceptancePanel .adp-pill-default { background: #F1F3F6; color: #66788A; }
</style>

<div id="acceptancePanel">
    <div class="adf-header">
        <div class="adf-header-icon"><i class="fa fa-users"></i></div>
        <div>
            <div class="adf-header-title">Acceptance Detail</div>
            <div class="adf-header-sub" id="adpDocumentCode">-</div>
        </div>
        <button type="button" class="adf-close" id="btn_closeAcceptancePanel"><i class="fa fa-times"></i></button>
    </div>
    <div class="panel-body">
        <div id="acceptanceDetailGrid"></div>
    </div>
</div>

<script type="text/javascript">
    var adpGridData = [];

    function dcdOpenAcceptanceDetail(row) {
        $("#adpDocumentCode").text(row.DOCUMENT_CODE || "-");
        $("#acceptancePanel").addClass("open");

        $.ajax({
            type: "POST",
            url: "@Url.Action("SearchDistributionDetail", "DocumentControlDashboard")",
            data: { documentTransactionId: row.DOCUMENT_TRANSACTION_ID },
            success: function (result) {
                adpGridData = (result.status && result.data) ? result.data : [];

                if ($("#acceptanceDetailGrid").data("dxDataGrid")) {
                    $("#acceptanceDetailGrid").dxDataGrid("instance").option("dataSource", adpGridData);
                } else {
                    buildAcceptanceDetailGrid();
                }
            },
            error: function () {
                showErrorMesgGrowl("Failed to load acceptance detail");
            }
        });
    }

    function buildAcceptanceDetailGrid() {
        $("#acceptanceDetailGrid").dxDataGrid({
            dataSource: adpGridData,
            showBorders: true,
            columnAutoWidth: true,
            wordWrapEnabled: false,
            height: "calc(100vh - 110px)",
            searchPanel: { visible: true, width: "100%", placeholder: "Search department..." },
            groupPanel: { visible: false },
            grouping: { autoExpandAll: true },
            paging: { pageSize: 20 },
            pager: { visible: true, displayMode: "compact", showInfo: true },
            noDataText: "No distribution target for this document yet.",
            columns: [
                {
                    dataField: "DIVISION_NAME",
                    caption: "Division",
                    groupIndex: 0
                },
                {
                    caption: "Department",
                    calculateDisplayValue: function (d) { return (d.DEPARTMENT_CODE || "") + " - " + (d.DEPARTMENT_NAME || ""); }
                },
                {
                    dataField: "STATUS",
                    caption: "Status",
                    alignment: "center",
                    width: 130,
                    cellTemplate: function (container, options) {
                        var d = options.data;
                        var pillClass = "adp-pill-default";
                        var pillText = "Not Sent";

                        if (d.STATUS == 1) {
                            if (d.ACCEPTED_FLAG == 1) {
                                pillClass = "adp-pill-success";
                                pillText = "Accepted";
                            } else {
                                pillClass = "adp-pill-warning";
                                pillText = "Waiting";
                            }
                        }

                        $("<span>").addClass("adp-pill " + pillClass).text(pillText).appendTo(container);
                    }
                }
            ]
        });
    }

    $(document).ready(function () {
        $("#btn_closeAcceptancePanel").on("click", function () {
            $("#acceptancePanel").removeClass("open");
        });

        // Klik di luar panel (di area grid utama) menutup panel - klik pada sel
        // Acceptance sendiri sudah stopPropagation() jadi tidak akan langsung
        // menutup ulang panel yang baru dibuka.
        $(document).on("click", function (e) {
            if ($("#acceptancePanel").hasClass("open") && !$(e.target).closest("#acceptancePanel").length) {
                $("#acceptancePanel").removeClass("open");
            }
        });
    });
</script>
