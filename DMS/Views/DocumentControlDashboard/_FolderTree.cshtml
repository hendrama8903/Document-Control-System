<link rel="stylesheet" href="~/css/views/DocumentControlDashboard/_FolderTree.css" asp-append-version="true" />

<aside class="dcd-folder-panel" id="dcdFolderPanel">
    <div class="dcd-folder-head">
        <span>Folders</span>
        <div class="dcd-folder-head-actions">
            <button type="button" class="dcd-folder-add-btn" id="btn_addRootFolder" title="New Folder"><i class="fa fa-plus"></i></button>
            @* Hide panel dari header-nya sendiri (request Hendra 2026-11-05); tombol
               "Show Folders" di toolbar grid baru muncul setelah panel disembunyikan *@
            <button type="button" class="dcd-folder-add-btn" id="btn_hideFolders" title="Hide Folders"><i class="fa fa-angle-double-left"></i></button>
        </div>
    </div>
    <div class="dcd-folder-tree" id="dcdFolderTree"></div>
    <div class="dcd-folder-foot">
        <span>Total Folders <b id="dcdTotalFolders">0</b></span>
    </div>
</aside>

@{
    // Reused as-is from both DocumentControlDashboard (global folders) and
    // UserDashboard (personal folders, request Hendra 2026-08-29) - the two
    // pages point this same tree UI at different controllers/tables entirely.
    // Falls back to DocumentControlDashboard so that page needs no ViewData change.
    var folderController = ViewData["FolderController"] as string ?? "DocumentControlDashboard";
}
<script type="text/javascript">
    var folderTreeConfig = {
        urls: {
            getFolderTree: "@Url.Action("GetFolderTree", folderController)",
            createFolder: "@Url.Action("CreateFolder", folderController)",
            renameFolder: "@Url.Action("RenameFolder", folderController)",
            deleteFolder: "@Url.Action("DeleteFolder", folderController)"
        }
    };
</script>
<script src="~/js/views/folder-tree.js" asp-append-version="true"></script>
