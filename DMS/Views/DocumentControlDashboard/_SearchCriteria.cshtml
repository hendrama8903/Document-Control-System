<div class="box-header dp-toolbar">
    <div class="dp-toolbar-left">
        <button type="button" class="dp-icon-btn dp-stats-toggle" id="btn_toggleFolders" title="Hide Folders"><i class="fa fa-angle-double-left"></i></button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_toggleFilters"><i class="fa fa-filter"></i> More Filters</button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_resetFilters"><i class="fa fa-refresh"></i> Reset</button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_refresh"><i class="fa fa-refresh"></i> Refresh</button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_moveToFolder" style="display:none;"><i class="fa fa-folder-o"></i> Move to Folder</button>
    </div>
    <div class="dp-toolbar-right">
        <a href="@Url.Action("Index", "Home")" class="btn dp-btn dp-btn-outline"><i class="fa fa-th-large"></i> Dashboard</a>
        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
        <button type="button" class="btn dp-btn dp-btn-primary" id="btn_export"><i class="fa fa-file-excel-o"></i> Export</button>
        <button type="button" class="dp-icon-btn dp-stats-toggle" id="btn_toggleStats" title="Show Register Overview">
            <i class="fa fa-angle-double-left"></i>
            <span class="dp-stats-toggle-badge" id="dpToggleBadge">0</span>
        </button>
    </div>
</div>
