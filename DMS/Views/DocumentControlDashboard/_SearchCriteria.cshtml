<div class="box-header dp-toolbar">
    <div class="dp-toolbar-left">
        <button type="button" class="dp-icon-btn dp-stats-toggle dcd-hidden" id="btn_toggleFolders" title="Show Folders"><i class="fa fa-angle-double-right"></i></button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_toggleFilters"><i class="fa fa-filter"></i> More Filters</button>
        @* Management System (2026-11-19) *@
        <select class="dcd-system-select" id="dcdSystemFilter" title="Management system"><option value="">All Systems</option></select>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_resetFilters"><i class="fa fa-undo"></i> Reset</button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_refresh"><i class="fa fa-refresh"></i> Refresh</button>
        @* Bulk actions: shown only while documents are ticked (2026-11-14) *@
        <div class="dcd-selection-bar" id="dcdSelectionBar" style="display:none;">
            <span class="dcd-selection-count" id="dcdSelectionCount">0 selected</span>
            <button type="button" class="dp-btn dp-btn-outline" id="btn_moveToFolder"><i class="fa fa-folder-o"></i> Move to Folder</button>
            <button type="button" class="dcd-selection-clear" id="btn_clearSelection" title="Clear selection"><i class="fa fa-times"></i></button>
        </div>
    </div>
    <div class="dp-toolbar-right">
        <a href="@Url.Action("Index", "Home")" class="dp-btn dp-btn-outline"><i class="fa fa-th-large"></i> Dashboard</a>
        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i> </button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_export"><i class="fa fa-download"></i> Export</button>
        <button type="button" class="dp-icon-btn dp-stats-toggle" id="btn_toggleStats" title="Show Register Overview">
            <i class="fa fa-angle-double-left"></i>
            <span class="dp-stats-toggle-badge" id="dpToggleBadge">0</span>
        </button>
    </div>
</div>
