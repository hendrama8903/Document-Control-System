<script type="text/javascript">
    //RECOMMIT DINA
    var gScreenMode = null;
    var gId = null;
    var gDocumentId = null;
    var gDocumentTransactionId = null;
    var gDocumentNo = null;
    var gIsApproved = null;
    var gFilePath = null;

    $(document).ready(function () {
        setDataSelect2WithParam("addEditDivision", "@Url.Action("GetSystemCodeSystemValue", "MSystem")", "- Choose -", "DIVISION");

        $("#btn_send").on("click", function () {
            onSendPrepare();
        });
    });

    function onSendPrepare() {
        var row = getSelectedRowData();
        if (row == null) {
            return;
        }

        gDocumentTransactionId = row.DOCUMENT_TRANSACTION_ID;
        gDocumentNo = row.DOCUMENT_CODE;
        gDocumentId = row.DOCUMENT_CTRL_ID;

        gIsApproved = 'Y';
        $('#addEditRemarks').val('');
        $("#modalSend").modal();
        $('#modalSend-title').html("Send Document");
        $('#labelConfirmation').html("Are you sure want to send Document No " + gDocumentNo + "?");
        $('#divRemarks').hide();
        $('#modalSend').on('shown.bs.modal', function () {

        });
    }

    $("#btn_okSend").on("click", function () {
        sendDocument();
    });

    function onViewAttachment(attachment, documentId) {
        gFilePath = attachment;
        gDocumentTransactionId = documentId;
        viewAttachment();
    }

    function viewAttachment() {
        if (gFilePath !== "null" && gFilePath !== null && gFilePath !== "") {
            var link = '@Html.Raw(Url.Action("ViewAttachment", "DocumentMaintenance", new { FILE_PATH = "-1", DOCUMENT_TRANSACTION_ID = "-2", type = "-3" }))';
            link = link.replace("-1", gFilePath);
            link = link.replace("-2", gDocumentTransactionId);
            link = link.replace("-3", "2");
            window.open(link, '_blank');
        } else {
            showErrorMesgGrowl("This data does not have an attachment");
        }
    }

    function onDownloadAttachment(attachment, documentId) {
        gFilePath = attachment;
        gDocumentTransactionId = documentId;
        downloadAttachment();
    }

    function downloadAttachment() {
        if (gFilePath !== "null" && gFilePath !== null && gFilePath !== "") {
            var link = '@Html.Raw(Url.Action("downloadAttachment", "DocumentMaintenance", new { FILE_PATH = "-1", DOCUMENT_TRANSACTION_ID = "-2" }))';
            link = link.replace("-1", gFilePath);
            link = link.replace("-2", gDocumentTransactionId);
            window.location.href = link;
        } else {
            showErrorMesgGrowl("This data does not have an attachment");
        }
    }

    function sendDocument() {
        popUpProgressHide();
        $.ajax({
            type: "POST",
            url: "@Url.Action("SendDocument", "DocumentControlDashboard")",
            dataType: 'json',
            traditional: true,
            data: {
                DOCUMENT_TRANSACTION_ID: gDocumentTransactionId,
                DOCUMENT_CTRL_ID: gDocumentId,
            },
            success: function (result) {
                if (result.status == true) {
                    showSuccessMesgGrowl(result.message);
                    $("#datagrid").dxDataGrid("instance").refresh();
                    popUpProgressHide();
                    $("#modalSend").modal('hide');
                } else {
                    showErrorMesgGrowl(result.message);
                    popUpProgressHide();
                }
            },
            error: function (result) {
                showErrorMesgGrowl(result);
                popUpProgressHide();
            }
        });
    }
</script>
