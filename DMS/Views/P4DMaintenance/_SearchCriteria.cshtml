<div class="box-header dp-toolbar">
    <div class="dp-toolbar-left">
        @if ((bool)ViewData["Add"])
        {
            <button type="button" class="btn dp-btn dp-btn-success" id="btn_add"><i class="fa fa-plus"></i> Register</button>
        }
        <div class="dropdown" style="display:inline-block;">
            <button type="button" class="btn dp-btn dp-btn-outline dropdown-toggle" data-toggle="dropdown">
                <i class="fa fa-list"></i> Actions <span class="caret"></span>
            </button>
            <ul class="dropdown-menu dp-dropdown-menu">
                @if ((bool)ViewData["Receive"] && (bool)ViewData["DocumentControlAccess"])
                {
                    <li><button type="button" id="btn_receive" title="First step: mark this registration entry as being reviewed (status becomes Checking)"><i class="fa fa-check-circle dp-menu-approve"></i> Receive</button></li>
                }
                @if ((bool)ViewData["Receive"] && (bool)ViewData["DocumentControlAccess"])
                {
                    <li><button type="button" id="btn_accept" title="Second step: confirm the registration entry (status becomes Accepted) - only possible after Receive"><i class="fa fa-check-square-o dp-menu-accept"></i> Accept</button></li>
                }
                @if ((bool)ViewData["UnReceive"] && (bool)ViewData["DocumentControlAccess"])
                {
                    <li><button type="button" id="btn_unreceive" title="Undo Accept - only possible before distribution has been assigned"><i class="fa fa-undo dp-menu-unreceive"></i> Un-Receive</button></li>
                }
                @if ((bool)ViewData["Edit"] && (bool)ViewData["DocumentControlAccess"])
                {
                    <li><button type="button" id="btn_edit"><i class="fa fa-map-marker dp-menu-location"></i> Update Location</button></li>
                }
                @if ((bool)ViewData["Send"] && (bool)ViewData["DocumentControlAccess"])
                {
                    <li><button type="button" id="btn_send"><i class="fa fa-paper-plane-o dp-menu-send"></i> Send</button></li>
                }
                @if ((bool)ViewData["Distribution"])
                {
                    <li><button type="button" id="btn_distribution"><i class="fa fa-share-alt dp-menu-distribution"></i> Distribution</button></li>
                }
                @if ((bool)ViewData["Reject"] && (bool)ViewData["DocumentControlAccess"])
                {
                    <li><button type="button" id="btn_reject"><i class="fa fa-ban dp-menu-reject"></i> Reject</button></li>
                }
                @if ((bool)ViewData["Delete"])
                {
                    <li role="separator" class="divider"></li>
                    <li><button type="button" id="btn_delete"><i class="fa fa-trash-o dp-menu-delete"></i> Delete</button></li>
                }
            </ul>
        </div>
        <button type="button" class="btn dp-btn dp-btn-outline" id="btn_toggleFilters"><i class="fa fa-filter"></i> More Filters</button>
        <button type="button" class="btn dp-btn dp-btn-outline" id="btn_resetFilters"><i class="fa fa-refresh"></i> Reset</button>
        <button type="button" class="btn dp-btn dp-btn-outline" id="btn_refresh"><i class="fa fa-refresh"></i> Refresh</button>
    </div>
    <div class="dp-toolbar-right">
        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
        @if ((bool)ViewData["Download"])
        {
            <button type="button" class="btn dp-btn dp-btn-outline" id="btn_download"><i class="fa fa-download"></i> Export</button>
        }
        <button type="button" class="dp-icon-btn dp-stats-toggle" id="btn_toggleStats" title="Show Document Status">
            <i class="fa fa-angle-double-left"></i>
            <span class="dp-stats-toggle-badge" id="dpToggleBadge">0</span>
        </button>
    </div>
</div>
