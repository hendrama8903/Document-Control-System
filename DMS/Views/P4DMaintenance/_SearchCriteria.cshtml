<div class="box-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; padding:0 0 14px 0;">
    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
        @if ((bool)ViewData["Add"])
        {
            <button type="button" class="btn btn-success btn-sm" id="btn_add" style="min-width: 84px;"><i class="fa fa-plus"></i> Add</button>
        }
        @if ((bool)ViewData["Receive"] && (bool)ViewData["DocumentControlAccess"])
        {
            <button type="button" class="btn btn-success btn-sm" id="btn_receive" style="min-width: 84px;"><i class="fa fa-inbox"></i> Receive</button>
        }
        @if ((bool)ViewData["Edit"] && (bool)ViewData["DocumentControlAccess"])
        {
            <button type="button" class="btn btn-warning btn-sm" id="btn_edit" style="min-width: 84px;"><i class="fa fa-map-marker"></i> Update Location</button>
        }
        @if ((bool)ViewData["Send"] && (bool)ViewData["DocumentControlAccess"])
        {
            <button type="button" class="btn btn-success btn-sm" id="btn_send" style="min-width: 84px;"><i class="fa fa-paper-plane-o"></i> Send</button>
        }
        @if ((bool)ViewData["Delete"])
        {
            <button type="button" class="btn btn-danger btn-sm" id="btn_delete" style="min-width: 84px;"><i class="fa fa-trash-o"></i> Delete</button>
        }
        @if ((bool)ViewData["Reject"] && (bool)ViewData["DocumentControlAccess"])
        {
            <button type="button" class="btn btn-reject btn-sm" id="btn_reject" style="min-width: 84px;"><i class="fa fa-ban"></i> Reject</button>
        }
    </div>
    <div style="display:flex; align-items:center; gap:6px;">
        @if ((bool)ViewData["Distribution"])
        {
            <button type="button" class="btn btn-success btn-sm" id="btn_distribution" style="min-width: 100px;"><i class="fa fa-share-alt"></i> Distribution</button>
        }
        @if ((bool)ViewData["Download"])
        {
            <button type="button" class="btn btn-primary btn-sm" id="btn_download" style="min-width: 110px;"><i class="fa fa-download"></i> Download</button>
        }
        <button type="button" class="btn btn-primary btn-sm" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i></button>
    </div>
</div>
