<div class="box-header dp-toolbar">
    <div class="dp-toolbar-left">
        @if ((bool)ViewData["Add"])
        {
            <button type="button" class="dp-btn dp-btn-primary" id="btn_add"><i class="fa fa-plus"></i> New</button>
        }
        @* Per-document actions live only in the row menu (⋮ in the Action column). The toolbar
           Actions dropdown repeated them for one selected row and was removed (Hendra 2026-11-13). *@
        @if ((bool)ViewData["DocumentControlAccess"])
        {
            @* Muncul hanya kalau ada dokumen yang menunggu tindakan user login (diatur di _GridView) *@
            <button type="button" class="dp-btn dp-btn-my-approval" id="btn_myApproval" style="display:none;" title="Show only documents waiting for your action (Receive / Accept / Send)">
                <i class="fa fa-bell"></i> My Action <span class="dp-my-approval-count" id="dpMyApprovalCount">0</span>
            </button>
        }
        <button type="button" class="dp-btn dp-btn-outline" id="btn_toggleFilters"><i class="fa fa-filter"></i> More Filters</button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_resetFilters"><i class="fa fa-undo"></i> Reset</button>
        <button type="button" class="dp-btn dp-btn-outline" id="btn_refresh"><i class="fa fa-refresh"></i> Refresh</button>
    </div>
    <div class="dp-toolbar-right">
        <button type="button" class="dp-icon-btn" id="btn_columns" title="Show/Hide Columns"><i class="fa fa-columns"></i> </button>
        @if ((bool)ViewData["Download"])
        {
            <button type="button" class="dp-btn dp-btn-outline" id="btn_download"><i class="fa fa-download"></i> Export</button>
        }
        <button type="button" class="dp-icon-btn dp-stats-toggle" id="btn_toggleStats" title="Show Document Status">
            <i class="fa fa-angle-double-left"></i>
            <span class="dp-stats-toggle-badge" id="dpToggleBadge">0</span>
        </button>
    </div>
</div>
