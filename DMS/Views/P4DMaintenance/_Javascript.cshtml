﻿@using Microsoft.AspNetCore.Http

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<script type="text/javascript">
    var p4dMaintenanceConfig = {
        canDistribution: @(((bool)ViewData["Distribution"]) ? "true" : "false"),
        canDelete: @(((bool)ViewData["Delete"]) ? "true" : "false"),
        canDocumentControlAccess: @(((bool)ViewData["DocumentControlAccess"]) ? "true" : "false"),
        canReceive: @((((bool)ViewData["Receive"]) && ((bool)ViewData["DocumentControlAccess"])) ? "true" : "false"),
        canUnReceive: @((((bool)ViewData["UnReceive"]) && ((bool)ViewData["DocumentControlAccess"])) ? "true" : "false"),
        canEdit: @((((bool)ViewData["Edit"]) && ((bool)ViewData["DocumentControlAccess"])) ? "true" : "false"),
        canSend: @((((bool)ViewData["Send"]) && ((bool)ViewData["DocumentControlAccess"])) ? "true" : "false"),
        canReject: @((((bool)ViewData["Reject"]) && ((bool)ViewData["DocumentControlAccess"])) ? "true" : "false"),
        canAdjustStamp: @(((bool)ViewData["StampLayout"]) ? "true" : "false"),
        stampLimits: {
            safeMarginPt: @DMS.Services.StampLayoutService.SafeMarginPt.ToString(System.Globalization.CultureInfo.InvariantCulture),
            minWidthPt: @DMS.Services.StampLayoutService.MinWidthPt.ToString(System.Globalization.CultureInfo.InvariantCulture),
            maxWidthPt: @DMS.Services.StampLayoutService.MaxWidthPt.ToString(System.Globalization.CultureInfo.InvariantCulture),
            noteHeightPt: @((DMS.Services.StampLayoutService.NoteGapPt + DMS.Services.StampLayoutService.NoteLineHeightPt).ToString(System.Globalization.CultureInfo.InvariantCulture))
        },
        sessionDepartmentId: "@Html.Raw(HttpContextAccessor.HttpContext.Session.GetInt32("DEPARTMENT_ID"))",
        urls: {
            search: "@Url.Action("Search", "P4DMaintenance")",
            searchDistributionDetail: "@Url.Action("SearchDistributionDetail", "P4DMaintenance")",
            documentMaintenanceGetDocumentCodeLoginBased: "@Url.Action("GetDocumentCodeLoginBased", "DocumentMaintenance")",
            searchDocumentApproval: "@Url.Action("SearchDocumentApproval", "P4DMaintenance")",
            departmentMasterSearchByDistribution: "@Url.Action("SearchByDistribution", "DepartmentMaster")",
            getDataByDocumentNo: "@Url.Action("GetDataByDocumentNo")",
            addEdit: "@Url.Action("AddEdit", "P4DMaintenance")",
            addEditDistribution: "@Url.Action("AddEditDistribution", "P4DMaintenance")",
            deleteData: "@Url.Action("Delete", "P4DMaintenance")",
            deleteDistributionMultiple: "@Url.Action("DeleteDistributionMultiple", "P4DMaintenance")",
            sendDistributionAll: "@Url.Action("SendDistributionAll", "P4DMaintenance")",
            accept: "@Url.Action("Accept", "P4DMaintenance")",
            stampLayoutInfo: "@Url.Action("StampLayoutInfo", "P4DMaintenance")",
            changeStampLayout: "@Url.Action("ChangeStampLayout", "P4DMaintenance")",
            pdfWorker: "@Url.Content("~/lib/pdfjs/pdf.worker.min.js")",
            unReceive: "@Url.Action("UnReceive", "P4DMaintenance")",
            approveReject: "@Url.Action("ApproveReject", "P4DMaintenance")",
            getByKey: "@Url.Action("GetByKey", "P4DMaintenance")",
            documentMaintenancePrintAttachment: "@Url.Action("printAttachment", "DocumentMaintenance")",
            documentMaintenanceCountTotalLog: "@Url.Action("CountTotalLog", "DocumentMaintenance")",
            documentMaintenanceSearchDocumentLog: "@Url.Action("SearchDocumentLog", "DocumentMaintenance")",
            documentMaintenanceGetByKey: "@Url.Action("GetByKey", "DocumentMaintenance")",
            documentMaintenanceSearchHistory: "@Url.Action("SearchHistory", "DocumentMaintenance")",
            downloadRaw: '@Html.Raw(Url.Action("Download", "P4DMaintenance"))',
            downloadAttachment: '@Html.Raw(Url.Action("downloadAttachment", "DocumentMaintenance", new { FILE_PATH = "-1", DOCUMENT_TRANSACTION_ID = "-2" }))',
            viewAttachment: '@Html.Raw(Url.Action("ViewAttachment", "DocumentMaintenance", new { FILE_PATH = "-1", DOCUMENT_TRANSACTION_ID = "-2", type = "-3" }))'
        }
    };
</script>
<script src="~/js/views/p4d-maintenance.js" asp-append-version="true"></script>
@if ((bool)ViewData["StampLayout"])
{
    <link rel="stylesheet" href="~/css/views/StampLayout/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/views/P4DMaintenance/_StampLayoutPopup.css" asp-append-version="true" />
    <script src="~/lib/pdfjs/pdf.min.js" asp-append-version="true"></script>
    <script src="~/js/views/stamp-layout-core.js" asp-append-version="true"></script>
    <script src="~/js/views/p4d-stamp-layout.js" asp-append-version="true"></script>
}
