<link rel="stylesheet" href="~/css/views/DivisionMaster/_PopupForm.css" asp-append-version="true" />

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="dvf-header">
                <div class="dvf-header-icon"><i class="fa fa-building"></i></div>
                <div>
                    <div class="dvf-header-title" id="modal-title">New Division</div>
                    <div class="dvf-header-sub" id="modal-subtitle">Add new division data</div>
                </div>
                <button type="button" class="dvf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="dvf-body">
                <div class="dvf-row">
                    <div class="dvf-row-left">
                        <div class="dvf-icon"><i class="fa fa-tag"></i></div>
                        <div>
                            <div class="dvf-label">Division Code <span class="text-red">*</span></div>
                            <div class="dvf-sub">Unique division code</div>
                        </div>
                    </div>
                    <div class="dvf-row-right">
                        <input class="form-control" id="addEditDivisionCd" type="text" maxlength="5" oninput="removeWhiteSpace(this)" placeholder="Enter division code" />
                        <input id="addEditId" type="hidden" />
                    </div>
                </div>

                <div class="dvf-row">
                    <div class="dvf-row-left">
                        <div class="dvf-icon"><i class="fa fa-file-o"></i></div>
                        <div>
                            <div class="dvf-label">Division Name <span class="text-red">*</span></div>
                            <div class="dvf-sub">Division name</div>
                        </div>
                    </div>
                    <div class="dvf-row-right">
                        <input class="form-control" id="addEditDivisionNm" type="text" oninput="removeWhiteSpace(this)" maxlength="255" placeholder="Enter division name" />
                    </div>
                </div>
            </div>

            <div class="dvf-footer">
                <button type="button" class="dvf-btn dvf-btn-cancel" id="btn_cancel" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="dvf-btn dvf-btn-primary" id="btn_save"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>
