@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<ul class="sidebar-menu" data-widget="tree">
    @Html.Raw(HttpContextAccessor.HttpContext.Session.GetString("menuString"))
</ul>
<script type="text/javascript">
    $(document).ready(function() {
        var requestPath = "@HttpContextAccessor.HttpContext.Request.Path.Value";
        // Profile ada di controller User, tapi bukan bagian dari menu User Management.
        if (requestPath.toLowerCase() === "/user/profile") {
            return;
        }

        var currentUrl = requestPath;
        var currentUrl = currentUrl.split('/');
        var currentUrl = '/' + currentUrl[1] + '/Index';
        var parentId = $('li[id="sidebarMenu' + currentUrl + '"]').attr('data-parentId');

        $('li[id="sidebarMenu' + currentUrl + '"]').addClass('active');
        if (parentId != 0) {
            $('li[id="parentId' + parentId + '"]').addClass('active treeview menu open');
        }
    });

</script>
