@*
    Dialog tanda tangan elektronik ala Folderit (request Hendra 2026-11-06).
    Dipasang sekali di _AdminLayout; dipanggil dari JS halaman mana pun:

        openSignaturePad({
            title: "Sign to approve",
            subtitle: "HMMI/WI/QCM/001 - Rev. 0",
            confirmText: "Sign & Approve",
            onSigned: function (sig) { ... }   // sig = { SIGN_METHOD, SIGN_DATA, SIGN_FONT }
        });
        appendSignature(formDataOrObject, sig);  // tambahkan ke FormData / objek data AJAX

    DRAW: goresan disimpan sebagai JSON koordinat (bukan gambar) pada kanvas logis 600x200.
    TYPE: teks nama + font tulisan tangan (daftar sama dengan SignatureService.TypeFonts).
    Ditulis tanpa jQuery/Bootstrap modal supaya bisa tampil di atas modal lain.
*@
<link rel="stylesheet" href="~/css/views/shared/_SignaturePad.css" asp-append-version="true" />

<div id="esignOverlay" role="dialog" aria-modal="true" aria-labelledby="esignTitle">
    <div class="esign-box">
        <div class="esign-head">
            <div class="esign-head-icon"><i class="fa fa-pencil"></i></div>
            <div>
                <div class="esign-title" id="esignTitle">Sign document</div>
                <div class="esign-sub" id="esignSub"></div>
            </div>
            <button type="button" class="esign-close" id="esignClose" title="Cancel">&times;</button>
        </div>
        <div class="esign-body">
            <div class="esign-tabs">
                <button type="button" class="esign-tab active" data-tab="DRAW"><i class="fa fa-paint-brush"></i> Draw</button>
                <button type="button" class="esign-tab" data-tab="TYPE"><i class="fa fa-keyboard-o"></i> Type</button>
            </div>

            <div id="esignDrawPanel">
                <div class="esign-pad-wrap">
                    <canvas id="esignCanvas" width="600" height="200"></canvas>
                    <div class="esign-line"></div>
                    <div class="esign-hint" id="esignHint">Draw your signature here with the mouse or your finger</div>
                </div>
                <div class="esign-tools">
                    <span>Signature is saved for this document only.</span>
                    <button type="button" class="esign-link" id="esignClear"><i class="fa fa-eraser"></i> Clear</button>
                </div>
            </div>

            <div id="esignTypePanel" class="esign-type" style="display:none;">
                <input type="text" id="esignText" maxlength="60" placeholder="Type your full name" autocomplete="off" />
                <div class="esign-fonts" id="esignFonts"></div>
            </div>

            <div class="esign-consent" id="esignConsent">By signing, I confirm that I have reviewed this document and that this electronic signature is mine.</div>
            <div class="esign-error" id="esignError"></div>
        </div>
        <div class="esign-foot">
            <button type="button" class="esign-btn" id="esignCancel">Cancel</button>
            <button type="button" class="esign-btn primary" id="esignConfirm" disabled>Sign</button>
        </div>
    </div>
</div>

<script src="~/js/signature-pad.js" asp-append-version="true"></script>
