@*
    Dialog tanda tangan elektronik ala Folderit (request Hendra 2026-11-06).
    Dipasang sekali di _AdminLayout; dipanggil dari JS halaman mana pun:

        openSignaturePad({
            title: "Sign to approve",
            subtitle: "HMMI/WI/QCM/001 - Rev. 0",
            confirmText: "Sign & Approve",
            onSigned: function (sig) { ... }   // sig = { SIGN_METHOD, SIGN_DATA, SIGN_FONT }
        });
        appendSignature(formDataOrObject, sig);  // tambahkan ke FormData / objek data AJAX

    DRAW: goresan disimpan sebagai JSON koordinat (bukan gambar) pada kanvas logis 600x200.
    TYPE: teks nama + font tulisan tangan (daftar sama dengan SignatureService.TypeFonts).
    Ditulis tanpa jQuery/Bootstrap modal supaya bisa tampil di atas modal lain.
*@
<style>
    #esignOverlay { position: fixed; inset: 0; z-index: 3000; background: rgba(16, 24, 40, .55); display: none; align-items: center; justify-content: center; padding: 16px; font-family: 'Inter', 'Segoe UI', sans-serif; }
    #esignOverlay.open { display: flex; }
    .esign-box { background: #fff; border-radius: 14px; width: 100%; max-width: 640px; box-shadow: 0 24px 48px -12px rgba(16,24,40,.35); overflow: hidden; }
    .esign-head { padding: 14px 18px; border-bottom: 1px solid #EEF1F5; display: flex; align-items: flex-start; gap: 10px; }
    .esign-head-icon { width: 34px; height: 34px; border-radius: 9px; background: #EAF1FD; color: #2450D8; display: flex; align-items: center; justify-content: center; flex: none; }
    .esign-title { font-size: 15px; font-weight: 700; color: #101828; }
    .esign-sub { font-size: 12px; color: #667085; margin-top: 2px; word-break: break-word; }
    .esign-close { margin-left: auto; background: none; border: none; font-size: 18px; color: #98A2B3; cursor: pointer; line-height: 1; }
    .esign-body { padding: 14px 18px 6px; }
    .esign-tabs { display: flex; gap: 6px; margin-bottom: 10px; }
    .esign-tab { flex: 1; border: 1px solid #D5DDE8; background: #fff; border-radius: 8px; padding: 7px 10px; font-size: 13px; font-weight: 600; color: #475467; cursor: pointer; }
    .esign-tab.active { border-color: #2450D8; background: #EAF1FD; color: #1C3FA6; }
    .esign-pad-wrap { position: relative; border: 1.5px dashed #B9C4D4; border-radius: 10px; background: #FCFCFD; }
    .esign-pad-wrap canvas { display: block; width: 100%; aspect-ratio: 3 / 1; touch-action: none; cursor: crosshair; border-radius: 10px; }
    .esign-line { position: absolute; left: 7%; right: 7%; bottom: 24%; border-bottom: 1px solid #D0D5DD; pointer-events: none; }
    .esign-hint { position: absolute; left: 0; right: 0; top: 40%; text-align: center; color: #B0B8C4; font-size: 13px; pointer-events: none; }
    .esign-type input { width: 100%; border: 1px solid #D5DDE8; border-radius: 8px; padding: 9px 11px; font-size: 14px; }
    .esign-fonts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
    .esign-font { border: 1px solid #D5DDE8; border-radius: 8px; padding: 8px 10px; cursor: pointer; background: #fff; text-align: center; color: #142878; font-size: 26px; line-height: 1.3; min-height: 56px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .esign-font.active { border-color: #2450D8; box-shadow: 0 0 0 3px rgba(36,80,216,.15); }
    .esign-tools { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; font-size: 12px; color: #667085; }
    .esign-link { background: none; border: none; color: #2450D8; font-weight: 600; cursor: pointer; padding: 0; font-size: 12px; }
    .esign-consent { font-size: 12px; color: #475467; background: #F9FAFB; border-radius: 8px; padding: 8px 10px; margin: 10px 0 4px; }
    .esign-error { color: #B42318; font-size: 12px; min-height: 16px; margin-top: 4px; }
    .esign-foot { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 18px; border-top: 1px solid #EEF1F5; }
    .esign-btn { border-radius: 8px; padding: 8px 16px; font-size: 13px; font-weight: 700; border: 1px solid #D5DDE8; background: #fff; color: #475467; cursor: pointer; }
    .esign-btn.primary { background: #2450D8; border-color: #2450D8; color: #fff; }
    .esign-btn.primary:disabled { opacity: .5; cursor: not-allowed; }
    @@media (max-width: 480px) { .esign-fonts { grid-template-columns: 1fr; } .esign-font { font-size: 22px; } }
</style>

<div id="esignOverlay" role="dialog" aria-modal="true" aria-labelledby="esignTitle">
    <div class="esign-box">
        <div class="esign-head">
            <div class="esign-head-icon"><i class="fa fa-pencil"></i></div>
            <div>
                <div class="esign-title" id="esignTitle">Sign document</div>
                <div class="esign-sub" id="esignSub"></div>
            </div>
            <button type="button" class="esign-close" id="esignClose" title="Cancel">&times;</button>
        </div>
        <div class="esign-body">
            <div class="esign-tabs">
                <button type="button" class="esign-tab active" data-tab="DRAW"><i class="fa fa-paint-brush"></i> Draw</button>
                <button type="button" class="esign-tab" data-tab="TYPE"><i class="fa fa-keyboard-o"></i> Type</button>
            </div>

            <div id="esignDrawPanel">
                <div class="esign-pad-wrap">
                    <canvas id="esignCanvas" width="600" height="200"></canvas>
                    <div class="esign-line"></div>
                    <div class="esign-hint" id="esignHint">Draw your signature here with the mouse or your finger</div>
                </div>
                <div class="esign-tools">
                    <span>Signature is saved for this document only.</span>
                    <button type="button" class="esign-link" id="esignClear"><i class="fa fa-eraser"></i> Clear</button>
                </div>
            </div>

            <div id="esignTypePanel" class="esign-type" style="display:none;">
                <input type="text" id="esignText" maxlength="60" placeholder="Type your full name" autocomplete="off" />
                <div class="esign-fonts" id="esignFonts"></div>
            </div>

            <div class="esign-consent" id="esignConsent">By signing, I confirm that I have reviewed this document and that this electronic signature is mine.</div>
            <div class="esign-error" id="esignError"></div>
        </div>
        <div class="esign-foot">
            <button type="button" class="esign-btn" id="esignCancel">Cancel</button>
            <button type="button" class="esign-btn primary" id="esignConfirm" disabled>Sign</button>
        </div>
    </div>
</div>

<script>
    (function () {
        var FONTS = ["Segoe Script", "Segoe Print", "Ink Free", "Gabriola"];   // = SignatureService.TypeFonts
        var W = 600, H = 200;
        var overlay = document.getElementById('esignOverlay');
        var canvas = document.getElementById('esignCanvas');
        var ctx = canvas.getContext('2d');
        var hint = document.getElementById('esignHint');
        var textInput = document.getElementById('esignText');
        var fontsBox = document.getElementById('esignFonts');
        var confirmBtn = document.getElementById('esignConfirm');
        var errorBox = document.getElementById('esignError');
        var strokes = [], current = null, mode = 'DRAW', font = FONTS[0], options = {};

        // Kanvas tajam di layar high-DPI; koordinat yang disimpan tetap skala logis 600x200
        function setupCanvas() {
            var ratio = window.devicePixelRatio || 1;
            canvas.width = W * ratio; canvas.height = H * ratio;
            ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
            redraw();
        }

        function redraw() {
            ctx.clearRect(0, 0, W, H);
            ctx.strokeStyle = '#142878'; ctx.fillStyle = '#142878';
            ctx.lineWidth = 2.6; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            strokes.forEach(function (s) {
                if (s.length === 1) { ctx.beginPath(); ctx.arc(s[0][0], s[0][1], 1.4, 0, Math.PI * 2); ctx.fill(); return; }
                ctx.beginPath(); ctx.moveTo(s[0][0], s[0][1]);
                for (var i = 1; i < s.length - 1; i++) {
                    var mx = (s[i][0] + s[i + 1][0]) / 2, my = (s[i][1] + s[i + 1][1]) / 2;
                    ctx.quadraticCurveTo(s[i][0], s[i][1], mx, my);
                }
                ctx.lineTo(s[s.length - 1][0], s[s.length - 1][1]);
                ctx.stroke();
            });
            hint.style.display = strokes.length ? 'none' : '';
        }

        function point(e) {
            var r = canvas.getBoundingClientRect();
            return [Math.round((e.clientX - r.left) * W / r.width * 10) / 10, Math.round((e.clientY - r.top) * H / r.height * 10) / 10];
        }

        canvas.addEventListener('pointerdown', function (e) {
            e.preventDefault();
            canvas.setPointerCapture(e.pointerId);
            current = [point(e)]; strokes.push(current); redraw(); refresh();
        });
        canvas.addEventListener('pointermove', function (e) {
            if (!current) return;
            var p = point(e), last = current[current.length - 1];
            if (Math.abs(p[0] - last[0]) + Math.abs(p[1] - last[1]) < 1.5) return;   // buang titik yang terlalu rapat
            current.push(p); redraw();
        });
        ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (ev) {
            canvas.addEventListener(ev, function () { current = null; refresh(); });
        });

        function pointCount() { return strokes.reduce(function (n, s) { return n + s.length; }, 0); }

        function refresh() {
            var ok = mode === 'DRAW' ? pointCount() >= 10 : textInput.value.trim().length >= 2;
            confirmBtn.disabled = !ok;
            errorBox.textContent = '';
            if (mode === 'TYPE') renderFonts();
        }

        function renderFonts() {
            var text = textInput.value.trim() || 'Your Name';
            fontsBox.innerHTML = '';
            FONTS.forEach(function (f) {
                var b = document.createElement('button');
                b.type = 'button'; b.className = 'esign-font' + (f === font ? ' active' : '');
                b.style.fontFamily = '"' + f + '", cursive'; b.textContent = text; b.title = f;
                b.onclick = function () { font = f; renderFonts(); };
                fontsBox.appendChild(b);
            });
        }

        function setMode(m) {
            mode = m;
            document.querySelectorAll('.esign-tab').forEach(function (t) { t.classList.toggle('active', t.getAttribute('data-tab') === m); });
            document.getElementById('esignDrawPanel').style.display = m === 'DRAW' ? '' : 'none';
            document.getElementById('esignTypePanel').style.display = m === 'TYPE' ? '' : 'none';
            if (m === 'DRAW') setupCanvas(); else setTimeout(function () { textInput.focus(); }, 0);
            refresh();
        }

        document.querySelectorAll('.esign-tab').forEach(function (t) {
            t.addEventListener('click', function () { setMode(t.getAttribute('data-tab')); });
        });
        document.getElementById('esignClear').onclick = function () { strokes = []; redraw(); refresh(); };
        textInput.addEventListener('input', refresh);

        function close() { overlay.classList.remove('open'); options = {}; }
        document.getElementById('esignCancel').onclick = close;
        document.getElementById('esignClose').onclick = close;
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay.classList.contains('open')) close(); });

        confirmBtn.onclick = function () {
            var sig = mode === 'DRAW'
                ? { SIGN_METHOD: 'DRAW', SIGN_DATA: JSON.stringify({ w: W, h: H, strokes: strokes }), SIGN_FONT: '' }
                : { SIGN_METHOD: 'TYPE', SIGN_DATA: textInput.value.trim(), SIGN_FONT: font };
            var callback = options.onSigned;
            close();
            if (callback) callback(sig);
        };

        window.openSignaturePad = function (opts) {
            options = opts || {};
            document.getElementById('esignTitle').textContent = options.title || 'Sign document';
            document.getElementById('esignSub').textContent = options.subtitle || '';
            document.getElementById('esignConsent').textContent = options.consent ||
                'By signing, I confirm that I have reviewed this document and that this electronic signature is mine.';
            confirmBtn.textContent = options.confirmText || 'Sign';
            strokes = []; textInput.value = options.defaultName || ''; font = FONTS[0];
            overlay.classList.add('open');
            setMode('DRAW');
        };

        window.appendSignature = function (target, sig) {
            if (!sig) return target;
            if (typeof FormData !== 'undefined' && target instanceof FormData) {
                target.append('SIGN_METHOD', sig.SIGN_METHOD); target.append('SIGN_DATA', sig.SIGN_DATA); target.append('SIGN_FONT', sig.SIGN_FONT || '');
            } else {
                target.SIGN_METHOD = sig.SIGN_METHOD; target.SIGN_DATA = sig.SIGN_DATA; target.SIGN_FONT = sig.SIGN_FONT || '';
            }
            return target;
        };

        window.addEventListener('resize', function () { if (overlay.classList.contains('open') && mode === 'DRAW') setupCanvas(); });
    })();
</script>
