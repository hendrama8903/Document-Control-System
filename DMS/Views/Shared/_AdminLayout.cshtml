@using Microsoft.AspNetCore.Http

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Document Control System - @ViewData["Title"]</title>
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true">
    <!-- DataTables -->
    <link rel="stylesheet" href="~/lib/datatables.net-bs/css/dataTables.bootstrap.min.css" asp-append-version="true">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/fontawesome-iconpicker-1.4.0/dist/css/fontawesome-iconpicker.min.css" asp-append-version="true">
    <!-- Ionicons -->
    <link rel="stylesheet" href="~/lib/Ionicons/css/ionicons.min.css" asp-append-version="true">
    <link rel="Stylesheet" href="~/lib/select2/dist/css/select2.css" asp-append-version="true" />
    <link rel="Stylesheet" href="~/lib/jquery-message-box-3.2.2/dist/messagebox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <!-- jQuery 3 -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/grid-common.js" asp-append-version="true"></script>
    <!-- Font aplikasi (self-hosted, tidak butuh internet) -->
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true">
    <!-- date-range picker -->
    <link rel="stylesheet" href="~/dist/css/daterangepicker.css" asp-append-version="true">
    <!-- date picker -->
    <link rel="stylesheet" href="~/dist/css/bootstrap-datepicker3.css" asp-append-version="true">
    <!-- date range picker -->
    <link rel="stylesheet" href="~/lib/daterangepicker-master/daterangepicker.css" asp-append-version="true">
    <!-- print.js -->
    <link rel="stylesheet" href="~/lib/print-js/print.min.css" asp-append-version="true">
    <!-- Tema admin (harus paling akhir agar menimpa style di atas) -->
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/views/shared/_AdminLayout.css" asp-append-version="true" />
</head>
<body class="adm-body">
    <div class="adm-scrim" id="admScrim" onclick="admToggleNav(false)"></div>
    <div class="adm-app" id="admApp">
        <script>
            // Sebelum sidebar digambar, supaya tidak berkedip. Default-nya menu tersembunyi;
            // terbuka hanya kalau user pernah memilih membukanya di browser ini.
            var admCollapsed = true;
            try {
                admCollapsed = localStorage.getItem('dms.sidebarCollapsed') !== '0';
            } catch (e) { }
            if (admCollapsed) {
                document.getElementById('admApp').classList.add('collapsed');
            }
        </script>

        <!-- ===== SIDEBAR: rail + panel menu ===== -->
        <aside class="adm-sidebar" id="admSidebar">
            <div class="adm-rail">
                <a class="adm-rail-ic" href="~/" title="Home">
                    <img src="~/images/logo.png" alt="Document Control System">
                </a>
                <button type="button" class="adm-rail-collapse" onclick="admToggleCollapse()" title="Hide menu" aria-expanded="true">
                    <i class="fa fa-angle-double-left"></i>
                </button>
                <div class="adm-rail-vtext">DOCUMENT <em>CONTROL</em> SYSTEM</div>
            </div>
            <div class="adm-sidepanel">
                <div class="adm-menu-search">
                    <i class="fa fa-search"></i>
                    <input type="text" id="admMenuSearch" placeholder="Search menu..." autocomplete="off">
                </div>
                @Html.Partial("_MainMenu")
            </div>
        </aside>

        <!-- ===== MAIN ===== -->
        <main class="adm-main">
            <div class="adm-topbar">
                <button type="button" class="adm-topbtn adm-menu-btn" onclick="admToggleNav(true)">
                    <i class="fa fa-bars"></i>
                </button>
                <div class="adm-crumb">DCS &nbsp;/&nbsp; <b>@ViewData["Title"]</b></div>
                @* Pencarian dokumen global - nomor, judul & ISI dokumen (full-text search, 2026-11-06) *@
                <form class="adm-docsearch" method="get" action="@Url.Action("Index", "Search")" role="search">
                    <i class="fa fa-search"></i>
                    <input type="search" name="q" id="admDocSearch" placeholder="Search documents..." autocomplete="off"
                           value="@(Context.Request.Path.StartsWithSegments("/Search") ? Context.Request.Query["q"].ToString() : "")"
                           aria-label="Search documents by number, title or content" maxlength="200">
                </form>
                <link rel="stylesheet" href="~/css/views/shared/_AdminLayout-2.css" asp-append-version="true" />
                <div class="adm-top-right">
                    <div class="dropdown adm-notif" id="notificationHeader">
                        <button type="button" class="adm-topbtn dropdown-toggle" data-toggle="dropdown" aria-expanded="false" onclick="GetListNotif()">
                            <i class="fa fa-bell-o"></i>
                            <span class="label label-warning" id="totalNotification"></span>
                        </button>
                        <ul class="dropdown-menu">
                            <li class="adm-notif-head" id="headerNotification">You have 0 unread message.</li>
                            <li>
                                <ul class="adm-notif-list" id="listNotification"></ul>
                            </li>
                            <li class="adm-notif-foot">
                                <a href="#" onclick="GetListNotif()">Refresh</a>
                                <a href="#" onclick="onClearAllNotif(); return false;">Clear</a>
                            </li>
                        </ul>
                    </div>
                    @{
                        string headerAvatarPath = HttpContextAccessor.HttpContext.Session.GetString("FILE_PATH");
                        string headerAvatarSrc = string.IsNullOrEmpty(headerAvatarPath) ? Url.Content("~/dist/img/user.png") : headerAvatarPath;
                    }
                    <a class="adm-user" href="~/User/Profile">
                        <img src="@headerAvatarSrc" id="imgHeaderAvatar" alt="User Image" onerror="this.onerror=null;this.src='@Url.Content("~/dist/img/user.png")';">
                        <span>
                            <span class="nm" id="txtUserNameLayout">@Html.Raw(HttpContextAccessor.HttpContext.Session.GetString("USERNAME"))</span>
                            @* Akun admin ditampilkan sebagai Admin: jabatannya dipakai alur approval, bukan menggambarkan aksesnya. *@
                            <span class="ps">@Html.Raw(HttpContextAccessor.HttpContext.Session.GetString("ROLE_ID") == "DMS-ADMIN" ? "Admin" : HttpContextAccessor.HttpContext.Session.GetString("POSITION_NAME"))</span>
                        </span>
                    </a>
                    <button type="button" class="adm-topbtn adm-topbtn-logout" onclick="confirmLogout();" title="Logout">
                        <i class="fa fa-sign-out"></i>
                    </button>
                </div>
            </div>

            <div class="adm-content">
                @RenderBody()
            </div>
        </main>
    </div>
    <!-- REQUIRED JS SCRIPTS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables.net/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables.net-bs/js/dataTables.bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap-growl/jquery.bootstrap-growl.js" asp-append-version="true"></script>
    <script src="~/lib/select2/dist/js/select2.full.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-message-box-3.2.2/dist/messagebox.js" asp-append-version="true"></script>
    <script src="~/lib/blockUI/jquery.blockUI.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap-filestyle-2.1.0/src/bootstrap-filestyle.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin-theme.js" asp-append-version="true"></script>
    <script src="~/lib/moment/min/moment.min.js" asp-append-version="true"></script>
    <script src="~/dist/js/daterangepicker.js" asp-append-version="true"></script>
    <script src="~/dist/js/bootstrap-datepicker.js" asp-append-version="true"></script>
    <script src="~/lib/fontawesome-iconpicker-1.4.0/dist/js/fontawesome-iconpicker.js" asp-append-version="true"></script>
    <script src="~/lib/daterangepicker-master/daterangepicker.js" asp-append-version="true"></script>
    <script src="~/lib/print-js/print.min.js" asp-append-version="true"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js" asp-append-version="true"></script>
    @* Dialog tanda tangan elektronik (Draw/Type) - dipakai Save, Approve, Mengetahui (2026-11-06) *@
    @await Html.PartialAsync("_SignaturePad")
</body>
</html>

<script type="text/javascript">
    var connection = new signalR.HubConnectionBuilder().withUrl("/notificationsHub").build();
    connection.on("ReceiveMessage", function (message) {
        if (message != "") {
            showSuccessMesgGrowl(message);
            GetListNotif();
        }
    });

    connection.start().then(() => {
        connection.invoke("AddToGroup", "@Html.Raw(HttpContextAccessor.HttpContext.Session.GetString("USERNAME"))").catch((err) => {
            console.error("Error when add group:", err);
        });
    }).catch((err) => {
        console.error("Error connecting to the hub:", err);
    });

    $(document).ready(function () {
        GetListNotif();
    });

    function GetListNotif() {
        $.ajax({
            type: "POST",
            url: "@Url.Action("getListNotification", "Auth")",
            dataType: 'json',
            traditional: true,
            data: {
                USERNAME: "@Html.Raw(HttpContextAccessor.HttpContext.Session.GetString("USERNAME"))",
            },
            success: function (result) {
                $('#listNotification').empty();
                if (result.status == true) {
                    var count = result.data.filter(item => item.STATUS === "0").length;
                    $('#totalNotification').text(count).toggle(count > 0);
                    $('#headerNotification').text("You have " + count + " unread message.");
                    $('#notificationHeader').toggleClass('has-unread', count > 0);
                    $.each(result.data, function (index) {
                        var background = "";
                        if (result.data[index].STATUS === "0") {
                            background = 'class="bg-warning"';
                        }

                        $('#listNotification').append(
                            '<li ' + background + '>'
                            + '<a href="#" onclick="onClickNotif(\'' + result.data[index].NOTIFICATION_URL + '\', \'' + result.data[index].NOTIFICATION_ID + '\')">'
                            + '<small><i class="fa fa-clock-o"> </i> ' + moment(result.data[index].NOTIFICATION_DATE).format('DD-MM-YYYY HH:mm') + '</small>'
                            + '<h4 style="margin-left:0px; margin-bottom:8px">'
                            + result.data[index].NOTIFICATION_TITLE
                            + '</h4>'
                            + '<p style="margin-left:0px">' + result.data[index].NOTIFICATION_TEXT + '</p>'
                            + '</a>'
                            + '</li>'
                        );
                    });
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function (result) {
                // Permintaan yang terputus karena user pindah halaman bukan error.
                if (result.status === 0) {
                    return;
                }
                showErrorMesgGrowl(result);
            }
        });
    }

    function onClearAllNotif() {
        showDangerConfirm("Are you sure you want to clear all notifications? This cannot be undone.", function () {
            $.ajax({
                type: "POST",
                url: "@Url.Action("ClearAll", "Inbox")"
            }).done(function (result) {
                if (result.status == true) {
                    GetListNotif();
                } else {
                    showErrorMesgGrowl(result.message);
                }
            }).fail(function (result) {
                showErrorMesgGrowl(result);
            });
        }, "Clear");
    }

    function onClickNotif(path, notificationId) {
        var data = {
            notificationId: notificationId
        };

        $.ajax({
            type: "GET",
            url: "@Url.Action("UpdateNotification", "Auth")",
            dataType: 'json',
            traditional: true,
            data: data,
            success: function (result) {
                if (result.status == true) {
                    window.location.href = path;
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function (result) {
                showErrorMesgGrowl(result);
            }
        });
    }

    function confirmLogout(){
        showConfirmMesg("Are you sure you want to logout ?", logout, "Confirmation");
    }

    function logout(){
        window.location.href = '@Url.Action("Logout", "Auth")';
    }

</script>
