<link rel="stylesheet" href="~/css/devextreme/dx.light.css" asp-append-version="true" />
<script src="~/js/devextreme/dx.custom.js" asp-append-version="true"></script>

<link rel="stylesheet" href="~/css/views/LegacyDocumentImport/Index.css" asp-append-version="true" />

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="di-page">

                <div class="di-header">
                    <div class="di-header-text">
                        <h1>@ViewData["Title"]</h1>
                        <p>Bring existing controlled documents into the system from an Excel template and a ZIP of their files.</p>
                    </div>
                    <a class="dp-btn dp-btn-outline" href="@Url.Action("DownloadTemplate")"><i class="fa fa-download"></i> Download Template</a>
                </div>

                <!-- One card, two steps (request Hendra 2026-11-12). Restyled 2026-11-15: same
                     colors, buttons and type sizes as the rest of the app, file pickers as tiles. -->
                <div class="di-card">

                    <!-- Step 1 (optional): departments' Master List (QCD/FR-QMS-00/004) -> filled
                         template. Only the document file NAMES are sent; the files go up in step 2. -->
                    <div class="di-step">
                        <div class="di-step-rail"><span class="di-step-no">1</span></div>
                        <div class="di-step-main">
                            <div class="di-step-title">Convert Master List <span class="di-badge">Optional</span></div>
                            <div class="di-step-desc">Starting from a department's Master List (QCD/FR-QMS-00/004)? Convert it into a filled import template. Skip this step if your template is already filled.</div>

                            <div class="di-step-row">
                                <input type="file" id="mlFiles" accept=".xlsx,.xls,.xlsm" multiple hidden />
                                <button type="button" class="di-pick" id="mlPick" title="Master List Dokumen Internal, one or more files">
                                    <span class="di-pick-icon excel"><i class="fa fa-file-excel-o"></i></span>
                                    <span class="di-pick-body">
                                        <span class="di-pick-title">Master Lists</span>
                                        <span class="di-pick-text" id="mlPicked">Choose one or more .xlsx files</span>
                                    </span>
                                </button>
                                <input type="file" id="mlFolder" webkitdirectory directory multiple hidden />
                                <button type="button" class="di-pick" id="mlPickFolder" title="Only the file names are read, to fill the File Name column">
                                    <span class="di-pick-icon folder"><i class="fa fa-folder-open-o"></i></span>
                                    <span class="di-pick-body">
                                        <span class="di-pick-title">Document Folder <span class="di-pick-opt">optional</span></span>
                                        <span class="di-pick-text" id="mlFolderPicked">Only file names are read, nothing is uploaded</span>
                                    </span>
                                </button>
                                <button type="button" class="dp-btn dp-btn-outline di-step-btn" id="btn_convert"><i class="fa fa-exchange"></i> Convert</button>
                            </div>
                            <div class="di-convert-result" id="mlResult"></div>
                            <div class="di-alert" id="mlAlert" role="alert"></div>
                        </div>
                    </div>

                    <!-- Step 2: filled template + ZIP of the documents -->
                    <div class="di-step">
                        <div class="di-step-rail"><span class="di-step-no">2</span></div>
                        <div class="di-step-main">
                            <div class="di-step-title">Upload and Validate</div>
                            <div class="di-step-desc">Choose the filled template and one ZIP with the document files. Nothing is saved until you press Import in the review.</div>

                            <div class="di-step-row">
                                <div class="di-pick di-dropzone" id="dzExcel" title="Drop or click to choose the filled template">
                                    <input type="file" id="excelFile" accept=".xlsx,.xls" hidden />
                                    <span class="di-pick-icon excel"><i class="fa fa-file-excel-o"></i></span>
                                    <span class="di-pick-body">
                                        <span class="di-pick-title">Excel Template</span>
                                        <span class="di-pick-text di-dz-dropline">Drop the .xlsx here or click to choose</span>
                                        <span class="di-dz-file" style="display:none;">
                                            <span class="di-dz-filename"></span>
                                            <span class="di-dz-filesize"></span>
                                        </span>
                                    </span>
                                    <i class="fa fa-check-circle di-dz-check"></i>
                                    <button type="button" class="di-dz-remove" title="Remove this file"><i class="fa fa-times"></i></button>
                                </div>
                                <div class="di-pick di-dropzone" id="dzZip" title="Drop or click to choose the ZIP of the documents">
                                    <input type="file" id="zipFile" accept=".zip" hidden />
                                    <span class="di-pick-icon zip"><i class="fa fa-file-archive-o"></i></span>
                                    <span class="di-pick-body">
                                        <span class="di-pick-title">Documents ZIP</span>
                                        <span class="di-pick-text di-dz-dropline">Drop the .zip here or click to choose</span>
                                        <span class="di-dz-file" style="display:none;">
                                            <span class="di-dz-filename"></span>
                                            <span class="di-dz-filesize"></span>
                                        </span>
                                    </span>
                                    <i class="fa fa-check-circle di-dz-check"></i>
                                    <button type="button" class="di-dz-remove" title="Remove this file"><i class="fa fa-times"></i></button>
                                </div>
                                <button type="button" class="dp-btn dp-btn-primary di-step-btn" id="btn_preview"><i class="fa fa-eye"></i> Preview &amp; Validate</button>
                            </div>

                            <div class="di-alert" id="importAlert" role="alert"></div>

                            <ul class="di-hints">
                                <li><i class="fa fa-file-excel-o"></i> Excel up to 10 MB</li>
                                <li><i class="fa fa-file-archive-o"></i> ZIP up to 100 MB, PDF or Excel files named as in the File Name column</li>
                                <li><i class="fa fa-shield"></i> Import is enabled only when every row passes validation</li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Review & Import - shown as a popup once Preview & Validate finishes -->
<div class="modal fade" id="modalReview" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="di-review-header">
                <div class="di-review-icon"><i class="fa fa-check-square-o"></i></div>
                <div>
                    <div class="di-review-title">Review &amp; Import</div>
                    <div class="di-review-sub" id="diReviewSub">Check the validation result of every row before importing.</div>
                </div>
                <button type="button" class="di-modal-close" data-dismiss="modal" aria-label="Close" title="Close"><i class="fa fa-times"></i></button>
            </div>

            <div class="di-review-toolbar">
                <div class="di-tabs" id="diTabs">
                    <button type="button" class="di-tab active" data-filter="all">All <span id="tabAllCount">0</span></button>
                    <button type="button" class="di-tab" data-filter="ready"><i class="fa fa-check-circle"></i> Ready <span id="tabReadyCount">0</span></button>
                    <button type="button" class="di-tab" data-filter="warning"><i class="fa fa-exclamation-triangle"></i> Warning <span id="tabWarningCount">0</span></button>
                    <button type="button" class="di-tab" data-filter="error"><i class="fa fa-times-circle"></i> Error <span id="tabErrorCount">0</span></button>
                </div>
                <button type="button" class="dp-btn dp-btn-outline" id="btn_export"><i class="fa fa-download"></i> Export Result</button>
            </div>

            <div class="modal-body">
                <div class="di-alert" id="reviewAlert" role="alert"></div>
                <div id="reviewGrid"></div>
            </div>

            <div class="di-final-actions">
                <div class="di-final-note" id="importNote">All rows must be error-free before you can import</div>
                <div class="di-final-right">
                    <button type="button" class="dp-btn dp-btn-outline" id="btn_cancel">Cancel</button>
                    @if ((bool)ViewData["Import"])
                    {
                        <button type="button" class="dp-btn dp-btn-primary" id="btn_import" disabled><i class="fa fa-upload"></i> Import <span id="btnImportCount">0</span> Documents</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Conversion Log - shown after Convert (2026-11-17): every code the system does not know yet,
     over all master lists at once, plus every error/warning of the conversion. -->
<div class="modal fade" id="modalConvertLog" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="di-review-header">
                <div class="di-review-icon"><i class="fa fa-list-alt"></i></div>
                <div>
                    <div class="di-review-title">Conversion Log</div>
                    <div class="di-review-sub" id="clSub"></div>
                </div>
                <button type="button" class="di-modal-close" data-dismiss="modal" aria-label="Close" title="Close"><i class="fa fa-times"></i></button>
            </div>

            <div class="modal-body">
                <div class="di-cl-stats" id="clStats"></div>

                <div class="di-alert" id="clFileProblems" role="alert"></div>

                <div class="di-cl-section" id="clMissingSection">
                    <div class="di-cl-head">
                        <div>
                            <div class="di-cl-title"><i class="fa fa-question-circle"></i> Codes Not in the System <span class="di-cl-count" id="clMissingCount">0</span></div>
                            <div class="di-cl-desc">Every code over all master lists, listed once. Add a former department under System Parameters &gt; DEPT_SUCCESSOR (code = old department, value = new department codes), other codes in their master, then convert again.</div>
                        </div>
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_copyMissing"><i class="fa fa-clipboard"></i> Copy Codes</button>
                    </div>
                    <div id="clMissingGrid"></div>
                </div>

                <div class="di-cl-section">
                    <div class="di-cl-head">
                        <div class="di-tabs" id="clTabs">
                            <button type="button" class="di-tab active" data-filter="all">All <span id="clAllCount">0</span></button>
                            <button type="button" class="di-tab" data-filter="error"><i class="fa fa-times-circle"></i> Error <span id="clErrorCount">0</span></button>
                            <button type="button" class="di-tab" data-filter="warning"><i class="fa fa-exclamation-triangle"></i> Warning <span id="clWarningCount">0</span></button>
                        </div>
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_exportLog"><i class="fa fa-download"></i> Export Log</button>
                    </div>
                    <div id="clLogGrid"></div>
                </div>
            </div>

            <div class="di-final-actions">
                <div class="di-final-note" id="clNote"></div>
                <div class="di-final-right">
                    <button type="button" class="dp-btn dp-btn-outline" data-dismiss="modal">Close</button>
                    <button type="button" class="dp-btn dp-btn-primary" id="btn_downloadConverted"><i class="fa fa-file-excel-o"></i> Download Template</button>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_Javascript")
