<script type="text/javascript">
    var gLastRows = [];       // last rendered rows (preview or report), each tagged with _category
    var gLastMode = "preview"; // "preview" | "report"
    var gActiveTab = "all";

    $(document).ready(function () {
        setupDropzone("dzExcel", "excelFile");
        setupDropzone("dzZip", "zipFile");

        $("#btn_preview").on("click", function () { runImport(false); });

        $("#btn_import").on("click", function () {
            var errorCount = gLastRows.filter(function (r) { return r._category === "error"; }).length;
            var readyCount = gLastRows.filter(function (r) { return r._category !== "error"; }).length;
            if (readyCount === 0 || errorCount > 0) return;
            showConfirmMesg("Are you sure you want to import all " + readyCount + " document(s) into the system?", function () {
                runImport(true);
            }, "Confirmation");
        });

        $("#btn_cancel").on("click", function () {
            resetUploadForm();
        });

        $("#btn_viewErrors").on("click", function () {
            setActiveTab("error");
        });

        $("#btn_export").on("click", function () {
            exportResultCsv();
        });

        $("#diTabs").on("click", ".di-tab", function () {
            setActiveTab($(this).data("filter"));
        });
    });

    // ---------- Dropzones ----------
    function setupDropzone(zoneId, inputId) {
        var zone = document.getElementById(zoneId);
        var input = document.getElementById(inputId);

        zone.addEventListener("click", function (e) {
            if (e.target.closest(".di-dz-file")) return;
            input.click();
        });

        input.addEventListener("change", function () {
            if (input.files.length > 0) {
                showSelectedFile(zone, input.files[0]);
            }
        });

        ["dragenter", "dragover"].forEach(function (evt) {
            zone.addEventListener(evt, function (e) {
                e.preventDefault();
                e.stopPropagation();
                zone.classList.add("dragover");
            });
        });

        ["dragleave", "drop"].forEach(function (evt) {
            zone.addEventListener(evt, function (e) {
                e.preventDefault();
                e.stopPropagation();
                zone.classList.remove("dragover");
            });
        });

        zone.addEventListener("drop", function (e) {
            var files = e.dataTransfer.files;
            if (files.length > 0) {
                input.files = files;
                showSelectedFile(zone, files[0]);
            }
        });
    }

    // The drag&drop box stays visible even after a file is picked (matches
    // mockup) - so the user can drop/browse again to replace it. Only the
    // colored "selected file" row below toggles.
    function showSelectedFile(zone, file) {
        zone.classList.add("filled");
        var fileBox = $(zone).find(".di-dz-file");
        fileBox.find(".di-dz-filename").text(file.name).attr("title", file.name);
        fileBox.find(".di-dz-filesize").text(formatFileSize(file.size));
        fileBox.show();
    }

    function formatFileSize(bytes) {
        if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + " MB";
        if (bytes >= 1024) return (bytes / 1024).toFixed(0) + " KB";
        return bytes + " B";
    }

    function resetDropzone(zoneId) {
        var zone = document.getElementById(zoneId);
        zone.classList.remove("filled");
        $(zone).find(".di-dz-dropline").show();
        $(zone).find(".di-dz-file").hide();
    }

    // ---------- Reset ----------
    function resetUploadForm() {
        document.getElementById("excelFile").value = "";
        document.getElementById("zipFile").value = "";
        resetDropzone("dzExcel");
        resetDropzone("dzZip");

        $("#modalReview").modal("hide");
        gLastRows = [];
        gActiveTab = "all";
        $("#btn_import").prop("disabled", true);
    }

    // ---------- Run preview / import ----------
    function runImport(commitMode) {
        var excelInput = document.getElementById("excelFile");
        var zipInput = document.getElementById("zipFile");

        if (excelInput.files.length == 0) {
            showErrorMesgGrowl("Please choose the Excel metadata file.");
            return;
        }
        if (zipInput.files.length == 0) {
            showErrorMesgGrowl("Please choose the ZIP file.");
            return;
        }

        var formData = new FormData();
        formData.append("excelFile", excelInput.files[0]);
        formData.append("zipFile", zipInput.files[0]);
        formData.append("commitMode", commitMode);

        popUpProgressShow();
        $("#btn_preview").prop("disabled", true);
        $("#btn_import").prop("disabled", true);

        $.ajax({
            type: "POST",
            url: "@Url.Action("ProcessImport", "LegacyDocumentImport")",
            contentType: false,
            processData: false,
            data: formData,
            success: function (result) {
                popUpProgressHide();
                $("#btn_preview").prop("disabled", false);

                if (result.status != true) {
                    showErrorMesgGrowl(result.message);
                    return;
                }

                if (commitMode) {
                    renderReview(result.data, "report");

                    if (result.failCount > 0) {
                        showErrorMesgGrowl(result.successCount + " imported, " + result.failCount + " failed - see details below.");
                    } else {
                        showSuccessMesgGrowl(result.successCount + " document(s) imported successfully.");
                        resetUploadForm();
                    }
                } else {
                    renderReview(result.data, "preview");
                }
            },
            error: function (result) {
                popUpProgressHide();
                $("#btn_preview").prop("disabled", false);
                showErrorMesgGrowl(result);
            }
        });
    }

    // ---------- Review rendering ----------
    // Category rules (uses only fields the backend already returns - no fabricated data):
    //  preview rows: "error" if !valid, "warning" if valid but isHistoryOnlyAppend (this
    //  Document Code already has an active document elsewhere - backfilling history into
    //  something that already exists, worth a second look), otherwise "ready".
    //  report rows (after commit): "ready" if status true, "error" if false - no warning
    //  tier once it's already been committed one way or the other.
    function categorize(row, mode) {
        if (mode === "report") {
            return row.status ? "ready" : "error";
        }
        if (!row.valid) return "error";
        if (row.isHistoryOnlyAppend) return "warning";
        return "ready";
    }

    function renderReview(rows, mode) {
        gLastMode = mode;
        gActiveTab = "all";

        gLastRows = rows.map(function (row) {
            row._category = categorize(row, mode);
            return row;
        });

        var readyCount = gLastRows.filter(function (r) { return r._category === "ready"; }).length;
        var warningCount = gLastRows.filter(function (r) { return r._category === "warning"; }).length;
        var errorCount = gLastRows.filter(function (r) { return r._category === "error"; }).length;
        var total = gLastRows.length;

        $("#tabAllCount").text(total);
        $("#tabReadyCount").text(readyCount);
        $("#tabWarningCount").text(warningCount);
        $("#tabErrorCount").text(errorCount);

        // All-or-nothing (request Hendra 2026-08-27): server menolak commit kalau
        // ADA SATU SAJA baris tidak valid, jadi Import di-disable total begitu
        // errorCount > 0 - bukan cuma kalau tidak ada baris ready sama sekali.
        // Semua error harus diperbaiki dulu (lihat pesan di kolom Message) baru
        // tombol ini aktif lagi.
        var importCount = mode === "preview" ? (readyCount + warningCount) : 0;
        $("#btnImportCount").text(importCount);
        $("#btn_import").prop("disabled", mode !== "preview" || importCount === 0 || errorCount > 0);

        if (mode === "preview") {
            if (errorCount > 0) {
                $("#importNote").text("Fix all " + errorCount + " error(s) below before you can import");
            } else {
                $("#importNote").text("All rows are error-free - ready to import");
            }
        }

        $("#modalReview").modal("show");
        renderGrid();
        setActiveTab("all");
    }

    function setActiveTab(filter) {
        gActiveTab = filter;
        $(".di-tab").removeClass("active");
        $(".di-tab[data-filter='" + filter + "']").addClass("active");

        var grid = $("#reviewGrid").dxDataGrid("instance");
        if (filter === "all") {
            grid.clearFilter();
        } else {
            grid.filter(["_category", "=", filter]);
        }
    }

    // ---------- Review grid (DevExtreme, same component used elsewhere in the app) ----------
    function renderGrid() {
        if ($("#reviewGrid").data("dxDataGrid")) {
            $("#reviewGrid").dxDataGrid("instance").option("dataSource", gLastRows);
            return;
        }

        $("#reviewGrid").dxDataGrid({
            dataSource: gLastRows,
            showBorders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            wordWrapEnabled: true,
            height: "auto",
            noDataText: "No documents in this view.",
            paging: { enabled: false },
            scrolling: { mode: "standard", useNative: false },
            sorting: { mode: "none" },
            filterRow: { visible: true, applyFilter: "auto" },
            searchPanel: { visible: false },
            columns: [
                {
                    caption: "",
                    dataField: "_category",
                    width: 34,
                    alignment: "center",
                    allowResizing: false,
                    allowFiltering: false,
                    cellTemplate: function (container, options) {
                        var iconClass = options.value === "ready" ? "fa-check-circle" : (options.value === "warning" ? "fa-exclamation-triangle" : "fa-times-circle");
                        $("<i>").addClass("fa " + iconClass + " di-status-icon " + options.value).appendTo(container);
                    }
                },
                { dataField: "documentCode", caption: "Document No.", calculateCellValue: function (row) { return row.documentCode || "-"; } },
                { dataField: "revision", caption: "Revision", width: 90, alignment: "center", calculateCellValue: function (row) { return row.revision != null ? row.revision : "-"; } },
                { dataField: "documentName", caption: "Document Title", calculateCellValue: function (row) { return row.documentName || "-"; } },
                { dataField: "fileName", caption: "File Name", calculateCellValue: function (row) { return row.fileName || "-"; } },
                {
                    caption: "File Size",
                    width: 90,
                    allowFiltering: false,
                    // Not available without parsing the ZIP client-side.
                    cellTemplate: function (container) { container.text("-"); }
                },
                {
                    caption: "Message",
                    minWidth: 220,
                    cellTemplate: function (container, options) {
                        $("<span>").addClass("di-msg-" + options.data._category).text(buildMessage(options.data)).appendTo(container);
                    }
                }
            ]
        });
    }

    function buildMessage(row) {
        if (gLastMode === "report") {
            return row.message || (row.status ? "Imported" : "Failed");
        }

        if (row._category === "error") {
            return (row.errors || []).join("; ");
        }
        if (row._category === "warning") {
            return "Revision " + row.revision + " will be appended as history to the Document Code's already-active document.";
        }
        if (row.isCurrentRevision) {
            return "Ready - revision " + row.revision + " will become the active document.";
        }
        return "Ready - historical revision " + row.revision + ".";
    }

    // ---------- Export ----------
    function exportResultCsv() {
        if (gLastRows.length === 0) return;

        var headers = ["Status", "Document No.", "Revision", "Document Title", "File Name", "Message"];
        var lines = [headers.join(",")];

        gLastRows.forEach(function (row) {
            var cells = [
                row._category,
                row.documentCode || "",
                row.revision != null ? row.revision : "",
                row.documentName || "",
                row.fileName || "",
                buildMessage(row)
            ].map(function (v) {
                var s = String(v).replace(/"/g, '""');
                return /[",\n]/.test(s) ? '"' + s + '"' : s;
            });
            lines.push(cells.join(","));
        });

        var blob = new Blob([lines.join("\n")], { type: "text/csv;charset=utf-8;" });
        var url = URL.createObjectURL(blob);
        var link = document.createElement("a");
        link.href = url;
        link.download = "Document_Import_Result.csv";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    }
</script>
