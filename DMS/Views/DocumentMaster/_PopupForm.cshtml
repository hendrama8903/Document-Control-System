<link rel="stylesheet" href="~/css/views/DocumentMaster/_PopupForm.css" asp-append-version="true" />

<div class="modal fade" id="modalAddEdit" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="dmf-header">
                <div class="dmf-header-icon"><i class="fa fa-file-text-o"></i></div>
                <div>
                    <div class="dmf-header-title" id="modal-title">New Document Category</div>
                    <div class="dmf-header-sub">Update the document category and its signing template</div>
                </div>
                <button type="button" class="dmf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="dmf-body">
                <div class="dmf-row">
                    <div class="dmf-row-left">
                        <div class="dmf-icon"><i class="fa fa-tag"></i></div>
                        <div>
                            <div class="dmf-label">Document Code <span class="text-red">*</span></div>
                            <div class="dmf-sub">Unique document code</div>
                        </div>
                    </div>
                    <div class="dmf-row-right">
                        <input class="form-control" id="addEditDocumentCode" type="text" oninput="removeWhiteSpace(this)" maxlength="5" />
                    </div>
                </div>

                <div class="dmf-row">
                    <div class="dmf-row-left">
                        <div class="dmf-icon"><i class="fa fa-file-o"></i></div>
                        <div>
                            <div class="dmf-label">Document Name <span class="text-red">*</span></div>
                            <div class="dmf-sub">Document category name</div>
                        </div>
                    </div>
                    <div class="dmf-row-right">
                        <input class="form-control" id="addEditDocumentName" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                    </div>
                </div>

                <div class="dmf-row">
                    <div class="dmf-row-left">
                        <div class="dmf-icon"><i class="fa fa-clone"></i></div>
                        <div>
                            <div class="dmf-label">Level <span class="text-red">*</span></div>
                            <div class="dmf-sub">Document hierarchy level</div>
                        </div>
                    </div>
                    <div class="dmf-row-right">
                        <select class="form-control" id="addEditLevel"></select>
                    </div>
                </div>

                <div class="dmf-row">
                    <div class="dmf-row-left">
                        <div class="dmf-icon"><i class="fa fa-history"></i></div>
                        <div>
                            <div class="dmf-label">Review Cycle (months)</div>
                            <div class="dmf-sub">Leave empty if not needed</div>
                        </div>
                    </div>
                    <div class="dmf-row-right">
                        <input class="form-control" id="addEditReviewCycleMonths" type="number" min="0" placeholder="Leave empty if periodic review is not required" />
                    </div>
                </div>

                <div class="dmf-row">
                    <div class="dmf-row-left">
                        <div class="dmf-icon"><i class="fa fa-paperclip"></i></div>
                        <div>
                            <div class="dmf-label">Template</div>
                            <div class="dmf-sub">Upload the document's signing template<br />Format: .xlsx, .xls</div>
                        </div>
                    </div>
                    <div class="dmf-row-right">
                        <input type="file" id="attachmentPath" accept=".xls,.xlsx" style="display:none;" />
                        <div class="dmf-upload-box" id="dmfUploadBox">
                            <div class="dmf-upload-icon" id="dmfUploadIcon"><i class="fa fa-file-excel-o"></i></div>
                            <div class="dmf-upload-text">
                                <div class="dmf-upload-filename" id="dmfUploadFilename">No file selected</div>
                                <div class="dmf-upload-hint" id="dmfUploadHint">Choose a template file to upload</div>
                            </div>
                            <button type="button" class="dmf-btn dmf-btn-outline" id="btn_chooseFile"><i class="fa fa-upload"></i> Choose file</button>
                            <button type="button" class="dmf-btn-icon-danger" id="btn_delete_filepath" title="Remove Template" style="display:none;"><i class="fa fa-trash"></i></button>
                        </div>
                        <div class="dmf-upload-maxsize">Maximum file size 10MB</div>
                        <div class="dmf-check" id="dmfTemplateCheck" style="display:none;"></div>
                        <div class="dmf-preview-row">
                            <button type="button" class="dmf-btn dmf-btn-outline" id="btn_previewTemplate" style="display:none;" title="Preview the signing page with sample data and signatures"><i class="fa fa-eye"></i> Preview Signing Page</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dmf-footer">
                <button type="button" class="dmf-btn dmf-btn-cancel" id="btn_cancel" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="dmf-btn dmf-btn-primary" id="btn_save"><i class="fa fa-check"></i> Save</button>
            </div>
        </div>
    </div>
</div>
