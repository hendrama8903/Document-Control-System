<style>
    #modalAddEdit .modal-content { border: none; border-radius: 14px; overflow: hidden; padding: 0; }
    #modalAddEdit .modal-header, #modalAddEdit .modal-footer { display: none; }

    .dpf-header {
        background: linear-gradient(135deg, #2450D8, #1C3FA6);
        color: #fff;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .dpf-header-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: rgba(255,255,255,.18);
        display: flex; align-items: center; justify-content: center;
        flex: none; font-size: 16px;
    }
    .dpf-header-title { font-size: 16px; font-weight: 700; }
    .dpf-header-sub { font-size: 12px; color: rgba(255,255,255,.85); margin-top: 1px; }
    .dpf-close {
        margin-left: auto; background: none; border: none;
        color: rgba(255,255,255,.85); font-size: 16px; cursor: pointer; padding: 4px;
    }
    .dpf-close:hover { color: #fff; }

    .dpf-body { padding: 4px 22px; }

    .dpf-row {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid #EEF1F5;
    }
    .dpf-row:last-child { border-bottom: none; }
    .dpf-row-left {
        display: flex; align-items: flex-start; gap: 11px;
        flex: 0 0 190px;
    }
    .dpf-icon {
        width: 36px; height: 36px; border-radius: 10px;
        background: #E7F1FB; color: #2450D8;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; flex: none;
    }
    .dpf-label { font-size: 13px; font-weight: 700; color: #1D2939; }
    .dpf-sub { font-size: 11px; color: #98A2B3; margin-top: 1px; line-height: 1.3; }
    .dpf-row-right { flex: 1 1 0; min-width: 0; padding-top: 6px; }
    .dpf-hint { font-size: 10.5px; color: #98A2B3; margin-top: 5px; line-height: 1.3; }

    @@media (max-width: 640px) {
        .dpf-row { flex-direction: column; align-items: stretch; }
        .dpf-row-left { flex: none; }
    }

    .dpf-footer {
        display: flex; justify-content: flex-end; gap: 10px;
        padding: 14px 22px; border-top: 1px solid #EEF1F5;
    }
    .dpf-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 16px; border-radius: 7px; font-size: 12.5px; font-weight: 700;
        border: 1px solid transparent; cursor: pointer; white-space: nowrap;
    }
    .dpf-btn-cancel { background: #fff; border-color: #D5DDE8; color: #475467; }
    .dpf-btn-cancel:hover { background: #F4F6F8; }
    .dpf-btn-primary { background: #2450D8; color: #fff; }
    .dpf-btn-primary:hover { background: #1C3FA6; }
</style>

<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="dpf-header">
                <div class="dpf-header-icon"><i class="fa fa-building"></i></div>
                <div>
                    <div class="dpf-header-title" id="modal-title">Add Department Master</div>
                    <div class="dpf-header-sub" id="modal-subtitle">Add a new department to the system</div>
                </div>
                <button type="button" class="dpf-close" data-dismiss="modal"><i class="fa fa-times"></i></button>
            </div>

            <div class="dpf-body">
                <div class="dpf-row">
                    <div class="dpf-row-left">
                        <div class="dpf-icon"><i class="fa fa-tag"></i></div>
                        <div>
                            <div class="dpf-label">Department Code <span class="text-red">*</span></div>
                            <div class="dpf-sub">Unique department code</div>
                        </div>
                    </div>
                    <div class="dpf-row-right">
                        <input class="form-control" id="addEditDepartment" type="text" maxlength="5" oninput="removeWhiteSpace(this)" placeholder="Enter department code" />
                        <input id="addEditId" type="hidden" />
                        <div class="dpf-hint">Use a short, unique code, e.g: FIN, HRD, IT</div>
                    </div>
                </div>

                <div class="dpf-row">
                    <div class="dpf-row-left">
                        <div class="dpf-icon"><i class="fa fa-file-o"></i></div>
                        <div>
                            <div class="dpf-label">Department Name <span class="text-red">*</span></div>
                            <div class="dpf-sub">Department name</div>
                        </div>
                    </div>
                    <div class="dpf-row-right">
                        <input class="form-control" id="addEditName" type="text" oninput="removeWhiteSpace(this)" maxlength="255" placeholder="Enter department name" />
                        <div class="dpf-hint">Enter the full department name</div>
                    </div>
                </div>

                <div class="dpf-row">
                    <div class="dpf-row-left">
                        <div class="dpf-icon"><i class="fa fa-sitemap"></i></div>
                        <div>
                            <div class="dpf-label">Division <span class="text-red">*</span></div>
                            <div class="dpf-sub">Select related division</div>
                        </div>
                    </div>
                    <div class="dpf-row-right">
                        <select class="form-control" id="addEditDivision"></select>
                        <div class="dpf-hint">Select the parent division for this department</div>
                    </div>
                </div>
            </div>

            <div class="dpf-footer">
                <button type="button" class="dpf-btn dpf-btn-cancel" id="btn_cancel" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="dpf-btn dpf-btn-primary" id="btn_save"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>
