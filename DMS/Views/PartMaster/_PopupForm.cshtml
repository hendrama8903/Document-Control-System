<div class="modal fade" id="modalAddEdit" role="dialog" aria-labelledby="basicModal" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title" id="modal-title">Add / Edit @ViewData["Title"]</h4>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 form-horizontal" style="margin-top:15px; margin-left:15px">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Old Part No<span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <select class="form-control" id="addEditOldPartNo"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Part No <span class="text-red"> *</span></label>
                                    <div class="col-sm-4">
                                        <input class="form-control" id="addEditPartNo" type="text" maxlength="10" onkeyup="setDataOldPartNo()" oninput="removeWhiteSpace(this)" />
                                    </div>
                                    <label class="col-sm-1 control-label" style="margin-left: -7px; margin-right: -20px;">SFX</label>
                                    <div class="col-sm-2">
                                        <input class="form-control" id="addEditPartNoSfx" type="text" oninput="removeWhiteSpace(this)" maxlength="2" style="width: 45px" />
                                    </div>
                                    <label class="col-sm-1 control-label" style="margin-left: -29px; margin-right: -20px;">Min</label>
                                    <div class="col-sm-2">
                                        <input class="form-control" id="addEditPartNoMin" type="text" oninput="removeWhiteSpace(this)" maxlength="2" style="width: 45px" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Part Name<span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <input class="form-control" id="addEditPartName" type="text" oninput="removeWhiteSpace(this)" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Category<span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <select class="form-control" id="addEditPartCategory"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Part Type<span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <select class="form-control" id="addEditPartType"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Part Unit<span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <select class="form-control" id="addEditPartUnit"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Net Weight<span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <input class="form-control" id="addEditPartNetWeight" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group has-feedback">
                                    <label class="col-sm-3 control-label">Valid From <span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <input class="form-control" id="addEditValidFrom" type="text" onkeydown="return false"/>
                                        <span class="glyphicon glyphicon-calendar form-control-feedback"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group has-feedback">
                                    <label class="col-sm-3 control-label">Valid To<span class="text-red"> *</span></label>
                                    <div class="col-sm-8">
                                        <input class="form-control" id="addEditValidTo" type="text" onkeydown="return false"/>
                                        <span class="glyphicon glyphicon-calendar form-control-feedback"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group has-feedback" id="inputContainer">
                                    <label class="col-sm-3 control-label">Attachment Path</label>
                                    <div class="col-sm-6" id="fileNameContainer">
                                        <input type="file" class="filestyle" data-btnClass="btn-primary" id="attachmentPath" style="height: 31px;">
                                    </div>
                                    <div class="col-sm-1" style="padding-left: 1px">
                                        <div class="btn-group">
                                            @if ((bool)ViewData["Delete-Attachment"])
                                            {
                                                <button type="button" id="btn_delete_attachment" class="btn btn-danger" data-toggle="tooltip" data-placement="bottom" title="Remove Attachment"><i class="fa fa-trash"></i></button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="col-xs-12 text-right">
                    <button type="button" class="btn btn-primary" id="btn_save" style="width: 80px;">Save</button>
                    <button type="button" class="btn btn-danger" id="btn_cancel" data-dismiss="modal" style="width: 80px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>