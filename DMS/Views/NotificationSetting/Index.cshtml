<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="divTitle">
                <div class="dp-header">
                    <div class="dp-header-left">
                        <div class="dp-header-icon"><i class="fa fa-envelope-o"></i></div>
                        <div>
                            <h1>@ViewData["Title"]</h1>
                            <p>Pilih jenis notifikasi mana yang ikut mengirim email, selain notifikasi in-app (Inbox/lonceng) yang selalu aktif.</p>
                        </div>
                    </div>
                    <div class="dp-header-actions">
                        <button type="button" class="dp-btn dp-btn-outline" id="btn_refresh"><i class="fa fa-refresh"></i> Refresh</button>
                    </div>
                </div>
            </div>
            <div class="dp-card">
                @Html.Partial("_GridView")
            </div>
        </div>
    </div>
</section>

@Html.Partial("_Javascript")
