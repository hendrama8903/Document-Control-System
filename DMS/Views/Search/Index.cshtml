@model DMS.Controllers.SearchController.PageModel
@using System.Text.RegularExpressions
@{
    // Hasil pencarian dokumen global (full-text search, request Hendra 2026-11-06)
    Microsoft.AspNetCore.Html.IHtmlContent Highlight(string text)
    {
        if (string.IsNullOrEmpty(text)) return new Microsoft.AspNetCore.Html.HtmlString("");
        string encoded = System.Net.WebUtility.HtmlEncode(text);
        foreach (string term in Model.Terms.OrderByDescending(t => t.Length))
        {
            string pattern = Regex.Escape(System.Net.WebUtility.HtmlEncode(term));
            encoded = Regex.Replace(encoded, "(?<!<[^>]*)(" + pattern + ")", "<mark>$1</mark>", RegexOptions.IgnoreCase);
        }
        return new Microsoft.AspNetCore.Html.HtmlString(encoded);
    }

    string Snippet(string snippet)
    {
        if (string.IsNullOrWhiteSpace(snippet)) return null;
        string s = Regex.Replace(snippet, @"\s+", " ").Trim();
        return "… " + s + " …";
    }

    string StatusClass(DMS.Controllers.SearchController.Result r) =>
        r.SOURCE_TYPE == "EXTERNAL" ? (r.STATUS == "1" ? "ok" : "bad")
        : r.STATUS switch { "1" or "5" => "ok", "4" => "warn", "2" => "bad", _ => "wait" };

    string FileIcon(string path)
    {
        string ext = System.IO.Path.GetExtension(path ?? "").ToLowerInvariant();
        return ext switch { ".pdf" => "fa-file-pdf-o", ".doc" or ".docx" => "fa-file-word-o", ".xls" or ".xlsx" => "fa-file-excel-o", _ => "fa-file-o" };
    }

    // Dokumen sah dibuka sebagai end user (stempel CONTROLLED COPY, sama seperti My
    // Documents); draft milik sendiri / admin dibuka sebagai tampilan internal.
    string ViewType(DMS.Controllers.SearchController.Result r) =>
        !Model.IsAdmin && (r.STATUS == "1" || r.STATUS == "4" || r.STATUS == "5") ? "3" : "1";
}

<link rel="stylesheet" href="~/css/views/Search/Index.css" asp-append-version="true" />

<section class="content">
    <div class="srch-wrap">
        <form class="srch-form" method="get" action="@Url.Action("Index", "Search")">
            <input type="search" name="q" value="@Model.Query" placeholder="Search by document number, title, or words inside the document" maxlength="200" autofocus />
            <button type="submit"><i class="fa fa-search"></i> Search</button>
        </form>

        @if (Model.Terms.Count == 0)
        {
            <div class="srch-empty">
                <i class="fa fa-search"></i>
                Type at least 2 characters to search document numbers, titles and the text inside documents.
            </div>
        }
        else
        {
            <div class="srch-head">
                <h3>Results for "@Model.Query"</h3>
                <span>@Model.Total document@(Model.Total == 1 ? "" : "s") found</span>
            </div>

            @if (Model.Results.Count == 0)
            {
                <div class="srch-empty">
                    <i class="fa fa-folder-open-o"></i>
                    No documents contain all of these words. Try fewer or different words.
                </div>
            }

            @foreach (var r in Model.Results)
            {
                string openJs;
                if (r.SOURCE_TYPE == "EXTERNAL")
                {
                    openJs = "window.open('" + Url.Action("DownloadAttachment", "ExternalDocument", new { path = r.FILE_PATH }) + "', '_blank')";
                }
                else
                {
                    openJs = "window.open('" + Url.Action("ViewAttachment", "DocumentMaintenance", new { FILE_PATH = r.FILE_PATH, DOCUMENT_TRANSACTION_ID = r.SOURCE_ID, type = ViewType(r) }) + "', '_blank')";
                }
                string snippet = Snippet(r.SNIPPET);

                <div class="srch-item">
                    <div class="srch-icon"><i class="fa @FileIcon(r.FILE_PATH)"></i></div>
                    <div class="srch-body">
                        <a class="srch-title" onclick="@openJs" title="Open document">@Highlight(r.TITLE ?? r.DOCUMENT_CODE ?? "(untitled)")</a>
                        @if (!string.IsNullOrEmpty(r.DOCUMENT_CODE))
                        {
                            <div class="srch-code">@Highlight(r.DOCUMENT_CODE)</div>
                        }
                        <div class="srch-meta">
                            @if (r.SOURCE_TYPE == "EXTERNAL")
                            {
                                <span class="srch-badge ext">External</span>
                            }
                            <span class="srch-badge @StatusClass(r)">@(r.STATUS_NAME ?? "-")</span>
                            @if (!string.IsNullOrEmpty(r.REVISION)) { <span>Rev. @r.REVISION</span> }
                            @if (!string.IsNullOrEmpty(r.CATEGORY_NAME)) { <span>@r.CATEGORY_NAME</span> }
                            @if (!string.IsNullOrEmpty(r.DEPARTMENT_NAME)) { <span><i class="fa fa-building-o"></i> @r.DEPARTMENT_NAME</span> }
                            @if (r.DOC_DATE != null) { <span><i class="fa fa-calendar-o"></i> @r.DOC_DATE.Value.ToString("dd MMM yyyy")</span> }
                        </div>
                        @if (snippet != null)
                        {
                            <div class="srch-snippet"><small>Found in document content@(r.EXTRACT_METHOD != null && r.EXTRACT_METHOD.Contains("OCR") && r.EXTRACT_METHOD != "TEXT/NO-OCR" ? " · read by OCR from scanned pages - may contain recognition errors" : "")</small>@Highlight(snippet)</div>
                        }
                    </div>
                </div>
            }

            @if (Model.PageCount > 1)
            {
                <div class="srch-pager">
                    @if (Model.Page > 1)
                    {
                        <a href="@Url.Action("Index", "Search", new { q = Model.Query, page = Model.Page - 1 })">&lsaquo;</a>
                    }
                    @for (int p = Math.Max(1, Model.Page - 3); p <= Math.Min(Model.PageCount, Model.Page + 3); p++)
                    {
                        if (p == Model.Page) { <span class="cur">@p</span> }
                        else { <a href="@Url.Action("Index", "Search", new { q = Model.Query, page = p })">@p</a> }
                    }
                    @if (Model.Page < Model.PageCount)
                    {
                        <a href="@Url.Action("Index", "Search", new { q = Model.Query, page = Model.Page + 1 })">&rsaquo;</a>
                    }
                </div>
            }

            <div class="srch-note">Document contents are indexed automatically a few minutes after a file is uploaded. Scanned PDFs and images are read with OCR, so their text may contain recognition errors.</div>
        }
    </div>
</section>
