@* Administration > Document Access Log - audit trail siapa membuka / mengunduh /
   mencetak dokumen apa (request Hendra 2026-11-06). *@
<link rel="stylesheet" href="~/css/devextreme/dx.light.css" asp-append-version="true" />
<script src="~/js/devextreme/dx.custom.js" asp-append-version="true"></script>

<link rel="stylesheet" href="~/css/views/DocumentAccessLog/Index.css" asp-append-version="true" />

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-card">
                <div class="box-header dp-toolbar dal-toolbar">
                    <div class="dp-toolbar-left" style="flex-wrap:wrap;">
                        <div>
                            <label>Date Range</label>
                            <div style="display:inline-block; width:230px;">
                                <input class="form-control input-sm" id="dalDate" type="text" placeholder="All dates" autocomplete="off" />
                            </div>
                        </div>
                        <div>
                            <label>Action</label>
                            <select id="dalAction" class="form-control input-sm">
                                <option value="">All Action</option>
                                <option value="VIEW">View</option>
                                <option value="DOWNLOAD">Download</option>
                                <option value="PRINT">Print</option>
                            </select>
                        </div>
                        <div style="min-width:200px;">
                            <label>User</label>
                            <select id="dalUser" class="form-control input-sm" style="width:200px;"></select>
                        </div>
                        <div>
                            <label>Document</label>
                            <input class="form-control input-sm dal-keyword" id="dalKeyword" type="text" placeholder="Document no. or title" />
                        </div>
                        <button type="button" class="dp-btn dp-btn-outline" id="dal_refresh" title="Refresh"><i class="fa fa-refresh"></i> Refresh</button>
                    </div>
                    <div class="dp-toolbar-right">
                        <button type="button" class="dp-btn dp-btn-outline" id="dal_export"><i class="fa fa-download"></i> Export</button>
                    </div>
                </div>
                <div class="box-body">
                    <div id="datagrid"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    var documentAccessLogConfig = {
        urls: {
            userNames: "@Url.Action("GetUserName", "User")",
            downloadExcel: "@Url.Action("DownloadExcel", "DocumentAccessLog")",
            search: "@Url.Action("Search", "DocumentAccessLog")"
        }
    };
</script>
<script src="~/js/views/document-access-log.js" asp-append-version="true"></script>
