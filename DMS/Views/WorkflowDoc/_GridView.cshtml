<link rel="stylesheet" href="~/css/devextreme/dx.light.css" asp-append-version="true" />
<script src="~/js/devextreme/dx.web.js" asp-append-version="true"></script>

<style>
    /* pastikan editor filter row terlihat jelas (hindari bentrok styling tema) */
    #datagrid .dx-datagrid-filter-row .dx-texteditor {
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fff;
    }

    #datagrid .dx-datagrid-filter-row .dx-texteditor-input {
        padding: 5px 8px;
        min-height: 28px;
    }

    /* sisakan ruang untuk ikon kaca pembesar (menu operator filter) agar tidak menimpa teks */
    #datagrid .dx-datagrid-filter-row .dx-editor-with-menu .dx-texteditor-input,
    #datagrid .dx-datagrid-filter-row .dx-editor-with-menu .dx-placeholder::before {
        padding-left: 32px;
    }

    /* tampilkan judul kolom penuh (wrap), jangan terpotong "..." */
    #datagrid .dx-datagrid-headers .dx-header-row td .dx-datagrid-text-content {
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        line-height: 1.3;
    }

    .wf-level-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
        background: #E7F1FB;
        color: #2450D8;
    }
    .wf-cat-pill {
        display: inline-block; padding: 3px 10px; border-radius: 20px;
        font-size: 11.5px; font-weight: 700; background: #FEF0C7; color: #93370D;
    }
    .wf-cat-default { color: #98A2B3; font-size: 12px; }
    .wf-note-warn { color: #B54708; font-size: 12px; white-space: normal; }
    .wf-status-active, .wf-status-inactive {
        display: inline-block; padding: 3px 10px; border-radius: 20px;
        font-size: 11.5px; font-weight: 700;
    }
    .wf-status-active { background: #D1FADF; color: #05603A; }
    .wf-status-inactive { background: #EAECF0; color: #475467; }
    #datagrid .wf-row-inactive td { color: #98A2B3; }

</style>

<div class="box-body">
    <div id="datagrid"></div>
</div>

<script type="text/javascript">
    var gCanEdit = @(((bool)ViewData["Edit"]) ? "true" : "false");
    var gCanDelete = @(((bool)ViewData["Delete"]) ? "true" : "false");
    var gCanAdd = @(((bool)ViewData["Add"]) ? "true" : "false");

    function getSelectedRowData() {
        var rows = $("#datagrid").dxDataGrid("instance").getSelectedRowsData();
        return rows.length > 0 ? rows[0] : null;
    }

    function updateActionButtons() {
        var row = getSelectedRowData();
        var selected = row != null;

        $("#btn_edit").prop("disabled", !selected);
        $("#btn_delete").prop("disabled", !selected);
        $("#btn_duplicate").prop("disabled", !selected);
        $("#btn_toggle_active").prop("disabled", !selected);
        $("#btn_toggle_active span").text(selected && row.IS_ACTIVE === false ? "Activate" : "Deactivate");
    }

    function computeGridHeight() {
        var gridTop = $("#datagrid").offset().top;
        var footerHeight = $("#divFooter").outerHeight(true) || 0;

        return Math.max(300, $(window).height() - gridTop - footerHeight - 40);
    }

    function wfRenderStats(data) {
        var total = data.length;
        var levels = new Set(data.map(function (r) { return r.DOCUMENT_LEVEL; })).size;
        var steps = data.reduce(function (sum, r) { return sum + (parseInt(r.WORKFLOW_SEQ) || 0); }, 0);

        var lastUpdated = null;
        data.forEach(function (r) {
            var dt = r.CHANGED_DT || r.CREATED_DT;
            if (dt != null && (lastUpdated == null || moment(dt).isAfter(lastUpdated))) {
                lastUpdated = dt;
            }
        });

        $("#wfStatTotal").text(total);
        $("#wfStatLevels").text(levels);
        $("#wfStatSteps").text(steps);
        $("#wfStatLastUpdated").html(lastUpdated != null
            ? moment(lastUpdated).format("DD MMM YYYY") + "<br><span style='font-size:11px;font-weight:600;color:#66788A;'>" + moment(lastUpdated).format("HH:mm") + "</span>"
            : "-");
    }

    $(document).ready(function () {
        $("#btn_add").prop("disabled", false);
        $("#btn_edit").prop("disabled", true);
        $("#btn_delete").prop("disabled", true);
        $("#btn_duplicate").prop("disabled", true);
        $("#btn_toggle_active").prop("disabled", true);

        var gridStore = new DevExpress.data.CustomStore({
            key: "WORKFLOW_DOC_ID",
            loadMode: "raw",
            load: function () {
                var d = $.Deferred();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Search", "WorkflowDoc")",
                    data: {
                        draw: 1,
                        start: 0,
                        length: 100000,
                        initialMode: false
                    }
                }).done(function (result) {
                    var data = result.data == "" ? [] : result.data;
                    wfRenderStats(data);
                    d.resolve(data);
                }).fail(function () {
                    d.reject("Data loading error");
                });

                return d.promise();
            }
        });

        $("#datagrid").dxDataGrid({
            dataSource: gridStore,
            showBorders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            wordWrapEnabled: false,
            sorting: { mode: "none" },
            noDataText: "Data not found.",
            height: computeGridHeight(),
            filterRow: { visible: false, applyFilter: "auto" },
            headerFilter: { visible: true },
            searchPanel: { visible: false, highlightCaseSensitive: false },
            toolbar: { visible: false },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always",
                allowSelectAll: false
            },
            paging: { pageSize: 10 },
            pager: {
                visible: true,
                displayMode: "compact",
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true,
                showNavigationButtons: true
            },
            columnChooser: {
                enabled: true,
                mode: "select"
            },
            columnFixing: { enabled: true },
            onSelectionChanged: function (e) {
                if (e.selectedRowKeys.length > 1) {
                    e.component.selectRows(e.currentSelectedRowKeys, false);
                    return;
                }
                updateActionButtons();
            },
            onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data.IS_ACTIVE === false) {
                    e.rowElement.addClass("wf-row-inactive");
                }
            },
            columns: [
                { type: "selection", width: 40, fixed: true, fixedPosition: "left" },
                {
                    caption: "No",
                    width: 50,
                    alignment: "center",
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        var pageIndex = options.component.pageIndex();
                        var pageSize = options.component.pageSize();
                        container.text(pageIndex * pageSize + options.row.rowIndex + 1);
                    }
                },
                {
                    dataField: "DOCUMENT_LEVEL",
                    caption: "Document Level",
                    alignment: "center",
                    fixed: true,
                    fixedPosition: "left",
                    cellTemplate: function (container, options) {
                        $("<span>").addClass("wf-level-pill").text("Level " + options.data.DOCUMENT_LEVEL).appendTo(container);
                    }
                },
                {
                    // Kosong = alur default level (berlaku untuk semua kategori di level
                    // itu yang tidak punya alur khusus); terisi = alur khusus kategori.
                    dataField: "DOCUMENT_CODE",
                    caption: "Document Category",
                    cellTemplate: function (container, options) {
                        if (options.data.DOCUMENT_ID) {
                            $("<span>").addClass("wf-cat-pill").text(options.data.DOCUMENT_CODE).appendTo(container);
                        } else {
                            $("<span>").addClass("wf-cat-default").text("Default (all categories)").appendTo(container);
                        }
                    }
                },
                {
                    caption: "Status",
                    alignment: "center",
                    calculateCellValue: function (rowData) { return rowData.IS_ACTIVE === false ? "Inactive" : "Active"; },
                    cellTemplate: function (container, options) {
                        $("<span>").addClass(options.value === "Active" ? "wf-status-active" : "wf-status-inactive").text(options.value).appendTo(container);
                    }
                },
                { dataField: "CREATOR_NAME", caption: "Creator Level" },
                { dataField: "WORKFLOW_SEQ", caption: "Total Steps", alignment: "center" },
                {
                    dataField: "POSITION_NAME",
                    caption: "Approver Chain",
                    cellTemplate: function (container, options) {
                        container.text(options.data.POSITION_NAME || "");
                        if ((options.data.POSITION_NAME || "").indexOf("*") >= 0) {
                            container.attr("title", "* = mandatory approver");
                        }
                    }
                },
                {
                    dataField: "NOTES",
                    caption: "Notes",
                    cellTemplate: function (container, options) {
                        if (options.data.NOTES) {
                            $("<span>").addClass("wf-note-warn")
                                .html('<i class="fa fa-exclamation-triangle"></i> ')
                                .append(document.createTextNode(options.data.NOTES))
                                .appendTo(container);
                        }
                    }
                },
                { dataField: "CREATED_BY", caption: "Created By", visible: false },
                {
                    dataField: "CREATED_DT",
                    caption: "Created Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CREATED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY") : "");
                    }
                },
                { dataField: "CHANGED_BY", caption: "Changed By", visible: false },
                {
                    dataField: "CHANGED_DT",
                    caption: "Changed Date",
                    alignment: "right",
                    visible: false,
                    cellTemplate: function (container, options) {
                        var value = options.data.CHANGED_DT;
                        container.text(value != null ? moment(value).format("DD-MM-YYYY") : "");
                    }
                },
                {
                    caption: "Action",
                    alignment: "center",
                    width: 70,
                    allowHiding: false,
                    allowFiltering: false,
                    fixed: true,
                    fixedPosition: "right",
                    cellTemplate: function (container, options) {
                        var row = options.data;

                        $("<button>")
                            .attr({ type: "button", title: "More actions" })
                            .addClass("dp-act-kebab")
                            .html('<i class="fa fa-ellipsis-v"></i>')
                            .on("click", function (e) {
                                e.stopPropagation();
                                openRowActionMenu($(this), row);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });

        $("#btn_columns").on("click", function () {
            $("#datagrid").dxDataGrid("instance").showColumnChooser();
        });

        // ---------- toolbar: show/hide column filter row ("More Filters") ----------
        $("#btn_toggleFilters").on("click", function () {
            var grid = $("#datagrid").dxDataGrid("instance");
            var visible = !grid.option("filterRow.visible");
            grid.option("filterRow.visible", visible);
            $(this).toggleClass("active", visible);
        });

        // ---------- toolbar: reset ----------
        $("#btn_resetFilters").on("click", function () {
            var grid = $("#datagrid").dxDataGrid("instance");
            grid.clearFilter();
            grid.clearSelection();
        });

        // ---------- toolbar: refresh ----------
        $("#btn_refresh").on("click", function () {
            $("#datagrid").dxDataGrid("instance").clearSelection();
            $("#datagrid").dxDataGrid("instance").refresh();
        });

        $(window).on("resize", function () {
            $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
        });

        $('body').tooltip({ selector: '[data-toggle="tooltip"]' });
    });

    // ---------- per-row "more actions" kebab menu ----------
    var $wfRowMenu = null;

    function buildRowActionMenu() {
        if ($wfRowMenu) return $wfRowMenu;

        $wfRowMenu = $('<ul class="dropdown-menu dp-dropdown-menu" role="menu"></ul>')
            .css({ position: "absolute", display: "none", "z-index": 2000, "min-width": "170px" })
            .appendTo("body");

        $(document).on("click", function () {
            $wfRowMenu.hide();
        });

        return $wfRowMenu;
    }

    function menuItem(cssClass, icon, label, onClick) {
        var $li = $('<li><a href="#" class="' + cssClass + '"><i class="fa ' + icon + '"></i> ' + label + '</a></li>');
        $li.find("a").on("click", function (e) {
            e.preventDefault();
            $wfRowMenu.hide();
            onClick();
        });
        return $li;
    }

    function openRowActionMenu($btn, row) {
        var $menu = buildRowActionMenu();
        $menu.empty();
        var grid = $("#datagrid").dxDataGrid("instance");

        if (gCanEdit) {
            $menu.append(menuItem("dp-menu-edit", "fa-pencil-square-o", "Edit", function () {
                grid.selectRows([row.WORKFLOW_DOC_ID], false);
                onEditPrepare();
            }));
        }

        if (gCanAdd) {
            $menu.append(menuItem("dp-menu-edit", "fa-files-o", "Duplicate", function () {
                onDuplicatePrepare(row);
            }));
        }

        if (gCanEdit) {
            $menu.append(menuItem("dp-menu-edit", "fa-power-off", row.IS_ACTIVE === false ? "Activate" : "Deactivate", function () {
                onToggleActivePrepare(row);
            }));
        }

        if (gCanDelete) {
            $menu.append('<li class="divider"></li>');
            $menu.append(menuItem("dp-menu-delete", "fa-trash-o", "Delete", function () {
                grid.selectRows([row.WORKFLOW_DOC_ID], false);
                onDeletePrepare();
            }));
        }

        var offset = $btn.offset();
        $menu.css({ top: offset.top + $btn.outerHeight() + 4, left: offset.left - $menu.outerWidth() + $btn.outerWidth() })
            .show();
    }
</script>
