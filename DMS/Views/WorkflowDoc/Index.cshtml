<link rel="stylesheet" href="~/css/views/shared/master-stats-panel.css" asp-append-version="true" />
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="dp-layout-row stats-collapsed" id="dpLayoutRow">
                <div class="dp-layout-main">
                    <div class="dp-card">
                        <div id="divSearch">
                            @Html.Partial("_SearchCriteria")
                        </div>
                        <div id="divGrid">
                            @Html.Partial("_GridView")
                        </div>
                    </div>
                </div>

                <aside class="dp-stats-panel" id="dpStatsPanel">
                    <div class="dp-stats-panel-head">
                        <span>Workflow Summary</span>
                        <button type="button" class="dp-stats-panel-close" id="btn_closeStatsPanel"><i class="fa fa-times"></i></button>
                    </div>
                    <div class="dp-stats-panel-body" id="wfStatsRow">
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon blue"><i class="fa fa-random"></i></div>
                            <div>
                                <span>Total Workflow</span>
                                <b id="wfStatTotal">-</b>
                                <small>All configurations</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon green"><i class="fa fa-layer-group"></i></div>
                            <div>
                                <span>Document Levels</span>
                                <b id="wfStatLevels">-</b>
                                <small>Distinct document levels</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon amber"><i class="fa fa-list-ol"></i></div>
                            <div>
                                <span>Approval Steps</span>
                                <b id="wfStatSteps">-</b>
                                <small>Total approval steps</small>
                            </div>
                        </div>
                        <div class="dp-stat-card">
                            <div class="dp-stat-card-icon purple"><i class="fa fa-calendar"></i></div>
                            <div>
                                <span>Last Updated</span>
                                <b id="wfStatLastUpdated">-</b>
                                <small>&nbsp;</small>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>
@Html.Partial("_PopupForm")
@Html.Partial("_Javascript")
