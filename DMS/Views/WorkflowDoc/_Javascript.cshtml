<script type="text/javascript">
    var gScreenMode = null;
    var gId = null;
    var gCode = null;
    var gName = null;
    var seq = 1;
    var detailData = [];
    var detailTable = null;
    // Tombol "Add" di section "Add New Level & Position" dobel fungsi jadi
    // "Update" begitu satu baris dipilih (lewat klik baris atau ikon pensil) -
    // tidak ada tombol Edit terpisah lagi seperti desain lama (request Hendra
    // 2026-08-18, redesign UI popup ini).
    var gDetailEditMode = false;

    // Kolom "Action" (ikon edit/delete per baris) - dipakai di DUA konfigurasi
    // DataTable (onAddPrepare & onEditPrepare) supaya tidak duplikasi definisi.
    // Delete cuma boleh untuk baris LEVEL PALING TINGGI (aturan sama seperti
    // tombol Delete lama - urutan level harus tetap rapat, tidak boleh bolong
    // di tengah).
    var detailActionColumnDef = {
        "targets": [3],
        "className": "text-center",
        "orderable": false,
        "render": function (data, type, row) {
            var canDelete = (parseInt(row.WORKFLOW_SEQ) + 1 == seq);
            return '<button type="button" class="wfd-row-btn wfd-row-edit" title="Edit"><i class="fa fa-pencil"></i></button>' +
                '<button type="button" class="wfd-row-btn wfd-row-delete" title="Delete"' + (canDelete ? '' : ' disabled') + '><i class="fa fa-trash"></i></button>';
        }
    };

    $(document).ready(function() {

        setDataSelect2("addEditApprover", "@Url.Action("GetUserName", "User")", "- Choose -");

        setDataSelect2WithParam("addEditWorkflowDocLevel", "@Url.Action("GetSystemCodeSystemValue", "MSystem")", "- Choose -", "LEVEL_CODE");
        setDataSelect2("addEditPositionName", "@Url.Action("GetPositionName", "WorkflowDoc")", "- Choose -");
        setDataSelect2("addEditPositionName2", "@Url.Action("GetPositionName", "WorkflowDoc")", "- Choose -");

        $("#btn_add").on("click", function() {
            onAddPrepare();
        });

        $("#btn_edit").on("click", function() {
            onEditPrepare();
        });

        $("#btn_delete").on("click", function() {
            onDeletePrepare();
        });

        $("#btn_save").on("click", function() {
            confirmAddEditData();
        });

        // Tombol tunggal "Add"/"Update" - lihat gDetailEditMode (di-toggle oleh
        // onSelectDetail waktu baris dipilih, dan onClearDetail waktu direset).
        $("#btn_add_detail").on("click", function () {
            if (gDetailEditMode) {
                onEditDetail();
            } else {
                onAddDetail();
            }
        });

        $("#btn_clear_detail").on("click", function () {
            onClearDetail();
        });

        $("#detailgrid").on("click", "tbody tr", function (e) {
            onSelectDetail($(this));
        });

        // Ikon pensil/tempat sampah per baris (kolom Action) - pensil pilih
        // baris untuk diedit (form di atas ikut dipetakan lewat onSelectDetail,
        // tombol Add berubah jadi Update), tempat sampah langsung hapus baris
        // itu (kalau memang boleh - lihat detailActionColumnDef).
        $("#detailgrid").on("click", ".wfd-row-edit", function (e) {
            e.stopPropagation();
            onSelectDetail($(this).closest("tr"));
        });

        $("#detailgrid").on("click", ".wfd-row-delete", function (e) {
            e.stopPropagation();
            if ($(this).prop("disabled")) return;
            onSelectDetail($(this).closest("tr"));
            onDeleteDetail();
        });

        function setStatsPanelCollapsed(collapsed) {
            var $row = $("#dpLayoutRow");
            var $icon = $("#btn_toggleStats i");

            $row.toggleClass("stats-collapsed", collapsed);
            $icon.toggleClass("fa-angle-double-right", !collapsed).toggleClass("fa-angle-double-left", collapsed);
            $("#btn_toggleStats").attr("title", collapsed ? "Show Summary" : "Hide Summary");

            setTimeout(function () {
                $("#datagrid").dxDataGrid("instance").option("height", computeGridHeight());
            }, 230);
        }

        $("#btn_toggleStats").on("click", function () {
            setStatsPanelCollapsed(!$("#dpLayoutRow").hasClass("stats-collapsed"));
        });

        $("#btn_closeStatsPanel").on("click", function () {
            setStatsPanelCollapsed(true);
        });

    });

    function onSearch() {
        var grid = $("#datagrid").dxDataGrid("instance");
        grid.clearSelection();
        grid.refresh();
    }

    function onAddPrepare() {
        gScreenMode = 'ADD';
        gId = null;
        $("#datagrid").dxDataGrid("instance").clearSelection();
        $('#modal-title').html("Add Workflow Document Master");
        $("#addEditWorkflowDocLevel").val("").trigger("change");
        $("#addEditPositionName").val("").trigger("change");
        $("#addEditWorkflowSeq").val("").trigger("change");
        $("#addEditPositionName2").val("").trigger("change");
        
        $('#addEditWorkflowDocLevel').prop('disabled', false);
        $('#addEditPositionName').prop('disabled', false);
        $('#addEditWorkflowSeq').prop('disabled', false);
        $('#addEditPositionName2').prop('disabled', false);

        $("#detailgrid").dataTable().fnDestroy();
        detailTable = $('#detailgrid').DataTable({
            "ordering"      : false,
            "oLanguage"     : { "sEmptyTable": "Data not found." },
            "scrollY"       : '110px',
            "scrollCollapse": false,
            "paging"        : false,
            "info"          : false,
            "searching"     : false,
            "data"          : [],
            "columnDefs"    : [
                {
                    "targets"   : [0],
                    "width"     : "18%",
                    "className" : "seq text-center",
                    "render"    : function (data) { return '<span class="wfd-level-badge">' + data + '</span>'; }
                },
                {
                    "targets": [2],
                    "className": "hide"
                },
                detailActionColumnDef
            ],
            "columns": [
                { "data": "WORKFLOW_SEQ", "name": "WORKFLOW_SEQ" },
                { "data": "POSITION_NAME", "name": "POSITION_NAME" },
                { "data": "POSITION_ID", "name": "POSITION_ID" },
                { "data": null, "name": "ACTION", "defaultContent": "" }
            ]
        });
        
        seq = 1;
        detailData = [];
        onClearDetail();
        
        $('#addEditWorkflowSeq').empty();
        $('#addEditWorkflowSeq').append(new Option(seq, seq, false, false)).trigger('change');

        $("#modalAddEdit").modal({
            backdrop: 'static',
            keyboard: false
        });
        $('#modalAddEdit').on('shown.bs.modal', function() {
            $('#addEditWorkflowCode').focus();
            $("#detailgrid").DataTable().columns.adjust().draw();
        });
    }

    function onEditPrepare() {

        var row = getSelectedRowData();
        if (row == null) {
            return;
        }

        gId = row.WORKFLOW_DOC_ID;
        gCode = row.DOCUMENT_LEVEL;
        gName = row.CREATOR_LEVEL;

        $.ajax({
            type: "POST",
            url: "@Url.Action("GetByCode", "WorkflowDoc")",
            async: false,
            data: {
                WORKFLOW_DOC_ID: gId,
                DOCUMENT_LEVEL : gCode,
                POSITION_ID: gName

            },
            success: function(result) {
                if (result.status == true) {
                    var data = result.data;
                    var data2 = result.data2;
                    console.log(data)
                    gScreenMode = 'EDIT';
                    $('#modal-title').html("Edit Workflow Doc Master");
                    $('#addEditWorkflowDocLevel').select2("trigger", "select", { data: { id: gCode.toString(), text: gCode.toString() } });
                    $('#addEditPositionName').select2("trigger", "select", { data: { id: data2.POSITION_ID, text: data2.POSITION_NAME } });

                    $("#addEditWorkflowDocLevel").prop("disabled", true);
                    $("#addEditPositionName").prop("disabled", true);
                    
                    $("#detailgrid").dataTable().fnDestroy();
                    detailTable = $('#detailgrid').DataTable({
                        "ordering"      : false,
                        "oLanguage"     : { "sEmptyTable": "Data not found." },
                        "scrollY"       : '110px',
                        "scrollCollapse": false,
                        "paging"        : false,
                        "info"          : false,
                        "searching"     : false,
                        "data"          : [],
                        "columnDefs"    : [
                            {
                                "targets": [0],
                                "width": "18%",
                                "className": "seq text-center",
                                "render": function (data) { return '<span class="wfd-level-badge">' + data + '</span>'; }
                            },
                            {
                                "targets": [2],
                                "className": "hide"
                            },
                            detailActionColumnDef
                        ],
                        "columns": [
                            { "data": "WORKFLOW_SEQ", "name": "WORKFLOW_SEQ" },
                            { "data": "POSITION_NAME", "name": "POSITION_NAME" },
                            { "data": "POSITION_ID", "name": "POSITION_ID" },
                            { "data": null, "name": "ACTION", "defaultContent": "" }
                        ]
                    });
        
                    seq = 1;
                    detailData = data;

                    detailTable.clear().draw();
                    detailTable.rows.add(detailData).draw(false);

                    $('#addEditWorkflowSeq').empty();
                    seq = parseInt(Math.max(...detailData.map(o => o.WORKFLOW_SEQ))) + 1;
                    for (let i = 1; i <= seq; i++) {
                        $('#addEditWorkflowSeq').append(new Option(i, i, false, false)).trigger('change');
                    }
                    onClearDetail();

                    $("#modalAddEdit").modal({
                        backdrop: 'static',
                        keyboard: false
                    });
                    $('#modalAddEdit').on('shown.bs.modal', function() {
                        $("#detailgrid").DataTable().columns.adjust().draw();
                    });
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function(result) {
                //popUpProgressHide();
                showErrorMesgGrowl(result);
            }
        });
    }

    function onDeletePrepare() {

        var row = getSelectedRowData();
        if (row == null) {
            return;
        }

        gId = row.WORKFLOW_DOC_ID;

        showConfirmMesg("Are you sure you want to delete the record?", deleteData, "Confirmation");
    }
    
    // Ganti tampilan tombol Add/Update sesuai gDetailEditMode.
    function refreshDetailActionButton() {
        var $btn = $("#btn_add_detail");
        if (gDetailEditMode) {
            $btn.addClass("wfd-btn-update").html('<i class="fa fa-check"></i> Update');
        } else {
            $btn.removeClass("wfd-btn-update").html('<i class="fa fa-plus"></i> Add');
        }
    }

    function onClearDetail() {
        $('#addEditWorkflowSeq').val(seq).trigger("change");
        $('#addEditPositionName2').val("").trigger("change");

        $("#addEditWorkflowSeq").prop("disabled", false);
        $("#btn_add_detail").prop("disabled", false);

        gDetailEditMode = false;
        refreshDetailActionButton();

        $('#detailgrid tr').removeClass("selected");
    }

    function onSelectDetail($row) {
        if(!$row.find("td:nth-child(1)").hasClass("dataTables_empty")){
            var workflowSeq = $row.find("td:nth-child(1)").text();
            var fullname    = $row.find("td:nth-child(2)").text();
            var approver    = $row.find("td:nth-child(3)").text();

            $('#addEditWorkflowSeq').val(workflowSeq).trigger("change");
            $('#addEditPositionName2').select2("trigger", "select", { data: { id: approver, text: fullname } });

            $("#addEditWorkflowSeq").prop("disabled", true);

            gDetailEditMode = true;
            refreshDetailActionButton();

            $('#detailgrid tr').removeClass("selected");
            $row.addClass('selected');
        }
    }

    function onAddDetail(){
        if ($('#addEditPositionName2').val() != null) {

            var data = {
                "WORKFLOW_SEQ" : $('#addEditWorkflowSeq').val(),
                "POSITION_NAME": $('#addEditPositionName2').select2('data')[0].text,
                "POSITION_ID"  : $('#addEditPositionName2').val(),
            };
            detailData.push(data);
            detailData.sort((a, b) => parseInt(a.WORKFLOW_SEQ) - parseInt(b.WORKFLOW_SEQ));
            
            detailTable.clear().draw();
            detailTable.rows.add(detailData).draw(false);

            if($('#addEditWorkflowSeq').val() == seq){
                seq++;
                $('#addEditWorkflowSeq').append(new Option(seq, seq, false, false)).trigger('change');
            }
            onClearDetail();
        }
    }

    function onEditDetail(){
        if ($('#addEditPositionName2').val() != null) {
            var i = $('#detailgrid tr.selected').index();
            
            var data = {
                "WORKFLOW_SEQ" : $('#addEditWorkflowSeq').val(),
                "POSITION_NAME": $('#addEditPositionName2').select2('data')[0].text,
                "POSITION_ID"  : $('#addEditPositionName2').val(),
            };
            detailData[i] = data;
            detailData.sort((a, b) => parseInt(a.WORKFLOW_SEQ) - parseInt(b.WORKFLOW_SEQ));
            
            detailTable.clear().draw();
            detailTable.rows.add(detailData).draw(false);

            onClearDetail();
        }
    }

    function onDeleteDetail(){
        if ($('#addEditPositionName2').val() != null) {
            var i = $('#detailgrid tr.selected').index();

            detailData.splice(i, 1);
            detailData.sort((a, b) => parseInt(a.WORKFLOW_SEQ) - parseInt(b.WORKFLOW_SEQ));
            
            detailTable.clear().draw();
            detailTable.rows.add(detailData).draw(false);

            if(detailData.length > 0){
                seq = parseInt(Math.max(...detailData.map(o => o.WORKFLOW_SEQ))) + 1;
            }else{
                seq = 1;
            }

            $('#addEditWorkflowSeq').empty();
            for (let i = 1; i <= seq; i++) {
                $('#addEditWorkflowSeq').append(new Option(i, i, false, false)).trigger('change');
            }
            onClearDetail();
        }
    }

    function confirmAddEditData() {
        
        if ($("#addEditWorkflowDocLevel").val().length == 0) {
            showErrorMesgGrowl("Workflow Level cannot be null");
        }
        if ($("#addEditPositionName").val().length == 0) {
            showErrorMesgGrowl("Workflow Position Name cannot be null");
        }
        else if (detailData.length == 0) {
            showErrorMesgGrowl("Detail Workflow cannot be empty");
        }
        else {
            showConfirmMesg("Are you sure you want to continue process?", addEditData, "Confirmation");
        }
    }

    function addEditData() {
        var row = getSelectedRowData();
        if (row != null) {
            gId = row.WORKFLOW_DOC_ID;
        }
        
        detailData.forEach(function (data) {
            data.WORKFLOW_DOC_ID = gId;
            data.DOCUMENT_LEVEL  = $('#addEditWorkflowDocLevel').val();
            data.CREATOR_LEVEL   = $('#addEditPositionName').val();
        });
        
        popUpProgressShow();
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            type       : "POST",
            url        : "@Url.Action("AddEdit", "WorkflowDoc")",
            data       : JSON.stringify(detailData),
            success: function(result) {
                popUpProgressHide();
                if (result.status == true) {
                    showSuccessMesgGrowl(result.message);
                    onSearch();
                    $("#modalAddEdit").modal('hide');
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function(result) {
                popUpProgressHide();
                showErrorMesgGrowl(result);
            }
        });
    }

    function deleteData() {
        popUpProgressShow();
        $.ajax({
            type: "POST",
            url: "@Url.Action("Delete", "WorkflowDoc")",
            dataType: 'json',
            traditional: true,
            data: {
                WORKFLOW_DOC_ID: gId
            },
            success: function(result) {
                popUpProgressHide();
                if (result.status == true) {
                    showSuccessMesgGrowl(result.message);
                    onSearch();
                } else {
                    showErrorMesgGrowl(result.message);
                }
            },
            error: function(result) {
                popUpProgressHide();
                showErrorMesgGrowl(result);
            }
        });
    }

</script>
